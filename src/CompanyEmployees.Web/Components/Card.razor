<section class="card">
    @if (Eyebrow is not null || Title is not null || HeaderAction is not null)
    {
        <div class="card-head">
            <div>
                @if (Eyebrow is not null)
                {
                    <div class="microlabel">@Eyebrow</div>
                }
                @if (Title is not null)
                {
                    <div class="card-title">@Title</div>
                }
            </div>
            @if (HeaderAction is not null)
            {
                @HeaderAction
            }
        </div>
    }
    @ChildContent
</section>

@code {
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? HeaderAction { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
