<div class="greet">
    <div>
        <h1>Calendar</h1>
        <p>Team availability at a glance.</p>
    </div>
    <div class="greet-date">@TodayLabel</div>
</div>

<Card Eyebrow="Team schedule" Title="@MonthLabel">
    <HeaderAction>
        <div class="cp-nav">
            <button class="cal-nav" @onclick="() => OnPrev.InvokeAsync()">‹</button>
            <button class="cp-today" @onclick="() => OnToday.InvokeAsync()">Today</button>
            <button class="cal-nav" @onclick="() => OnNext.InvokeAsync()">›</button>
        </div>
    </HeaderAction>
    <ChildContent>
        <div class="cp-grid cp-wds">
            @foreach (var w in Weekdays)
            {
                <div class="cp-wd">@w</div>
            }
        </div>
        <div class="cp-grid">
            @foreach (var c in Cells)
            {
                <div class="cp-cell @(c.Dim ? "dim" : "") @(c.Wknd ? "wknd" : "") @(c.IsToday ? "today" : "")">
                    <div class="cp-day">@c.Date.Day</div>
                    <div class="cp-evts">
                        @foreach (var e in c.Events.Take(3))
                        {
                            <div class="cp-evt tone-@e.Tone @(e.Pending ? "pending" : "")" title="@e.Title">@e.Label</div>
                        }
                        @if (c.Events.Count > 3)
                        {
                            <div class="cp-more">+@(c.Events.Count - 3) more</div>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="cp-legend">
            <span><span class="tone-mark-accent"></span> Annual</span>
            <span><span class="tone-mark-amber"></span> Sick</span>
            <span><span class="tone-mark-purple"></span> Parental</span>
            <span><span class="tone-mark-gray"></span> Unpaid</span>
            <span class="note">Dashed outline = pending approval</span>
        </div>
    </ChildContent>
</Card>

@code {
    [Parameter, EditorRequired] public string TodayLabel { get; set; } = "";
    [Parameter, EditorRequired] public string MonthLabel { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<string> Weekdays { get; set; } = Array.Empty<string>();
    [Parameter, EditorRequired] public IReadOnlyList<CpCell> Cells { get; set; } = Array.Empty<CpCell>();

    [Parameter] public EventCallback OnPrev { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnToday { get; set; }

    public record CpEvt(string Label, string Tone, bool Pending, string Title);
    public record CpCell(DateTime Date, bool Dim, bool Wknd, bool IsToday, List<CpEvt> Events);
}
