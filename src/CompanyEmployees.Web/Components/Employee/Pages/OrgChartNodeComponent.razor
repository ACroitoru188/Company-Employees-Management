@using CompanyEmployees.Application
@using MudBlazor

<li>
    <div class="org-node @(Node.IsFocusNode ? "org-node-focus" : "org-node-unfocus")">
        <MudAvatar Size="Size.Medium" Color="Color.Primary" Class="mb-2">@Node.Initials</MudAvatar>
        <MudText Typo="Typo.body2" Style="font-weight: 600; line-height: 1.2;">@Node.Name</MudText>
        <MudText Typo="Typo.caption" Style="display: block; margin-top: 4px;">@Node.Role</MudText>
        @if (!string.IsNullOrEmpty(Node.Department))
        {
            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary); display: block;">@Node.Department</MudText>
        }
    </div>
    @if (Node.Subordinates.Any())
    {
        <ul>
            @foreach (var child in Node.Subordinates)
            {
                <OrgChartNodeComponent Node="child" />
            }
        </ul>
    }
</li>

@code {
    [Parameter, EditorRequired]
    public OrgChartNode Node { get; set; } = default!;
}
