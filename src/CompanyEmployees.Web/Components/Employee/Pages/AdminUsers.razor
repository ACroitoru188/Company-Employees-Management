@page "/admin/users"
@layout EmployeeLayout
@using System.Globalization
@using System.Security.Claims
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Domain.Entities
@using CompanyEmployees.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@inject EmployeeContext Employees
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Users · Admin</PageTitle>

@if (!_authorized)
{
	<MudProgressCircular Indeterminate="true" />
}
else
{
	<MudText Typo="Typo.h5" Style="font-weight:600;" Class="mb-4">Users & Contracts</MudText>

	<MudDataGrid T="User" Items="@_users" QuickFilter="@_quickFilter"
				 Filterable="true" SortMode="SortMode.Multiple"
				 FilterMode="DataGridFilterMode.ColumnFilterRow"
				 Hover="true" Dense="true" Elevation="1">
		<ToolBarContent>
			<MudTextField @bind-Value="_quickSearch" Placeholder="Search users or contracts..."
						  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
						  IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense"
						  Immediate="true" />
			<MudSpacer />
		</ToolBarContent>
		<Columns>
			<PropertyColumn Property="@(u => u.Name)" Title="Name" />
			<PropertyColumn Property="@(u => u.Email)" Title="Email" />
			<PropertyColumn Property="@(u => u.Role)" Title="Role" />
			<TemplateColumn T="User" Title="Contract Type" Sortable="true"
							SortBy="@(u => GetActiveContract(u)?.Type.ToString() ?? "None")" Filterable="false">
				<CellTemplate>
					@{
						var contract = GetActiveContract(context.Item);
					}
					@if (contract == null)
					{
						<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">No Contract</MudChip>
					}
					else if (contract.Type == ContractType.Determinate)
					{
						<MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">Determinate</MudChip>
					}
					else
					{
						<MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">Indeterminate</MudChip>
					}
				</CellTemplate>
			</TemplateColumn>
			<TemplateColumn T="User" Title="Contract Period & Status" Sortable="true"
							SortBy="@(u => GetActiveContract(u)?.Status.ToString() ?? "")" Filterable="false">
				<CellTemplate>
					@{
						var contract = GetActiveContract(context.Item);
					}
					@if (contract != null)
					{
						<div class="d-flex flex-column">
							<div class="d-flex align-center gap-1">
								<MudChip T="string" Size="Size.Small" Color="@GetStatusColor(contract.Status)" Variant="Variant.Text" Class="pa-0 ma-0">
									@contract.Status
								</MudChip>
								<MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
									@contract.StartDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) – @(contract.EndDate?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "Indefinite")
								</MudText>
							</div>
						</div>
					}
					else
					{
						<MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">—</MudText>
					}
				</CellTemplate>
			</TemplateColumn>
			<TemplateColumn T="User" Title="Department" Sortable="true"
							 SortBy="@(u => GetDepartmentName(u.DepartmentId))" Filterable="false">
				<CellTemplate>
					<MudAutocomplete T="Guid?" Value="context.Item.DepartmentId"
									 ValueChanged="@(v => OnUserDepartmentChangedAsync(context.Item, v))"
									 SearchFunc="@SearchDepartments"
									 ToStringFunc="@GetDepartmentName"
									 ResetValueOnEmptyText="true"
									 CoerceText="true" Dense="true" />
				</CellTemplate>
			</TemplateColumn>
			<TemplateColumn T="User" Title="Actions" Filterable="false" Sortable="false">
				<CellTemplate>
					<MudTooltip Text="Manage Contract">
						<MudIconButton Icon="@Icons.Material.Filled.Assignment" Size="Size.Small" Color="Color.Primary"
									   OnClick="@(() => OpenEditContractDialog(context.Item))" />
					</MudTooltip>
				</CellTemplate>
			</TemplateColumn>
		</Columns>
		<PagerContent>
			<MudDataGridPager T="User" />
		</PagerContent>
	</MudDataGrid>
}

@code {
	[CascadingParameter]
	private Task<AuthenticationState>? AuthStateTask { get; set; }

	private bool _authorized;
	private List<User> _users = [];
	private List<Department> _departments = [];
	private string _quickSearch = "";

	private Func<User, bool> _quickFilter => u =>
	{
		if (string.IsNullOrWhiteSpace(_quickSearch)) return true;
		var contract = GetActiveContract(u);
		return u.Name.Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
			|| (u.Email ?? "").Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
			|| u.Role.ToString().Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
			|| GetDepartmentName(u.DepartmentId).Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
			|| (contract != null && contract.Type.ToString().Contains(_quickSearch, StringComparison.OrdinalIgnoreCase))
			|| (contract != null && contract.Status.ToString().Contains(_quickSearch, StringComparison.OrdinalIgnoreCase));
	};

	protected override async Task OnInitializedAsync()
	{
		if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
			return;

		var user = (await AuthStateTask!).User;
		var role = user.FindFirst(ClaimTypes.Role)?.Value;
		if (role != UserRole.Admin.ToString())
		{
			Nav.NavigateTo("/employee/dashboard");
			return;
		}

		_authorized = true;
		await LoadAsync();
	}

	private async Task LoadAsync()
	{
		_users = await Employees.GetAllUsersAsync();
		_departments = await Employees.GetDepartmentsAsync();
	}

	private Contract? GetActiveContract(User user)
	{
		return user.Contracts?
			.OrderByDescending(c => c.CreatedAt)
			.FirstOrDefault();
	}

	private Color GetStatusColor(ContractStatus status) => status switch
	{
		ContractStatus.Active => Color.Success,
		ContractStatus.Terminated => Color.Error,
		ContractStatus.Expired => Color.Dark,
		_ => Color.Default
	};

	private async Task OpenEditContractDialog(User user)
	{
		var contract = GetActiveContract(user);
		var parameters = new DialogParameters<EditContractDialog>
		{
			{ x => x.UserName, user.Name },
			{ x => x.ExistingContract, contract }
		};

		var dialog = await DialogService.ShowAsync<EditContractDialog>("Manage Contract", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
		var result = await dialog.Result;

		if (result != null && !result.Canceled && result.Data is EditContractDialog.ContractEditResult res)
		{
			await Employees.SaveUserContractAsync(user.Id, res.Type, res.Status, res.StartDate, res.EndDate, res.Notes);
			Snackbar.Add($"Contract updated for {user.Name}.", Severity.Success);
			await LoadAsync();
		}
	}

	private async Task OnUserDepartmentChangedAsync(User user, Guid? departmentId)
	{
		await Employees.AssignUserToDepartmentAsync(user.Id, departmentId);
		Snackbar.Add($"{user.Name} moved.", Severity.Success);
		await LoadAsync();
	}

	private string GetDepartmentName(Guid? id) =>
		id == null ? "None" : _departments.FirstOrDefault(d => d.Id == id)?.Name ?? "";

	private Task<IEnumerable<Guid?>> SearchDepartments(string value, CancellationToken token)
	{
		var allIds = _departments.Select(d => (Guid?)d.Id).Prepend(null);

		if (string.IsNullOrEmpty(value) || value.Equals("None", StringComparison.InvariantCultureIgnoreCase) || _departments.Any(d => d.Name.Equals(value, StringComparison.InvariantCultureIgnoreCase)))
		{
			return Task.FromResult(allIds);
		}

		var matches = _departments
			.Where(d => d.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase))
			.Select(d => (Guid?)d.Id);
		return Task.FromResult(matches);
	}
}
