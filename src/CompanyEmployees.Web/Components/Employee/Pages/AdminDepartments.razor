@page "/admin/departments"
@layout EmployeeLayout
@using System.Security.Claims
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Domain.Entities
@using CompanyEmployees.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@inject EmployeeContext Employees
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Departments · Admin</PageTitle>

@if (!_authorized)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h5" Style="font-weight:600;" Class="mb-4">Departments</MudText>
    <div class="mb-4">
        <MudTextField @bind-Value="_searchDepartment"
                      Placeholder="Search department..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Small"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"></MudTextField>
    </div>

    <MudTable T="Department" Items="@FilteredDepartments" Hover="true" Elevation="1" Class="mb-6">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Manager</MudTh>
            <MudTh>Members</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">
                <MudTextField @bind-Value="context.Name" Immediate="false"
                              OnBlur="@(() => SaveDepartmentAsync(context))" />
            </MudTd>
            <MudTd DataLabel="Manager">
                <MudSelect T="Guid?" Value="context.ManagerId"
                           ValueChanged="@(v => OnManagerChangedAsync(context, v))">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">None</MudSelectItem>
                    @foreach (var lm in _lineManagers)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)lm.Id)">@lm.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudTd>
            <MudTd DataLabel="Members">@context.Members.Count</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                               OnClick="@(() => DeleteDepartmentAsync(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>

    <MudPaper Class="pa-4 mb-6" Elevation="0" Outlined="true">
        <MudText Typo="Typo.subtitle2" Class="mb-2">New department</MudText>
        <div class="d-flex align-center gap-3">
            <MudTextField T="string" @bind-Value="_newName" Label="Name" />
            <MudSelect T="Guid?" @bind-Value="_newManagerId" Label="Manager" Style="min-width:200px;">
                <MudSelectItem T="Guid?" Value="@((Guid?)null)">None</MudSelectItem>
                @foreach (var lm in _lineManagers)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)lm.Id)">@lm.Name</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateDepartmentAsync">
                Add
            </MudButton>
        </div>
    </MudPaper>

    <MudText Typo="Typo.h5" Style="font-weight:600;" Class="mb-4">Users</MudText>
        <div class="mb-4">
            <MudTextField @bind-Value="_searchUser"
                          Placeholder="Search user..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Small"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"></MudTextField>
        </div>

        <MudTable T="User" Items="@FilteredUsers" Hover="true" Elevation="1">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Role</MudTh>
            <MudTh>Department</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Role">@context.Role</MudTd>
            <MudTd DataLabel="Department">
                <MudSelect T="Guid?" Value="context.DepartmentId"
                           ValueChanged="@(v => OnUserDepartmentChangedAsync(context, v))">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">None</MudSelectItem>
                    @foreach (var d in _departments)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)d.Id)">@d.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _authorized;
    private List<Department> _departments = [];
    private List<User> _users = [];
    private IEnumerable<User> _lineManagers => _users.Where(u => u.Role == UserRole.LineManager);

    private string _newName = "";
    private Guid? _newManagerId;

    private string _searchDepartment = "";

    private IEnumerable<Department> FilteredDepartments =>
        string.IsNullOrWhiteSpace(_searchDepartment)
            ? _departments
            : _departments.Where(d => d.Name.Contains(_searchDepartment, StringComparison.OrdinalIgnoreCase));

    private string _searchUser = "";

    private IEnumerable<User> FilteredUsers =>
        string.IsNullOrWhiteSpace(_searchUser)
            ? _users
            : _users.Where(u => u.Name.Contains(_searchUser, StringComparison.OrdinalIgnoreCase));

    // The role comes from the auth cookie's claims (AppClaimsPrincipalFactory),
    // so non-admins are redirected without a database query.
    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null)
            return;

        var user = (await AuthStateTask).User;
        var role = user.FindFirst(ClaimTypes.Role)?.Value;
        if (role != UserRole.Admin.ToString())
        {
            Nav.NavigateTo("/employee/dashboard");
            return;
        }

        _authorized = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _departments = await Employees.GetDepartmentsAsync();
        _users = await Employees.GetAllUsersAsync();
    }

    private async Task SaveDepartmentAsync(Department dept)
    {
        await Employees.UpdateDepartmentAsync(dept.Id, dept.Name, dept.ManagerId);
        Snackbar.Add("Department updated.", Severity.Success);
        await LoadAsync();
    }

    private async Task OnManagerChangedAsync(Department dept, Guid? managerId)
    {
        dept.ManagerId = managerId;
        await SaveDepartmentAsync(dept);
    }

    private async Task CreateDepartmentAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName))
        {
            Snackbar.Add("Name is required.", Severity.Warning);
            return;
        }
        await Employees.CreateDepartmentAsync(_newName, _newManagerId);
        Snackbar.Add("Department created.", Severity.Success);
        _newName = "";
        _newManagerId = null;
        await LoadAsync();
    }

    private async Task DeleteDepartmentAsync(Department dept)
    {
        await Employees.DeleteDepartmentAsync(dept.Id);
        Snackbar.Add("Department deleted.", Severity.Success);
        await LoadAsync();
    }

    private async Task OnUserDepartmentChangedAsync(User user, Guid? departmentId)
    {
        await Employees.AssignUserToDepartmentAsync(user.Id, departmentId);
        Snackbar.Add($"{user.Name} moved.", Severity.Success);
        await LoadAsync();
    }
}
