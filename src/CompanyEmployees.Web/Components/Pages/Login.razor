@page "/"
@layout AuthLayout
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using CompanyEmployees.Data
@using CompanyEmployees.Data.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>Sign in · Siemens Leave</PageTitle>

@* ponytail: verifies against Employee.PasswordHash directly (PasswordHasher<Employee>,
   same hasher Identity uses). No cookie/session yet — Sign in just navigates to /dashboard
   on success. Superseded once the bitmask->Identity migration lands (SignInManager). *@
<div class="lm login-page">
    <header class="login-brand" data-intro>
        <div class="brand-sq"><div></div></div>
        <span class="brand-word">SIEMENS</span>
    </header>

    <EditForm Model="_form" OnValidSubmit="HandleLogin" class="login-card">
        <DataAnnotationsValidator />
        <div class="microlabel" data-intro>Leave management</div>
        <h1 data-intro>Sign in to your workspace</h1>
        <p class="login-sub" data-intro>Use your Siemens single sign-on credentials.</p>

        @if (_error is not null)
        {
            <div class="login-error" data-intro>@_error</div>
        }

        <label class="lfield" data-intro>
            Work email
            <InputText type="email" @bind-Value="_form.Email" placeholder="yourname@siemens.com" autocomplete="username" />
        </label>
        <label class="lfield" data-intro>
            Password
            <InputText type="password" @bind-Value="_form.Password" autocomplete="current-password" />
        </label>

        <div class="login-row" data-intro>
            <label class="check"><input type="checkbox" checked /> Keep me signed in</label>
            <a href="/forgot-password">Forgot password?</a>
        </div>

        <button type="submit" class="btn-pri btn-block" data-intro disabled="@_checking">Sign in</button>

        <div class="login-foot" data-intro>Protected by Siemens SSO · Demo workspace</div>
    </EditForm>

    <footer class="login-legal" data-intro>
        <span>© 2026 Siemens AG</span><span>Privacy</span><span>Terms</span><span>Help</span>
    </footer>
</div>

@code {
    private readonly LoginForm _form = new();
    private string? _error;
    private bool _checking;

    private async Task HandleLogin()
    {
        _checking = true;
        _error = null;

        var employee = await Db.Employees
            .FirstOrDefaultAsync(e => e.Email == _form.Email && e.IsActive);

        var hasher = new PasswordHasher<Employee>();
        var verified = employee is not null &&
            hasher.VerifyHashedPassword(employee, employee.PasswordHash, _form.Password)
                is PasswordVerificationResult.Success or PasswordVerificationResult.SuccessRehashNeeded;

        if (!verified)
        {
            _error = "Invalid email or password.";
            _checking = false;
            return;
        }

        Nav.NavigateTo("/dashboard");
    }

    private class LoginForm
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";
    }
}
