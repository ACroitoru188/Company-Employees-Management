@page "/"
@layout AuthLayout

<PageTitle>Sign in · Siemens Leave</PageTitle>

@* ponytail: static mockup — the form does not authenticate yet, Sign in
   navigates straight to /dashboard so the flow is clickable. Wire real SSO later. *@
<div class="lm login-page">
    <header class="login-brand" data-intro>
        <div class="brand-sq"><div></div></div>
        <span class="brand-word">SIEMENS</span>
    </header>

    <form method="get" action="/dashboard" class="login-card">
        <div class="microlabel" data-intro>Leave management</div>
        <h1 data-intro>Sign in to your workspace</h1>
        <p class="login-sub" data-intro>Use your Siemens single sign-on credentials.</p>

        <label class="lfield" data-intro>
            Work email
            <input type="email" placeholder="yourname@siemens.com" autocomplete="username" />
        </label>
        <label class="lfield" data-intro>
            Password
            <input type="password" autocomplete="current-password" />
        </label>

        <div class="login-row" data-intro>
            <label class="check"><input type="checkbox" checked /> Keep me signed in</label>
            <a href="/forgot-password">Forgot password?</a>
        </div>

        <button type="submit" class="btn-pri btn-block" data-intro>Sign in</button>

        <div class="login-foot" data-intro>Protected by Siemens SSO · Demo workspace</div>
    </form>

    <footer class="login-legal" data-intro>
        <span>© 2026 Siemens AG</span><span>Privacy</span><span>Terms</span><span>Help</span>
    </footer>
</div>
