@page "/"
@layout AuthLayout
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>Sign in · Time Off Management</PageTitle>
<EmployeeProviders />

@* Mock sign-in for the Employee UI stage: no real authentication yet — any
   well-formed credentials navigate to the employee dashboard. The previous
   DB-backed check (PasswordHasher against Employee.PasswordHash) was removed
   with the MudBlazor redesign; bring it back via Identity/SignInManager when
   real auth lands. *@

<div class="login-wrap">
    <MudPaper Elevation="3" Class="pa-8 login-card">
        <div class="d-flex align-baseline gap-3 mb-6">
            <MudText Typo="Typo.h5" Style="font-weight:700; letter-spacing:.06em; color:var(--mud-palette-primary);">
                SIEMENS
            </MudText>
            <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">
                Time Off Management
            </MudText>
        </div>

        <MudText Typo="Typo.h6" Style="font-weight:600;">Sign in to your workspace</MudText>
        <MudText Typo="Typo.body2" Class="mb-6" Style="color:var(--mud-palette-text-secondary);">
            Use your Siemens credentials.
        </MudText>

        <MudForm @ref="_form">
            <MudTextField T="string" @bind-Value="_email" Label="Work email"
                          Variant="Variant.Outlined" InputType="InputType.Email"
                          Required="true" RequiredError="Email is required"
                          Validation="@(new Func<string, string?>(ValidateEmail))"
                          Placeholder="yourname@siemens.com" Class="mb-4" />
            <MudTextField T="string" @bind-Value="_password" Label="Password"
                          Variant="Variant.Outlined"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Required="true" RequiredError="Password is required"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                          AdornmentAriaLabel="Show password" />

            <div class="d-flex justify-space-between align-center gap-4 my-4 flex-wrap">
                <MudCheckBox T="bool" @bind-Value="_keepSignedIn" Label="Keep me signed in" Dense="true" />
                <MudLink Href="/forgot-password" Typo="Typo.body2" Class="ml-auto">Forgot password?</MudLink>
            </div>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       FullWidth="true" OnClick="SignIn">
                Sign in
            </MudButton>
        </MudForm>

        <MudText Typo="Typo.caption" Class="d-block mt-6"
                 Style="text-align:center; color:var(--mud-palette-text-secondary);">
            Demo workspace · no real authentication yet
        </MudText>
    </MudPaper>

    <MudText Typo="Typo.caption" Class="mt-4" Style="color:var(--mud-palette-text-secondary);">
        © 2026 Siemens AG · Privacy · Terms · Help
    </MudText>
</div>

@code {
    private MudForm _form = default!;
    private string _email = "";
    private string _password = "";
    private bool _showPassword;
    private bool _keepSignedIn = true;

    private static string? ValidateEmail(string value) =>
        string.IsNullOrWhiteSpace(value) || value.Contains('@') ? null : "Enter a valid email address";

    private async Task SignIn()
    {
        await _form.Validate();
        if (_form.IsValid)
            Nav.NavigateTo("/employee/dashboard");
    }
}
