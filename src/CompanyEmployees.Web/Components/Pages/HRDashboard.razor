@page "/hr/dashboard"
@layout CompanyEmployees.Web.Components.Layout.EmployeeLayout
<PageTitle>Dashboard HR</PageTitle>

<div class="hr-dashboard-container">
    
    <!-- Header -->
    <header class="hr-header">
        <div class="hr-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            <h2>Dashboard HR</h2>
        </div>
        <div class="hr-user">Bun venit, Maria</div>
    </header>

    <!-- Metrics Cards -->
    <div class="metrics-grid">
        <div class="metric-card">
            <div class="metric-label">Angajați activi</div>
            <div class="metric-value">248</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Angajați noi (30 zile)</div>
            <div class="metric-value">7</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Cereri concediu</div>
            <div class="metric-value">
                <span class="text-amber">5</span> 
                <span class="metric-sub">în așteptare</span>
            </div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Contracte expiră</div>
            <div class="metric-value text-red">3</div>
        </div>
    </div>

    <!-- Panels -->
    <div class="panels-grid">
        
        <!-- Cereri de aprobat -->
        <div class="hr-panel requests-panel">
            <div class="panel-header">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                Cereri de aprobat
            </div>
            <div class="requests-list">
                
                <div class="request-row">
                    <div class="req-info">
                        <div class="req-name">Andrei Pop</div>
                        <div class="req-desc">Concediu · 3 zile</div>
                    </div>
                    <div class="req-status status-pending">pending</div>
                </div>

                <div class="request-row">
                    <div class="req-info">
                        <div class="req-name">Ioana Radu</div>
                        <div class="req-desc">Medical · 1 zi</div>
                    </div>
                    <div class="req-status status-pending">pending</div>
                </div>

                <div class="request-row">
                    <div class="req-info">
                        <div class="req-name">Vlad Ionescu</div>
                        <div class="req-desc">Concediu · 5 zile</div>
                    </div>
                    <div class="req-status status-approved">aprobat manager</div>
                </div>

            </div>
        </div>

        <!-- Angajați pe departament -->
        <div class="hr-panel depts-panel">
            <div class="panel-header">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="18" y="3" width="4" height="18"></rect>
                    <rect x="10" y="8" width="4" height="13"></rect>
                    <rect x="2" y="13" width="4" height="8"></rect>
                </svg>
                Angajați pe departament
            </div>
            <div class="depts-list">
                
                <div class="dept-row">
                    <div class="dept-info">
                        <span>Engineering</span>
                        <span>96</span>
                    </div>
                    <div class="dept-bar-track">
                        <!-- max value is 96, so 96/96 = 100% -->
                        <div class="dept-bar-fill" style="width: 100%"></div>
                    </div>
                </div>

                <div class="dept-row">
                    <div class="dept-info">
                        <span>Sales</span>
                        <span>54</span>
                    </div>
                    <div class="dept-bar-track">
                        <!-- 54/96 = 56.25% -->
                        <div class="dept-bar-fill" style="width: 56.25%"></div>
                    </div>
                </div>

                <div class="dept-row">
                    <div class="dept-info">
                        <span>HR</span>
                        <span>12</span>
                    </div>
                    <div class="dept-bar-track">
                        <!-- 12/96 = 12.5% -->
                        <div class="dept-bar-fill" style="width: 12.5%"></div>
                    </div>
                </div>

                <div class="dept-row">
                    <div class="dept-info">
                        <span>Marketing</span>
                        <span>28</span>
                    </div>
                    <div class="dept-bar-track">
                        <!-- 28/96 = 29.16% -->
                        <div class="dept-bar-fill" style="width: 29.16%"></div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Alert Banner -->
    <div class="hr-alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
        <span>2 angajați nu au evaluare de performanță completată pentru trimestrul curent</span>
    </div>

</div>

@code {
    // Fără logică momentan
}
