@page "/hr/dashboard"
@layout CompanyEmployees.Web.Components.Layout.EmployeeLayout
@using System.Globalization
@using CompanyEmployees.Application
@using CompanyEmployees.Application.Contexts
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@inject EmployeeContext Employees
@inject NavigationManager Nav

<PageTitle>HR Dashboard · Time Off Management</PageTitle>

@if (_data is null)
{
	<p>Loading…</p>
}
else
{
	<div class="hr-dashboard-container">

		<!-- Header -->
		<header class="hr-header">
			<div class="hr-title">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="3" width="7" height="7"></rect>
					<rect x="14" y="3" width="7" height="7"></rect>
					<rect x="14" y="14" width="7" height="7"></rect>
					<rect x="3" y="14" width="7" height="7"></rect>
				</svg>
				<h2>HR Dashboard</h2>
			</div>
			<div class="hr-user">Welcome, @_name</div>
		</header>

		<!-- Metrics Cards -->
		<div class="metrics-grid">
			<div class="metric-card">
				<div class="metric-label">Active employees</div>
				<div class="metric-value">@_data.ActiveEmployees</div>
			</div>
			<div class="metric-card">
				<div class="metric-label">New employees (30 days)</div>
				<div class="metric-value">@_data.NewEmployees</div>
			</div>
			<div class="metric-card">
				<div class="metric-label">Leave requests</div>
				<div class="metric-value">
					<span class="text-amber">@_data.PendingRequests</span>
					<span class="metric-sub">pending</span>
				</div>
			</div>
			<div class="metric-card">
				<div class="metric-label">On leave today</div>
				<div class="metric-value">@_data.OnLeaveToday</div>
			</div>
		</div>

		<!-- Panels -->
		<div class="panels-grid">

			<!-- Requests awaiting approval -->
			<div class="hr-panel requests-panel">
				<div class="panel-header">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="10"></circle>
						<polyline points="12 6 12 12 16 14"></polyline>
					</svg>
					Requests to approve
				</div>
				<div class="px-4 py-2 border-bottom">
					<MudTextField @bind-value="SearchTerm"
								  PlaceHolder="Search by name..."
								  Adornment="Adornment.Start"
								  AdornmentIcon="@Icons.Material.Filled.Search"
								  IconSize="Size.Small"
								  Margin="Margin.Dense"
								  Variant="Variant.Outlined"
								  Immediate="true"></MudTextField>
				</div>
				<div class="requests-list">
					@if (!FilteredRequests.Any())
					{
						<div class="request-row">
							<div class="req-info">
								<div class="req-desc">No requests are waiting for approval.</div>
							</div>
						</div>
					}
					@{
						var requestList = FilteredRequests.ToList();
					}
					@for (int i = 0; i < requestList.Count; i++)
					{
						var request = requestList[i];
						var isLast = i == requestList.Count - 1;
						<div class="request-item" style="border-bottom: @(isLast ? "none" : "1px solid #eee");">
							<div class="request-row" style="cursor: pointer; border-bottom: none; padding-bottom: @(_selectedRequest == request ? "0.5rem" : "1rem");" @onclick="() => ToggleRequest(request)">
								<div class="req-info">
									<div class="req-name">@request.Name</div>
									<div class="req-desc">
										@request.Type &middot; @request.Days @(request.Days == 1 ? "day" : "days") &middot; @request.Department
									</div>
								</div>
								<div class="req-status status-pending">pending</div>
							</div>
							
							@if (_selectedRequest == request)
							{
								<div class="request-details-panel mt-2 mb-4 p-4 rounded" style="background-color: #ffffff; border: 1px solid #e0e0e0;">
									@{
										var nameParts = request.Name.Split(' ', 2);
										var firstName = nameParts.Length > 0 ? nameParts[0] : "";
										var lastName = nameParts.Length > 1 ? nameParts[1] : "";
										var role = request.Role == "LineManager" ? "Manager" : request.Role;
									}

									<div class="d-flex justify-space-between mb-4">
										<div>
											<MudText Typo="Typo.h6"><b>Name:</b> @firstName</MudText>
											<MudText Typo="Typo.h6" Class="mt-1"><b>Surname:</b> @lastName</MudText>
											<MudText Typo="Typo.h6" Class="mt-1"><b>Department:</b> @request.Department</MudText>
											<MudText Typo="Typo.h6" Class="mt-1"><b>Role:</b> @role</MudText>
										</div>
										<div class="d-flex align-center justify-center rounded border border-solid border-dark" style="width: 120px; height: 150px; background-color: var(--mud-palette-background-grey); border-width: 2px;">
											<MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size: 5rem; color: var(--mud-palette-text-secondary);" />
										</div>
									</div>

									<MudDivider Class="my-4 border-solid border-dark" Style="border-width: 2px;" />

									<MudText Typo="Typo.h6" Class="mb-3"><b>Leave type:</b> @request.Type</MudText>

									<MudText Typo="Typo.h6" Class="mb-3"><b>Reason:</b> @(string.IsNullOrWhiteSpace(request.Reason) || request.Reason.Equals(request.Type, StringComparison.OrdinalIgnoreCase) || request.Reason.Equals(request.Type + " leave", StringComparison.OrdinalIgnoreCase) ? "No reason specified" : request.Reason)</MudText>
									
									<MudText Typo="Typo.h6" Class="mb-3">
										<b>Period:</b> @request.StartDate.ToString("dd.MM.yyyy") - @request.EndDate.ToString("dd.MM.yyyy") (@request.Days @(request.Days == 1 ? "day" : "days"))
									</MudText>
									
									<MudText Typo="Typo.h6" Class="mb-3"><b>Submitted at:</b> @request.SubmittedAt.ToString("dd.MM.yyyy - HH:mm")</MudText>
									
									<div class="d-flex justify-end mt-4">
										<MudButton Variant="Variant.Filled" OnClick="() => ToggleRequest(request)" Class="mr-2">CLOSE</MudButton>
										<MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="RejectRequest" Class="mr-2">REJECT</MudButton>
										<MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="ApproveRequest">APPROVE</MudButton>
									</div>
								</div>
							}
						</div>
					}
				</div>
			</div>

			<!-- Employees per department -->
			<div class="hr-panel depts-panel">
				<div class="panel-header">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="18" y="3" width="4" height="18"></rect>
						<rect x="10" y="8" width="4" height="13"></rect>
						<rect x="2" y="13" width="4" height="8"></rect>
					</svg>
					Employees per department
				</div>
				<div class="depts-list">
					@foreach (var department in _data.Departments)
					{
						<div class="dept-row">
							<div class="dept-info">
								<span>@department.Name</span>
								<span>@department.Count</span>
							</div>
							<div class="dept-bar-track">
								<div class="dept-bar-fill" style="width: @BarWidth(department.Count)"></div>
							</div>
						</div>
					}
				</div>
			</div>
		</div>

		<!-- Alert Banner -->
		@if (_data.StaleRequests > 0)
		{
			<div class="hr-alert">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
					<line x1="12" y1="9" x2="12" y2="13"></line>
					<line x1="12" y1="17" x2="12.01" y2="17"></line>
				</svg>
				<span>
					@_data.StaleRequests @(_data.StaleRequests == 1 ? "request has" : "requests have")
					been waiting for approval for more than 7 days
				</span>
			</div>
		}

	</div>

}

@code {
	private HrPendingRequest? _selectedRequest;

	private void ToggleRequest(HrPendingRequest request)
	{
		if (_selectedRequest == request)
		{
			_selectedRequest = null;
		}
		else
		{
			_selectedRequest = request;
		}
	}

	private void ApproveRequest()
	{
		// Aici vei pune logica backend de aprobare pe viitor
		_selectedRequest = null;
	}

	private void RejectRequest()
	{
		// Aici vei pune logica backend de respingere pe viitor
		_selectedRequest = null;
	}

	[CascadingParameter]
	private Task<AuthenticationState>? AuthStateTask { get; set; }

	private string _name = "";
	private HrDashboardResult? _data;
	private string SearchTerm { get; set; } = "";

	private IEnumerable<HrPendingRequest> FilteredRequests => string.IsNullOrWhiteSpace(SearchTerm)
		? _data!.Pending
		: _data!.Pending.Where(r => r.Name.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));

	// Same gate as AdminDepartments: HR is a department, so this reads the
	// Department claim rather than the role one. Non-HR users get sent back.
	protected override async Task OnInitializedAsync()
	{
		if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
			return;

		var user = (await AuthStateTask!).User;
		if (user.FindFirst("Department")?.Value != "HR")
		{
			Nav.NavigateTo("/employee/dashboard");
			return;
		}

		_name = user.FindFirst("FullName")?.Value ?? "";
		_data = await Employees.GetHrDashboardAsync();
	}

	// Bars are relative to the largest department, so the biggest one fills the track.
	private string BarWidth(int count)
	{
		var largest = 0;
		foreach (var department in _data!.Departments)
		{
			if (department.Count > largest)
				largest = department.Count;
		}

		if (largest == 0)
			return "0%";

		var percent = count * 100.0 / largest;
		return percent.ToString("0.##", CultureInfo.InvariantCulture) + "%";
	}
}
