@page "/hr/dashboard"
@layout CompanyEmployees.Web.Components.Layout.EmployeeLayout
@using CompanyEmployees.Application
@using CompanyEmployees.Application.Contexts
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@inject EmployeeContext Employees
@inject NavigationManager Nav

<PageTitle>HR Dashboard · Time Off Management</PageTitle>

@if (_data is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h5" Style="font-weight:600;">HR Dashboard</MudText>
    <MudText Typo="Typo.body2" Class="mb-4" Style="color:var(--mud-palette-text-secondary);">
        Welcome, @_name
    </MudText>

    <MudGrid Spacing="3" Class="mb-6">
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Style="color:var(--mud-palette-text-secondary); letter-spacing:.08em;">
                        ACTIVE EMPLOYEES
                    </MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:700;">@_data.ActiveEmployees</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Style="color:var(--mud-palette-text-secondary); letter-spacing:.08em;">
                        NEW (30 DAYS)
                    </MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:700;">@_data.NewEmployees</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Style="color:var(--mud-palette-text-secondary); letter-spacing:.08em;">
                        PENDING
                    </MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:700;">@_data.PendingRequests</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Style="color:var(--mud-palette-text-secondary); letter-spacing:.08em;">
                        ON LEAVE TODAY
                    </MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:700;">@_data.OnLeaveToday</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h6" Style="font-weight:600;" Class="mb-3">Requests to approve</MudText>

    @* HR sees the whole company's pending queue read-only — approving is the
       manager's job, on /manager/team. *@
    @if (_data.Pending.Count == 0)
    {
        <MudPaper Class="pa-4 mb-6" Elevation="0" Outlined="true">
            <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">
                No requests are waiting for approval.
            </MudText>
        </MudPaper>
    }
    else
    {
        <MudTable T="HrPendingRequest" Items="@_data.Pending" Hover="true" Elevation="1" Class="mb-6">
            <HeaderContent>
                <MudTh>Employee</MudTh>
                <MudTh>Department</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Days</MudTh>
                <MudTh>Waiting</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Employee">@context.Name</MudTd>
                <MudTd DataLabel="Department">@context.Department</MudTd>
                <MudTd DataLabel="Type">@context.Type</MudTd>
                <MudTd DataLabel="Days">@context.Days @(context.Days == 1 ? "day" : "days")</MudTd>
                <MudTd DataLabel="Waiting">
                    @context.WaitingDays @(context.WaitingDays == 1 ? "day" : "days")
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudText Typo="Typo.h6" Style="font-weight:600;" Class="mb-3">Employees per department</MudText>

    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        @foreach (var department in _data.Departments)
        {
            <div class="mb-3">
                <div class="d-flex justify-space-between">
                    <MudText Typo="Typo.body2">@department.Name</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">@department.Count</MudText>
                </div>
                <MudProgressLinear Color="Color.Primary" Value="@BarWidth(department.Count)" Class="mt-1" />
            </div>
        }
    </MudPaper>

    @if (_data.StaleRequests > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-6">
            @_data.StaleRequests @(_data.StaleRequests == 1 ? "request has" : "requests have")
            been waiting for approval for more than 7 days
        </MudAlert>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string _name = "";
    private HrDashboardResult? _data;

    // Same gate as AdminDepartments: HR is a department, so this reads the
    // Department claim rather than the role one. Non-HR users get sent back.
    protected override async Task OnInitializedAsync()
    {
        if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
            return;

        var user = (await AuthStateTask!).User;
        if (user.FindFirst("Department")?.Value != "HR")
        {
            Nav.NavigateTo("/employee/dashboard");
            return;
        }

        _name = user.FindFirst("FullName")?.Value ?? "";
        _data = await Employees.GetHrDashboardAsync();
    }

    // Bars are relative to the largest department, so the biggest one fills the track.
    private double BarWidth(int count)
    {
        var largest = 0;
        foreach (var department in _data!.Departments)
        {
            if (department.Count > largest)
                largest = department.Count;
        }

        if (largest == 0)
            return 0;

        return count * 100.0 / largest;
    }
}
