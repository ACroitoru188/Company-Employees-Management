@page "/hr/dashboard"
@layout CompanyEmployees.Web.Components.Layout.EmployeeLayout
@using System.Globalization
@using CompanyEmployees.Application
@using CompanyEmployees.Application.Contexts
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@inject EmployeeContext Employees
@inject NavigationManager Nav
@inject IDialogService DialogService

<PageTitle>HR Dashboard · Time Off Management</PageTitle>

@if (_data is null)
{
	<p>Loading…</p>
}
else
{
	<div class="hr-dashboard-container">

		<!-- Header -->
		<header class="hr-header">
			<div class="hr-title">
				<MudText Typo="Typo.h5" Style="font-weight:600;">HR Dashboard</MudText>
			</div>
			<div class="hr-user">Welcome, @_name</div>
		</header>

		<!-- Metrics Cards -->
		<MudGrid Spacing="3" Class="mb-6">
			<MudItem xs="12" sm="6" md="3">
				<MudCard Elevation="1">
					<MudCardContent>
						<MudText Typo="Typo.overline" Style="color:var(--mud-palette-text-secondary); letter-spacing:.08em;">
							Active employees
						</MudText>
						<MudText Typo="Typo.h4" Style="font-weight:700;">@_data.ActiveEmployees</MudText>
					</MudCardContent>
				</MudCard>
			</MudItem>
			<MudItem xs="12" sm="6" md="3">
				<MudCard Elevation="1">
					<MudCardContent>
						<MudText Typo="Typo.overline" Style="color:var(--mud-palette-text-secondary); letter-spacing:.08em;">
							New employees (30 days)
						</MudText>
						<MudText Typo="Typo.h4" Style="font-weight:700;">@_data.NewEmployees</MudText>
					</MudCardContent>
				</MudCard>
			</MudItem>
			<MudItem xs="12" sm="6" md="3">
				<MudCard Elevation="1">
					<MudCardContent>
						<MudText Typo="Typo.overline" Style="color:var(--mud-palette-text-secondary); letter-spacing:.08em;">
							Leave requests
						</MudText>
						<div class="d-flex align-baseline gap-1">
							<MudText Typo="Typo.h4" Style="font-weight:700;" Color="Color.Warning">@_data.PendingRequests</MudText>
							<MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">pending</MudText>
						</div>
					</MudCardContent>
				</MudCard>
			</MudItem>
			<MudItem xs="12" sm="6" md="3">
				<MudCard Elevation="1">
					<MudCardContent>
						<MudText Typo="Typo.overline" Style="color:var(--mud-palette-text-secondary); letter-spacing:.08em;">
							On leave today
						</MudText>
						<MudText Typo="Typo.h4" Style="font-weight:700;">@_data.OnLeaveToday</MudText>
					</MudCardContent>
				</MudCard>
			</MudItem>
		</MudGrid>

		<!-- Panels -->
		<div class="panels-grid">

			<!-- Requests awaiting approval -->
			<div class="hr-panel requests-panel">
				<div class="panel-header">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="10"></circle>
						<polyline points="12 6 12 12 16 14"></polyline>
					</svg>
					Requests to approve
				</div>
				<div class="px-4 py-2 border-bottom">
					<MudTextField @bind-value="SearchTerm"
								  PlaceHolder="Search by name..."
								  Adornment="Adornment.Start"
								  AdornmentIcon="@Icons.Material.Filled.Search"
								  IconSize="Size.Small"
								  Margin="Margin.Dense"
								  Variant="Variant.Outlined"
								  Immediate="true"></MudTextField>
				</div>
				<div class="requests-list">
					@if (!FilteredRequests.Any())
					{
						<div class="request-row">
							<div class="req-info">
								<div class="req-desc">No requests are waiting for approval.</div>
							</div>
						</div>
					}
					@{
						var requestList = FilteredRequests.ToList();
					}
					@for (int i = 0; i < requestList.Count; i++)
					{
						var request = requestList[i];
						var isLast = i == requestList.Count - 1;
						<div class="request-item" style="border-bottom: @(isLast ? "none" : "1px solid #eee");">
							<div class="request-row" style="cursor: pointer; border-bottom: none; padding-bottom: @(_selectedRequest == request ? "0.5rem" : "1rem");" @onclick="() => ToggleRequest(request)">
								<div class="req-info">
									<div class="req-name">@request.Name</div>
									<div class="req-desc">
										@request.Type &middot; @request.Days @(request.Days == 1 ? "day" : "days") &middot; @request.Department
										&middot; @request.StartDate.ToString("MMM d", CultureInfo.InvariantCulture)–@request.EndDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
									</div>
								</div>
								<div class="req-status status-pending">pending</div>
							</div>
							
							@if (_selectedRequest == request)
							{
								<div class="request-details-panel mt-2 mb-4 p-4 rounded" style="background-color: #ffffff; border: 1px solid #e0e0e0;">
									@{
										var nameParts = request.Name.Split(' ', 2);
										var firstName = nameParts.Length > 0 ? nameParts[0] : "";
										var lastName = nameParts.Length > 1 ? nameParts[1] : "";
										var role = request.Role == "LineManager" ? "Manager" : request.Role;
									}

									<div class="d-flex justify-space-between mb-4">
										<div>
											<MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">Name</MudText>
											<MudText Typo="Typo.body1" Style="font-weight:500;" Class="mb-2">@firstName</MudText>
											<MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">Surname</MudText>
											<MudText Typo="Typo.body1" Style="font-weight:500;" Class="mb-2">@lastName</MudText>
											<MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">Department</MudText>
											<MudText Typo="Typo.body1" Style="font-weight:500;" Class="mb-2">@request.Department</MudText>
											<MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">Role</MudText>
											<MudText Typo="Typo.body1" Style="font-weight:500;">@role</MudText>
										</div>
										<div class="d-flex align-center justify-center rounded border border-solid border-dark" style="width: 120px; height: 150px; background-color: var(--mud-palette-background-grey); border-width: 2px;">
											<MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size: 5rem; color: var(--mud-palette-text-secondary);" />
										</div>
									</div>

									<MudDivider Class="my-4" />

									<MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">Leave type</MudText>
									<MudText Typo="Typo.body1" Style="font-weight:500;" Class="mb-3">@request.Type</MudText>

									<MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">Reason</MudText>
									<MudText Typo="Typo.body1" Class="mb-3">@(string.IsNullOrWhiteSpace(request.Reason) || request.Reason.Equals(request.Type, StringComparison.OrdinalIgnoreCase) || request.Reason.Equals(request.Type + " leave", StringComparison.OrdinalIgnoreCase) ? "No reason specified" : request.Reason)</MudText>

									<MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">Period</MudText>
									<MudText Typo="Typo.body1" Style="font-weight:500;" Class="mb-3">
										@request.StartDate.ToString("dd.MM.yyyy") - @request.EndDate.ToString("dd.MM.yyyy") (@request.Days @(request.Days == 1 ? "day" : "days"))
									</MudText>

									<MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">Submitted @request.SubmittedAt.ToString("dd.MM.yyyy - HH:mm")</MudText>
									
									<div class="d-flex justify-end mt-4">
										<MudButton Variant="Variant.Filled" OnClick="() => ToggleRequest(request)" Class="mr-2">CLOSE</MudButton>
										<MudButton Variant="Variant.Filled" OnClick="() => EditDates(request)" Class="mr-2">EDIT DATES</MudButton>
										<MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="RejectRequest" Class="mr-2">REJECT</MudButton>
										<MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="ApproveRequest">APPROVE</MudButton>
									</div>
								</div>
							}
						</div>
					}
				</div>
			</div>

			<!-- Employees per department -->
			<div class="hr-panel depts-panel">
				<div class="panel-header">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="18" y="3" width="4" height="18"></rect>
						<rect x="10" y="8" width="4" height="13"></rect>
						<rect x="2" y="13" width="4" height="8"></rect>
					</svg>
					Employees per department
				</div>
				<div class="depts-list">
					@foreach (var department in _data.Departments)
					{
						<div class="dept-row">
							<div class="dept-info">
								<span>@department.Name</span>
								<span>@department.Count</span>
							</div>
							<div class="dept-bar-track">
								<div class="dept-bar-fill" style="width: @BarWidth(department.Count)"></div>
							</div>
						</div>
					}
				</div>
			</div>
		</div>

		<!-- Alert Banner -->
		@if (_data.StaleRequests > 0)
		{
			<div class="hr-alert">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
					<line x1="12" y1="9" x2="12" y2="13"></line>
					<line x1="12" y1="17" x2="12.01" y2="17"></line>
				</svg>
				<span>
					@_data.StaleRequests @(_data.StaleRequests == 1 ? "request has" : "requests have")
					been waiting for approval for more than 7 days
				</span>
			</div>
		}

	</div>

}

@code {
	private HrPendingRequest? _selectedRequest;

	private void ToggleRequest(HrPendingRequest request)
	{
		if (_selectedRequest == request)
		{
			_selectedRequest = null;
		}
		else
		{
			_selectedRequest = request;
		}
	}

	private void ApproveRequest()
	{
		// Aici vei pune logica backend de aprobare pe viitor
		_selectedRequest = null;
	}

	private void RejectRequest()
	{
		// Aici vei pune logica backend de respingere pe viitor
		_selectedRequest = null;
	}

	[CascadingParameter]
	private Task<AuthenticationState>? AuthStateTask { get; set; }

	private string _name = "";
	private HrDashboardResult? _data;
	private string SearchTerm { get; set; } = "";

	private async Task EditDates(HrPendingRequest request)
	{
		var parameters = new DialogParameters<EditLeaveDatesDialog>
		{
			{ d => d.Request, request }
		};
		var dialog = await DialogService.ShowAsync<EditLeaveDatesDialog>("Edit leave period", parameters);
		var result = await dialog.Result;
		if (result is { Canceled: false })
			_data = await Employees.GetHrDashboardAsync();
	}

	private IEnumerable<HrPendingRequest> FilteredRequests => string.IsNullOrWhiteSpace(SearchTerm)
		? _data!.Pending
		: _data!.Pending.Where(r => r.Name.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));

	// Same gate as AdminDepartments: HR is a department, so this reads the
	// Department claim rather than the role one. Non-HR users get sent back.
	protected override async Task OnInitializedAsync()
	{
		if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
			return;

		var user = (await AuthStateTask!).User;
		if (user.FindFirst("Department")?.Value != "HR")
		{
			Nav.NavigateTo("/employee/dashboard");
			return;
		}

		_name = user.FindFirst("FullName")?.Value ?? "";
		_data = await Employees.GetHrDashboardAsync();
	}

	// Bars are relative to the largest department, so the biggest one fills the track.
	private string BarWidth(int count)
	{
		var largest = 0;
		foreach (var department in _data!.Departments)
		{
			if (department.Count > largest)
				largest = department.Count;
		}

		if (largest == 0)
			return "0%";

		var percent = count * 100.0 / largest;
		return percent.ToString("0.##", CultureInfo.InvariantCulture) + "%";
	}
}
