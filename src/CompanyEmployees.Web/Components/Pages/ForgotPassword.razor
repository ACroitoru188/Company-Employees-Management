@page "/forgot-password"
@layout AuthLayout

<PageTitle>Reset password · Siemens Leave</PageTitle>

@* ponytail: static mockup — no email is actually sent yet. Wire to real SSO/reset later. *@
<div class="lm login-page">
    <header class="login-brand" data-intro>
        <div class="brand-sq"><div></div></div>
        <span class="brand-word">SIEMENS</span>
    </header>

    <form method="get" action="/" class="login-card">
        <div class="microlabel" data-intro>Account recovery</div>
        <h1 data-intro>Reset your password</h1>
        <p class="login-sub" data-intro>Enter your work email and we'll send you a link to reset your password.</p>

        <label class="lfield" data-intro>
            Work email
            <input type="email" placeholder="yourname@siemens.com" autocomplete="username" />
        </label>

        <button type="submit" class="btn-pri btn-block" data-intro>Send reset link</button>

        <div class="login-foot" data-intro><a href="/">← Back to sign in</a></div>
    </form>

    <footer class="login-legal" data-intro>
        <span>© 2026 Siemens AG</span><span>Privacy</span><span>Terms</span><span>Help</span>
    </footer>
</div>
