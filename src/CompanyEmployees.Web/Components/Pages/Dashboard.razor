@page "/dashboard"
@layout AuthLayout
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization

<PageTitle>Dashboard · Siemens Leave</PageTitle>

@* ponytail: whole app screen, composed from Components/*. Sidebar (left, fixed) +
   right column split into a thin TopBar row and one bordered content panel that
   hosts whichever view is active. All state is local and the data is hardcoded —
   swap for real services later. *@
<div class="shell">
    <Sidebar ActiveView="@_view" IsManager="@IsManager" PendingCount="@PendingCount"
             RequestsNavLabel="@RequestsNavLabel"
             OnGoDashboard="GoDashboard" OnGoRequests="GoRequests" OnGoCalendar="GoCalendar" />

    <div class="main">
        <TopBar IsManager="@IsManager" RoleLabel="@RoleLabel"
                OnSetEmployee="SetEmployee" OnSetManager="SetManager" OnOpenRequest="OpenRequest"
                OnChangeProfilePicture="ChangeProfilePicture" OnContactAdministration="ContactAdministration" />

        <main class="content-panel">
            <div class="chrome-strip">
                <span class="chrome-dot"></span>
                <span class="chrome-dot"></span>
                <span class="chrome-title">@ViewTitle</span>
            </div>
            <div class="content-body">
                @if (_view == "requests")
                {
                    <MyRequestsView Requests="@MyRequestEntries" OnNewRequest="OpenRequest" OnCancel="Cancel" />
                }
                else if (_view == "calendar")
                {
                    <TeamCalendarView TodayLabel="@TodayLabel" MonthLabel="@CpMonthLabel" Weekdays="@_calWeekdays"
                                       Cells="@CpViewCells()" OnPrev="CpPrev" OnNext="CpNext" OnToday="CpToday" />
                }
                else if (!IsManager)
                {
                    <div class="greet">
                        <div>
                            <h1>Good morn</h1>
                            <p>Here's what's happening with your time off.</p>
                        </div>
                        <div class="greet-date">@TodayLabel</div>
                    </div>
                    <EmployeeOverview Balances="@BalanceEntries" Week="@WeekEntries" WhoOut="@WhoOutEntries"
                                       Activity="@ActivityEntries" MyRequests="@MyRequestEntries" Months="@MonthEntries" />
                }
                else
                {
                    <div class="greet">
                        <div>
                            <h1>Good morn</h1>
                            <p>You have <b>@PendingCount requests</b> waiting for your review.</p>
                        </div>
                        <div class="greet-date">@TodayLabel</div>
                    </div>
                    <ManagerOverview Stats="@MgrStatEntries" PendingCount="@PendingCount" Approvals="@ApprovalEntries"
                                      WhoOut="@WhoOutEntries" Distribution="@DistEntries"
                                      OnApprove="Approve" OnReject="Reject" />
                }
            </div>
        </main>
    </div>
</div>

@if (_requestOpen)
{
    <RequestSheet LeaveTypes="@_leaveTypes" SelectedType="@_newType" SelectionLabel="@SelectionLabel"
                  MonthLabel="@CalMonthLabel" Weekdays="@_calWeekdays" Cells="@RequestCalCells()" Reason="@_newReason"
                  OnClose="CloseRequest" OnSubmit="Submit" OnTypeChanged="TypeChanged" OnDayClicked="ClickDay"
                  OnPrevMonth="PrevMonth" OnNextMonth="NextMonth" OnReasonChanged="ReasonChanged" />
}

<Toast Show="_toastShow" Message="@_toast" />

@code {
    // ---- state ----
    private string _role = "employee";
    private string _view = "dashboard";  // dashboard | requests | calendar (in-shell views, state survives switching)
    private int _cpYear = Today.Year;
    private int _cpMonth = Today.Month - 1;   // 0-based — calendar page month
    private bool _requestOpen;
    private bool _requestClosing;
    private string _toast = "";
    private bool _toastShow;
    private string _newType = "Annual leave";
    private string _newReason = "";
    private int _viewYear = Today.Year;
    private int _viewMonth = Today.Month - 1;   // 0-based
    private DateTime? _selStart;
    private DateTime? _selEnd;
    private CancellationTokenSource? _toastCts;

    private static readonly DateTime Today = DateTime.Today;
    private static string TodayLabel => Today.ToString("dddd, d MMMM yyyy", CultureInfo.InvariantCulture);
    private static readonly string[] _leaveTypes = { "Annual leave", "Sick leave", "Parental", "Unpaid leave" };
    private static readonly string[] _calWeekdays = { "MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN" };

    private bool IsManager => _role == "manager";
    private int PendingCount => _approvals.Count(a => a.Status == "pending");
    private string RoleLabel => IsManager ? "Line manager" : "Employee";
    private string RequestsNavLabel => IsManager ? "Approvals" : "My requests";
    private string ViewTitle => _view switch
    {
        "requests" => "My requests",
        "calendar" => "Calendar",
        _          => "Dashboard",
    };

    // ---- actions ----
    private void SetEmployee() => _role = "employee";
    private void SetManager() { _role = "manager"; if (_view == "requests") _view = "dashboard"; }  // managers have no "my requests" view
    private void OpenRequest() => _requestOpen = true;

    // ponytail: no backend — these acknowledge with a toast until real endpoints exist. Sign out is a plain link to /.
    private void ChangeProfilePicture() => ShowToast("Profile picture upload coming soon");
    private void ContactAdministration() => ShowToast("A message has been sent to administration");

    // ---- in-shell navigation ----
    private void GoDashboard() => _view = "dashboard";
    private void GoRequests() { if (!IsManager) _view = "requests"; }   // ponytail: manager "Approvals" link stays inert — approvals live on the dashboard
    private void GoCalendar() => _view = "calendar";

    private void Cancel(MyRequestsView.RequestEntry entry)
    {
        var r = _myRequests.FirstOrDefault(x => x.Type == entry.Type && x.Range == entry.Range && x.Days == entry.Days && x.Status == entry.Status);
        if (r is null) return;
        _myRequests.Remove(r);
        ShowToast("Request cancelled");
    }

    private async Task CloseRequest()
    {
        if (_requestClosing) return;
        _requestClosing = true;
        _requestOpen = false;
        _requestClosing = false;
        await Task.CompletedTask;
    }
    private void PrevMonth() { if (--_viewMonth < 0) { _viewMonth = 11; _viewYear--; } }
    private void NextMonth() { if (++_viewMonth > 11) { _viewMonth = 0; _viewYear++; } }
    private void TypeChanged(string label) => _newType = label;
    private void ReasonChanged(string reason) => _newReason = reason;

    private void ClickDay(DateTime? ts)
    {
        if (ts is not DateTime d) return;
        if (_selStart is null || _selEnd is not null) { _selStart = d; _selEnd = null; }
        else if (d < _selStart) { _selStart = d; _selEnd = null; }
        else { _selEnd = d; }
    }

    private async Task Submit()
    {
        string range; int days; DateTime start, end;
        if (_selStart is DateTime s && _selEnd is DateTime e) { range = $"{Fmt(s)} – {Fmt(e)}"; days = (e - s).Days + 1; start = s; end = e; }
        else if (_selStart is DateTime s2) { range = Fmt(s2); days = 1; start = end = s2; }
        else { range = Fmt(Today); days = 1; start = end = Today; }

        _myRequests.Insert(0, new Request(_newType, range, days, "Pending", start, end));
        _selStart = _selEnd = null;
        _newReason = "";
        ShowToast("Request submitted — pending approval");
        await CloseRequest();
    }

    private void Approve(int id)
    {
        var a = _approvals.First(x => x.Id == id);
        a.Status = "approved";
        ShowToast("Request approved");
    }

    private void Reject(int id)
    {
        var a = _approvals.First(x => x.Id == id);
        a.Status = "rejected";
        ShowToast("Request declined");
    }

    private void ShowToast(string msg)
    {
        _toast = msg;
        _toastShow = true;
        _toastCts?.Cancel();
        var cts = _toastCts = new CancellationTokenSource();
        _ = HideToastLater(cts.Token);
    }

    private async Task HideToastLater(CancellationToken ct)
    {
        try
        {
            await Task.Delay(2800, ct);
            _toastShow = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose() => _toastCts?.Cancel();

    private static string Fmt(DateTime d) => d.ToString("MMM d", CultureInfo.InvariantCulture);

    // leave-type tone key → .tone-* / .dot-* / .fill-* classes
    private static string TypeTone(string t) => t switch
    {
        "Sick leave"   => "amber",
        "Parental"     => "purple",
        "Unpaid leave" => "gray",
        _              => "accent",   // Annual leave
    };

    // ---- calendar page (month grid of team leave + own requests) ----
    private string CpMonthLabel => new DateTime(_cpYear, _cpMonth + 1, 1).ToString("MMMM yyyy", CultureInfo.InvariantCulture);
    private void CpPrev() { if (--_cpMonth < 0) { _cpMonth = 11; _cpYear--; } }
    private void CpNext() { if (++_cpMonth > 11) { _cpMonth = 0; _cpYear++; } }
    private void CpToday() { _cpYear = Today.Year; _cpMonth = Today.Month - 1; }

    private List<TeamCalendarView.CpCell> CpViewCells()
    {
        var first = new DateTime(_cpYear, _cpMonth + 1, 1);
        int lead = ((int)first.DayOfWeek + 6) % 7;                              // Monday-first
        var start = first.AddDays(-lead);
        int total = (lead + DateTime.DaysInMonth(_cpYear, _cpMonth + 1) + 6) / 7 * 7;   // whole weeks

        var cells = new List<TeamCalendarView.CpCell>();
        for (int i = 0; i < total; i++)
        {
            var d = start.AddDays(i);
            var evts = new List<TeamCalendarView.CpEvt>();
            foreach (var e in _events)
                if (d >= e.Start && d <= e.End)
                    evts.Add(new(e.Person.Split(' ')[0], TypeTone(e.Type), false, $"{e.Person} · {e.Type}"));
            foreach (var r in _myRequests)
                if (r.Start is DateTime rs && r.End is DateTime re && d >= rs && d <= re)
                    evts.Add(new("You", TypeTone(r.Type), r.Status == "Pending", $"You · {r.Type} ({r.Status})"));
            cells.Add(new(d, d.Month != _cpMonth + 1, d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday, d == Today, evts));
        }
        return cells;
    }

    // ---- request-sheet calendar / selection derived values ----
    private string CalMonthLabel => new DateTime(_viewYear, _viewMonth + 1, 1).ToString("MMMM yyyy", CultureInfo.InvariantCulture);

    private string SelectionLabel
    {
        get
        {
            if (_selStart is DateTime s && _selEnd is DateTime e) return $"{Fmt(s)} – {Fmt(e)} · {(e - s).Days + 1} days";
            if (_selStart is DateTime s2) return $"{Fmt(s2)} – …";
            return "";
        }
    }

    private List<RequestSheet.CalCell> RequestCalCells()
    {
        var cells = new List<RequestSheet.CalCell>();
        int firstW = ((int)new DateTime(_viewYear, _viewMonth + 1, 1).DayOfWeek + 6) % 7;   // Monday-first
        int dim = DateTime.DaysInMonth(_viewYear, _viewMonth + 1);
        for (int i = 0; i < firstW; i++)
            cells.Add(new RequestSheet.CalCell(null, "", "empty"));

        for (int day = 1; day <= dim; day++)
        {
            var ts = new DateTime(_viewYear, _viewMonth + 1, day);
            bool isStart = _selStart == ts, isEnd = _selEnd == ts;
            bool inRange = _selStart is not null && _selEnd is not null && ts > _selStart && ts < _selEnd;

            string css;
            if (isStart && isEnd) css = "ep";                       // single-day range
            else if (isStart && _selEnd is not null) css = "ep ep-l";
            else if (isEnd) css = "ep ep-r";
            else if (isStart) css = "ep";
            else if (inRange) css = "range";
            else if (ts == Today) css = "today";
            else css = "";

            cells.Add(new RequestSheet.CalCell(ts, day.ToString(), css));
        }
        return cells;
    }

    // ---- view-model mapping (records live in components; Dashboard owns the data) ----
    private IReadOnlyList<EmployeeOverview.Balance> BalanceEntries =>
        _balances.Select(b => new EmployeeOverview.Balance(b.Label, b.Tone, b.Value, b.Note, b.Pct)).ToList();
    private IReadOnlyList<EmployeeOverview.WeekDay> WeekEntries =>
        _week.Select(d => new EmployeeOverview.WeekDay(d.Wd, d.N, d.HasOut, d.DotTone, d.IsToday, d.Wknd)).ToList();
    private IReadOnlyList<EmployeeOverview.PersonEntry> WhoOutEntries =>
        _whoOut.Select(p => new EmployeeOverview.PersonEntry(p.Name, p.Initials, p.Type, p.Range, p.Tone)).ToList();
    private IReadOnlyList<EmployeeOverview.ActivityItem> ActivityEntries =>
        _activity.Select(a => new EmployeeOverview.ActivityItem(a.Text, a.Time, a.Tone)).ToList();
    private IReadOnlyList<EmployeeOverview.MonthBar> MonthEntries =>
        _months.Select(m => new EmployeeOverview.MonthBar(m.Label, m.H, m.Current)).ToList();
    private IReadOnlyList<MyRequestsView.RequestEntry> MyRequestEntries =>
        _myRequests.Select(r => new MyRequestsView.RequestEntry(r.Type, r.Range, r.Days, r.Status)).ToList();
    private IReadOnlyList<ManagerOverview.MgrStat> MgrStatEntries =>
        MgrStats.Select(s => new ManagerOverview.MgrStat(s.Label, s.Value, s.Note, s.Css)).ToList();
    private IReadOnlyList<ManagerOverview.ApprovalEntry> ApprovalEntries =>
        _approvals.Select(a => new ManagerOverview.ApprovalEntry(a.Id, a.Name, a.Initials, a.Dept, a.Type, a.Range, a.Days, a.Reason, a.Status)).ToList();
    private IReadOnlyList<ManagerOverview.Dist> DistEntries =>
        _distribution.Select(d => new ManagerOverview.Dist(d.Label, d.Pct, d.Tone)).ToList();

    // ---- types (source data — mapped to component records above) ----
    private record Balance(string Label, string Tone, string Value, string Note, string Pct);
    private record WeekDay(string Wd, int N, bool HasOut, string DotTone, bool IsToday, bool Wknd);
    private record Person(string Name, string Initials, string Type, string Range, string Tone);
    private record ActivityItem(string Text, string Time, string Tone);
    private record Request(string Type, string Range, int Days, string Status, DateTime? Start = null, DateTime? End = null);
    private record MonthBar(string Label, string H, bool Current);
    private record MgrStat(string Label, string Value, string Note, string Css);
    private record Dist(string Label, string Pct, string Tone);
    private record LeaveEvent(string Person, string Type, DateTime Start, DateTime End);

    private class Approval
    {
        public int Id;
        public string Name = "", Initials = "", Dept = "", Type = "", Range = "", Reason = "";
        public int Days;
        public string Status = "pending";
    }

    // ponytail: no backend yet — collections start empty, so every list renders its
    // empty state. Real services will populate these later.
    private readonly Balance[] _balances = Array.Empty<Balance>();
    private readonly WeekDay[] _week = Array.Empty<WeekDay>();
    private readonly Person[] _whoOut = Array.Empty<Person>();
    private readonly ActivityItem[] _activity = Array.Empty<ActivityItem>();
    private readonly List<Request> _myRequests = new();
    private readonly LeaveEvent[] _events = Array.Empty<LeaveEvent>();
    private readonly MonthBar[] _months = Array.Empty<MonthBar>();
    private readonly Dist[] _distribution = Array.Empty<Dist>();
    private readonly List<Approval> _approvals = new();

    private MgrStat[] MgrStats =>
    [
        new("On leave today",      "0",                     "of 0 team members",  ""),
        new("Pending approvals",   PendingCount.ToString(), "awaiting your review", "accent"),
        new("Approved this month", "0",                     "requests",           "green"),
        new("Avg. approval time",  "—",                     "across the team",    ""),
    ];
}
