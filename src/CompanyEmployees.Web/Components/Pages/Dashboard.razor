@page "/dashboard"

<PageTitle>Dashboard · CompanyEmployees</PageTitle>

<section class="stats">
    <div class="stat" data-cursor>
        <div class="stat-top">
            <span class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="8" r="3.2" /><path d="M3.5 20a5.5 5.5 0 0 1 11 0" /><path d="M16 5.2a3 3 0 0 1 0 5.6M17.5 20a5.5 5.5 0 0 0-3-4.9" />
                </svg>
            </span>
            <svg class="spark" viewBox="0 0 74 30" preserveAspectRatio="none"><path d="M0 24 12 22 24 23 37 16 49 17 61 9 74 6" /></svg>
        </div>
        <div class="stat-label">Total employees</div>
        <div class="stat-value">247</div>
        <div class="stat-note"><span class="delta up">+8</span> vs last month</div>
    </div>

    <div class="stat" data-cursor>
        <div class="stat-top">
            <span class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 20V7l6-3 6 3v13" /><path d="M16 11h4v9M4 20h16" />
                </svg>
            </span>
            <svg class="spark" viewBox="0 0 74 30" preserveAspectRatio="none"><path d="M0 20 12 20 24 15 37 15 49 11 61 12 74 8" /></svg>
        </div>
        <div class="stat-label">Departments</div>
        <div class="stat-value">9</div>
        <div class="stat-note">Across 3 office locations</div>
    </div>

    <div class="stat" data-cursor>
        <div class="stat-top">
            <span class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="8" r="3.2" /><path d="M3.5 20a5.5 5.5 0 0 1 11 0" /><path d="M19 8v6M22 11h-6" />
                </svg>
            </span>
            <svg class="spark" viewBox="0 0 74 30" preserveAspectRatio="none"><path d="M0 22 12 18 24 20 37 12 49 14 61 7 74 10" /></svg>
        </div>
        <div class="stat-label">New hires (30d)</div>
        <div class="stat-value">12</div>
        <div class="stat-note"><span class="delta up">+3</span> vs previous 30 days</div>
    </div>

    <div class="stat" data-cursor>
        <div class="stat-top">
            <span class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="17" rx="2" /><path d="M3 9h18M8 2v4M16 2v4" />
                </svg>
            </span>
            <svg class="spark" viewBox="0 0 74 30" preserveAspectRatio="none"><path d="M0 12 12 15 24 11 37 18 49 14 61 20 74 18" /></svg>
        </div>
        <div class="stat-label">On leave today</div>
        <div class="stat-value">5</div>
        <div class="stat-note">2 returning this week</div>
    </div>
</section>

<div class="grid-2">
    <div class="panel" data-cursor>
        <div class="panel-head">
            <span class="panel-title">Recent employees</span>
            <a class="panel-link" href="#">View all</a>
        </div>
        <div class="table-wrap">
            <table class="emp">
                <thead>
                    <tr><th>Name</th><th>Department</th><th>Role</th><th>Start date</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in _employees)
                    {
                        <tr>
                            <td>
                                <div class="person">
                                    <span class="avatar avatar--sm">@e.Initials</span>
                                    <div>
                                        <div class="name">@e.Name</div>
                                        <div class="email">@e.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>@e.Department</td>
                            <td>@e.Role</td>
                            <td>@e.StartDate</td>
                            <td><span class="badge @e.StatusClass">@e.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="panel" data-cursor>
        <div class="panel-head">
            <span class="panel-title">Headcount by department</span>
        </div>
        <div class="panel-body">
            <div class="bars">
                @foreach (var d in _departments)
                {
                    <div class="bar-row">
                        <div class="bar-meta">
                            <span>@d.Name</span>
                            <span class="val">@d.Count</span>
                        </div>
                        <div class="bar-track">
                            <div class="bar-fill" style="width:@(d.Count * 100 / _deptMax)%;background:@d.Color"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private record Employee(string Name, string Email, string Department, string Role, string StartDate, string Status, string StatusClass)
    {
        public string Initials => string.Concat(Name.Split(' ').Select(p => p[0]));
    }

    private record Dept(string Name, int Count, string Color);

    // ponytail: hardcoded sample data for the mockup. Swap for a real query later.
    private readonly Employee[] _employees =
    {
        new("Andreea Ionescu", "andreea.ionescu@nordwave.io", "Design", "Product Designer", "Jun 24, 2026", "Active", "active"),
        new("Mihai Popescu", "mihai.popescu@nordwave.io", "Engineering", "Backend Engineer", "Jun 18, 2026", "Active", "active"),
        new("Elena Dumitrescu", "elena.dumitrescu@nordwave.io", "People", "HR Specialist", "Jun 10, 2026", "On leave", "leave"),
        new("Radu Constantinescu", "radu.constantinescu@nordwave.io", "Sales", "Sales Lead", "May 29, 2026", "Remote", "remote"),
        new("Ioana Marin", "ioana.marin@nordwave.io", "Engineering", "QA Engineer", "May 21, 2026", "Active", "active"),
    };

    private readonly Dept[] _departments =
    {
        new("Engineering", 84, "var(--deep-ocean)"),
        new("Operations",  41, "var(--blue-spruce)"),
        new("Sales",       38, "var(--jungle-teal)"),
        new("Design",      28, "var(--seagrass-2)"),
        new("People",      22, "var(--mint-leaf-2)"),
        new("Finance",     16, "var(--mint-leaf)"),
    };

    private int _deptMax => _departments.Max(d => d.Count);
}
