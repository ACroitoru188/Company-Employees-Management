<div class="appr @(Status != "pending" ? "done" : "")">
    <div class="appr-top">
        <Avatar Initials="@Initials" Tone="@Tone" />
        <div class="row-main">
            <div class="row-name">@Name <span class="appr-dept">· @Dept</span></div>
            <div class="appr-meta">
                <span class="pill tone-@Tone.ToString().ToLowerInvariant()">@Type</span>
                <span class="appr-range">@Range</span>
                <span class="appr-days">· @Days @(Days == 1 ? "day" : "days")</span>
            </div>
            <div class="appr-reason">"@Reason"</div>
        </div>
    </div>
    @if (Status == "pending")
    {
        <div class="appr-actions">
            <RetroButton Variant="RetroButton.ButtonVariant.Primary" OnClick="() => OnApprove.InvokeAsync()">Approve</RetroButton>
            <RetroButton Variant="RetroButton.ButtonVariant.Danger" OnClick="() => OnReject.InvokeAsync()">Decline</RetroButton>
        </div>
    }
    else
    {
        <div class="appr-done @(Status == "approved" ? "ok" : "no")">@(Status == "approved" ? "✓ Approved · employee notified" : "× Declined · employee notified")</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public string Initials { get; set; } = "";
    [Parameter, EditorRequired] public string Dept { get; set; } = "";
    [Parameter, EditorRequired] public string Type { get; set; } = "";
    [Parameter] public LeaveTone Tone { get; set; } = LeaveTone.Accent;
    [Parameter, EditorRequired] public string Range { get; set; } = "";
    [Parameter] public int Days { get; set; }
    [Parameter, EditorRequired] public string Reason { get; set; } = "";
    [Parameter, EditorRequired] public string Status { get; set; } = "pending";
    [Parameter] public EventCallback OnApprove { get; set; }
    [Parameter] public EventCallback OnReject { get; set; }
}
