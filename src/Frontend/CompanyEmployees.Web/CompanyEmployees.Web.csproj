<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>company-employees-management-web</UserSecretsId>
  </PropertyGroup>


  <ItemGroup>
    <Folder Include="Controllers\" />
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11" />
    <Folder Include="Assets\" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.4" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.14.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- AppLocalizer reads these from ContentRootPath at startup, so they must travel with the app. -->
    <Content Update="Languages\*.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="KillZombieProcesses" BeforeTargets="PreBuildEvent" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="taskkill /F /IM CompanyEmployees.Web.exe /T 2&gt;nul || exit 0" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\Backend\CompanyEmployees.Domain\CompanyEmployees.Domain.csproj" />
    <ProjectReference Include="..\..\Backend\CompanyEmployees.Persistence\CompanyEmployees.Persistence.csproj" />
    <ProjectReference Include="..\..\Backend\CompanyEmployees.Gateway\CompanyEmployees.Gateway.csproj" />
    <ProjectReference Include="..\..\Backend\CompanyEmployees.Application\CompanyEmployees.Application.csproj" />
    <ProjectReference Include="..\..\Backend\CompanyEmployees.Infrastructure\CompanyEmployees.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Languages\*.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
