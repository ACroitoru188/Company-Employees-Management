@page "/hr/dashboard"
@layout CompanyEmployees.Web.Components.Layout.EmployeeLayout
@using System.Globalization
@using CompanyEmployees.Application
@using CompanyEmployees.Application.Contexts
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@using DomainInvalidOperationException = CompanyEmployees.Domain.Exceptions.InvalidOperationException
@inject EmployeeContext Employees
@inject ActingContext Acting
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IToastService Toast

<PageTitle>HR Dashboard · Time Off Management</PageTitle>

@if (_data is null)
{
	<FluentProgressRing />
}
else
{
	<FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
				 HorizontalGap="12" Wrap="true" Width="100%">
		<FluentLabel Typo="Typography.PaneHeader" Weight="FontWeight.Bold">HR Dashboard</FluentLabel>
		<FluentSpacer />
		<FluentAnchor Href="/api/employees/export.csv" Appearance="Appearance.Outline"
					  IconStart="@(new Icons.Regular.Size20.ArrowDownload())">
			Download latest CSV
		</FluentAnchor>
		<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Welcome, @_name</FluentLabel>
	</FluentStack>

	<FluentGrid Spacing="3" Style="margin:16px 0 24px;">
		<FluentGridItem xs="12" sm="6" md="3">
			<FluentCard Style="padding:16px;">
				<FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
					<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-overline">Active employees</FluentLabel>
					<FluentLabel Typo="Typography.PageTitle" Weight="FontWeight.Bold">@_data.ActiveEmployees</FluentLabel>
				</FluentStack>
			</FluentCard>
		</FluentGridItem>
		<FluentGridItem xs="12" sm="6" md="3">
			<FluentCard Style="padding:16px;">
				<FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
					<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-overline">New employees (30 days)</FluentLabel>
					<FluentLabel Typo="Typography.PageTitle" Weight="FontWeight.Bold">@_data.NewEmployees</FluentLabel>
				</FluentStack>
			</FluentCard>
		</FluentGridItem>
		<FluentGridItem xs="12" sm="6" md="3">
			<FluentCard Style="padding:16px;">
				<FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
					<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-overline">Leave requests</FluentLabel>
					<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6"
								 VerticalAlignment="VerticalAlignment.Bottom">
						<FluentLabel Typo="Typography.PageTitle" Weight="FontWeight.Bold" Color="Color.Warning">
							@_data.PendingRequests
						</FluentLabel>
						<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">pending</FluentLabel>
					</FluentStack>
				</FluentStack>
			</FluentCard>
		</FluentGridItem>
		<FluentGridItem xs="12" sm="6" md="3">
			<FluentCard Style="padding:16px;">
				<FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
					<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-overline">On leave today</FluentLabel>
					<FluentLabel Typo="Typography.PageTitle" Weight="FontWeight.Bold">@_data.OnLeaveToday</FluentLabel>
				</FluentStack>
			</FluentCard>
		</FluentGridItem>
	</FluentGrid>

	<FluentGrid Spacing="3">
		@* Both request lists share the left column so they share a width; the
		   departments card stretches down the right instead of stopping short. *@
		<FluentGridItem xs="12" md="8">
			<FluentStack Orientation="Orientation.Vertical" VerticalGap="24">
				<FluentCard Style="padding:16px;">
					<FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
						<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8"
									 VerticalAlignment="VerticalAlignment.Center">
							<FluentIcon Value="@(new Icons.Regular.Size20.Clock())" Color="Color.Accent" />
							<FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">Requests to approve</FluentLabel>
						</FluentStack>

						<FluentSearch @bind-Value="SearchTerm" @bind-Value:after="StateHasChanged"
									  Placeholder="Search by name..." Style="width:100%;" />

						@if (!FilteredRequests.Any())
						{
							<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
								No requests are waiting for approval.
							</FluentLabel>
						}
						else
						{
							@* The accordion replaces the hand-rolled expand/collapse row: one panel open
							   at a time, which is exactly what ToggleRequest used to do by hand. *@
							@* Both the accordion and its items size to their content, so without these
							   each row stops short of the card's right edge. *@
							<FluentAccordion Style="width:100%;">
								@foreach (var request in FilteredRequests)
								{
									<FluentAccordionItem Id="@request.RequestId.ToString()" Style="width:100%;">
										<HeadingTemplate>
											<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12"
														 VerticalAlignment="VerticalAlignment.Center" Width="100%">
												<FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
													<FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">
														@request.Name
													</FluentLabel>
													<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
												@request.Type &middot; @request.Days @(request.Days == 1 ? "working day" : "working days")
														&middot; @request.Department
														&middot; @request.StartDate.ToString("MMM d", CultureInfo.InvariantCulture)–@request.EndDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
													</FluentLabel>
												</FluentStack>
												<FluentSpacer />
												@* Amber, the colour this app gives a pending decision everywhere else —
												   accent blue read as "approved" next to the green and red ones. *@
												<FluentBadge Fill="highlight" BackgroundColor="var(--warning)" Color="white">pending</FluentBadge>
											</FluentStack>
										</HeadingTemplate>

										<ChildContent>
											@{
												var nameParts = request.Name.Split(' ', 2);
												var firstName = nameParts.Length > 0 ? nameParts[0] : "";
												var lastName = nameParts.Length > 1 ? nameParts[1] : "";
												var role = request.Role == "LineManager" ? "Manager" : request.Role;
												var reason = string.IsNullOrWhiteSpace(request.Reason)
													|| request.Reason.Equals(request.Type, StringComparison.OrdinalIgnoreCase)
													|| request.Reason.Equals(request.Type + " leave", StringComparison.OrdinalIgnoreCase)
														? "No reason specified"
														: request.Reason;
											}

											<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="24" Width="100%">
												<FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
													<FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
														<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Name</FluentLabel>
														<FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@firstName</FluentLabel>
													</FluentStack>
													<FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
														<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Surname</FluentLabel>
														<FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@lastName</FluentLabel>
													</FluentStack>
													<FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
														<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Department</FluentLabel>
														<FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@request.Department</FluentLabel>
													</FluentStack>
													<FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
														<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Role</FluentLabel>
														<FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@role</FluentLabel>
													</FluentStack>
												</FluentStack>
											</FluentStack>

											<FluentDivider Role="DividerRole.Presentation" Style="margin:16px 0;" />

											<FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
												<FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
													<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Leave type</FluentLabel>
													<FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@request.Type</FluentLabel>
												</FluentStack>
												<FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
													<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Reason</FluentLabel>
													<FluentLabel Typo="Typography.Body">@reason</FluentLabel>
												</FluentStack>
												<FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
													<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Period</FluentLabel>
													<FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">
														@request.StartDate.ToString("dd.MM.yyyy") - @request.EndDate.ToString("dd.MM.yyyy")
														(@request.Days @(request.Days == 1 ? "working day" : "working days"))
													</FluentLabel>
												</FluentStack>
												<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-caption">
													Submitted @request.SubmittedAt.ToString("dd.MM.yyyy - HH:mm")
												</FluentLabel>
											</FluentStack>

											<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8"
														 HorizontalAlignment="HorizontalAlignment.End" Width="100%"
														 Style="margin-top:16px;">
												<FluentButton Appearance="Appearance.Neutral"
															  OnClick="@(() => EditDates(request))">Edit dates</FluentButton>
												<FluentButton Appearance="Appearance.Neutral"
															  OnClick="@(() => DecideAsync(request, false))">Reject</FluentButton>
												<FluentButton Appearance="Appearance.Accent"
															  OnClick="@(() => DecideAsync(request, true))">Approve</FluentButton>
											</FluentStack>
										</ChildContent>
									</FluentAccordionItem>
								}
							</FluentAccordion>
						}
					</FluentStack>
				</FluentCard>
		@* Approved leave whose owner has asked for it back. Separate card rather than a second
		   tab on the one above: the two lists answer different questions and are searched
		   independently. *@
		<FluentCard Style="padding:16px;">
			<FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
				<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8"
							 VerticalAlignment="VerticalAlignment.Center">
					<FluentIcon Value="@(new Icons.Regular.Size20.ArrowUndo())" Color="Color.Accent" />
					<FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">Cancellation requests</FluentLabel>
					<FluentSpacer />
					@if (_data.CancellationRequests.Count > 0)
					{
						<FluentBadge Fill="highlight" BackgroundColor="var(--warning)" Color="white">
							@_data.CancellationRequests.Count waiting
						</FluentBadge>
					}
				</FluentStack>

				<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
					Employees asking to undo leave that was already approved. The leave stands until you
					decide; approving returns the days to their balance.
				</FluentLabel>

				@if (_data.CancellationRequests.Count > 0)
				{
					<FluentSearch @bind-Value="CancellationSearchTerm" @bind-Value:after="StateHasChanged"
								  Placeholder="Search by name..." Style="width:100%;" />
				}

				@if (!FilteredCancellations.Any())
				{
					<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
						No one has asked to cancel approved leave.
					</FluentLabel>
				}
				else
				{
					<FluentAccordion Style="width:100%;">
						@foreach (var request in FilteredCancellations)
						{
							<FluentAccordionItem Id="@($"cancellation-{request.RequestId}")" Style="width:100%;">
								<HeadingTemplate>
									<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12"
												 VerticalAlignment="VerticalAlignment.Center" Width="100%">
										<FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
											<FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">
												@request.Name
											</FluentLabel>
											<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
												@request.Type &middot; @request.Days @(request.Days == 1 ? "working day" : "working days")
												&middot; @request.Department
												&middot; @request.StartDate.ToString("MMM d", CultureInfo.InvariantCulture)&ndash;@request.EndDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
											</FluentLabel>
										</FluentStack>
										<FluentSpacer />
										@if (request.InProgress)
										{
											@* Already under way, so approving hands back days that were in fact taken. *@
											<FluentBadge Fill="highlight" BackgroundColor="var(--error)" Color="white">in progress</FluentBadge>
										}
										<FluentBadge Fill="highlight" BackgroundColor="var(--warning)" Color="white">cancellation requested</FluentBadge>
									</FluentStack>
								</HeadingTemplate>
								<ChildContent>
									@{
										var originalReason = string.IsNullOrWhiteSpace(request.Reason)
											|| request.Reason.Equals(request.Type, StringComparison.OrdinalIgnoreCase)
											|| request.Reason.Equals(request.Type + " leave", StringComparison.OrdinalIgnoreCase)
												? "No reason specified"
												: request.Reason;
										var cancellationRole = request.Role == "LineManager" ? "Manager" : request.Role;
									}

									<FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
										<FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
											<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Why they want it cancelled</FluentLabel>
											<FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@request.CancellationReason</FluentLabel>
										</FluentStack>
										<FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
											<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Department</FluentLabel>
											<FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@request.Department</FluentLabel>
										</FluentStack>
										<FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
											<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Role</FluentLabel>
											<FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@cancellationRole</FluentLabel>
										</FluentStack>
										<FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
											<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Leave type</FluentLabel>
											<FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@request.Type</FluentLabel>
										</FluentStack>
										<FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
											<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Original reason</FluentLabel>
											<FluentLabel Typo="Typography.Body">@originalReason</FluentLabel>
										</FluentStack>
										<FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
											<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Period</FluentLabel>
											<FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">
												@request.StartDate.ToString("dd.MM.yyyy") - @request.EndDate.ToString("dd.MM.yyyy")
												(@request.Days @(request.Days == 1 ? "working day" : "working days"))
											</FluentLabel>
										</FluentStack>
										<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-caption">
											Requested @request.RequestedAt.ToString("dd.MM.yyyy - HH:mm")
										</FluentLabel>
									</FluentStack>

									<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8"
												 HorizontalAlignment="HorizontalAlignment.End" Width="100%"
												 Style="margin-top:16px;">
										<FluentButton Appearance="Appearance.Neutral"
													  OnClick="@(() => DecideCancellationAsync(request, false))">Decline</FluentButton>
										<FluentButton Appearance="Appearance.Accent"
													  OnClick="@(() => DecideCancellationAsync(request, true))">Approve cancellation</FluentButton>
									</FluentStack>
								</ChildContent>
							</FluentAccordionItem>
						}
					</FluentAccordion>
				}
			</FluentStack>
		</FluentCard>
			</FluentStack>
		</FluentGridItem>

		<FluentGridItem xs="12" md="4">
			<FluentCard Style="padding:16px; height:100%;">
				<FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
					<FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">Employees per department</FluentLabel>

					@foreach (var department in _data.Departments)
					{
						<FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
							<FluentStack Orientation="Orientation.Horizontal" Width="100%">
								<FluentLabel Typo="Typography.Body">@department.Name</FluentLabel>
								<FluentSpacer />
								<FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@department.Count</FluentLabel>
							</FluentStack>
							@* Bars are relative to the largest department, so the biggest one fills the track. *@
							<FluentProgress Value="@BarPercent(department.Count)" Min="0" Max="100" />
						</FluentStack>
					}
				</FluentStack>
			</FluentCard>
		</FluentGridItem>
	</FluentGrid>

	@if (_data.StaleRequests > 0)
	{
		<FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false" Style="margin-top:24px;">
			@_data.StaleRequests @(_data.StaleRequests == 1 ? "request has" : "requests have")
			been waiting for approval for more than 7 days
		</FluentMessageBar>
	}
}

@code {
	private Guid _myId;

	[CascadingParameter]
	private Task<AuthenticationState>? AuthStateTask { get; set; }

	[SupplyParameterFromQuery(Name = "search")]
	public string? InitialSearch { get; set; }

	private string _name = "";
	private HrDashboardResult? _data;
	private string SearchTerm { get; set; } = "";
	private string CancellationSearchTerm { get; set; } = "";
	private ActingUser? _acting;
	private ActingOnBehalf? _onBehalf => _acting is { IsImpersonating: true, DelegationId: not null }
		? new ActingOnBehalf(_acting.RealUserId, _acting.DelegationId.Value)
		: null;

	private async Task DecideAsync(HrPendingRequest request, bool approved)
	{
		await Employees.HrDecideRequestAsync(_myId, request.RequestId, approved, _onBehalf);
		_data = await Employees.GetHrDashboardAsync(_myId);
	}

	private async Task EditDates(HrPendingRequest request)
	{
		var content = EditLeaveDatesDialog.Model.From(request);

		var parameters = new DialogParameters
		{
			Title = "Edit leave period",
			PrimaryAction = "Save",
			SecondaryAction = "Cancel",
			Width = "420px",
			// Runs before the dialog is allowed to close; returning false keeps it open with
			// the message written back onto the content the dialog is rendering.
			ValidateDialogAsync = () => SaveDatesAsync(content)
		};

		var dialog = await DialogService.ShowDialogAsync<EditLeaveDatesDialog, EditLeaveDatesDialog.Model>(
			content, parameters);

		var result = await dialog.Result;
		if (!result.Cancelled)
			_data = await Employees.GetHrDashboardAsync(_myId);
	}

	private async Task<bool> SaveDatesAsync(EditLeaveDatesDialog.Model content)
	{
		content.SetError(null);

		if (content.Start is null || content.End is null)
		{
			content.SetError("Both dates are required.");
			return false;
		}

		try
		{
			await Employees.UpdateRequestDatesAsync(
				content.RequestId,
				DateOnly.FromDateTime(content.Start.Value),
				DateOnly.FromDateTime(content.End.Value));
			return true;
		}
		catch (DomainInvalidOperationException ex)
		{
			content.SetError(ex.Message);
			return false;
		}
	}

	private IEnumerable<HrPendingRequest> FilteredRequests => string.IsNullOrWhiteSpace(SearchTerm)
		? _data!.Pending
		: _data!.Pending.Where(r => r.Name.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));

	private IEnumerable<HrCancellationRequest> FilteredCancellations =>
		string.IsNullOrWhiteSpace(CancellationSearchTerm)
			? _data!.CancellationRequests
			: _data!.CancellationRequests.Where(r =>
				r.Name.Contains(CancellationSearchTerm, StringComparison.OrdinalIgnoreCase));

	private async Task DecideCancellationAsync(HrCancellationRequest request, bool approve)
	{
		var verb = approve ? "Approve" : "Decline";
		var confirmation = await DialogService.ShowConfirmationAsync(
			approve
				? $"Cancel {request.Name}'s {request.Type} leave and return {request.Days} "
					+ $"{(request.Days == 1 ? "day" : "days")} to their balance?"
				: $"Decline {request.Name}'s request? Their {request.Type} leave stays approved.",
			verb,
			"Back",
			$"{verb} cancellation");

		if ((await confirmation.Result).Cancelled)
			return;

		// Blazor Server tears the circuit down on an unhandled exception, which reads to the
		// user as the page freezing - so a refusal from the backend has to surface as a toast.
		try
		{
			await Employees.HrDecideCancellationAsync(_myId, request.RequestId, approve, _onBehalf);
			_data = await Employees.GetHrDashboardAsync(_myId);
			Toast.ShowSuccess(approve
				? $"{request.Name}'s leave was cancelled."
				: $"{request.Name}'s cancellation request was declined.");
		}
		catch (Exception ex)
		{
			_data = await Employees.GetHrDashboardAsync(_myId);
			Toast.ShowError(ex.Message);
		}
	}

	// Same gate as AdminDepartments: HR is a department, so this reads the
	// Department claim rather than the role one. Non-HR users get sent back.
	protected override async Task OnInitializedAsync()
	{
		if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
			return;

		var user = (await AuthStateTask!).User;
		if (user.FindFirst("Department")?.Value != "HR")
		{
			Nav.NavigateTo("/employee/dashboard");
			return;
		}

		if (!string.IsNullOrWhiteSpace(InitialSearch))
		{
			SearchTerm = InitialSearch;
		}

		_name = user.FindFirst("FullName")?.Value ?? "";
		var me = await Employees.GetEmployeeByEmailAsync(user.Identity!.Name!);
		_myId = me.Id;
		_acting = await Acting.GetAsync();
		_data = await Employees.GetHrDashboardAsync(_myId);
	}

	private int BarPercent(int count)
	{
		var largest = 0;
		foreach (var department in _data!.Departments)
		{
			if (department.Count > largest)
				largest = department.Count;
		}

		return largest == 0 ? 0 : (int)Math.Round(count * 100.0 / largest);
	}
}
