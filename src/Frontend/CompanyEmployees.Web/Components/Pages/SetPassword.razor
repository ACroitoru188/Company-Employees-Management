@page "/set-password"
@layout AuthLayout
@rendermode InteractiveServer
@inject EmployeeAccountService Accounts

<PageTitle>Set password · Siemens Leave</PageTitle>

<div class="login-wrap">
    <MudPaper Elevation="3" Class="pa-8 login-card">
        <MudText Typo="Typo.h5" Style="font-weight:600;">Set your password</MudText>

        @if (_completed)
        {
            <MudAlert Severity="Severity.Success" Class="my-4">
                Your password has been set. You can now sign in.
            </MudAlert>
            <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
                Go to sign in
            </MudButton>
        }
        else if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Code))
        {
            <MudAlert Severity="Severity.Error" Class="my-4">
                This setup link is invalid or incomplete.
            </MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mt-2 mb-6" Style="color:var(--mud-palette-text-secondary);">
                Create a password for @Email. This link can only be used once.
            </MudText>

            @if (_errors.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">
                    @foreach (var error in _errors)
                    {
                        <div>@error</div>
                    }
                </MudAlert>
            }

            <MudForm @ref="_form">
                <MudTextField T="string" @bind-Value="_password" Label="New password"
                              Variant="Variant.Outlined" InputType="InputType.Password"
                              Required="true" RequiredError="Password is required" Class="mb-4" />
                <MudTextField T="string" @bind-Value="_confirmPassword" Label="Confirm password"
                              Variant="Variant.Outlined" InputType="InputType.Password"
                              Required="true" RequiredError="Confirm your password"
                              Validation="@(new Func<string, string?>(ValidateConfirmation))" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           FullWidth="true" Class="mt-6" Disabled="_busy" OnClick="SetPasswordAsync">
                    @(_busy ? "Setting password…" : "Set password")
                </MudButton>
            </MudForm>
        }
    </MudPaper>
</div>

@code {
    private MudForm _form = default!;
    private string _password = "";
    private string _confirmPassword = "";
    private readonly List<string> _errors = [];
    private bool _busy;
    private bool _completed;

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    public string? Code { get; set; }

    private string? ValidateConfirmation(string value) =>
        value == _password ? null : "Passwords do not match";

    private async Task SetPasswordAsync()
    {
        _errors.Clear();
        await _form.ValidateAsync();
        if (!_form.IsValid || Email == null || Code == null)
            return;

        _busy = true;
        try
        {
            var result = await Accounts.SetInitialPasswordAsync(Email, Code, _password);
            if (result.Succeeded)
            {
                _completed = true;
                return;
            }

            _errors.AddRange(result.Errors.Select(error => error.Description));
        }
        finally
        {
            _busy = false;
        }
    }
}
