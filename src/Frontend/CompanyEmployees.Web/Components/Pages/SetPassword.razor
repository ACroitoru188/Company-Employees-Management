@page "/set-password"
@layout AuthLayout
@rendermode InteractiveServer
@inject EmployeeAccountService Accounts

<PageTitle>Create password · Siemens Time Off</PageTitle>
<EmployeeProviders />

<div class="password-page">
    <main class="password-shell">
        <section class="password-card">
            <div class="brand-mark">SIEMENS</div>

            @if (_completed)
            {
                <div class="simple-state simple-state--success" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Large" />
                </div>
                <h1 class="page-title">Password created</h1>
                <p class="page-subtitle">
                    Your account is ready. You can now sign in with your new password.
                </p>
                <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary"
                           Size="Size.Large" FullWidth="true" Class="main-button">
                    Continue to sign in
                </MudButton>
            }
            else if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Code))
            {
                <div class="simple-state simple-state--error" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Large" />
                </div>
                <h1 class="page-title">Invalid password link</h1>
                <p class="page-subtitle">
                    This link is incomplete, expired, or has already been used. Ask your administrator for a new one.
                </p>
                <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary"
                           Size="Size.Large" FullWidth="true" Class="main-button">
                    Back to sign in
                </MudButton>
            }
            else
            {
                <h1 class="page-title">Create your password</h1>
                <p class="page-subtitle">
                    Set the password for <strong>@Email</strong>
                </p>

                @if (_errors.Count > 0)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="error-alert">
                        @foreach (var error in _errors)
                        {
                            <div>@error</div>
                        }
                    </MudAlert>
                }

                <div class="password-form">
                    <div class="field">
                        <input type="@(_showPassword ? "text" : "password")"
                               class="field-input"
                               placeholder="New password*"
                               autocomplete="new-password"
                               value="@_password"
                               @oninput="@(e => _password = e.Value?.ToString() ?? "")" />
                        <button type="button" class="field-toggle"
                                @onclick="@(() => _showPassword = !_showPassword)"
                                aria-label="Show or hide new password">
                            <MudIcon Icon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)" Size="Size.Small" />
                        </button>
                    </div>

                    <div class="field">
                        <input type="@(_showConfirmation ? "text" : "password")"
                               class="field-input"
                               placeholder="Confirm password*"
                               autocomplete="new-password"
                               value="@_confirmPassword"
                               @oninput="@(e => _confirmPassword = e.Value?.ToString() ?? "")" />
                        <button type="button" class="field-toggle"
                                @onclick="@(() => _showConfirmation = !_showConfirmation)"
                                aria-label="Show or hide password confirmation">
                            <MudIcon Icon="@(_showConfirmation ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)" Size="Size.Small" />
                        </button>
                    </div>

                    <p class="password-hint">
                        Use at least 6 characters, including uppercase, lowercase, a number, and a symbol.
                    </p>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                               FullWidth="true" Disabled="_busy" OnClick="SetPasswordAsync" Class="main-button">
                        @(_busy ? "Creating password…" : "Create password")
                    </MudButton>
                </div>
            }
        </section>

        <div class="page-footer">© 2026 Siemens · Privacy · Terms · Help</div>
    </main>
</div>

@code {
    private string _password = "";
    private string _confirmPassword = "";
    private readonly List<string> _errors = [];
    private bool _busy;
    private bool _completed;
    private bool _showPassword;
    private bool _showConfirmation;

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    public string? Code { get; set; }

    private async Task SetPasswordAsync()
    {
        _errors.Clear();

        if (string.IsNullOrWhiteSpace(_password))
            _errors.Add("Password is required");
        else if (_confirmPassword != _password)
            _errors.Add("Passwords do not match");

        if (_errors.Count > 0 || Email == null || Code == null)
            return;

        _busy = true;
        try
        {
            var result = await Accounts.SetInitialPasswordAsync(Email, Code, _password);
            if (result.Succeeded)
            {
                _completed = true;
                return;
            }

            _errors.AddRange(result.Errors.Select(error => error.Description));
        }
        finally
        {
            _busy = false;
        }
    }
}
