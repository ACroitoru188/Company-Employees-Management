@page "/set-password"
@layout AuthLayout
@rendermode InteractiveServer
@inject EmployeeAccountService Accounts

<PageTitle>Create password · Siemens Time Off</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16"
             HorizontalAlignment="HorizontalAlignment.Center" Style="padding:48px 16px;">
    <FluentCard Width="420px" Style="padding:32px;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
            <FluentLabel Typo="Typography.PaneHeader" Weight="FontWeight.Bold" Color="Color.Custom" CustomColor="var(--accent-foreground-rest)"
                         Alignment="HorizontalAlignment.Center">
                SIEMENS
            </FluentLabel>

            @if (_completed)
            {
                <FluentIcon Value="@(new Icons.Filled.Size32.CheckmarkCircle())" Color="Color.Success" />
                <FluentLabel Typo="Typography.Header" Weight="FontWeight.Bold">Password created</FluentLabel>
                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                    Your account is ready. You can now sign in with your new password.
                </FluentLabel>
                <FluentAnchor Href="/" Appearance="Appearance.Accent" Style="width:100%;">
                    Continue to sign in
                </FluentAnchor>
            }
            else if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Code))
            {
                <FluentIcon Value="@(new Icons.Filled.Size32.Warning())" Color="Color.Error" />
                <FluentLabel Typo="Typography.Header" Weight="FontWeight.Bold">Invalid password link</FluentLabel>
                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                    This link is incomplete, expired, or has already been used. Ask your administrator for a new one.
                </FluentLabel>
                <FluentAnchor Href="/" Appearance="Appearance.Accent" Style="width:100%;">
                    Back to sign in
                </FluentAnchor>
            }
            else
            {
                <FluentLabel Typo="Typography.Header" Weight="FontWeight.Bold">Create your password</FluentLabel>
                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                    Set the password for <strong>@Email</strong>
                </FluentLabel>

                @if (_errors.Count > 0)
                {
                    <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
                            @foreach (var error in _errors)
                            {
                                <FluentLabel Typo="Typography.Body">@error</FluentLabel>
                            }
                        </FluentStack>
                    </FluentMessageBar>
                }

                <FluentTextField @bind-Value="_password" Label="New password"
                                 TextFieldType="@(_showPassword ? TextFieldType.Text : TextFieldType.Password)"
                                 Autocomplete="new-password" Required="true" Style="width:100%;">
                    <FluentButton slot="end" Appearance="Appearance.Stealth"
                                  IconStart="@(new Icons.Regular.Size16.Eye())"
                                  Title="Show or hide new password"
                                  OnClick="@(() => _showPassword = !_showPassword)" />
                </FluentTextField>

                <FluentTextField @bind-Value="_confirmPassword" Label="Confirm password"
                                 TextFieldType="@(_showConfirmation ? TextFieldType.Text : TextFieldType.Password)"
                                 Autocomplete="new-password" Required="true" Style="width:100%;">
                    <FluentButton slot="end" Appearance="Appearance.Stealth"
                                  IconStart="@(new Icons.Regular.Size16.Eye())"
                                  Title="Show or hide password confirmation"
                                  OnClick="@(() => _showConfirmation = !_showConfirmation)" />
                </FluentTextField>

                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                    Use at least 6 characters, including uppercase, lowercase, a number, and a symbol.
                </FluentLabel>

                <FluentButton Appearance="Appearance.Accent" Disabled="_busy"
                              OnClick="SetPasswordAsync" Style="width:100%;">
                    @(_busy ? "Creating password…" : "Create password")
                </FluentButton>
            }
        </FluentStack>
    </FluentCard>

    <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
        © 2026 Siemens · Privacy · Terms · Help
    </FluentLabel>
</FluentStack>

@code {
    private string _password = "";
    private string _confirmPassword = "";
    private readonly List<string> _errors = [];
    private bool _busy;
    private bool _completed;
    private bool _showPassword;
    private bool _showConfirmation;

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    public string? Code { get; set; }

    private async Task SetPasswordAsync()
    {
        _errors.Clear();

        if (string.IsNullOrWhiteSpace(_password))
            _errors.Add("Password is required");
        else if (_confirmPassword != _password)
            _errors.Add("Passwords do not match");

        if (_errors.Count > 0 || Email == null || Code == null)
            return;

        _busy = true;
        try
        {
            var result = await Accounts.SetInitialPasswordAsync(Email, Code, _password);
            if (result.Succeeded)
            {
                _completed = true;
                return;
            }

            _errors.AddRange(result.Errors.Select(error => error.Description));
        }
        finally
        {
            _busy = false;
        }
    }
}
