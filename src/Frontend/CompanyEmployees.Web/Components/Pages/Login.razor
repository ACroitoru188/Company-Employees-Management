@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using CompanyEmployees.Web.Security
@using CompanyEmployees.Domain.Enums
@layout AuthLayout
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<PageTitle>Sign in · Time Off Management</PageTitle>
<EmployeeProviders />

<div class="login-wrap">
    <MudPaper Elevation="3" Class="pa-8 login-card">
        <div class="d-flex align-baseline justify-center gap-3 mb-6">
            <MudText Typo="Typo.h4" Style="font-weight:800; letter-spacing:.06em; color:var(--mud-palette-primary);">
                SIEMENS
            </MudText>

        </div>

        <MudText Typo="Typo.h6" Style="font-weight:600;">Sign in to your workspace</MudText>
        <MudText Typo="Typo.body2" Class="mb-6" Style="color:var(--mud-palette-text-secondary);">
            Use your Siemens credentials.
        </MudText>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@_error</MudAlert>
        }

        <form id="hiddenLoginForm" method="post" action="/api/auth/login" style="display:none;">
            <AntiforgeryToken />
            <input type="hidden" name="email" value="@_email" />
            <input type="hidden" name="password" value="@_password" />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        </form>

        <MudForm @ref="_form">
            <MudTextField T="string" @bind-Value="_email" Label="Work email"
                          Variant="Variant.Outlined" InputType="InputType.Email"
                          Required="true" RequiredError="Email is required"
                          Validation="@(new Func<string, string?>(ValidateEmail))"
                          Placeholder="yourname@siemens.com" Class="mb-4" />
            <MudTextField T="string" @bind-Value="_password" Label="Password"
                          Variant="Variant.Outlined"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Required="true" RequiredError="Password is required"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                          AdornmentAriaLabel="Show password" />

            <div class="d-flex justify-space-between align-center gap-4 my-4 flex-wrap">
                <MudCheckBox T="bool" @bind-Value="_keepSignedIn" Label="Keep me signed in" Dense="true" />
                <MudLink Href="/forgot-password" Typo="Typo.body2" Class="ml-auto" Style="margin-top:6px;">Forgot password?</MudLink>
            </div>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       FullWidth="true" Disabled="_busy" OnClick="SignIn">
                @(_busy ? "Signing in…" : "Sign in")
            </MudButton>
        </MudForm>

    </MudPaper>

    <MudText Typo="Typo.caption" Class="mt-4" Style="color:var(--mud-palette-text-secondary);">
        © 2026 Siemens · Privacy · Terms · Help
    </MudText>
</div>

@code {
    private MudForm _form = default!;
    private string _email = "";
    private string _password = "";
    private bool _showPassword;
    private bool _keepSignedIn = true;
    private string? _error;
    private bool _busy;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? QueryError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                var roleClaim = authState.User.FindFirst(ClaimTypes.Role)?.Value;
                UserRole? role = Enum.TryParse<UserRole>(roleClaim, out var parsedRole) ? parsedRole : null;
                var department = authState.User.FindFirst("Department")?.Value;
                Nav.NavigateTo(!string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//")
                    ? ReturnUrl
                    : HomeRouteResolver.Resolve(role, department));
                return;
            }
        }

        if (!string.IsNullOrEmpty(QueryError))
        {
            _error = "Invalid email or password.";
        }
    }

    private static string? ValidateEmail(string value) =>
        string.IsNullOrWhiteSpace(value) || value.Contains('@') ? null : "Enter a valid email address";

    private async Task SignIn()
    {
        _error = null;
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _busy = true;

        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('hiddenLoginForm').submit();");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _busy = false;
        }
    }
}