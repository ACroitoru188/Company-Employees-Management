@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using CompanyEmployees.Web.Security
@using CompanyEmployees.Domain.Enums
@using CompanyEmployees.Domain.Entities
@using CompanyEmployees.Application.Contexts
@layout AuthLayout
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject EmployeeContext Employees

<PageTitle>Sign in · Time Off Management</PageTitle>

<div class="login-page">
    <video @ref="_backgroundVideo" class="login-background" autoplay muted loop playsinline preload="auto" aria-hidden="true" tabindex="-1">
        <source src="/media/login-background.mp4" type="video/mp4" />
    </video>
    <div class="login-overlay" aria-hidden="true"></div>

    <div class="login-content">
@* Centred on both axes. It used to sit 48px from the top of a full-height window, which left a
   few hundred pixels of empty canvas under it — the card looked dropped onto the page rather
   than placed on it. min-height rather than height so a short window scrolls instead of
   squeezing the card. *@
<FluentStack Orientation="Orientation.Vertical" VerticalGap="16"
             HorizontalAlignment="HorizontalAlignment.Center"
             VerticalAlignment="VerticalAlignment.Center"
             Style="min-height:100vh; padding:32px 16px;">
    <FluentCard Width="420px" Style="padding:32px;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
            <FluentLabel Typo="Typography.PaneHeader" Weight="FontWeight.Bold" Alignment="HorizontalAlignment.Center"
                         Color="Color.Custom" CustomColor="var(--accent-foreground-rest)">
                SIEMENS
            </FluentLabel>

            <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
                <FluentLabel Typo="Typography.Header" Weight="FontWeight.Bold">Sign in to your workspace</FluentLabel>
                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Use your Siemens credentials.</FluentLabel>
            </FluentStack>

            @if (_error is not null)
            {
                <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">@_error</FluentMessageBar>
            }

            @* The hidden-form hop exists because an interactive circuit cannot set the auth
               cookie itself; the endpoint does it and redirects. *@
            <form id="hiddenLoginForm" method="post" action="/api/auth/login" style="display:none;">
                <AntiforgeryToken />
                <input type="hidden" name="email" value="@_email" />
                <input type="hidden" name="password" value="@_password" />
                <input type="hidden" name="regionId" value="@_regionId" />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            </form>

            <FluentSelect TOption="Region"
                          Label="Region"
                          Items="@_regions"
                          OptionValue="@(r => r.Id.ToString())"
                          OptionText="@(r => r.Name)"
                          SelectedOption="@_selectedRegion"
                          SelectedOptionChanged="@(r => { _selectedRegion = r; _regionId = r?.Id; })"
                          Required="true"
                          Style="width:100%;" />

            <FluentTextField @bind-Value="_email" Label="Work email" TextFieldType="TextFieldType.Email"
                               Placeholder="yourname@siemens.com" Required="true"
                              Immediate="true" @onkeyup="HandleKeyUp" Style="width:100%;" />

            <FluentTextField @bind-Value="_password" Label="Password"
                               TextFieldType="@(_showPassword ? TextFieldType.Text : TextFieldType.Password)"
                              Required="true" Immediate="true" @onkeyup="HandleKeyUp" Style="width:100%;">
                <button slot="end" type="button" class="password-toggle"
                        title="@(_showPassword ? "Hide password" : "Show password")"
                        aria-label="@(_showPassword ? "Hide password" : "Show password")"
                        aria-pressed="@_showPassword"
                        @onclick="TogglePasswordVisibility">
                    @if (_showPassword)
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3.3 2.3 21.7 20.7l-1 1-3.2-3.2A10.8 10.8 0 0 1 12 20C6.7 20 2.7 16.7 1.2 12.5a1.5 1.5 0 0 1 0-1 12.4 12.4 0 0 1 3.2-4.8L2.3 3.3l1-1Zm3.2 6.5a8.9 8.9 0 0 0-2.6 3.2c1.4 3.3 4.5 5.5 8.1 5.5 1.2 0 2.4-.3 3.4-.7l-1.6-1.6A4 4 0 0 1 8.8 10l-2.3-1.2Zm5-2.3h.5a8.8 8.8 0 0 1 8.1 5.5 9 9 0 0 1-1.4 2.3l1.8 1.8a12 12 0 0 0 2.3-3.6 1.5 1.5 0 0 0 0-1C21.3 7.3 17.3 4 12 4c-.8 0-1.5.1-2.2.2l1.7 2.3Z" />
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 4C6.7 4 2.7 7.3 1.2 11.5a1.5 1.5 0 0 0 0 1C2.7 16.7 6.7 20 12 20s9.3-3.3 10.8-7.5a1.5 1.5 0 0 0 0-1C21.3 7.3 17.3 4 12 4Zm0 13.5c-3.6 0-6.7-2.2-8.1-5.5C5.3 8.7 8.4 6.5 12 6.5s6.7 2.2 8.1 5.5c-1.4 3.3-4.5 5.5-8.1 5.5Zm0-9a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z" />
                        </svg>
                    }
                </button>
            </FluentTextField>

            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                         HorizontalGap="12" Width="100%">
                <FluentCheckbox @bind-Value="_keepSignedIn" Label="Keep me signed in" />
                <FluentSpacer />
                <FluentAnchor Href="/forgot-password" Appearance="Appearance.Hypertext">Forgot password?</FluentAnchor>
            </FluentStack>

            <FluentButton Appearance="Appearance.Accent" Disabled="@_busy" OnClick="SignIn"
                          Style="width:100%;">
                @(_busy ? "Signing in…" : "Sign in")
            </FluentButton>
        </FluentStack>
    </FluentCard>

            <div class="login-footer">
                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="rgba(255,255,255,.92)">
                    © 2026 Siemens · Privacy · Terms · Help
                </FluentLabel>
            </div>
</FluentStack>
    </div>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private bool _showPassword;
    private bool _keepSignedIn = true;
    private string? _error;
    private bool _busy;
    private List<Region> _regions = [];
    private Region? _selectedRegion;
    private Guid? _regionId;
    private ElementReference _backgroundVideo;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? QueryError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                var roleClaim = authState.User.FindFirst(ClaimTypes.Role)?.Value;
                UserRole? role = Enum.TryParse<UserRole>(roleClaim, out var parsedRole) ? parsedRole : null;
                var department = authState.User.FindFirst("Department")?.Value;
                Nav.NavigateTo(!string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//")
                    ? ReturnUrl
                    : HomeRouteResolver.Resolve(role, department));
                return;
            }
        }

        if (!string.IsNullOrEmpty(QueryError))
        {
            _error = "Invalid email, password, or region.";
        }

        _regions = await Employees.GetRegionsAsync(activeOnly: true);
        _selectedRegion = _regions.FirstOrDefault(region => region.Code == "RO") ?? _regions.FirstOrDefault();
        _regionId = _selectedRegion?.Id;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("companyEmployeesLogin.prepareBackgroundVideo", _backgroundVideo, 0.65);
        }
    }

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private Task HandleKeyUp(KeyboardEventArgs args) =>
        args.Key == "Enter" ? SignIn() : Task.CompletedTask;

    private async Task SignIn()
    {
        _error = null;

        // Fluent has no MudForm equivalent that validates a loose set of fields, so the three
        // required values are checked here before the form is posted.
        if (_regionId is null || string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Region, email and password are all required.";
            return;
        }

        if (!_email.Contains('@'))
        {
            _error = "Enter a valid email address.";
            return;
        }

        _busy = true;

        try
        {
            // Write the current component values into the real HTML form immediately before
            // submitting it. Fluent text fields can raise their change event in the same browser
            // turn as this click, before Blazor has rendered the updated hidden inputs.
            await JSRuntime.InvokeVoidAsync(
                "companyEmployeesLogin.submit",
                "hiddenLoginForm",
                _email,
                _password,
                _regionId.Value.ToString(),
                ReturnUrl ?? string.Empty);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _busy = false;
        }
    }
}
