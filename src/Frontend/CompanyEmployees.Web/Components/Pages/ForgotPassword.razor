@page "/forgot-password"
@layout AuthLayout
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>Reset password · Siemens Leave</PageTitle>

@* ponytail: static mockup — no email is actually sent yet. Wire to real SSO/reset later.
   The GET form that used to back it only navigated to "/", which is what the button does. *@
<FluentStack Orientation="Orientation.Vertical" VerticalGap="16"
             HorizontalAlignment="HorizontalAlignment.Center" Style="padding:48px 16px;">
    <FluentCard Width="420px" Style="padding:32px;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
            <FluentLabel Typo="Typography.PaneHeader" Weight="FontWeight.Bold" Color="Color.Custom" CustomColor="var(--accent-foreground-rest)"
                         Alignment="HorizontalAlignment.Center">
                SIEMENS
            </FluentLabel>

            <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Account recovery</FluentLabel>
                <FluentLabel Typo="Typography.Header" Weight="FontWeight.Bold">Reset your password</FluentLabel>
                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                    Enter your work email and we'll send you a link to reset your password.
                </FluentLabel>
            </FluentStack>

            <FluentTextField @bind-Value="_email" Label="Work email" TextFieldType="TextFieldType.Email"
                             Placeholder="yourname@siemens.com" Autocomplete="username" Style="width:100%;" />

            <FluentButton Appearance="Appearance.Accent" Style="width:100%;"
                          OnClick="@(() => Nav.NavigateTo("/"))">
                Send reset link
            </FluentButton>

            <FluentAnchor Href="/" Appearance="Appearance.Hypertext">← Back to sign in</FluentAnchor>
        </FluentStack>
    </FluentCard>

    <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
        © 2026 Siemens AG · Privacy · Terms · Help
    </FluentLabel>
</FluentStack>

@code {
    private string _email = "";
}
