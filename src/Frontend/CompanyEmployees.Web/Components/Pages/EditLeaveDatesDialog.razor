@using CompanyEmployees.Application
@implements IDialogContentComponent<EditLeaveDatesDialog.Model>

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
        <FluentDatePicker Label="Start date" @bind-Value="Content.Start" Style="width:100%;" />
        <FluentDatePicker Label="End date" @bind-Value="Content.End" Style="width:100%;" />

        @if (Content.Error is not null)
        {
            <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">@Content.Error</FluentMessageBar>
        }
    </FluentStack>
</FluentDialogBody>

@code {
    [Parameter]
    public Model Content { get; set; } = default!;

    // Fluent runs the primary action's validation outside this component's event loop, so a
    // message written onto Content during it would never reach the screen without this.
    protected override void OnInitialized() => Content.Refresh = () => InvokeAsync(StateHasChanged);

    // Presentational only, like the other dialogs: the caller owns the save and writes any
    // failure back onto this same Content instance, which is what puts the message above.
    public class Model : DialogContentModel
    {
        public Guid RequestId { get; set; }
        public DateTime? Start { get; set; }
        public DateTime? End { get; set; }
        public string? Error { get; private set; }

        // The caller writes failures here from its ValidateDialogAsync, which runs outside
        // this component's event loop — hence the notify rather than a plain setter.
        public void SetError(string? message)
        {
            Error = message;
            NotifyChanged();
        }

        public static Model From(HrPendingRequest request) => new()
        {
            RequestId = request.RequestId,
            Start = request.StartDate.ToDateTime(TimeOnly.MinValue),
            End = request.EndDate.ToDateTime(TimeOnly.MinValue)
        };
    }
}
