<div class="greet">
    <div>
        <h1>My requests</h1>
        <p>Everything you've requested this year.</p>
    </div>
    <div class="greet-date">@Pending pending · @Approved approved</div>
</div>

<Card Eyebrow="2026" Title="All requests">
    <HeaderAction><button class="card-link" @onclick="() => OnNewRequest.InvokeAsync()">New request</button></HeaderAction>
    <ChildContent>
        @if (Requests.Count == 0)
        {
            <div class="empty">No requests yet. Use "Request time off" to create one.</div>
        }
        <RowList>
            @foreach (var r in Requests)
            {
                <RequestRow Type="@r.Type" Range="@r.Range" Days="@r.Days" Status="@r.Status"
                            Tone="@ParseTone(r.Type)" ShowDot="true"
                            OnCancel="() => OnCancel.InvokeAsync(r)" />
            }
        </RowList>
    </ChildContent>
</Card>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<RequestEntry> Requests { get; set; } = Array.Empty<RequestEntry>();
    [Parameter] public EventCallback OnNewRequest { get; set; }
    [Parameter] public EventCallback<RequestEntry> OnCancel { get; set; }

    private int Pending => Requests.Count(r => r.Status == "Pending");
    private int Approved => Requests.Count(r => r.Status == "Approved");

    private static LeaveTone ParseTone(string t) => t switch
    {
        "Sick leave"   => LeaveTone.Amber,
        "Parental"     => LeaveTone.Purple,
        "Unpaid leave" => LeaveTone.Gray,
        _              => LeaveTone.Accent,
    };

    public record RequestEntry(string Type, string Range, int Days, string Status);
}
