<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <link rel="stylesheet" href="app.css?v=3" />
    <link rel="stylesheet" href="@Assets["CompanyEmployees.Web.styles.css"]" />
    @* Fluent UI ships only a CSS reboot; the design tokens come from FluentDesignTheme. *@
    <link rel="stylesheet" href="_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <script>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('anim');</script>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <ErrorBoundary>
        <ChildContent>
            <Routes @rendermode="InteractiveServer" />
        </ChildContent>
        <ErrorContent Context="ex">
            @* Outside any layout, so it brings its own providers — otherwise the Fluent
               components here render without a theme. *@
            <CompanyEmployees.Web.Components.Employee.EmployeeProviders />
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12" Style="padding:20px;">
                <FluentLabel Typo="Typography.PaneHeader" Weight="FontWeight.Bold" Color="Color.Error">
                    CRITICAL ERROR CAUGHT
                </FluentLabel>
                <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">@ex.Message</FluentMessageBar>
                <FluentTextArea Value="@ex.StackTrace" ReadOnly="true" Rows="20" Style="width:100%;" />
            </FluentStack>
        </ErrorContent>
    </ErrorBoundary>
    <ReconnectModal />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script src="/js/culture.js"></script>
    <script src="/js/login.js"></script>
    <script src="/js/orgchart.js"></script>
    <script src="/js/pointer.js"></script>
    <script src="/js/anim.js"></script>
    @* Fluent UI's own JS is a Blazor library initializer, loaded by blazor.web.js — a
       manual script tag here would run it twice. *@
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
