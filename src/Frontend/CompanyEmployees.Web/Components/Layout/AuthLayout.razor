@* Bare layout for the pages rendered before sign-in. They still need the Fluent providers,
   but nothing of the app shell. *@
@inherits LayoutComponentBase

<CompanyEmployees.Web.Components.Employee.EmployeeProviders />

<FluentLayout>
    <FluentBodyContent>
        @Body
    </FluentBodyContent>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss"><FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" /></span>
</div>
