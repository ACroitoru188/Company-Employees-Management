@* Default layout, backing NotFound and Error only. Kept minimal on purpose: those pages
   render outside the signed-in shell, so they need the providers but none of the nav. *@
@inherits LayoutComponentBase

<CompanyEmployees.Web.Components.Employee.EmployeeProviders />

<FluentLayout>
    <FluentHeader>
        <FluentLabel Typo="Typography.PaneHeader" Color="Color.Custom" CustomColor="#FFFFFF">CompanyEmployees</FluentLabel>
    </FluentHeader>

    <FluentBodyContent Style="padding:24px;">
        @Body
    </FluentBodyContent>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
