@inherits LayoutComponentBase

@* Only the popover provider, not the whole EmployeeProviders set: MudThemeProvider would
   overwrite this layout's own palette. Needed because Dashboard.razor renders TopBar,
   which hosts the notification bell — and its MudMenu cannot open without one. *@
<MudPopoverProvider />

<div class="app">
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-mark">CE</div>
            <span class="brand-name">CompanyEmployees</span>
        </div>
        <NavMenu />
    </aside>

    <div class="main">
        <header class="topbar">
            <a class="btn-new" href="/dashboard">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M12 5v14M5 12h14" />
                </svg>
                New employee
            </a>
            <div class="avatar" title="Luca Rusu · Administrator">LR</div>
        </header>

        <main class="content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
