@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Domain.Entities
@using CompanyEmployees.Web.Security
@using CompanyEmployees.Web.Services
@inherits LayoutComponentBase
@inject ThemeState ThemeState
@inject AppLocalizer Text
@inject ActingContext Acting
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime JSRuntime
@inject IToastService Toast
@inject IDialogService DialogService
@inject LanguagePreferenceService LanguagePreferences
@inject ILogger<EmployeeLayout> Logger
@implements IDisposable

<CompanyEmployees.Web.Components.Employee.EmployeeProviders />

<FluentLayout>
    @* The bar people already look at changes colour, rather than a strip being added above
       it: an added element gets tuned out within days, a familiar one that looks wrong does
       not. This is the main guard against acting in someone's account by accident. *@
    @* The class is load-bearing, not decoration: FluentHeader's own background rule is
       `.header[b-hash]`, and app.css needs one more class than that to replace it. *@
    <FluentHeader Class="app-header" Style="@HeaderStyle">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                     HorizontalGap="12" Width="100%">
            <FluentLabel Typo="Typography.PaneHeader" Color="Color.Custom" CustomColor="#FFFFFF">SIEMENS</FluentLabel>

            @if (_acting?.IsImpersonating == true)
            {
                <FluentIcon Value="@(new Icons.Regular.Size20.ArrowSwap())" Color="Color.Custom" CustomColor="#FFFFFF" />
                <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold" Color="Color.Custom" CustomColor="#FFFFFF">
                    Acting as @_acting.EffectiveUserName
                </FluentLabel>
                @* forceLoad, and OnClick rather than Href: FluentButton has no Href parameter
                   (the attribute lands on the web component and does nothing), and the stop
                   endpoint swaps the auth cookie, which only a full document load picks up. *@
                <FluentButton Appearance="Appearance.Outline"
                              OnClick="@(() => Nav.NavigateTo("/api/auth/impersonate/stop", forceLoad: true))">
                    Return to my account
                </FluentButton>
            }
            else
            {
                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="#FFFFFF">@Text["Time Off Management"]</FluentLabel>
            }

            <FluentSpacer />
            <CompanyEmployees.Web.Components.NotificationBell />
            @* The borrowed account is already named on the left of this bar; repeating it here
               left the real person nowhere on screen. *@
            <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="#FFFFFF">@SignedInName</FluentLabel>
        </FluentStack>
    </FluentHeader>

    @* FluentLayout is a flex column, and this row defaults to `flex: 0 1 auto` with
       `align-items: start` — so it collapses to the height of the nav menu's items and the
       whole shell stops partway down the window, with blank page below it. flex:1 makes the
       row claim the space left under the header, Stretch makes the drawer and the page fill
       it, and min-height:0 lets the page scroll inside instead of pushing the row taller. *@
    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0" Width="100%"
                 VerticalAlignment="VerticalAlignment.Stretch"
                 Style="flex:1 1 auto; min-height:0;">
        <FluentNavMenu Width="250" Collapsible="true" Title="@Text["WORKSPACE"]">
            @* The links live in their own region so the drawer itself never scrolls: this is
               the part that gives way when a role has more sections than the window is tall,
               while the account footer below keeps its corner.

               Stretch is not optional here: a stack aligns its children to the start by
               default, which leaves every nav row only as wide as its own label — ragged
               edges and no full-width hover or selection band. *@
            <FluentStack Class="drawer-links" Orientation="Orientation.Vertical"
                         HorizontalAlignment="HorizontalAlignment.Stretch"
                         VerticalGap="0" Width="100%">
            <FluentNavLink Href="/employee/dashboard" Match="NavLinkMatch.All"
                           Icon="@(new Icons.Regular.Size20.Board())">@Text["Dashboard"]</FluentNavLink>
            <FluentNavLink Href="/employee/calendar" Match="NavLinkMatch.All"
                           Icon="@(new Icons.Regular.Size20.CalendarLtr())">@Text["Calendar"]</FluentNavLink>
            <FluentNavLink Href="/employee/team" Match="NavLinkMatch.All"
                           Icon="@(new Icons.Regular.Size20.People())">@Text["Team"]</FluentNavLink>
            <FluentNavLink Href="/employee/my-requests" Match="NavLinkMatch.All"
                           Icon="@(new Icons.Regular.Size20.Document())">@Text["My Requests"]</FluentNavLink>
            <FluentNavLink Href="/employee/org-chart" Match="NavLinkMatch.All"
                           Icon="@(new Icons.Regular.Size20.Organization())">@Text["Org Chart"]</FluentNavLink>

            @if (_canSeeDelegationHistory)
            {
                @* Hidden rather than shown-and-empty: for most people this page has nothing
                   in it and never will. Admins always get it — for them it is oversight of
                   the region, not their own history. *@
                <FluentNavLink Href="/manager/delegation-history" Match="NavLinkMatch.All"
                               Icon="@(new Icons.Regular.Size20.History())">@Text["Delegation History"]</FluentNavLink>
            }

            @* Flat links, not FluentNavGroups. A group is a collapsible heading over a list, and
               these had one child each — a permanently expanded "HR" heading whose only purpose
               was to hold "HR Dashboard", indented under it for no reason. The role already
               decides whether the link appears at all; a heading saying so again adds a row and
               a chevron and nothing else. *@
            @if (_department == HomeRouteResolver.HrDepartmentName)
            {
                <FluentNavLink Href="/hr/dashboard" Match="NavLinkMatch.All"
                               Icon="@(new Icons.Regular.Size20.PersonBoard())">@Text["HR Dashboard"]</FluentNavLink>
            }

            @if (_role == "LineManager")
            {
                <FluentNavLink Href="/manager/team" Match="NavLinkMatch.All"
                               Icon="@(new Icons.Regular.Size20.PeopleTeam())">@Text["Department"]</FluentNavLink>
            }

            @if (_role == "Admin")
            {
                <FluentNavLink Href="/admin/departments" Match="NavLinkMatch.All"
                               Icon="@(new Icons.Regular.Size20.Building())">@Text["Departments"]</FluentNavLink>
                <FluentNavLink Href="/admin/users" Match="NavLinkMatch.All"
                               Icon="@(new Icons.Regular.Size20.People())">@Text["Users"]</FluentNavLink>
            }

            </FluentStack>

            @* The account footer is the drawer's last flex child, so it lands in the bottom
               corner without an auto margin — which matters: an auto margin inside a scroll
               container is added to the scrollable overflow, and that is what was producing a
               scrollbar over content that already fitted. *@
            <FluentStack Class="drawer-footer" Orientation="Orientation.Vertical"
                         HorizontalAlignment="HorizontalAlignment.Stretch"
                         VerticalGap="0" Width="100%">
            <FluentDivider Role="DividerRole.Presentation" />

            @if (_acting?.IsImpersonating == true)
            {
                @* The borrowed account sits above your own, so the drawer always answers
                   "whose account am I in" without opening anything. *@
                <FluentCard Style="@($"background:{ImpersonationTint}; margin:8px;")">
                    <FluentPersona Name="@_acting.EffectiveUserName"
                                   Initials="@Initials(_acting.EffectiveUserName)"
                                   ImageSize="36px" TextPosition="TextPosition.End">
                        @* FluentPersona drops its Name whenever ChildContent is supplied, so the name is
                           rendered here explicitly above the secondary line. *@
                        <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold" Color="Color.Custom" CustomColor="#FFFFFF">@_acting.EffectiveUserName</FluentLabel>
                        <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="#FFFFFF">acting on their behalf</FluentLabel>
                    </FluentPersona>
                </FluentCard>
            }
            else if (_availableDelegations.Count > 0)
            {
                @* Switching swaps the auth cookie, which a circuit cannot do — hence a real
                   form post, the same hop the login page makes. One form per delegation with
                   its id already in the markup: filling a single shared form on click races
                   the render, and the post leaves with an empty id. *@
                @foreach (var delegation in _availableDelegations)
                {
                    <form id="@ImpersonateFormId(delegation.Id)" method="post"
                          action="/api/auth/impersonate" style="display:none;">
                        <input type="hidden" name="delegationId" value="@delegation.Id" />
                    </form>
                }

                <FluentButton Id="switch-account" Appearance="Appearance.Stealth"
                              IconStart="@(new Icons.Regular.Size20.ArrowSwap())"
                              OnClick="@(() => _switchMenuOpen = !_switchMenuOpen)">
                    Act for someone else (@_availableDelegations.Count)
                </FluentButton>
                <FluentMenu Anchor="switch-account" @bind-Open="_switchMenuOpen" VerticalThreshold="170">
                    @foreach (var delegation in _availableDelegations)
                    {
                        <FluentMenuItem OnClick="@(() => StartImpersonationAsync(delegation.Id))">
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                                <FluentLabel Typo="Typography.Body">@delegation.Manager.Name</FluentLabel>
                                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                                    until @delegation.EndDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
                                </FluentLabel>
                            </FluentStack>
                        </FluentMenuItem>
                    }
                </FluentMenu>
            }

            <FluentButton Id="profile-menu" Appearance="Appearance.Stealth"
                          OnClick="@(() => _profileMenuOpen = !_profileMenuOpen)">
                @* Your own account, under the borrowed one. Every claim in the cookie describes
                   the account being borrowed — name, role and department all belong to it — so
                   while impersonating this reads the real identity off ActingUser instead, and
                   drops the role line rather than attributing someone else's role to you. *@
                @* ImageSize stated rather than left to the default: the disc's size belongs to the
                   call site, not to a stylesheet rule that would reach every persona in the app. *@
                <FluentPersona Name="@SignedInName" Initials="@(Initials(SignedInName))"
                               ImageSize="36px" TextPosition="TextPosition.End">
                    @* FluentPersona drops its Name whenever ChildContent is supplied, so the name is
                       rendered here explicitly above the secondary line. *@
                    <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@SignedInName</FluentLabel>
                    <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                        @* HR is a department, not a UserRole — its staff are plain Employees,
                           so show the department instead. *@
                        @(_acting?.IsImpersonating == true
                            ? "your account"
                            : _department == HomeRouteResolver.HrDepartmentName ? "HR" : _role)
                    </FluentLabel>
                </FluentPersona>
            </FluentButton>
            <FluentMenu Anchor="profile-menu" @bind-Open="_profileMenuOpen" VerticalThreshold="170">
                <FluentMenuItem>
                    <FluentSwitch Value="ThemeState.IsDarkMode"
                                  ValueChanged="@(async (bool _) => await ThemeState.ToggleAsync())"
                                  Label="@Text["Dark mode"]" />
                </FluentMenuItem>
                <FluentDivider Role="DividerRole.Presentation" />
                <FluentMenuItem OnClick="OpenLanguageDialogAsync">
                    <span slot="start">
                        <FluentIcon Value="@(new Icons.Regular.Size20.LocalLanguage())" />
                    </span>
                    @Text["Language"] · @CurrentLanguageName
                </FluentMenuItem>
                <FluentDivider Role="DividerRole.Presentation" />
                <FluentMenuItem OnClick="@(() => Nav.NavigateTo("mailto:it-support@siemens.com"))">
                    <span slot="start">
                        <FluentIcon Value="@(new Icons.Regular.Size20.PersonSupport())" />
                    </span>
                    @Text["Contact IT department"]
                </FluentMenuItem>
                <FluentDivider Role="DividerRole.Presentation" />
                @* Full page load: the logout endpoint must clear the auth cookie itself. *@
                <FluentMenuItem OnClick="@(() => Nav.NavigateTo("/api/auth/logout", forceLoad: true))">
                    <span slot="start">
                        <FluentIcon Value="@(new Icons.Regular.Size20.SignOut())" Color="Color.Error" />
                    </span>
                    @Text["Sign out"]
                </FluentMenuItem>
            </FluentMenu>
            </FluentStack>
        </FluentNavMenu>

        @* flex rather than width:100%: as a flex item, 100% resolves against the whole row
           including the 250px drawer, so the page was always that much too wide and the window
           grew a horizontal scrollbar. min-width:0 lets it shrink past its content instead. *@
        <FluentBodyContent Style="padding:24px; flex:1 1 auto; min-width:0;">
            @Body
        </FluentBodyContent>
    </FluentStack>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? SwitchError { get; set; }

    // Red rather than a softer accent: this is the one state where a wrong click lands on
    // someone else's team. Material Red 700 keeps white text above the 4.5:1 contrast floor.
    private const string ImpersonationTint = "#D32F2F";

    private string _name = "";
    private string _initials = "";
    private string _role = "";
    private string _department = "";
    private string _email = "";
    private string _culture = SupportedLanguages.DefaultCulture;

    private ActingUser? _acting;
    private List<ManagerDelegation> _availableDelegations = new();
    private bool _canSeeDelegationHistory;
    private bool _switchErrorShown;
    private bool _switchMenuOpen;
    private bool _profileMenuOpen;

    private string HeaderStyle => _acting?.IsImpersonating == true
        ? $"background:{ImpersonationTint};"
        : "";

    // The person at the keyboard, which the FullName claim stops being the moment an account
    // is borrowed — from then on every claim describes the borrowed account.
    private string SignedInName => _acting?.IsImpersonating == true ? _acting.RealUserName : _name;

    // User info comes from the auth cookie's claims, never from the database:
    // the layout shares the page's scoped DbContext, and a second query in
    // flight on the same context throws. Claims are already in memory.
    protected override async Task OnInitializedAsync()
    {
        ThemeState.OnChange += StateHasChanged;

        if (AuthStateTask is null)
            return;

        var user = (await AuthStateTask).User;
        _name = user.FindFirst("FullName")?.Value ?? "";
        _role = user.FindFirst(ClaimTypes.Role)?.Value ?? "";
        _department = user.FindFirst("Department")?.Value ?? "";
        _email = user.Identity?.Name ?? "";
        _culture = SupportedLanguages.Normalize(CultureInfo.CurrentUICulture.Name);
        _initials = Initials(_name);

        _acting = await Acting.GetAsync();

        if (_acting is null)
            return;

        // The two things here that do need the database. Own scope for the same reason the
        // comment above gives; the switcher is skipped while already inside another account.
        if (!_acting.IsImpersonating)
            await LoadAvailableDelegationsAsync();

        await LoadDelegationHistoryAccessAsync();
    }

    // The impersonate endpoint can only answer with a redirect, so a refusal arrives as a
    // query string. Without this the switch just appears to do nothing. Shown once: the
    // parameter stays in the URL, and the layout is parameterised again on every render
    // pass — prerender and interactive alone would raise it twice.
    protected override void OnParametersSet()
    {
        if (SwitchError is null || _switchErrorShown)
            return;

        _switchErrorShown = true;
        Toast.ShowWarning("That delegation is no longer available.");
    }

    private async Task LoadAvailableDelegationsAsync()
    {
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var impersonation = scope.ServiceProvider.GetRequiredService<ImpersonationContext>();
            _availableDelegations = await impersonation.GetAvailableDelegationsAsync(_acting!.RealUserId);
        }
        catch (Exception ex)
        {
            // The switcher is not worth taking every page down for.
            Logger.LogWarning(ex, "Could not load delegations for user {UserId}.", _acting!.RealUserId);
            _availableDelegations = new List<ManagerDelegation>();
        }
    }

    // Asked for the account currently in use: inside a borrowed account the drawer should
    // describe that account, not the person borrowing it.
    private async Task LoadDelegationHistoryAccessAsync()
    {
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var impersonation = scope.ServiceProvider.GetRequiredService<ImpersonationContext>();
            _canSeeDelegationHistory =
                await impersonation.CanSeeDelegationHistoryAsync(_acting!.EffectiveUserId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not resolve delegation history access for {UserId}.",
                _acting!.EffectiveUserId);
            _canSeeDelegationHistory = false;
        }
    }

    private string CurrentLanguageName =>
        SupportedLanguages.All.First(language => language.Culture == _culture).NativeName;

    // Saved against the account first, then applied to this browser. The reverse order would
    // leave a reload happening while the write is still in flight, and a failed write would
    // still have changed the page.
    private async Task OpenLanguageDialogAsync()
    {
        _profileMenuOpen = false;

        var content = new LanguageDialog.Model { Culture = _culture };
        var dialog = await DialogService.ShowDialogAsync<LanguageDialog>(content, new DialogParameters
        {
            Title = Text["Language"],
            PrimaryAction = Text["Save"],
            SecondaryAction = Text["Cancel"],
            Width = "360px"
        });

        var result = await dialog.Result;
        if (result.Cancelled)
            return;

        var chosen = SupportedLanguages.Normalize(content.Culture);
        if (chosen == _culture)
            return;

        try
        {
            await LanguagePreferences.SaveAsync(_email, chosen);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not save the language preference for {Email}.", _email);
            Toast.ShowError("Your language could not be saved.");
            return;
        }

        _culture = chosen;
        // Writes the culture cookie and reloads: the translations are resolved server-side per
        // request, so the circuit has to be rebuilt for the new culture to take effect.
        await JSRuntime.InvokeVoidAsync("companyCulture.set", chosen);
    }

    private static string ImpersonateFormId(Guid delegationId) => $"impersonate-{delegationId:D}";

    private Task StartImpersonationAsync(Guid delegationId) =>
        JSRuntime.InvokeVoidAsync("eval",
            $"document.getElementById('{ImpersonateFormId(delegationId)}').submit();").AsTask();

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(part => part[0]));

    public void Dispose() => ThemeState.OnChange -= StateHasChanged;
}
