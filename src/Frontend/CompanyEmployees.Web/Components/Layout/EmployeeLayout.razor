@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Domain.Entities
@using CompanyEmployees.Web.Security
@using CompanyEmployees.Web.Services
@inherits LayoutComponentBase
@inject ThemeState ThemeState
@inject ActingContext Acting
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject ILogger<EmployeeLayout> Logger
@implements IDisposable

<CompanyEmployees.Web.Components.Employee.EmployeeProviders />

<MudLayout>
    @* The bar people already look at changes colour, rather than a strip being added above
       it: an added element gets tuned out within days, a familiar one that looks wrong does
       not. This is the main guard against acting in someone's account by accident. *@
    <MudAppBar Elevation="1" Style="@AppBarStyle">
        <MudText Typo="Typo.h6" Style="font-weight:700; letter-spacing:.06em;">SIEMENS</MudText>
        @if (_acting?.IsImpersonating == true)
        {
            <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Class="ml-4" />
            <MudText Typo="Typo.body2" Class="ml-2" Style="font-weight:600;">
                Acting as @_acting.EffectiveUserName
            </MudText>
            <MudButton Href="/api/auth/impersonate/stop" ForceLoad="true"
                       Variant="Variant.Outlined" Size="Size.Small" Class="ml-3"
                       Style="color:#fff; border-color:rgba(255,255,255,.7);">
                Return to my account
            </MudButton>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="ml-3" Style="opacity:.85;">Time Off Management</MudText>
        }
        <MudSpacer />

        <!-- Interactive notification bell in AppBar -->
        <div class="mr-4">
            <CompanyEmployees.Web.Components.NotificationBell />
        </div>

        <MudText Typo="Typo.body2" Class="ml-2">@_name</MudText>
    </MudAppBar>

    <MudDrawer Open="true" Variant="DrawerVariant.Persistent" ClipMode="DrawerClipMode.Always" Elevation="1">
        <div class="d-flex flex-column" style="height:100%;">
            <MudText Typo="Typo.overline" Class="px-4 pt-4" Style="color:var(--mud-palette-text-secondary);">
                WORKSPACE
            </MudText>
            <MudNavMenu>
                <MudNavLink Href="employee/dashboard" Match="NavLinkMatch.All"
                            Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
                <MudNavLink Href="employee/calendar" Match="NavLinkMatch.All"
                            Icon="@Icons.Material.Filled.CalendarMonth">Calendar</MudNavLink>
                <MudNavLink Href="employee/team" Match="NavLinkMatch.All"
                            Icon="@Icons.Material.Filled.Groups">Team</MudNavLink>
                <MudNavLink Href="employee/my-requests" Match="NavLinkMatch.All"
                            Icon="@Icons.Material.Filled.Description">My Requests</MudNavLink>
                <MudNavLink Href="employee/org-chart" Match="NavLinkMatch.All"
                            Icon="@Icons.Material.Filled.AccountTree">Org Chart</MudNavLink>
                @if (_department == HomeRouteResolver.HrDepartmentName)
                {
                    <MudText Typo="Typo.overline" Class="px-4 pt-4" Style="color:var(--mud-palette-text-secondary);">
                        HR
                    </MudText>
                    <MudNavLink Href="hr/dashboard" Match="NavLinkMatch.All"
                                Icon="@Icons.Material.Filled.Badge">HR Dashboard</MudNavLink>
                }
                @if (_role == "LineManager")
                {
                    <MudText Typo="Typo.overline" Class="px-4 pt-4" Style="color:var(--mud-palette-text-secondary);">
                        LineManager
                    </MudText>
                    <MudNavLink Href="manager/team" Match="NavLinkMatch.All"
                                Icon="@Icons.Material.Filled.SupervisorAccount">Department</MudNavLink>
                }
                @if (_role == "Admin")
                {
                    <MudText Typo="Typo.overline" Class="px-4 pt-4" Style="color:var(--mud-palette-text-secondary);">
                        IT ADMIN
                    </MudText>
                    <MudNavLink Href="admin/departments" Match="NavLinkMatch.All"
                                Icon="@Icons.Material.Filled.Business">Departments</MudNavLink>
                    <MudNavLink Href="admin/users" Match="NavLinkMatch.All"
                                Icon="@Icons.Material.Filled.People">Users</MudNavLink>
                }
            </MudNavMenu>
            <div class="mt-auto" style="border-top:1px solid var(--mud-palette-lines-default);">
                @if (_acting?.IsImpersonating == true)
                {
                    @* The borrowed account sits above your own, so the drawer always answers
                       "whose account am I in" without opening anything. *@
                    <div class="pa-4 d-flex align-center gap-3"
                         style="@($"background:{ImpersonationTint};")">
                        <MudAvatar Size="Size.Small" Style="@($"background:#fff; color:{ImpersonationTint};")">
                            @Initials(_acting.EffectiveUserName)
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.body2" Style="color:#fff; font-weight:600;">
                                @_acting.EffectiveUserName
                            </MudText>
                            <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,.85);">
                                acting on their behalf
                            </MudText>
                        </div>
                    </div>
                }
                else if (_availableDelegations.Count > 0)
                {
                    @* Switching swaps the auth cookie, which a circuit cannot do — hence a
                       real form post, the same hop the login page makes. One form per
                       delegation with its id already in the markup: filling a single shared
                       form on click races the render, and the post leaves with an empty id. *@
                    @foreach (var delegation in _availableDelegations)
                    {
                        <form id="@ImpersonateFormId(delegation.Id)" method="post"
                              action="/api/auth/impersonate" style="display:none;">
                            <input type="hidden" name="delegationId" value="@delegation.Id" />
                        </form>
                    }

                    <MudMenu ActivationEvent="MouseEvent.LeftClick" AnchorOrigin="Origin.TopCenter"
                             TransformOrigin="Origin.BottomCenter" FullWidth="true" Dense="true">
                        <ActivatorContent Context="switchMenu">
                            <div class="pa-3 d-flex align-center gap-2" style="cursor:pointer;"
                                 @onclick="switchMenu.ToggleAsync">
                                <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small"
                                         Style="color:var(--mud-palette-text-secondary);" />
                                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
                                    Act for someone else (@_availableDelegations.Count)
                                </MudText>
                            </div>
                        </ActivatorContent>
                        <ChildContent>
                            @foreach (var delegation in _availableDelegations)
                            {
                                <MudMenuItem OnClick="@(() => StartImpersonationAsync(delegation.Id))">
                                    <MudText Typo="Typo.body2">@delegation.Manager.Name</MudText>
                                    <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
                                        until @delegation.EndDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
                                    </MudText>
                                </MudMenuItem>
                            }
                        </ChildContent>
                    </MudMenu>
                }

                <MudMenu ActivationEvent="MouseEvent.LeftClick" AnchorOrigin="Origin.TopCenter"
                         TransformOrigin="Origin.BottomCenter" FullWidth="true" Dense="true">
                    @* Custom activator content gets no click handler from MudMenu —
                       it has to toggle the menu through the MenuContext itself. *@
                    <ActivatorContent Context="menu">
                        <div class="pa-4 d-flex align-center gap-3" style="cursor:pointer;"
                             @onclick="menu.ToggleAsync">
                            <MudAvatar Size="Size.Small" Color="Color.Primary">@_initials</MudAvatar>
                            <div>
                                <MudText Typo="Typo.body2">@_name</MudText>
                                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
                                    @* HR is a department, not a UserRole — its staff are
                                       plain Employees, so show the department instead. *@
                                    @(_department == HomeRouteResolver.HrDepartmentName ? "HR" : _role)
                                </MudText>
                            </div>
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="px-4 py-2 d-flex align-center justify-space-between gap-3" @onclick:stopPropagation="true">
                            <MudText Typo="Typo.body2">Dark mode</MudText>
                            <MudSwitch T="bool" Value="ThemeState.IsDarkMode"
                                       ValueChanged="@(async (bool _) => await ThemeState.ToggleAsync())"
                                       Color="Color.Primary" />
                        </div>
                        <MudDivider />
                        <MudMenuItem Href="mailto:it-support@siemens.com"
                                     Icon="@Icons.Material.Filled.SupportAgent">Contact IT department</MudMenuItem>
                        <MudDivider />
                        @* Full page load: the logout endpoint must clear the auth cookie itself. *@
                        <MudMenuItem Href="/api/auth/logout" ForceLoad="true"
                                     Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error">
                            <MudText Typo="Typo.body2" Color="Color.Error">Sign out</MudText>
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </div>
        </div>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? SwitchError { get; set; }

    // Red rather than a softer accent: this is the one state where a wrong click lands on
    // someone else's team. Material Red 700 keeps white text above the 4.5:1 contrast floor.
    private const string ImpersonationTint = "#D32F2F";

    private string _name = "";
    private string _initials = "";
    private string _role = "";
    private string _department = "";

    private ActingUser? _acting;
    private List<ManagerDelegation> _availableDelegations = new();

    private string AppBarStyle => _acting?.IsImpersonating == true
        ? $"color:#fff; background:{ImpersonationTint};"
        : "color:#fff;";

    // User info comes from the auth cookie's claims, never from the database:
    // the layout shares the page's scoped DbContext, and a second query in
    // flight on the same context throws. Claims are already in memory.
    protected override async Task OnInitializedAsync()
    {
        ThemeState.OnChange += StateHasChanged;

        if (AuthStateTask is null)
            return;

        var user = (await AuthStateTask).User;
        _name = user.FindFirst("FullName")?.Value ?? "";
        _role = user.FindFirst(ClaimTypes.Role)?.Value ?? "";
        _department = user.FindFirst("Department")?.Value ?? "";
        _initials = Initials(_name);

        _acting = await Acting.GetAsync();

        // The one thing here that does need the database. Own scope for the same reason the
        // comment above gives, and skipped entirely while already inside another account.
        if (_acting is not null && !_acting.IsImpersonating)
            await LoadAvailableDelegationsAsync();
    }

    // The impersonate endpoint can only answer with a redirect, so a refusal arrives as a
    // query string. Without this the switch just appears to do nothing.
    protected override void OnParametersSet()
    {
        if (SwitchError is not null)
            Snackbar.Add("That delegation is no longer available.", Severity.Warning);
    }

    private async Task LoadAvailableDelegationsAsync()
    {
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var impersonation = scope.ServiceProvider.GetRequiredService<ImpersonationContext>();
            _availableDelegations = await impersonation.GetAvailableDelegationsAsync(_acting!.RealUserId);
        }
        catch (Exception ex)
        {
            // The switcher is not worth taking every page down for.
            Logger.LogWarning(ex, "Could not load delegations for user {UserId}.", _acting!.RealUserId);
            _availableDelegations = new List<ManagerDelegation>();
        }
    }

    private static string ImpersonateFormId(Guid delegationId) => $"impersonate-{delegationId:D}";

    private Task StartImpersonationAsync(Guid delegationId) =>
        JSRuntime.InvokeVoidAsync("eval",
            $"document.getElementById('{ImpersonateFormId(delegationId)}').submit();").AsTask();

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(part => part[0]));

    public void Dispose() => ThemeState.OnChange -= StateHasChanged;
}
