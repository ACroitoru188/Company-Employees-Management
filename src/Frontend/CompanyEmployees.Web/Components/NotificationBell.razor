@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using CompanyEmployees.Domain.Entities
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Application.Notifications
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthState
@inject INotificationDispatcher Dispatcher
@inject NavigationManager Nav
@inject ILogger<NotificationBell> Logger
@implements IDisposable

<MudMenu ActivationEvent="MouseEvent.LeftClick"
         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
    @* Custom activator content gets no click handler from MudMenu —
       it has to toggle the menu through the MenuContext itself. *@
    <ActivatorContent Context="menu">
        <MudBadge Content="@_unreadCount" Color="Color.Error" Overlap="true"
                  Visible="@(_unreadCount > 0)">
            <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                           Color="Color.Inherit" OnClick="@menu.ToggleAsync" />
        </MudBadge>
    </ActivatorContent>
    <ChildContent>
        <div style="width:360px;">
            <div class="px-4 py-2 d-flex align-center justify-space-between gap-3"
                 @onclick:stopPropagation="true">
                <MudText Typo="Typo.subtitle2">Notifications</MudText>
                @if (_unreadCount > 0)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                               OnClick="MarkAllAsReadAsync">Mark all as read</MudButton>
                }
            </div>
            <MudDivider />

            @if (_notifications.Count == 0)
            {
                <div class="px-4 py-8 d-flex flex-column align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Outlined.NotificationsNone" Size="Size.Large"
                             Style="color:var(--mud-palette-text-disabled);" />
                    <MudText Typo="Typo.body2" Align="Align.Center"
                             Style="color:var(--mud-palette-text-secondary);">
                        No notifications yet.
                    </MudText>
                </div>
            }
            else
            {
                <div style="max-height:380px; overflow-y:auto;">
                    @foreach (var notification in _notifications)
                    {
                        <MudMenuItem OnClick="@(() => OpenAsync(notification))">
                            <NotificationRow Notification="@notification" RelativeTime="true" />
                        </MudMenuItem>
                    }
                </div>

                @* The history page is deliberately absent from the drawer nav, so this is
                   the only way in. *@
                <MudDivider />
                <MudMenuItem Href="/employee/notifications">
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Primary">
                        See all notifications
                    </MudText>
                </MudMenuItem>
            }
        </div>
    </ChildContent>
</MudMenu>

@code {
    private const int VisibleCount = 8;

    private Guid _currentUserId;
    private List<Notification> _notifications = new();
    private int _unreadCount;
    private IDisposable? _subscription;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userIdString = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!Guid.TryParse(userIdString, out _currentUserId))
            return;

        // Subscribe before the first read: anything saved in between would otherwise reach
        // neither, and stay invisible until reload.
        _subscription = Dispatcher.Subscribe(_currentUserId, OnNotificationChangeAsync);

        await ReloadAsync();
    }

    // The dispatcher calls this from the thread that saved the change, not this circuit —
    // so every field the render reads is touched inside InvokeAsync.
    private Task OnNotificationChangeAsync(NotificationChange change) =>
        InvokeAsync(async () =>
        {
            if (change.Created is null)
            {
                await ReloadAsync();
            }
            else
            {
                _notifications.Insert(0, change.Created);
                if (_notifications.Count > VisibleCount)
                    _notifications.RemoveAt(_notifications.Count - 1);

                _unreadCount++;
            }

            StateHasChanged();
        });

    // Own scope for every query: this component shares the layout's scoped DbContext with
    // the page, and a second query in flight on it throws.
    private async Task ReloadAsync()
    {
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var context = scope.ServiceProvider.GetRequiredService<NotificationContext>();

            _notifications = await context.GetRecentAsync(_currentUserId, VisibleCount);
            _unreadCount = await context.GetUnreadCountAsync(_currentUserId);
        }
        catch (Exception ex)
        {
            // This lives in the layout, so an escaping exception replaces every page under
            // it with the error screen. An empty bell is the better failure mode.
            Logger.LogWarning(ex, "Could not load notifications for user {UserId}.", _currentUserId);
            _notifications = new List<Notification>();
            _unreadCount = 0;
        }
    }

    // Clicking a notification is the only thing that marks it read — MudMenu owns closing,
    // so a stray click outside can no longer clear the list.
    private async Task OpenAsync(Notification notification)
    {
        if (!notification.IsRead)
            await RunAsync(context => context.MarkAsReadAsync(_currentUserId, notification.Id));

        if (!string.IsNullOrWhiteSpace(notification.ActionUrl))
            Nav.NavigateTo(notification.ActionUrl);
    }

    private Task MarkAllAsReadAsync() =>
        RunAsync(context => context.MarkAllAsReadAsync(_currentUserId));

    // Both writes publish a read-state change that comes back through
    // OnNotificationChangeAsync, so there is no local count here to drift from the database.
    private async Task RunAsync(Func<NotificationContext, Task> action)
    {
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var context = scope.ServiceProvider.GetRequiredService<NotificationContext>();
            await action(context);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not update notifications for user {UserId}.", _currentUserId);
        }
    }

    public void Dispose() => _subscription?.Dispose();
}
