@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using CompanyEmployees.Domain.Entities
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Application.Notifications
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthState
@inject INotificationDispatcher Dispatcher
@inject IMessageService Messages
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ILogger<NotificationBell> Logger
@implements IDisposable

@* Same trap as the bell below, one step ahead of it: an accent badge on the accent-blue app bar
   is blue on blue. Fill is the neutral surface colour in either theme, with the accent as the
   number on it. *@
<FluentCounterBadge Count="@_unreadCount" Max="99"
                    BackgroundColor="Color.Fill" Color="Color.Accent"
                    ShowWhen="@(count => count > 0)">
    @* White, stated: the bell sits on the accent-blue app bar, and an icon left to its default
       takes the accent colour — blue on blue. It only ever showed because a stealth button used
       to paint a pale box behind it, which is not a colour choice, it is an accident. Everything
       else in this bar names #FFFFFF the same way. *@
    <FluentButton Id="notification-bell" Appearance="Appearance.Stealth"
                  IconStart="@(new Icons.Regular.Size20.Alert().WithColor("#FFFFFF"))"
                  OnClick="@(() => _open = !_open)" Title="Notifications" />
</FluentCounterBadge>

<FluentPopover AnchorId="notification-bell" @bind-Open="_open"
               FixedPlacement="true" VerticalThreshold="320" Style="width: 380px;">
    <Header>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                     HorizontalGap="8" Width="100%">
            <FluentLabel Typo="Typography.Header">Notifications</FluentLabel>
            <FluentSpacer />
            @if (_unreadCount > 0)
            {
                <FluentButton Appearance="Appearance.Stealth" OnClick="MarkAllAsReadAsync">
                    Mark all as read
                </FluentButton>
            }
        </FluentStack>
    </Header>
    <Body>
        @if (HasNotifications)
        {
            @* Fluent's own notification centre. It draws the card, the relative time and the
               dismiss control; this component only keeps its list in step with the database. *@
            <FluentMessageBarProvider Section="@MessageSections.NotificationCenter"
                                      Type="MessageType.Notification"
                                      MaxMessageCount="0"
                                      NewestOnTop="true"
                                      ClearAfterNavigation="false"
                                      Class="notification-center" />
        }
        else
        {
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8"
                         HorizontalAlignment="HorizontalAlignment.Center">
                <FluentIcon Value="@(new Icons.Regular.Size24.CheckmarkCircle())"
                            Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" />
                <FluentLabel Typo="Typography.Body" Color="Color.Custom"
                             CustomColor="var(--neutral-foreground-hint)">
                    You are all caught up.
                </FluentLabel>
            </FluentStack>
        }
    </Body>
    <Footer>
        @* A panel rather than a page: the full list opens over whatever you were doing and
           scrolls, and closing it leaves you where you were. It is also the only way to reach
           notifications already read, since the centre above holds unread ones only. *@
        <FluentButton Appearance="Appearance.Lightweight" OnClick="OpenAllAsync">
            See all notifications
        </FluentButton>
    </Footer>
</FluentPopover>

@code {
    // The centre is an unread inbox: dismissing a card is what marks it read, so anything
    // already read lives on the history page rather than here.
    private const int VisibleCount = 8;

    // NotificationContext has no unread-only query and adding one would change the
    // Application layer for a presentation detail, so a window of recent rows is filtered
    // here instead. The badge still counts every unread row in the database.
    private const int RecentWindow = 50;

    private Guid _currentUserId;
    private int _unreadCount;
    private bool _open;
    private IDisposable? _subscription;

    // Ids currently in the centre, so a reload landing on top of a live insert can't show the
    // same notification twice.
    private readonly HashSet<Guid> _shown = new();

    // Asked of the service rather than of _shown: dismissing a card removes it from the
    // service straight away, and this component only hears about it on the reload that follows.
    private bool HasNotifications => Messages.Count(MessageSections.NotificationCenter) > 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userIdString = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!Guid.TryParse(userIdString, out _currentUserId))
            return;

        // Subscribe before the first read: anything saved in between would otherwise reach
        // neither, and stay invisible until reload.
        _subscription = Dispatcher.Subscribe(_currentUserId, OnNotificationChangeAsync);

        await ReloadAsync();
    }

    // The dispatcher calls this from the thread that saved the change, not this circuit —
    // so every field the render reads is touched inside InvokeAsync.
    private Task OnNotificationChangeAsync(NotificationChange change) =>
        InvokeAsync(async () =>
        {
            if (change.Created is null)
                await ReloadAsync();
            else
                Show(change.Created, countAsUnread: true);

            StateHasChanged();
        });

    // Own scope for every query: this component shares the layout's scoped DbContext with
    // the page, and a second query in flight on it throws.
    private async Task ReloadAsync()
    {
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var context = scope.ServiceProvider.GetRequiredService<NotificationContext>();

            var recent = await context.GetRecentAsync(_currentUserId, RecentWindow);
            _unreadCount = await context.GetUnreadCountAsync(_currentUserId);

            ResetCenter();

            // Oldest first: the provider shows a section newest-on-top, which is the reverse
            // of the order the messages were added in.
            foreach (var notification in recent.Where(n => !n.IsRead).Take(VisibleCount).Reverse())
                Show(notification, countAsUnread: false);
        }
        catch (Exception ex)
        {
            // This lives in the layout, so an escaping exception replaces every page under
            // it with the error screen. An empty bell is the better failure mode.
            Logger.LogWarning(ex, "Could not load notifications for user {UserId}.", _currentUserId);
            ResetCenter();
            _unreadCount = 0;
        }
    }

    // Clear() detaches the messages without raising their OnClose; Remove() would, and would
    // mark every card read on the way past.
    private void ResetCenter()
    {
        Messages.Clear(MessageSections.NotificationCenter);
        _shown.Clear();
    }

    private void Show(Notification notification, bool countAsUnread)
    {
        if (!_shown.Add(notification.Id))
            return;

        if (countAsUnread)
            _unreadCount++;

        Messages.ShowMessageBar(options =>
        {
            options.Section = MessageSections.NotificationCenter;
            options.Intent = MessageIntent.Info;
            options.Title = TitleFor(notification);
            options.Body = notification.Message;

            // Rendered as "5 minutes ago" against DateTime.Now, so it has to be local time;
            // the column is UTC.
            options.Timestamp = notification.CreatedAt.ToLocalTime();

            // Opening one navigates, and the centre has to survive that.
            options.ClearAfterNavigation = false;

            // Dismissing the card is the acknowledgement.
            options.OnClose = _ => MarkAsReadAsync(notification);

            if (!string.IsNullOrWhiteSpace(notification.ActionUrl))
            {
                options.PrimaryAction = new ActionButton<Message>
                {
                    Text = "View",
                    OnClick = _ => OpenAsync(notification)
                };
            }
        });
    }

    // The card has no title of its own to show, and the heading line is single-line: the
    // destination is the one short, reliable label the stored row carries.
    private static string TitleFor(Notification notification)
    {
        var actionUrl = notification.ActionUrl ?? string.Empty;

        if (actionUrl.StartsWith("/employee/my-requests", StringComparison.Ordinal))
            return "Leave request";
        if (actionUrl.StartsWith("/employee/profile", StringComparison.Ordinal))
            return "Contract";
        if (actionUrl.StartsWith("/manager", StringComparison.Ordinal))
            return "Delegation";

        return "Notification";
    }

    private async Task OpenAsync(Notification notification)
    {
        _open = false;
        await MarkAsReadAsync(notification);
        Nav.NavigateTo(notification.ActionUrl!);
    }

    private async Task OpenAllAsync()
    {
        _open = false;

        await DialogService.ShowPanelAsync<NotificationsPanel>(
            new NotificationsPanel.Model { UserId = _currentUserId },
            new DialogParameters
            {
                Title = "Notifications",
                Alignment = HorizontalAlignment.Right,
                Width = "440px",
                PrimaryAction = null,
                SecondaryAction = null,
                ShowDismiss = true
            });
    }

    private Task MarkAsReadAsync(Notification notification) =>
        RunAsync(context => context.MarkAsReadAsync(_currentUserId, notification.Id));

    private Task MarkAllAsReadAsync() =>
        RunAsync(context => context.MarkAllAsReadAsync(_currentUserId));

    // Both writes publish a read-state change that comes back through
    // OnNotificationChangeAsync, so there is no local count here to drift from the database.
    private async Task RunAsync(Func<NotificationContext, Task> action)
    {
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var context = scope.ServiceProvider.GetRequiredService<NotificationContext>();
            await action(context);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not update notifications for user {UserId}.", _currentUserId);
        }
    }

    public void Dispose()
    {
        _subscription?.Dispose();

        // The service outlives this component within the circuit; leaving the section filled
        // would double the list if the layout is rebuilt.
        Messages.Clear(MessageSections.NotificationCenter);
    }
}
