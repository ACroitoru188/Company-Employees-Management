<aside class="sidebar">
    <div class="sb-brand">
        <div class="brand-sq"><div></div></div>
        <span class="brand-word">SIEMENS</span>
    </div>
    <nav class="sb-links">
        <SidebarLink ViewName="dashboard" ActiveView="@ActiveView" Label="Dashboard" OnClick="OnGoDashboard">
            <Icon>
                <svg class="sb-icon" width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2.5" y="2.5" width="6.5" height="6.5" rx="1" /><rect x="11" y="2.5" width="6.5" height="6.5" rx="1" />
                    <rect x="2.5" y="11" width="6.5" height="6.5" rx="1" /><rect x="11" y="11" width="6.5" height="6.5" rx="1" />
                </svg>
            </Icon>
        </SidebarLink>

        <SidebarLink ViewName="requests" ActiveView="@ActiveView" Label="@RequestsNavLabel" OnClick="OnGoRequests" Badge="@RequestsBadge">
            <Icon>
                <svg class="sb-icon" width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 2.5h7l3 3v12h-10z" /><path d="M12 2.5v3h3" /><path d="M7 10.5h6M7 13.5h6" />
                </svg>
            </Icon>
        </SidebarLink>

        <SidebarLink ViewName="calendar" ActiveView="@ActiveView" Label="Calendar" OnClick="OnGoCalendar">
            <Icon>
                <svg class="sb-icon" width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2.5" y="4" width="15" height="13.5" rx="1.5" /><path d="M2.5 8h15" /><path d="M6.5 2v4M13.5 2v4" />
                </svg>
            </Icon>
        </SidebarLink>

        <SidebarLink ViewName="team" ActiveView="@ActiveView" Label="Team">
            <Icon>
                <svg class="sb-icon" width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="7" cy="6.5" r="2.75" /><path d="M2.5 17v-1.5a4 4 0 0 1 4-4h1a4 4 0 0 1 4 4V17" />
                    <circle cx="14.5" cy="7.5" r="2.25" /><path d="M13 11.2a3.3 3.3 0 0 1 4.5 3.1V17" />
                </svg>
            </Icon>
        </SidebarLink>

        <SidebarLink ViewName="reports" ActiveView="@ActiveView" Label="Reports">
            <Icon>
                <svg class="sb-icon" width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 17V8M9.5 17V3M16 17v-6" />
                </svg>
            </Icon>
        </SidebarLink>
    </nav>
</aside>

@code {
    [Parameter, EditorRequired] public string ActiveView { get; set; } = "dashboard";
    [Parameter] public bool IsManager { get; set; }
    [Parameter] public int PendingCount { get; set; }
    [Parameter, EditorRequired] public string RequestsNavLabel { get; set; } = "";

    [Parameter] public EventCallback OnGoDashboard { get; set; }
    [Parameter] public EventCallback OnGoRequests { get; set; }
    [Parameter] public EventCallback OnGoCalendar { get; set; }

    private int? RequestsBadge => IsManager && PendingCount > 0 ? PendingCount : null;
}
