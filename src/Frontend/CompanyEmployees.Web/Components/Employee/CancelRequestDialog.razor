@* Fluent dialogs render only their body; the title and the two buttons come from the
   DialogParameters the caller passes. State travels on the Content object, which the caller
   reads back after a non-cancelled result. Mirrors TerminateContractDialog. *@
@using System.Globalization
@inject AppLocalizer Text
@implements IDialogContentComponent<CancelRequestDialog.Model>

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <FluentLabel Typo="Typography.Body">
            @Text.Format("Withdraw your {0} request for {1}–{2}?",
                Text[Content.Type.ToString()], Content.StartDate.ToString("MMM d", CultureInfo.CurrentCulture),
                Content.EndDate.ToString("MMM d, yyyy", CultureInfo.CurrentCulture))
        </FluentLabel>

        <FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">
            @Text["Only requests nobody has approved yet can be cancelled. This cannot be undone."]
        </FluentMessageBar>

        <FluentTextArea @bind-Value="Content.Reason"
                        Label="@Text["Reason for cancelling (optional)"]"
                        Placeholder="@Text["Let your manager know why...."]"
                        Rows="3"
                        Style="width:100%;" />
    </FluentStack>
</FluentDialogBody>

@code {
    [Parameter]
    public Model Content { get; set; } = default!;

    public class Model
    {
        public Guid RequestId { get; set; }
        public LeaveType Type { get; set; }
        public DateOnly StartDate { get; set; }
        public DateOnly EndDate { get; set; }
        public string Reason { get; set; } = "";
    }
}
