@using System.Globalization
@implements IDialogContentComponent<ExtendContractDialog.Model>

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <FluentLabel Typo="Typography.Body">
            Extend fixed-term contract for <strong>@Content.EmployeeName</strong>.
        </FluentLabel>

        <FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">
            Current period:
            @Content.CurrentStartDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) –
            @(Content.CurrentEndDate?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "Indefinite")
        </FluentMessageBar>

        <FluentDatePicker Label="New end date"
                          Value="@Content.NewEndDate"
                          ValueChanged="@OnDateChanged"
                          Min="@Content.MinDate"
                          Required="true"
                          Style="width:100%;" />

        @if (!string.IsNullOrEmpty(Content.ErrorMessage))
        {
            <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
                @Content.ErrorMessage
            </FluentMessageBar>
        }
    </FluentStack>
</FluentDialogBody>

@code {
    [Parameter]
    public Model Content { get; set; } = default!;

    // Fluent runs the primary action's validation outside this component's event loop, so a
    // message written onto Content during it would never reach the screen without this.
    protected override void OnInitialized() => Content.Refresh = () => InvokeAsync(StateHasChanged);

    private void OnDateChanged(DateTime? date)
    {
        Content.NewEndDate = date;
        Content.Validate();
    }

    public class Model : DialogContentModel
    {
        public string EmployeeName { get; set; } = "";
        public DateOnly CurrentStartDate { get; set; }
        public DateOnly? CurrentEndDate { get; set; }

        public DateTime? NewEndDate { get; set; }
        public DateTime? MinDate { get; set; }
        public string ErrorMessage { get; set; } = "";

        // The caller builds the model, so the defaults are derived here rather than in an
        // OnInitialized the dialog would have to own.
        public void Initialise()
        {
            var min = CurrentEndDate?.ToDateTime(TimeOnly.MinValue).AddDays(1)
                      ?? CurrentStartDate.ToDateTime(TimeOnly.MinValue).AddDays(1);
            MinDate = min;
            NewEndDate = min.AddMonths(6);
        }

        public bool IsValid => NewEndDate.HasValue && (MinDate is null || NewEndDate >= MinDate);

        public void Validate()
        {
            ErrorMessage = NewEndDate switch
            {
                null => "Please select a valid new end date.",
                _ when MinDate.HasValue && NewEndDate < MinDate =>
                    "New end date must be strictly after the current end date.",
                _ => ""
            };

            NotifyChanged();
        }

        public DateOnly SelectedDate => DateOnly.FromDateTime(NewEndDate!.Value);
    }
}
