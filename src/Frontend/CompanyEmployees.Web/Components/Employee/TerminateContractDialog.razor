@* Fluent dialogs render only their body; the title and the two buttons come from the
   DialogParameters the caller passes. State travels on the Content object, which the caller
   reads back after a non-cancelled result. *@
@implements IDialogContentComponent<TerminateContractDialog.Model>

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <FluentLabel Typo="Typography.Body">
            Are you sure you want to terminate the contract for <strong>@Content.EmployeeName</strong>?
        </FluentLabel>

        <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
            This action marks the contract as Terminated and cannot be undone.
        </FluentMessageBar>

        <FluentTextArea @bind-Value="Content.Reason"
                        Label="Termination reason (optional)"
                        Placeholder="Provide reason or context for termination..."
                        Rows="3"
                        Style="width:100%;" />
    </FluentStack>
</FluentDialogBody>

@code {
    [Parameter]
    public Model Content { get; set; } = default!;

    public class Model
    {
        public string EmployeeName { get; set; } = "";
        public string Reason { get; set; } = "";
    }
}
