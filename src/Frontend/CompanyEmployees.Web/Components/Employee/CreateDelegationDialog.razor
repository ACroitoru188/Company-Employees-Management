@* Fluent dialogs render only their body; the title and the two buttons come from the
   DialogParameters the caller passes. State travels on the Content object, which the caller
   reads back after a non-cancelled result. *@
@using CompanyEmployees.Domain.Entities
@using System.Globalization
@implements IDialogContentComponent<CreateDelegationDialog.Model>

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
            @(string.IsNullOrWhiteSpace(Content.Intro)
                ? "Temporarily delegate your manager approval rights and contract management duties to a colleague."
                : Content.Intro)
        </FluentLabel>

        @* SelectedOption is bound, not just its change event: without it the select shows the
           first colleague as though it were chosen while SelectedDelegateId is still null, and
           the primary action then refuses to close with nothing selected. *@
        <FluentSelect TOption="User"
                      Label="Delegate to (colleague)"
                      Placeholder="Choose a colleague..."
                      Items="@Content.AvailableUsers"
                      OptionValue="@(u => u.Id.ToString())"
                      OptionText="@(u => $"{u.Name} ({u.Role} - {u.Department?.Name ?? "No dept"})")"
                      SelectedOption="@Content.SelectedDelegate"
                      SelectedOptionChanged="@(u => Content.SelectedDelegateId = u?.Id)"
                      Style="width:100%;" />

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
            <FluentDatePicker Label="Start date" @bind-Value="Content.StartDate" Style="width:100%;" />
            <FluentDatePicker Label="End date" @bind-Value="Content.EndDate" Style="width:100%;" />
        </FluentStack>

        <FluentTextArea @bind-Value="Content.Reason"
                        Label="Reason (e.g. annual leave)"
                        Placeholder="Explain why you are delegating..."
                        Rows="2"
                        Style="width:100%;" />

        @if (!string.IsNullOrEmpty(Content.ErrorMessage))
        {
            <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
                @Content.ErrorMessage
            </FluentMessageBar>
        }
    </FluentStack>
</FluentDialogBody>

@code {
    [Parameter]
    public Model Content { get; set; } = default!;

    // Fluent runs the primary action's validation outside this component's event loop, so a
    // message written onto Content during it would never reach the screen without this.
    protected override void OnInitialized() => Content.Refresh = () => InvokeAsync(StateHasChanged);

    public class Model : DialogContentModel
    {
        public List<User> AvailableUsers { get; set; } = [];

        // Set when the dialog opens out of a leave request: the dates arrive filled in with
        // the leave period, but stay editable so a shorter handover is possible.
        public DateTime? StartDate { get; set; } = DateTime.Today;
        public DateTime? EndDate { get; set; } = DateTime.Today.AddDays(7);
        public string? Intro { get; set; }

        public Guid? SelectedDelegateId { get; set; }
        public string Reason { get; set; } = "";
        public string ErrorMessage { get; set; } = "";

        public User? SelectedDelegate =>
            AvailableUsers.FirstOrDefault(user => user.Id == SelectedDelegateId);

        public bool IsValid =>
            SelectedDelegateId.HasValue && StartDate.HasValue && EndDate.HasValue && EndDate >= StartDate;

        // Called from the caller's ValidateDialogAsync. Returning false alone would keep the
        // dialog open with no explanation, which reads as a dead button — so the reason is
        // written where the body already renders it.
        public bool Validate()
        {
            ErrorMessage = !SelectedDelegateId.HasValue
                ? "Choose the colleague who will act for you."
                : !StartDate.HasValue || !EndDate.HasValue
                    ? "Both dates are required."
                    : EndDate < StartDate
                        ? "The end date cannot be before the start date."
                        : "";

            NotifyChanged();
            return ErrorMessage.Length == 0;
        }

        // The caller turns a confirmed dialog into this before handing it to ManagerContext.
        public DelegationResult ToResult() => new(
            SelectedDelegateId!.Value,
            DateOnly.FromDateTime(StartDate!.Value),
            DateOnly.FromDateTime(EndDate!.Value),
            string.IsNullOrWhiteSpace(Reason) ? null : Reason);
    }

    public record DelegationResult(Guid DelegateId, DateOnly StartDate, DateOnly EndDate, string? Reason);
}
