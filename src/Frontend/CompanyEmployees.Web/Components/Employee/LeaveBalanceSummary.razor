@using System.Globalization
@using CompanyEmployees.Web.Services
@inject ThemeState ThemeState
@inject AppLocalizer Text

<FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
             HorizontalGap="16" Wrap="true" Width="100%">
    @* Width="auto" is what keeps the page action on the same line as the greeting. A vertical
       FluentStack writes `width: 100%` inline unless told otherwise, so this block claimed the
       whole row and pushed the spacer and the button onto a second line — the button ended up
       floating in the gap above the cards, aligned to nothing. *@
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="2" Width="auto">
        <FluentLabel Typo="Typography.PaneHeader" Weight="FontWeight.Bold">@Text.Format("Good morning, {0}", FirstName)</FluentLabel>
        <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">@Subtitle</FluentLabel>
    </FluentStack>
    <FluentSpacer />
    @if (Actions is not null)
    {
        @Actions
    }
</FluentStack>

<FluentGrid Spacing="3" Style="margin-top:16px;">
    @foreach (var balance in Balances)
    {
        <FluentGridItem xs="12" sm="6" md="3">
            <FluentCard>
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                    <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-overline">
                        @Text[balance.Type.ToString()].ToUpper(CultureInfo.CurrentCulture)
                    </FluentLabel>

                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4"
                                 VerticalAlignment="VerticalAlignment.Bottom">
                        <FluentLabel Typo="Typography.PageTitle" Weight="FontWeight.Bold">@balance.Remaining</FluentLabel>
                        <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-caption">
                            / @Text.Format("{0} days", balance.BaseDays)
                        </FluentLabel>
                        @if (balance.CarriedOverDays > 0)
                        {
                            <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--success)" Class="app-caption">
                                + @Text.Format("{0} days", balance.CarriedOverDays)
                            </FluentLabel>
                            <FluentTooltip Anchor="@($"carry-over-{balance.Type}")">
                                @Text.Format("{0} days carried over from last year; unused days expire on {1}", balance.CarriedOverDays, balance.CarryOverExpiryDate?.ToString("d", CultureInfo.CurrentCulture))
                            </FluentTooltip>
                            <FluentIcon Id="@($"carry-over-{balance.Type}")" Value="@(new Icons.Regular.Size16.Info())"
                                        Color="Color.Neutral" />
                        }
                        @if (balance.ExpiredCarriedOverDays > 0)
                        {
                            <FluentLabel Typo="Typography.Body" Color="Color.Error" Class="app-caption">
                                - @Text.Format("{0} expired", balance.ExpiredCarriedOverDays)
                            </FluentLabel>
                        }
                    </FluentStack>

                    @* The leave-type colour is per category, which Fluent's single-accent
                       palette has no slot for — hence the local custom colour. *@
                    <FluentProgress Min="0" Max="@balance.EffectiveDaysTotal" Value="@balance.Remaining"
                                    Stroke="ProgressStroke.Normal"
                                    Style="@($"--accent-fill-rest:{LeaveTypePalette.Hex(balance.Type, ThemeState.IsDarkMode)};")" />

                    <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-caption">
                        @Text.Format("{0} used this year", balance.DaysUsed)
                    </FluentLabel>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
    }
</FluentGrid>

@code {
    [Parameter, EditorRequired] public string UserName { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<LeaveBalance> Balances { get; set; } = [];
    [Parameter] public RenderFragment? Actions { get; set; }

    private string FirstName => UserName.Split(' ')[0];

    private string Subtitle
    {
        get
        {
            var d = DateTime.Today;
            // The long date follows the chosen language too — an English weekday next to a
            // translated week label reads like a bug.
            return $"{d.ToString("D", CultureInfo.CurrentCulture)} · {Text.Format("Week {0}", ISOWeek.GetWeekOfYear(d))}";
        }
    }
}
