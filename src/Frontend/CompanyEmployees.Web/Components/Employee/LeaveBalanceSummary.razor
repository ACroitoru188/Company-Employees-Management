@using System.Globalization
@using CompanyEmployees.Web.Services
@inject ThemeState ThemeState
@inject AppLocalizer Text

<div class="d-flex align-center justify-space-between flex-wrap gap-4 mb-4">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:600;">@Text.Format("Good morning, {0}", FirstName)</MudText>
        <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">@Subtitle</MudText>
    </div>
    @if (Actions is not null)
    {
        <div>@Actions</div>
    }
</div>

<MudGrid Spacing="3">
    @foreach (var balance in Balances)
    {
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Style="color:var(--mud-palette-text-secondary); letter-spacing:.08em;">
                        @Text[balance.Type.ToString()].ToUpper(CultureInfo.CurrentCulture)
                    </MudText>
                    <div class="d-flex align-baseline gap-1 mb-2">
                        <MudText Typo="Typo.h4" Style="font-weight:700;">@balance.Remaining</MudText>
                        <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">
                            / @Text.Format("{0} days", balance.BaseDays)
                        </MudText>
                        @if (balance.CarriedOverDays > 0)
                        {
                            <MudText Typo="Typo.body2" Style="color:var(--mud-palette-success); font-weight:600;">
                                + @Text.Format("{0} days", balance.CarriedOverDays)
                            </MudText>
                            <MudTooltip Text="@Text.Format("{0} days carried over from last year; unused days expire on {1}", balance.CarriedOverDays, balance.CarryOverExpiryDate?.ToString("d", CultureInfo.CurrentCulture))">
                                <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small"
                                         Style="color:var(--mud-palette-text-secondary); vertical-align:middle;" />
                            </MudTooltip>
                        }
                        @if (balance.ExpiredCarriedOverDays > 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Error" Style="font-weight:600;">
                                - @Text.Format("{0} expired", balance.ExpiredCarriedOverDays)
                            </MudText>
                        }
                    </div>
                    <MudProgressLinear Value="@(balance.EffectiveDaysTotal == 0 ? 0 : 100.0 * balance.Remaining / balance.EffectiveDaysTotal)"
                                       Color="Color.Primary" Rounded="true" Size="Size.Small" Class="mb-2"
                                       Style="@($"--mud-palette-primary:{LeaveTypePalette.Hex(balance.Type, ThemeState.IsDarkMode)};")" />
                    <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
                        @Text.Format("{0} used this year", balance.DaysUsed)
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    [Parameter, EditorRequired] public string UserName { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<LeaveBalance> Balances { get; set; } = [];
    [Parameter] public RenderFragment? Actions { get; set; }

    private string FirstName => UserName.Split(' ')[0];

    private string Subtitle
    {
        get
        {
            var d = DateTime.Today;
            return $"{d.ToString("D", CultureInfo.CurrentCulture)} · {Text.Format("Week {0}", ISOWeek.GetWeekOfYear(d))}";
        }
    }
}
