@using System.Globalization
@using CompanyEmployees.Web.Services
@inject AppLocalizer Text
@implements IDialogContentComponent<TimeOffRequest>

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8"
                     VerticalAlignment="VerticalAlignment.Center">
            @* Per-category colour, which Fluent's single-accent palette has no slot for. *@
            <FluentBadge Fill="highlight"
                         BackgroundColor="@LeaveTypePalette.Hex(Content.Type)"
                         Color="white">
                @Text[Content.Type.ToString()]
            </FluentBadge>
            <FluentBadge Fill="highlight" BackgroundColor="@StatusColor(Content.Status)" Color="white">
                @Text[Content.Status.ToString()]
            </FluentBadge>
        </FluentStack>

        <FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">
            @Content.StartDate.ToString("MMM d", CultureInfo.CurrentCulture) –
            @Content.EndDate.ToString("MMM d, yyyy", CultureInfo.CurrentCulture)
            (@Content.Days @Text[Content.Days == 1 ? "day" : "days"])
        </FluentLabel>

        <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
            <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">@Text["Reason"]</FluentLabel>
            <FluentLabel Typo="Typography.Body">
                @(string.IsNullOrWhiteSpace(Content.Reason) ? "—" : Content.Reason)
            </FluentLabel>
        </FluentStack>

        <FluentDivider Role="DividerRole.Presentation" />

        <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
            @Text.Format("Submitted {0}", Content.SubmittedAt.ToString("MMM d, yyyy HH:mm", CultureInfo.CurrentCulture))
        </FluentLabel>

        @if (Content.Status is RequestStatus.Approved or RequestStatus.Rejected)
        {
            <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                @Text.Format("Decided by {0}{1}", Content.DecidedBy ?? "—", Content.DecidedAt is { } decided
                    ? $" · {decided.ToString("MMM d, yyyy HH:mm", CultureInfo.CurrentCulture)}" : "")
            </FluentLabel>
        }
    </FluentStack>
</FluentDialogBody>

@code {
    [Parameter]
    public TimeOffRequest Content { get; set; } = default!;

    private static string StatusColor(RequestStatus status) => status switch
    {
        RequestStatus.Approved => "var(--success)",
        RequestStatus.Rejected => "var(--error)",
        _ => "var(--warning)"
    };
}
