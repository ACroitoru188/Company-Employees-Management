@using CompanyEmployees.Domain.Entities
@using CompanyEmployees.Domain.Enums
@using System.Globalization
@implements IDialogContentComponent<EditContractDialog.Model>

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <FluentLabel Typo="Typography.Body">
            Manage contract details for <strong>@Content.UserName</strong>
        </FluentLabel>

        <FluentSelect TOption="ContractType"
                      Label="Contract type"
                      Items="@ContractTypes"
                      OptionValue="@(t => t.ToString())"
                      OptionText="@(t => t.ToString())"
                      SelectedOption="@Content.Type"
                      SelectedOptionChanged="@(t => Content.Type = t)"
                      Style="width:100%;" />

        <FluentSelect TOption="ContractStatus"
                      Label="Contract status"
                      Items="@ContractStatuses"
                      OptionValue="@(s => s.ToString())"
                      OptionText="@(s => s.ToString())"
                      SelectedOption="@Content.Status"
                      SelectedOptionChanged="@(s => Content.Status = s)"
                      Style="width:100%;" />

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
            <FluentDatePicker Label="Start date" @bind-Value="Content.StartDate" Style="width:100%;" />
            @if (Content.Type == ContractType.Determinate)
            {
                <FluentDatePicker Label="End date" @bind-Value="Content.EndDate" Style="width:100%;" />
            }
        </FluentStack>

        <FluentTextArea @bind-Value="Content.Notes"
                        Label="Notes / details"
                        Placeholder="Contract reference, remarks..."
                        Rows="2"
                        Style="width:100%;" />

        @if (!string.IsNullOrEmpty(Content.ErrorMessage))
        {
            <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
                @Content.ErrorMessage
            </FluentMessageBar>
        }
    </FluentStack>
</FluentDialogBody>

@code {
    [Parameter]
    public Model Content { get; set; } = default!;

    // Fluent runs the primary action's validation outside this component's event loop, so a
    // message written onto Content during it would never reach the screen without this.
    protected override void OnInitialized() => Content.Refresh = () => InvokeAsync(StateHasChanged);

    private static readonly ContractType[] ContractTypes = Enum.GetValues<ContractType>();
    private static readonly ContractStatus[] ContractStatuses = Enum.GetValues<ContractStatus>();

    public class Model : DialogContentModel
    {
        public string UserName { get; set; } = "";
        public Contract? ExistingContract { get; set; }

        public ContractType Type { get; set; } = ContractType.Indeterminate;
        public ContractStatus Status { get; set; } = ContractStatus.Active;
        public DateTime? StartDate { get; set; } = DateTime.Today;
        public DateTime? EndDate { get; set; } = DateTime.Today.AddYears(1);
        public string Notes { get; set; } = "";
        public string ErrorMessage { get; set; } = "";

        public void Initialise()
        {
            if (ExistingContract is null)
                return;

            Type = ExistingContract.Type;
            Status = ExistingContract.Status;
            StartDate = ExistingContract.StartDate.ToDateTime(TimeOnly.MinValue);
            EndDate = ExistingContract.EndDate?.ToDateTime(TimeOnly.MinValue);
            Notes = ExistingContract.Notes ?? "";
        }

        // Returns null and fills ErrorMessage when the entry is not usable.
        public ContractEditResult? TryBuildResult()
        {
            if (!StartDate.HasValue)
            {
                ErrorMessage = "Start date is required.";
                NotifyChanged();
                return null;
            }

            if (Type == ContractType.Determinate && (!EndDate.HasValue || EndDate < StartDate))
            {
                ErrorMessage = "Determinate contracts require an end date that is after the start date.";
                NotifyChanged();
                return null;
            }

            var end = Type == ContractType.Determinate && EndDate.HasValue
                ? DateOnly.FromDateTime(EndDate.Value)
                : (DateOnly?)null;

            return new ContractEditResult(Type, Status, DateOnly.FromDateTime(StartDate.Value), end,
                string.IsNullOrWhiteSpace(Notes) ? null : Notes);
        }
    }

    public record ContractEditResult(
        ContractType Type, ContractStatus Status, DateOnly StartDate, DateOnly? EndDate, string? Notes);
}
