    private double _translateY = 0;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private OrgChartNode? _root;
    private List<OrgChartNode> _nodes = new();
    private List<(OrgChartNode Source, OrgChartNode Target)> _edges = new();
    
    private OrgChartNode? _hoveredNode = null;
    private CancellationTokenSource? _hoverCts;
    private bool _isMouseOverPanel = false;

    private bool _isManagerOrHr = false;
    private string _userRole = "";
    private string _userDepartment = "";
    private Guid _currentUserId = Guid.Empty;
    private HashSet<Guid> _subordinateIds = new();
    
    private bool _isDragging = false;
    private double _startX = 0;
    private double _startY = 0;
    private bool _hasDragged = false;

    private OrgChartNode? _selectedSearchNode;

    protected override async Task OnInitializedAsync()
    {
        ThemeState.OnChange += StateHasChanged;
        InitializeContinentsData();
        _europeCountries = EuropeMapData.GetCountries();
        _romaniaCounties = RomaniaMapData.GetCounties();
        _brasovSites = BrasovMapData.GetSites();
        UpdateBreadcrumbs();

        if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, true))
            return;

        var authState = await AuthStateTask!;
        var userIdString = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        _userRole = authState.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
        _userDepartment = authState.User.FindFirst("Department")?.Value ?? "";

        bool isActingAdmin = false;
        if (Guid.TryParse(userIdString, out var userId))
        {
            _currentUserId = userId;
            
            if (_userRole != UserRole.Admin.ToString())
            {
                var delegationsReceived = await Manager.GetActiveDelegationsAssignedToMeAsync(userId);
                isActingAdmin = delegationsReceived.Any(d => d.Manager.Role == UserRole.Admin);
            }

            _isManagerOrHr = _userRole == UserRole.LineManager.ToString() ||
                             _userRole == UserRole.Admin.ToString() ||
                             isActingAdmin ||
                             _userDepartment.Equals("HR", StringComparison.OrdinalIgnoreCase);

            bool isAdmin = _userRole == UserRole.Admin.ToString() || isActingAdmin;
            _root = await EmployeeCtx.GetCompanyOrgChartAsync(userId, isAdmin);

            if (_root != null)
            {
                _nodes.Clear();
                _edges.Clear();
                FlattenTree(_root);

                _subordinateIds.Clear();
                var selfNode = FindNodeInTree(_root, _currentUserId);
                if (selfNode != null)
                {
                    CollectSubordinateIds(selfNode, _subordinateIds);
                }
                
                _translateX = 450 - _root.X;
                _translateY = 50;
            }
        }
    }

