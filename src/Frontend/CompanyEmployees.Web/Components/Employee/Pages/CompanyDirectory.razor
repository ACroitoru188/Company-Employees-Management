@page "/employee/org-chart"
@layout CompanyEmployees.Web.Components.Layout.EmployeeLayout
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Application
@using CompanyEmployees.Domain.Enums
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@using CompanyEmployees.Web.Models
@using CompanyEmployees.Web.Services
@inject EmployeeContext EmployeeCtx
@inject ManagerContext Manager
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject ThemeState ThemeState
@implements IDisposable

<PageTitle>Organization Chart · Global Directory</PageTitle>

<div class="d-flex justify-space-between align-center mb-3 flex-wrap gap-2">
    <div>
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.h5" Style="font-weight:700;">Global Organization Chart</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Style="font-weight: 600; font-size: 11px;">
                @(_currentLevel switch {
                    HierarchyLevel.World => "Level 1: Global Continents",
                    HierarchyLevel.Continent => $"Level 2: {(_selectedContinent?.Name ?? "Europe")} Continent Map",
                    HierarchyLevel.Country => $"Level 3: {(_selectedCountry?.Name ?? "Romania")} Regional Hubs Map",
                    _ => "Level 4: Site Org Chart"
                })
            </MudChip>
        </div>
        <MudBreadcrumbs Items="_breadcrumbItems" Class="pa-0 mt-1" Separator=">">
            <ItemTemplate Context="item">
                <MudLink Href="@item.Href" OnClick="@(() => OnBreadcrumbClick(item))" Typo="Typo.caption" Style="cursor: pointer; font-weight: 600; color: var(--mud-palette-primary);">
                    @item.Text
                </MudLink>
            </ItemTemplate>
        </MudBreadcrumbs>
    </div>

    <div class="d-flex align-center gap-3 flex-wrap">
        @* Level Toggle Button Group *@
        <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Medium">
            <MudButton Variant="@(_currentLevel == HierarchyLevel.World ? Variant.Filled : Variant.Outlined)"
                       StartIcon="@Icons.Material.Filled.Public"
                       OnClick="@(() => SwitchLevel(HierarchyLevel.World))"
                       Style="text-transform:none; font-weight:600;">
                Global Map
            </MudButton>
            <MudButton Variant="@(_currentLevel == HierarchyLevel.Continent ? Variant.Filled : Variant.Outlined)"
                       StartIcon="@Icons.Material.Filled.Map"
                       OnClick="@(() => { _selectedContinent = _continents.FirstOrDefault(c => c.Id == "europe"); SwitchLevel(HierarchyLevel.Continent); })"
                       Style="text-transform:none; font-weight:600;">
                Europe Map
            </MudButton>
            <MudButton Variant="@(_currentLevel == HierarchyLevel.Country ? Variant.Filled : Variant.Outlined)"
                       StartIcon="@Icons.Material.Filled.Place"
                       OnClick="@(() => { _selectedCountry = _europeCountries.FirstOrDefault(c => c.Id == "rou"); SwitchLevel(HierarchyLevel.Country); })"
                       Style="text-transform:none; font-weight:600;">
                Romania Hubs
            </MudButton>
            <MudButton Variant="@(_currentLevel == HierarchyLevel.SiteOrgChart ? Variant.Filled : Variant.Outlined)"
                       StartIcon="@Icons.Material.Filled.AccountTree"
                       OnClick="@(() => SwitchLevel(HierarchyLevel.SiteOrgChart))"
                       Style="text-transform:none; font-weight:600;">
                Org Tree
            </MudButton>
        </MudButtonGroup>

        @* Search People Input *@
        <MudAutocomplete T="OrgChartNode"
                         Value="_selectedSearchNode"
                         ValueChanged="OnSearchNodeSelected"
                         SearchFunc="SearchEmployees"
                         ToStringFunc="@(node => node?.Name ?? "")"
                         Placeholder="Search people..."
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Adornment="Adornment.Start"
                         AdornmentIcon="@Icons.Material.Filled.Search"
                         AdornmentColor="Color.Primary"
                         Clearable="true"
                         Class="search-people-input"
                         Style="min-width: 240px; max-width: 300px;"
                         CoerceValue="true"
                         MaxItems="10">
            <ItemTemplate Context="node">
                <div class="d-flex align-center gap-2 py-1">
                    <MudAvatar Size="Size.Small" Color="Color.Primary" Style="font-size: 11px; font-weight: 700;">
                        @node.Initials
                    </MudAvatar>
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.body2" Style="font-weight: 600; line-height: 1.2;">@node.Name</MudText>
                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary); font-size: 11px;">
                            @node.Role @(!string.IsNullOrEmpty(node.Department) ? $"· {node.Department}" : "")
                        </MudText>
                    </div>
                </div>
            </ItemTemplate>
        </MudAutocomplete>

        @if (_currentLevel == HierarchyLevel.SiteOrgChart)
        {
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.CenterFocusStrong"
                       OnClick="FocusOnSelf"
                       Class="focus-btn"
                       Style="border-radius: 8px; font-weight: 700; text-transform: none; padding: 6px 16px; border-width: 2px; height: 40px; white-space: nowrap;">
                Focus Me
            </MudButton>
        }
    </div>
</div>

<MudCard Elevation="1" Style="height: 75vh; overflow: hidden; position: relative;" class="@($"org-card {(_currentLevel == HierarchyLevel.World ? "world-view" : "")}")">
    <MudCardContent Class="pa-0" Style="height: 100%; width: 100%; position: relative; background-color: var(--mud-palette-background-grey); overflow: hidden;" id="orgContainer"
                    @onwheel="OnWheel" @onmousedown="OnMouseDown" @onmousemove="OnMouseMove" @onmouseup="OnMouseUp" @onmouseleave="OnMouseUp">

        @if (_currentLevel == HierarchyLevel.World)
        {
            @* ========================================== *@
            @* LEVEL 1: INTERACTIVE VECTOR WORLD MAP      *@
            @* ========================================== *@
            <svg width="100%" height="100%" viewBox="0 0 1200 650" preserveAspectRatio="xMidYMid slice" class="@($"world-map-svg {(ThemeState.IsDarkMode ? "dark-map" : "light-map")}")">
                <defs>
                    <style>
                        .world-map-svg.dark-map {
                            background: radial-gradient(circle at 50% 50%, #151d2a 0%, #0d121c 100%);
                        }
                        .world-map-svg.light-map {
                            background: radial-gradient(circle at 50% 50%, #f0f7fa 0%, #d8e8f0 100%);
                        }

                        /* Continents Dark Mode */
                        .dark-map .world-continent-path {
                            fill: rgba(0, 163, 180, 0.12);
                            stroke: #00E5FF;
                            stroke-width: 1.6px;
                            stroke-linejoin: round;
                            stroke-linecap: round;
                            transition: fill 0.25s ease, stroke 0.25s ease, stroke-width 0.25s ease;
                            filter: drop-shadow(0 0 3px rgba(0, 229, 255, 0.3));
                        }
                        .dark-map .continent-group:hover .world-continent-path,
                        .dark-map .world-continent-path.hovered {
                            fill: rgba(0, 229, 255, 0.28);
                            stroke: #00FFF0;
                            stroke-width: 2.5px;
                            filter: drop-shadow(0 0 10px rgba(0, 229, 255, 0.7));
                            cursor: pointer;
                        }

                        /* Continents Light Mode */
                        .light-map .world-continent-path {
                            fill: #ffffff;
                            stroke: #008899;
                            stroke-width: 1.6px;
                            stroke-linejoin: round;
                            stroke-linecap: round;
                            transition: fill 0.25s ease, stroke 0.25s ease, stroke-width 0.25s ease;
                            filter: drop-shadow(0 2px 5px rgba(0, 70, 90, 0.18));
                        }
                        .light-map .continent-group:hover .world-continent-path,
                        .light-map .world-continent-path.hovered {
                            fill: #cbeeef;
                            stroke: #005a66;
                            stroke-width: 2.4px;
                            filter: drop-shadow(0 4px 12px rgba(0, 120, 150, 0.35));
                            cursor: pointer;
                        }

                        /* Pins Dark Mode */
                        .dark-map .continent-pin-pulse {
                            fill: none;
                            stroke: #00E5FF;
                            stroke-width: 1.5px;
                            opacity: 0.7;
                            animation: continentPulse 2.5s infinite ease-in-out;
                        }
                        .dark-map .continent-pin-center {
                            fill: #00E5FF;
                            stroke: #ffffff;
                            stroke-width: 2px;
                            filter: drop-shadow(0 0 8px #00E5FF);
                        }
                        .dark-map .continent-group:hover .continent-pin-center {
                            fill: #FFFF00;
                            filter: drop-shadow(0 0 12px #FFFF00);
                        }

                        /* Pins Light Mode */
                        .light-map .continent-pin-pulse {
                            fill: none;
                            stroke: #008899;
                            stroke-width: 1.5px;
                            opacity: 0.7;
                            animation: continentPulse 2.5s infinite ease-in-out;
                        }
                        .light-map .continent-pin-center {
                            fill: #008899;
                            stroke: #ffffff;
                            stroke-width: 2px;
                            filter: drop-shadow(0 2px 6px rgba(0, 136, 153, 0.4));
                        }
                        .light-map .continent-group:hover .continent-pin-center {
                            fill: #d97706;
                            stroke: #ffffff;
                            filter: drop-shadow(0 0 10px rgba(217, 119, 6, 0.6));
                        }

                        @@keyframes continentPulse {
                            0% { r: 6px; opacity: 0.9; stroke-width: 2px; }
                            50% { r: 18px; opacity: 0.15; stroke-width: 1px; }
                            100% { r: 6px; opacity: 0.9; stroke-width: 2px; }
                        }

                        /* Labels Dark Mode */
                        .dark-map .continent-label {
                            font-family: 'Roboto', 'Inter', sans-serif;
                            font-size: 13px;
                            font-weight: 700;
                            fill: #ffffff;
                            letter-spacing: 0.5px;
                            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.9));
                            pointer-events: none;
                            user-select: none;
                        }
                        .dark-map .continent-sublabel {
                            font-family: 'Roboto', 'Inter', sans-serif;
                            font-size: 10px;
                            font-weight: 500;
                            fill: rgba(0, 229, 255, 0.9);
                            letter-spacing: 0.2px;
                            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.9));
                            pointer-events: none;
                            user-select: none;
                        }

                        /* Labels Light Mode */
                        .light-map .continent-label {
                            font-family: 'Roboto', 'Inter', sans-serif;
                            font-size: 13px;
                            font-weight: 700;
                            fill: #0f172a;
                            letter-spacing: 0.5px;
                            filter: drop-shadow(0 1px 2px rgba(255,255,255,0.9));
                            pointer-events: none;
                            user-select: none;
                        }
                        .light-map .continent-sublabel {
                            font-family: 'Roboto', 'Inter', sans-serif;
                            font-size: 10px;
                            font-weight: 600;
                            fill: #007788;
                            letter-spacing: 0.2px;
                            filter: drop-shadow(0 1px 2px rgba(255,255,255,0.85));
                            pointer-events: none;
                            user-select: none;
                        }

                        /* Flight Lines */
                        .flight-line {
                            fill: none !important;
                            stroke-dasharray: 4, 6;
                            animation: flightDash 25s linear infinite;
                            pointer-events: none;
                        }
                        .dark-map .flight-line {
                            stroke: rgba(0, 229, 255, 0.35);
                            stroke-width: 1.5px;
                        }
                        .light-map .flight-line {
                            stroke: rgba(0, 136, 153, 0.45);
                            stroke-width: 1.5px;
                        }

                        @@keyframes flightDash {
                            to { stroke-dashoffset: -100; }
                        }

                        /* Munich HQ */
                        .global-hq-halo {
                            fill: none;
                            stroke-width: 2px;
                            animation: hqHalo 2s infinite ease-out;
                        }
                        .dark-map .global-hq-halo { stroke: #FFD700; }
                        .light-map .global-hq-halo { stroke: #d97706; }

                        .dark-map .global-hq-dot {
                            fill: #FFD700;
                            stroke: #ffffff;
                            stroke-width: 1.5px;
                            filter: drop-shadow(0 0 6px #FFD700);
                        }
                        .light-map .global-hq-dot {
                            fill: #d97706;
                            stroke: #ffffff;
                            stroke-width: 1.5px;
                            filter: drop-shadow(0 0 5px rgba(217, 119, 6, 0.5));
                        }

                        .dark-map .global-hq-text {
                            font-family: 'Roboto', 'Inter', sans-serif;
                            font-size: 11px;
                            font-weight: 700;
                            fill: #FFD700;
                            letter-spacing: 0.5px;
                            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.9));
                        }
                        .light-map .global-hq-text {
                            font-family: 'Roboto', 'Inter', sans-serif;
                            font-size: 11px;
                            font-weight: 700;
                            fill: #b45309;
                            letter-spacing: 0.5px;
                            filter: drop-shadow(0 1px 2px rgba(255,255,255,0.9));
                        }

                        @@keyframes hqHalo {
                            0% { r: 5px; opacity: 1; }
                            100% { r: 18px; opacity: 0; }
                        }
                    </style>

                    @* Grid Pattern for Blueprint/Cyber Aesthetics *@
                    <pattern id="worldGrid" width="40" height="40" patternUnits="userSpaceOnUse">
                        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="@(ThemeState.IsDarkMode ? "rgba(255, 255, 255, 0.04)" : "rgba(0, 100, 140, 0.06)")" stroke-width="1" />
                    </pattern>
                    <linearGradient id="continentGlow" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#00E5FF" stop-opacity="0.25" />
                        <stop offset="100%" stop-color="#007791" stop-opacity="0.08" />
                    </linearGradient>
                    <filter id="neonGlow" x="-20%" y="-20%" width="140%" height="140%">
                        <feGaussianBlur stdDeviation="4" result="blur" />
                        <feComposite in="SourceGraphic" in2="blur" operator="over" />
                    </filter>
                </defs>

                @* Background Grid *@
                <rect width="100%" height="100%" fill="url(#worldGrid)" />

                @* Latitude / Longitude Decorative Grid Lines *@
                <g class="world-geo-lines">
                    <line x1="0" y1="325" x2="1200" y2="325" stroke="@(ThemeState.IsDarkMode ? "rgba(0, 229, 255, 0.15)" : "rgba(0, 130, 160, 0.2)")" stroke-dasharray="6,6" stroke-width="1" /> @* Equator *@
                    <line x1="0" y1="180" x2="1200" y2="180" stroke="@(ThemeState.IsDarkMode ? "rgba(255, 255, 255, 0.05)" : "rgba(0, 100, 140, 0.1)")" stroke-dasharray="4,4" stroke-width="1" /> @* Tropic of Cancer *@
                    <line x1="0" y1="470" x2="1200" y2="470" stroke="@(ThemeState.IsDarkMode ? "rgba(255, 255, 255, 0.05)" : "rgba(0, 100, 140, 0.1)")" stroke-dasharray="4,4" stroke-width="1" /> @* Tropic of Capricorn *@
                    <line x1="600" y1="0" x2="600" y2="650" stroke="@(ThemeState.IsDarkMode ? "rgba(0, 229, 255, 0.12)" : "rgba(0, 130, 160, 0.18)")" stroke-dasharray="6,6" stroke-width="1" /> @* Prime Meridian *@
                </g>

                @* World Map Content Layer (Static Crisp Full-View) *@
                <g class="world-map-content-layer">
                    
                    @* Continental Landmasses (High Precision Vector Contours) *@
                    @foreach (var continent in _continents)
                    {
                        bool isSelected = _activeContinent?.Id == continent.Id;
                        <g class="continent-group @(isSelected ? "continent-active" : "")"
                           @onclick="() => OnContinentClick(continent)"
                           @ondblclick="() => OnContinentDblClick(continent)"
                           cursor="pointer">
                            
                            @* Main Continent SVG Outline with non-scaling-stroke for crisp performance *@
                            <path d="@continent.SvgPath" 
                                  vector-effect="non-scaling-stroke"
                                  class="world-continent-path @(isSelected ? "selected" : "")" />
                            <text x="0" y="7" class="continent-label" text-anchor="middle">@continent.Name</text>
                        </g>
                    }

                    @* Global Connections (Curved Inter-Continental HQ Network from Munich HQ) *@
                    <g class="world-flight-lines">
                        @* Siemens Global HQ in Munich, Germany (638.6, 258.0) to Other Continents *@
                        <path d="M 638.6 258.0 Q 440 130 244.5 285.3" fill="none" class="flight-line" vector-effect="non-scaling-stroke" /> @* Munich -> North America *@
                        <path d="M 638.6 258.0 Q 520 370 440.4 440.5" fill="none" class="flight-line" vector-effect="non-scaling-stroke" /> @* Munich -> South America *@
                        <path d="M 638.6 258.0 Q 640 330 672.5 397.9" fill="none" class="flight-line" vector-effect="non-scaling-stroke" /> @* Munich -> Africa *@
                        <path d="M 638.6 258.0 Q 800 200 947.3 297.6" fill="none" class="flight-line" vector-effect="non-scaling-stroke" /> @* Munich -> Asia *@
                        <path d="M 638.6 258.0 Q 850 400 1045.9 467.0" fill="none" class="flight-line" vector-effect="non-scaling-stroke" /> @* Munich -> Oceania *@
                    </g>

                    @* Global Executive Anchor: Siemens Global HQ (Munich, Germany - 638.6, 258.0) *@
                    <g transform="@($"translate({WorldMapData.MunichHQ_X.ToString(System.Globalization.CultureInfo.InvariantCulture)}, {WorldMapData.MunichHQ_Y.ToString(System.Globalization.CultureInfo.InvariantCulture)})")" class="global-hq-group">
                        <circle r="14" class="global-hq-halo" />
                        <circle r="5.5" class="global-hq-dot" />
                        <text x="0" y="16" class="global-hq-text" text-anchor="middle">Siemens Global HQ (Munich)</text>
                    </g>
                </g>
            </svg>

            @* Floating Continent Executive Inspection Card (Glassmorphism) - Opens on Click *@
            @if (_activeContinent != null)
            {
                <div class="@($"continent-floating-card elevation-4 {(ThemeState.IsDarkMode ? "dark-card" : "light-card")}")" style="left: 40px; top: 40px;">
                    <div class="card-header-row">
                        <div class="d-flex align-center gap-3">
                            <span class="continent-flag">@_activeContinent.FlagEmoji</span>
                            <div>
                                <div class="continent-title">@_activeContinent.Name</div>
                                <div class="continent-region-code">@_activeContinent.RegionCode</div>
                            </div>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _activeContinent = null)" aria-label="Close" Style="opacity: 0.7;" />
                    </div>

                    <div class="card-details-grid">
                        <div class="detail-item">
                            <span class="detail-label">Regional Leader</span>
                            <span class="detail-val highlight">--</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Title</span>
                            <span class="detail-val">--</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Total Workforce</span>
                            <span class="detail-val">0 Employees</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Active Hubs</span>
                            <span class="detail-val">0 Campus Sites</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Active Countries</span>
                            <span class="detail-val">0 Countries</span>
                        </div>
                    </div>
                    
                    <div class="card-actions mt-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth="true"
                                   OnClick="@(() => OnContinentDblClick(_activeContinent))">
                            @(_activeContinent.Id == "europe" ? "Explore Europe Hubs" : "Drill Down")
                        </MudButton>
                    </div>
                </div>
            }

            @* Quick Continent Selector (Direct Buttons, No Bar Container) *@
            <div class="continent-button-row">
                @foreach (var cont in _continents)
                {
                    bool isSelected = _activeContinent?.Id == cont.Id;
                    <MudButton Size="Size.Small"
                               Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary"
                               OnClick="@(() => SelectAndCenterContinent(cont))"
                               Class="continent-nav-btn"
                               Style="@(isSelected ? "font-weight: 700; text-transform: none; white-space: nowrap;" : "font-weight: 600; text-transform: none; white-space: nowrap;")">
                        @cont.Name
                    </MudButton>
                }
            </div>
        }
        else if (_currentLevel == HierarchyLevel.Continent)
        {
            @* ========================================== *@
            @* LEVEL 2: INTERACTIVE EUROPE CONTINENT MAP *@
            @* ========================================== *@
            <svg width="100%" height="100%" viewBox="0 0 1000 650" preserveAspectRatio="xMidYMid meet" class="@($"europe-map-svg {(ThemeState.IsDarkMode ? "dark-map" : "light-map")}")">
                <defs>
                    <style>
                        .europe-map-svg.dark-map {
                            background: radial-gradient(circle at 50% 50%, #151d2a 0%, #0d121c 100%);
                        }
                        .europe-map-svg.light-map {
                            background: radial-gradient(circle at 50% 50%, #f0f7fa 0%, #d8e8f0 100%);
                        }

                        /* Country paths dark */
                        .dark-map .europe-country-path {
                            fill: rgba(0, 163, 180, 0.14);
                            stroke: #00E5FF;
                            stroke-width: 1.8px;
                            stroke-linejoin: round;
                            stroke-linecap: round;
                            transition: fill 0.25s ease, stroke 0.25s ease, stroke-width 0.25s ease, filter 0.25s ease;
                            filter: drop-shadow(0 0 3px rgba(0, 229, 255, 0.35));
                            cursor: pointer;
                        }
                        .dark-map .europe-country-group:hover .europe-country-path,
                        .dark-map .europe-country-path.hovered {
                            fill: rgba(0, 229, 255, 0.32);
                            stroke: #00FFF0;
                            stroke-width: 2.8px;
                            filter: drop-shadow(0 0 12px rgba(0, 229, 255, 0.85));
                        }

                        /* Country paths light */
                        .light-map .europe-country-path {
                            fill: #ffffff;
                            stroke: #008899;
                            stroke-width: 1.8px;
                            stroke-linejoin: round;
                            stroke-linecap: round;
                            transition: fill 0.25s ease, stroke 0.25s ease, stroke-width 0.25s ease, filter 0.25s ease;
                            filter: drop-shadow(0 2px 6px rgba(0, 70, 90, 0.2));
                            cursor: pointer;
                        }
                        .light-map .europe-country-group:hover .europe-country-path,
                        .light-map .europe-country-path.hovered {
                            fill: #cbeeef;
                            stroke: #005a66;
                            stroke-width: 2.8px;
                            filter: drop-shadow(0 4px 14px rgba(0, 120, 150, 0.4));
                        }

                        /* Pin styles */
                        .dark-map .europe-pin-dot {
                            fill: #00E5FF;
                            filter: drop-shadow(0 0 6px #00E5FF);
                        }
                        .dark-map .europe-pin-hq {
                            fill: #FFD700;
                            filter: drop-shadow(0 0 8px #FFD700);
                        }
                        .light-map .europe-pin-dot {
                            fill: #008899;
                            filter: drop-shadow(0 1px 3px rgba(0,0,0,0.3));
                        }
                        .light-map .europe-pin-hq {
                            fill: #E68A00;
                            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
                        }

                        @@keyframes europePulse {
                            0% { r: 5; opacity: 1; }
                            100% { r: 16; opacity: 0; }
                        }
                        .europe-pulse-ring {
                            animation: europePulse 2s cubic-bezier(0.25, 0.8, 0.25, 1) infinite;
                        }
                    </style>

                    <pattern id="europeCyberGrid" width="40" height="40" patternUnits="userSpaceOnUse">
                        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="@(ThemeState.IsDarkMode ? "rgba(0, 229, 255, 0.05)" : "rgba(0, 136, 153, 0.07)")" stroke-width="1"/>
                    </pattern>
                </defs>

                <!-- Grid Background -->
                <rect width="100%" height="100%" fill="url(#europeCyberGrid)" />

                <!-- Europe Countries Group -->
                @foreach (var country in _europeCountries)
                {
                    bool isSelected = _activeCountry?.Id == country.Id;
                    <g class="europe-country-group @(isSelected ? "country-active" : "")"
                       @onclick="() => OnCountryClick(country)"
                       @ondblclick="() => OnCountryDblClick(country)"
                       cursor="pointer">
                        
                        <!-- Main Country Boundary -->
                        <path d="@country.SvgPath"
                              class="@($"europe-country-path {(isSelected ? "selected" : "")}")" />

                        <!-- Major Hub Pins for this Country -->
                        @foreach (var hub in country.Hubs)
                        {
                            <g transform="@($"translate({hub.X.ToString(System.Globalization.CultureInfo.InvariantCulture)}, {hub.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)})")">
                                @if (hub.IsHQ)
                                {
                                    <circle r="7" class="europe-pulse-ring" fill="none" stroke="@(ThemeState.IsDarkMode ? "#FFD700" : "#E68A00")" stroke-width="1.8" />
                                    <circle r="5" class="europe-pin-hq" />
                                    <circle r="2" fill="#ffffff" />
                                }
                                else
                                {
                                    <circle r="3.5" class="europe-pin-dot" />
                                    <circle r="1.5" fill="#ffffff" />
                                }
                            </g>
                        }
                    </g>
                }
            </svg>

            <!-- Floating Country Inspection Card (Consistent with Continent Card) - Opens on Click -->
            @if (_activeCountry != null)
            {
                <div class="@($"continent-floating-card elevation-4 {(ThemeState.IsDarkMode ? "dark-card" : "light-card")}")" style="left: 40px; top: 40px; max-width: 280px;">
                    <div class="card-header-row">
                        <div class="d-flex align-center gap-3">
                            <span class="continent-flag">@_activeCountry.Flag</span>
                            <div>
                                <div class="continent-title">@_activeCountry.Name</div>
                                <div class="continent-region-code">@_activeCountry.Capital (Capital) · @_activeCountry.Code</div>
                            </div>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _activeCountry = null)" aria-label="Close" Style="opacity: 0.7;" />
                    </div>

                    <div class="card-details-grid">
                        <div class="detail-item">
                            <span class="detail-label">Managing Director</span>
                            <span class="detail-val highlight">--</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Total Workforce</span>
                            <span class="detail-val">0 Employees</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Active Hubs</span>
                            <span class="detail-val">0 Campus Sites</span>
                        </div>
                    </div>

                    <div class="card-body">
                        <!-- Hubs preview list -->
                        <div class="d-flex flex-column gap-1 mt-1">
                            @foreach (var hub in _activeCountry.Hubs)
                            {
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@(hub.IsHQ ? Icons.Material.Filled.Star : Icons.Material.Filled.Business)" Size="Size.Small" Color="Color.Primary" Style="font-size: 14px;" />
                                    <span style="font-size: 12px; font-weight: 500;">
                                        @(hub.IsHQ ? "⭐ " : "")@hub.Name
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="card-actions mt-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth="true"
                                   OnClick="@(() => OnCountryDblClick(_activeCountry))"
                                   Style="text-transform:none; font-weight:700; white-space:nowrap;">
                            Drill Down
                        </MudButton>
                    </div>
                </div>
            }

            <!-- Back to Global Map button (bottom left) -->
            <div class="europe-bottom-nav">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => SwitchLevel(HierarchyLevel.World))"
                           Class="map-nav-back-btn">
                    Global Map
                </MudButton>
            </div>
        }
        else if (_currentLevel == HierarchyLevel.Country)
        {
            @* ==================================================== *@
            @* LEVEL 3: INTERACTIVE ROMANIA COUNTIES & SIEMENS HUBS *@
            @* ==================================================== *@
            <svg width="100%" height="100%" viewBox="0 0 1000 650" preserveAspectRatio="xMidYMid meet" class="@($"romania-map-svg {(ThemeState.IsDarkMode ? "dark-map" : "light-map")}")">
                <defs>
                    <style>
                        .romania-map-svg.dark-map {
                            background: radial-gradient(circle at 50% 50%, #151d2a 0%, #0d121c 100%);
                        }
                        .romania-map-svg.light-map {
                            background: radial-gradient(circle at 50% 50%, #f0f7fa 0%, #d8e8f0 100%);
                        }

                        /* County paths dark */
                        .dark-map .romania-county-path {
                            fill: rgba(0, 163, 180, 0.10);
                            stroke: #00D5FF;
                            stroke-width: 1.4px;
                            stroke-linejoin: round;
                            stroke-linecap: round;
                            transition: fill 0.25s ease, stroke 0.25s ease, stroke-width 0.25s ease, filter 0.25s ease;
                            filter: drop-shadow(0 0 3px rgba(0, 213, 255, 0.25));
                            cursor: pointer;
                        }
                        .dark-map .romania-county-path.has-presence {
                            fill: rgba(0, 163, 180, 0.22);
                            stroke: #00FFF0;
                            stroke-width: 1.8px;
                            filter: drop-shadow(0 0 6px rgba(0, 229, 255, 0.45));
                        }
                        .dark-map .romania-county-group:hover .romania-county-path,
                        .dark-map .romania-county-path.selected {
                            fill: rgba(0, 229, 255, 0.35);
                            stroke: #00FFF0;
                            stroke-width: 2.5px;
                            filter: drop-shadow(0 0 14px rgba(0, 229, 255, 0.9));
                        }

                        /* County paths light */
                        .light-map .romania-county-path {
                            fill: #ffffff;
                            stroke: #008899;
                            stroke-width: 1.4px;
                            stroke-linejoin: round;
                            stroke-linecap: round;
                            transition: fill 0.25s ease, stroke 0.25s ease, stroke-width 0.25s ease, filter 0.25s ease;
                            filter: drop-shadow(0 2px 5px rgba(0, 70, 90, 0.15));
                            cursor: pointer;
                        }
                        .light-map .romania-county-path.has-presence {
                            fill: #e0f4f7;
                            stroke: #006677;
                            stroke-width: 1.8px;
                            filter: drop-shadow(0 3px 8px rgba(0, 90, 120, 0.25));
                        }
                        .light-map .romania-county-group:hover .romania-county-path,
                        .light-map .romania-county-path.selected {
                            fill: #cbeeef;
                            stroke: #005a66;
                            stroke-width: 2.5px;
                            filter: drop-shadow(0 4px 14px rgba(0, 120, 150, 0.4));
                        }

                        /* Siemens Pin styles - Dark Mode */
                        .dark-map .siemens-pin-dot {
                            fill: #00E5FF;
                            filter: drop-shadow(0 0 8px #00E5FF);
                        }
                        .dark-map .siemens-pin-hq {
                            fill: #FFD700;
                            filter: drop-shadow(0 0 12px #FFD700);
                        }
                        .dark-map .siemens-hq-pulse-ring {
                            fill: none;
                            stroke: #FFD700;
                            stroke-width: 2px;
                            animation: romaniaPulse 2s cubic-bezier(0.25, 0.8, 0.25, 1) infinite;
                        }
                        .dark-map .siemens-hub-pulse-ring {
                            fill: none;
                            stroke: #00E5FF;
                            stroke-width: 1.8px;
                            animation: romaniaPulse 2.2s cubic-bezier(0.25, 0.8, 0.25, 1) infinite;
                        }

                        /* City Tag Badges Dark */
                        .dark-map .siemens-city-tag-hq {
                            fill: rgba(20, 28, 44, 0.90);
                            stroke: #FFD700;
                            stroke-width: 1.5px;
                            filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.6));
                        }
                        .dark-map .siemens-city-text-hq {
                            font-family: 'Roboto', 'Inter', sans-serif;
                            font-size: 11px;
                            font-weight: 800;
                            fill: #FFD700;
                            letter-spacing: 0.5px;
                        }
                        .dark-map .siemens-city-tag {
                            fill: rgba(13, 22, 36, 0.88);
                            stroke: #00E5FF;
                            stroke-width: 1.2px;
                            filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.5));
                        }
                        .dark-map .siemens-city-text {
                            font-family: 'Roboto', 'Inter', sans-serif;
                            font-size: 10px;
                            font-weight: 700;
                            fill: #00FFF0;
                            letter-spacing: 0.4px;
                        }

                        /* Siemens Pin styles - Light Mode */
                        .light-map .siemens-pin-dot {
                            fill: #008899;
                            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
                        }
                        .light-map .siemens-pin-hq {
                            fill: #E68A00;
                            filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.35));
                        }
                        .light-map .siemens-hq-pulse-ring {
                            fill: none;
                            stroke: #E68A00;
                            stroke-width: 2px;
                            animation: romaniaPulse 2s cubic-bezier(0.25, 0.8, 0.25, 1) infinite;
                        }
                        .light-map .siemens-hub-pulse-ring {
                            fill: none;
                            stroke: #008899;
                            stroke-width: 1.8px;
                            animation: romaniaPulse 2.2s cubic-bezier(0.25, 0.8, 0.25, 1) infinite;
                        }

                        /* City Tag Badges Light */
                        .light-map .siemens-city-tag-hq {
                            fill: #ffffff;
                            stroke: #E68A00;
                            stroke-width: 1.5px;
                            filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.15));
                        }
                        .light-map .siemens-city-text-hq {
                            font-family: 'Roboto', 'Inter', sans-serif;
                            font-size: 11px;
                            font-weight: 800;
                            fill: #C07000;
                            letter-spacing: 0.5px;
                        }
                        .light-map .siemens-city-tag {
                            fill: #ffffff;
                            stroke: #008899;
                            stroke-width: 1.2px;
                            filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.12));
                        }
                        .light-map .siemens-city-text {
                            font-family: 'Roboto', 'Inter', sans-serif;
                            font-size: 10px;
                            font-weight: 700;
                            fill: #006677;
                            letter-spacing: 0.4px;
                        }

                        @@keyframes romaniaPulse {
                            0% { r: 6; opacity: 1; }
                            100% { r: 18; opacity: 0; }
                        }
                    </style>

                    <pattern id="romaniaCyberGrid" width="40" height="40" patternUnits="userSpaceOnUse">
                        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="@(ThemeState.IsDarkMode ? "rgba(0, 229, 255, 0.05)" : "rgba(0, 136, 153, 0.07)")" stroke-width="1"/>
                    </pattern>
                </defs>

                <!-- Grid Background -->
                <rect width="100%" height="100%" fill="url(#romaniaCyberGrid)" />

                <!-- Romanian Counties Group (Authentic geographical vector boundaries) -->
                @foreach (var county in _romaniaCounties)
                {
                    bool isSelected = _activeRomaniaCounty?.Id == county.Id;
                    <g class="romania-county-group @(isSelected ? "county-active" : "")"
                       @onclick="() => OnRomaniaCountyClick(county)"
                       @ondblclick="() => OnRomaniaCountyDblClick(county)"
                       cursor="pointer">
                        
                        <!-- County Boundary Path -->
                        <path d="@county.SvgPath"
                              class="@($"romania-county-path {(county.HasSiemensPresence ? "has-presence" : "")} {(isSelected ? "selected" : "")}")" />
                    </g>
                }

                <!-- Accentuated Siemens Presence Cities (EXACTLY ONE PIN & LABEL PER CITY) -->
                @foreach (var county in _romaniaCounties.Where(c => c.HasSiemensPresence))
                {
                    bool isHubSelected = _activeRomaniaCounty?.Id == county.Id;
                    string tagText = county.IsHQ ? "⭐ BUCUREȘTI HQ" : county.CountySeat.ToUpper();
                    
                    // Specific non-colliding offsets for city tag badges
                    string tagTransform = county.CountySeat switch
                    {
                        "Brașov" => "translate(10, 8)",
                        "Sibiu" => "translate(-75, -12)",
                        "Craiova" => "translate(10, 8)",
                        "Timișoara" => "translate(10, -12)",
                        "București" => "translate(14, -14)",
                        _ => "translate(10, -12)"
                    };

                    int badgeWidth = county.IsHQ ? 135 : (county.CountySeat.Length > 8 ? 120 : 90);

                    <g class="siemens-hub-pin-group @(isHubSelected ? "selected-hub" : "")"
                       transform="@($"translate({county.CenterX.ToString(System.Globalization.CultureInfo.InvariantCulture)}, {county.CenterY.ToString(System.Globalization.CultureInfo.InvariantCulture)})")"
                       @onclick="() => OnRomaniaCountyClick(county)"
                       @ondblclick="() => OnRomaniaCountyDblClick(county)"
                       cursor="pointer">
                        @if (county.IsHQ)
                        {
                            <!-- Bucharest HQ: Prominent Golden Radar & Badge -->
                            <circle r="14" class="siemens-hq-pulse-ring" />
                            <circle r="7" class="siemens-pin-hq" />
                            <circle r="3" fill="#ffffff" />
                            <g transform="@tagTransform">
                                <rect width="@badgeWidth" height="24" rx="12" class="siemens-city-tag-hq" />
                                <text x="12" y="16" class="siemens-city-text-hq">@tagText</text>
                            </g>
                        }
                        else
                        {
                            <!-- Regional Hubs: Luminous Cyan Pulsing Ring & Clean City Label Tag -->
                            <circle r="10" class="siemens-hub-pulse-ring" />
                            <circle r="5" class="siemens-pin-dot" />
                            <circle r="2" fill="#ffffff" />
                            <g transform="@tagTransform">
                                <rect width="@badgeWidth" height="20" rx="10" class="siemens-city-tag" />
                                <text x="10" y="14" class="siemens-city-text">@tagText</text>
                            </g>
                        }
                    </g>
                }
            </svg>

            <!-- Floating Romania County Inspection Card (Consistent with World & Europe Cards) -->
            @if (_activeRomaniaCounty != null)
            {
                <div class="@($"continent-floating-card elevation-4 {(ThemeState.IsDarkMode ? "dark-card" : "light-card")}")" style="left: 40px; top: 40px; max-width: 320px;">
                    <div class="card-header-row">
                        <div class="d-flex align-center gap-3">
                            <span class="continent-flag">🇷🇴</span>
                            <div>
                                <div class="continent-title">@_activeRomaniaCounty.Name</div>
                                <div class="continent-region-code">@_activeRomaniaCounty.CountySeat (Reședință) · @_activeRomaniaCounty.Region</div>
                            </div>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _activeRomaniaCounty = null)" aria-label="Close" Style="opacity: 0.7;" />
                    </div>
                    <div class="card-body">
                    @if (_activeRomaniaCounty.HasSiemensPresence)
                    {
                        <!-- Siemens Hubs preview list -->
                        <div class="d-flex flex-column gap-1 mt-1">
                            <span style="font-size: 11px; font-weight: 600; color: var(--mud-palette-text-secondary);">Siemens Sites:</span>
                            @foreach (var hub in _activeRomaniaCounty.Hubs)
                            {
                                <div style="font-size: 11px; padding: 4px 8px; border-radius: 6px; background: @(ThemeState.IsDarkMode ? "rgba(0,229,255,0.10)" : "rgba(0,136,153,0.10)"); color: @(ThemeState.IsDarkMode ? "#00E5FF" : "#008899");">
                                    <div class="d-flex justify-space-between align-center">
                                        <span style="font-weight: 700;">@(hub.IsHQ ? "⭐ " : "🏢 ")@hub.Name</span>
                                        <span style="font-weight: 600; opacity: 0.9; white-space: nowrap; flex-shrink: 0;">0 staff</span>
                                    </div>
                                    <div style="font-size: 9.5px; opacity: 0.8; margin-top: 1px;">@hub.Division · @hub.Address</div>
                                </div>
                            }
                        </div>
                    }
                    </div>

                    <div class="d-flex justify-space-between align-center mt-3 pt-2" style="@(ThemeState.IsDarkMode ? "border-top: 1px solid rgba(255,255,255,0.08);" : "border-top: 1px solid rgba(0,0,0,0.08);")">
                        <span class="explore-hint">Double-click county to explore site tree</span>
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   OnClick="@(() => OnRomaniaCountyDblClick(_activeRomaniaCounty))"
                                   Style="text-transform:none; font-weight:700; white-space:nowrap;">
                            @(_activeRomaniaCounty.Id == "ro_bv" || _activeRomaniaCounty.Name.Contains("Brașov") || _activeRomaniaCounty.Name.Contains("Brasov") ? "Explore Brașov Hubs (2)" : "Drill Down")
                        </MudButton>
                    </div>
                </div>
            }

            <!-- Back to Europe Map button (bottom left) -->
            <div class="romania-bottom-nav">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => SwitchLevel(HierarchyLevel.Continent))"
                           Class="map-nav-back-btn">
                    Europe Map
                </MudButton>
            </div>
        }
        else if (_currentLevel == HierarchyLevel.City)
        {
            @* ==================================================== *@
            @* LEVEL 4: INTERACTIVE BRAȘOV CITY & SIEMENS SITES     *@
            @* ==================================================== *@
            <svg width="100%" height="100%" viewBox="0 0 1000 650" preserveAspectRatio="xMidYMid meet" class="@($"brasov-map-svg {(ThemeState.IsDarkMode ? "dark-map" : "light-map")}")">
                <defs>
                    <style>
                        .brasov-map-svg.dark-map {
                            background: radial-gradient(circle at 50% 50%, #151d2a 0%, #0d121c 100%);
                        }
                        .brasov-map-svg.light-map {
                            background: radial-gradient(circle at 50% 50%, #f0f7fa 0%, #d8e8f0 100%);
                        }

                        /* Brașov Detailed City Contour (Steady, no hover glow on map) */
                        .dark-map .brasov-city-path {
                            fill: rgba(0, 163, 180, 0.12);
                            stroke: #00FFF0;
                            stroke-width: 2.2px;
                            stroke-linejoin: round;
                            stroke-linecap: round;
                            filter: drop-shadow(0 0 10px rgba(0, 229, 255, 0.35));
                            pointer-events: none;
                        }

                        .light-map .brasov-city-path {
                            fill: #ffffff;
                            stroke: #008899;
                            stroke-width: 2.2px;
                            stroke-linejoin: round;
                            stroke-linecap: round;
                            filter: drop-shadow(0 4px 12px rgba(0, 70, 90, 0.15));
                            pointer-events: none;
                        }

                        /* Interactive Building / Site Pin & Badge (Both Blue with Hover Glow) */
                        .siemens-brasov-site-group {
                            transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.25s ease;
                            cursor: pointer;
                        }

                        .dark-map .siemens-brasov-site-group:hover,
                        .dark-map .siemens-brasov-site-group.selected-site {
                            filter: drop-shadow(0 0 16px rgba(0, 229, 255, 0.95)) drop-shadow(0 0 28px rgba(0, 229, 255, 0.7));
                        }

                        .light-map .siemens-brasov-site-group:hover,
                        .light-map .siemens-brasov-site-group.selected-site {
                            filter: drop-shadow(0 4px 16px rgba(0, 140, 180, 0.55));
                        }

                        /* Dark Mode: Both sites in Siemens Cyber Blue / Electric Cyan */
                        .dark-map .bv-site-pulse-plm,
                        .dark-map .bv-site-pulse-rd {
                            fill: none;
                            stroke: #00E5FF;
                            stroke-width: 2px;
                            animation: romaniaPulse 2.2s cubic-bezier(0.25, 0.8, 0.25, 1) infinite;
                        }
                        .dark-map .bv-site-dot-plm,
                        .dark-map .bv-site-dot-rd {
                            fill: #00E5FF;
                            filter: drop-shadow(0 0 10px #00E5FF);
                        }
                        .dark-map .bv-site-tag-plm,
                        .dark-map .bv-site-tag-rd {
                            fill: rgba(10, 22, 38, 0.92);
                            stroke: #00E5FF;
                            stroke-width: 1.4px;
                            filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.7));
                            transition: stroke 0.2s ease, stroke-width 0.2s ease;
                        }
                        .dark-map .bv-site-text-plm,
                        .dark-map .bv-site-text-rd {
                            font-family: 'Roboto', 'Inter', sans-serif;
                            font-size: 11px;
                            font-weight: 800;
                            fill: #00FFF0;
                            letter-spacing: 0.4px;
                        }

                        /* Light Mode: Both sites in Deep Tech Blue */
                        .light-map .bv-site-pulse-plm,
                        .light-map .bv-site-pulse-rd {
                            fill: none;
                            stroke: #0088AA;
                            stroke-width: 2px;
                            animation: romaniaPulse 2.2s cubic-bezier(0.25, 0.8, 0.25, 1) infinite;
                        }
                        .light-map .bv-site-dot-plm,
                        .light-map .bv-site-dot-rd {
                            fill: #007A99;
                            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
                        }
                        .light-map .bv-site-tag-plm,
                        .light-map .bv-site-tag-rd {
                            fill: #ffffff;
                            stroke: #0088AA;
                            stroke-width: 1.4px;
                            filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.12));
                            transition: stroke 0.2s ease, stroke-width 0.2s ease;
                        }
                        .light-map .bv-site-text-plm,
                        .light-map .bv-site-text-rd {
                            font-family: 'Roboto', 'Inter', sans-serif;
                            font-size: 11px;
                            font-weight: 800;
                            fill: #005566;
                            letter-spacing: 0.4px;
                        }
                    </style>
                </defs>

                <!-- Grid Background & Deselect Area -->
                <rect width="100%" height="100%" fill="url(#romaniaCyberGrid)" cursor="default" @onclick="() => _activeBrasovSite = null" />

                <!-- Brașov Detailed City Contour (No hover glow) -->
                <g class="brasov-city-group">
                    <path d="@BrasovMapData.CitySvgPath" class="brasov-city-path" />
                </g>

                <!-- Header Title -->
                <text x="75" y="80" style="font-family:'Roboto', 'Inter', sans-serif; font-size:18px; font-weight:800; fill:@(ThemeState.IsDarkMode ? "rgba(0,229,255,0.85)" : "#006677"); letter-spacing:1px; pointer-events:none;">
                    ORAȘUL BRAȘOV · SIEMENS HUBS
                </text>
                <text x="75" y="102" style="font-family:'Roboto', 'Inter', sans-serif; font-size:12px; font-weight:500; fill:@(ThemeState.IsDarkMode ? "rgba(255,255,255,0.6)" : "#557788"); pointer-events:none;">
                    Cele 2 Centre Tehnologice & R&D Siemens
                </text>

                <!-- The 2 Distinct Siemens Sites in Brașov (Both Blue with Glowing Effect on Hover) -->
                @foreach (var site in _brasovSites)
                {
                    bool isSiteSelected = _activeBrasovSite?.Id == site.Id;

                    <g class="siemens-brasov-site-group @(isSiteSelected ? "selected-site" : "")"
                       transform="@($"translate({site.X.ToString(System.Globalization.CultureInfo.InvariantCulture)}, {site.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)})")"
                       @onclick="() => OnBrasovSiteClick(site)"
                       @ondblclick="() => OnBrasovSiteDblClick(site)">
                        <circle r="14" class="bv-site-pulse-plm" />
                        <circle r="7" class="bv-site-dot-plm" />
                        <circle r="3" fill="#ffffff" />
                    </g>
                }
            </svg>

            <!-- Floating Inspection Card for Brașov Sites -->
            @if (_activeBrasovSite != null)
            {
                <div class="@($"continent-floating-card animate-fade-in {(ThemeState.IsDarkMode ? "dark-card" : "light-card")}")"
                     style="pointer-events: auto; left: 40px; top: 40px;">
                    <div class="card-header-row">
                        <div class="d-flex align-center gap-2">
                            <span class="continent-flag">@(_activeBrasovSite.Id.Contains("rd") ? "🔬" : "💻")</span>
                            <div>
                                <div class="continent-title">@_activeBrasovSite.Name</div>
                                <div class="continent-region-code">@_activeBrasovSite.Division · Brașov</div>
                            </div>
                        </div>
                        <div class="d-flex align-center gap-1">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Style="font-weight:700;">
                                0 Staff
                            </MudChip>
