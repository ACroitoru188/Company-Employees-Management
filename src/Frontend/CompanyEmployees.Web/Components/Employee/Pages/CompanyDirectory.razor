                           OnClick="@(() => SwitchLevel(HierarchyLevel.Country))"
                           Class="map-nav-back-btn">
                    Romania Map
                </MudButton>
            </div>
        }
        else
        {
            @* ========================================== *@
            @* LEVEL 5: TREE ORGANIZATION CHART           *@
            @* ========================================== *@
            @if (_root == null)
            {
                <div class="d-flex justify-center align-center" style="height: 100%;">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else
            {
                <svg width="100%" height="100%">
                    <g transform="@($"translate({_translateX.ToString(System.Globalization.CultureInfo.InvariantCulture)}, {_translateY.ToString(System.Globalization.CultureInfo.InvariantCulture)}) scale({_scale.ToString(System.Globalization.CultureInfo.InvariantCulture)})")">
                        @* Lines Layer (Orthogonal 90-degree connectors) *@
                        @foreach (var edge in _edges)
                        {
                            <path d="@GetOrthogonalPath(edge.Source, edge.Target)" 
                                  class="@(edge.Target.IsFocusNode && edge.Source.IsFocusNode ? "org-line-focus" : "org-line")" />
                        }

                        @* Nodes Layer *@
                        @foreach (var node in _nodes)
                        {
                            bool isSelf = node.UserId == _currentUserId;
                            <g transform="translate(@node.X, @node.Y)">
                                @if (isSelf)
                                {
                                    <circle r="33" class="org-node-self-aura" />
                                }

                                <circle r="25" class="@(isSelf ? "org-node-circle-self" : (node.IsFocusNode ? "org-node-circle-focus" : "org-node-circle"))" 
                                        @onmouseenter="() => OnNodeMouseEnter(node)" 
                                        @onmouseleave="OnNodeMouseLeave"
                                        @onclick="() => OnNodeClick(node)" />
                                @((MarkupString)$"<text x=\"0\" y=\"0\" class=\"{(isSelf ? "org-text-self" : (node.IsFocusNode ? "org-text-focus" : "org-text"))}\" dominant-baseline=\"central\" text-anchor=\"middle\" style=\"pointer-events: none;\">{node.Initials}</text>")

