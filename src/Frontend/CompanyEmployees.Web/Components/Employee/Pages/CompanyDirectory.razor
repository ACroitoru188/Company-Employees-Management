    </MudCardContent>
</MudCard>

@code {
    private enum HierarchyLevel
    {
        World,
        Continent,
        Country,
        City,
        SiteOrgChart
    }

    private HierarchyLevel _currentLevel = HierarchyLevel.World;
    private ContinentModel? _selectedContinent;
