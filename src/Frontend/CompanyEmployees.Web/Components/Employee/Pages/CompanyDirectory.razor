    private static string GetContractPeriodText(OrgChartNode node)
    {
        if (!node.HasContract || !node.ContractStartDate.HasValue) return "—";
        var start = node.ContractStartDate.Value.ToString("dd.MM.yyyy");
        if (node.ContractEndDate.HasValue) return $"{start} - {node.ContractEndDate.Value:dd.MM.yyyy}";
        return $"{start} - Indefinite";
    }

    private static string GetContractStatusText(OrgChartNode node)
    {
        if (!node.HasContract || node.ContractType == null) return "—";
        return node.ContractType == ContractType.Determinate ? "Determinate" : "Indeterminate";
    }

    private static string GetOrthogonalPath(OrgChartNode source, OrgChartNode target)
    {
        var c = System.Globalization.CultureInfo.InvariantCulture;
        double startX = source.X;
        double startY = source.Y + 25;
        double endX = target.X;
        double endY = target.Y - 25;
        double midY = (startY + endY) / 2.0;
        return $"M {startX.ToString(c)} {startY.ToString(c)} V {midY.ToString(c)} H {endX.ToString(c)} V {endY.ToString(c)}";
    }

    private Task<IEnumerable<OrgChartNode>> SearchEmployees(string value, CancellationToken token)
    {
        var searchable = GetSearchableNodes();
        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<OrgChartNode>>(searchable.Take(8));
        }

        var results = searchable
            .Where(n => (!string.IsNullOrWhiteSpace(n.Name) && n.Name.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrWhiteSpace(n.Role) && n.Role.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
                        (!string.IsNullOrWhiteSpace(n.Department) && n.Department.Contains(value, StringComparison.OrdinalIgnoreCase)))
            .Take(10);

        return Task.FromResult<IEnumerable<OrgChartNode>>(results);
    }

    private List<OrgChartNode> GetSearchableNodes()
    {
        var list = new List<OrgChartNode>();
        if (_root == null) return list;

        bool isAdmin = _userRole == UserRole.Admin.ToString() || (_isManagerOrHr && _userDepartment != "HR" && _userRole != UserRole.LineManager.ToString());
        bool isManager = _userRole == UserRole.LineManager.ToString();

        if (isAdmin)
        {
            CollectAllNodes(_root, list);
        }
        else if (isManager)
        {
            var selfNode = FindNodeInTree(_root, _currentUserId);
            if (selfNode != null)
            {
                CollectAllNodes(selfNode, list);
            }
        }
        else
        {
            var selfNode = FindNodeInTree(_root, _currentUserId);
            if (selfNode != null)
            {
                list.Add(selfNode);
            }
        }

        return list.Where(n => !string.IsNullOrWhiteSpace(n.Name) && n.Name != "Company HQ").ToList();
    }

    private void CollectAllNodes(OrgChartNode node, List<OrgChartNode> list)
    {
        list.Add(node);
        foreach (var child in node.Subordinates)
        {
            CollectAllNodes(child, list);
        }
    }

    public void Dispose()
    {
        ThemeState.OnChange -= StateHasChanged;
        _hoverCts?.Cancel();
        _hoverCts?.Dispose();
    }
