@page "/employee/org-chart"
@layout CompanyEmployees.Web.Components.Layout.EmployeeLayout
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Application
@using CompanyEmployees.Domain.Enums
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@using CompanyEmployees.Web.Models
@using CompanyEmployees.Web.Services
@inject EmployeeContext EmployeeCtx
@inject NavigationManager Nav
@inject IToastService Toast
@inject IJSRuntime JSRuntime

<PageTitle>Organization Chart · Global Directory</PageTitle>

<div class="page-shell">
<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true"
             VerticalAlignment="VerticalAlignment.Center" Width="100%">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8"
                     VerticalAlignment="VerticalAlignment.Center">
            <FluentLabel Typo="Typography.PaneHeader" Weight="FontWeight.Bold">Global Organization Chart</FluentLabel>
            @* A caption for the title, not something to press — so it stops wearing the colour
               that means "press me". *@
            <FluentBadge Appearance="Appearance.Neutral">
                @(_currentLevel == HierarchyLevel.World ? "Level 1: Global Continents" : "Level 5: Site Org Chart")
            </FluentBadge>
        </FluentStack>

        <FluentBreadcrumb>
            <FluentBreadcrumbItem Href="javascript:void(0)"
                                  @onclick="@(() => SwitchLevel(HierarchyLevel.World))">
                🌍 Global World Map
            </FluentBreadcrumbItem>
            @if (_currentLevel == HierarchyLevel.SiteOrgChart)
            {
                <FluentBreadcrumbItem>🏢 Site Org Chart</FluentBreadcrumbItem>
            }
        </FluentBreadcrumb>
    </FluentStack>

    <FluentSpacer />

    @* A view switcher, not two actions. Accent here meant "this view is selected", which is the
       same paint the app uses for "this is the thing to press" — so the page appeared to have two
       primary buttons that happened to swap. Neutral for the selected side and stealth for the
       other reads as one segmented control and gives the accent back to real actions. *@
    <FluentButton Appearance="@(_currentLevel == HierarchyLevel.World ? Appearance.Neutral : Appearance.Stealth)"
                  IconStart="@(new Icons.Regular.Size20.Globe())"
                  OnClick="@(() => SwitchLevel(HierarchyLevel.World))">
        Global Map
    </FluentButton>
    <FluentButton Appearance="@(_currentLevel == HierarchyLevel.SiteOrgChart ? Appearance.Neutral : Appearance.Stealth)"
                  IconStart="@(new Icons.Regular.Size20.Organization())"
                  OnClick="@(() => SwitchLevel(HierarchyLevel.SiteOrgChart))">
        Org Tree
    </FluentButton>

    @* Only where there is a tree to search. The people it searches come from _root, which is
       loaded with the org tree — on the world map that is null, so the box sat there taking
       input and never returning a single result, with nothing to say why. Focus Me below was
       already hidden for the same reason. *@
    @if (_currentLevel == HierarchyLevel.SiteOrgChart)
    {
    <FluentAutocomplete TOption="OrgChartNode"
                        Placeholder="Search people..."
                        OnOptionsSearch="OnSearchAsync"
                        OptionText="@(node => node.Name)"
                        OptionValue="@(node => node.UserId.ToString())"
                        MaximumSelectedOptions="1"
                        MaximumOptionsSearch="10"
                        SelectedOptions="@_searchSelection"
                        SelectedOptionsChanged="OnSearchNodeSelected"
                        Width="280px">
        <OptionTemplate Context="node">
            <FluentPersona Name="@node.Name" Initials="@node.Initials" ImageSize="24px"
                           TextPosition="TextPosition.End">
                @* FluentPersona drops its Name whenever ChildContent is supplied, so the name is
                   rendered here explicitly above the secondary line. *@
                <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@node.Name</FluentLabel>
                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                    @node.Role@(string.IsNullOrEmpty(node.Department) ? "" : $" · {node.Department}")
                </FluentLabel>
            </FluentPersona>
        </OptionTemplate>
    </FluentAutocomplete>
    }

    @if (_currentLevel == HierarchyLevel.SiteOrgChart)
    {
        <FluentButton Appearance="Appearance.Outline"
                      IconStart="@(new Icons.Regular.Size20.Target())"
                      OnClick="FocusOnSelf">
            Focus Me
        </FluentButton>
    }
</FluentStack>

@if (_currentLevel == HierarchyLevel.World)
{
    @* The hand-drawn vector map was the one thing on this page with no Fluent equivalent;
       the same information is now a card per region, which also makes the counts readable
       without hovering. *@
    <FluentGrid Spacing="3" Style="margin-top:16px;">
        @foreach (var continent in _continents)
        {
            <FluentGridItem xs="12" sm="6" md="4">
                <FluentCard Style="padding:16px; height:100%;">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8"
                                     VerticalAlignment="VerticalAlignment.Center" Width="100%">
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                                <FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">
                                    @continent.FlagEmoji @continent.Name
                                </FluentLabel>
                                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-caption">
                                    @continent.RegionCode
                                </FluentLabel>
                            </FluentStack>
                            <FluentSpacer />
                            <FluentBadge Appearance="Appearance.Neutral">
                                @continent.ActiveCountriesCount Countries
                            </FluentBadge>
                        </FluentStack>

                        <FluentDivider Role="DividerRole.Presentation" />

                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                            <FluentStack Orientation="Orientation.Horizontal" Width="100%">
                                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Regional Leader</FluentLabel>
                                <FluentSpacer />
                                <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold" Color="Color.Custom" CustomColor="var(--accent-foreground-rest)">
                                    @continent.LeadName
                                </FluentLabel>
                            </FluentStack>
                            <FluentStack Orientation="Orientation.Horizontal" Width="100%">
                                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Title</FluentLabel>
                                <FluentSpacer />
                                <FluentLabel Typo="Typography.Body">@continent.LeadRole</FluentLabel>
                            </FluentStack>
                            <FluentStack Orientation="Orientation.Horizontal" Width="100%">
                                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Total Workforce</FluentLabel>
                                <FluentSpacer />
                                <FluentLabel Typo="Typography.Body">
                                    @continent.TotalEmployeesCount.ToString("N0") Employees
                                </FluentLabel>
                            </FluentStack>
                            <FluentStack Orientation="Orientation.Horizontal" Width="100%">
                                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Active Hubs</FluentLabel>
                                <FluentSpacer />
                                <FluentLabel Typo="Typography.Body">@continent.ActiveHubsCount Campus Sites</FluentLabel>
                            </FluentStack>
                        </FluentStack>

                        <FluentStack Orientation="Orientation.Horizontal" Width="100%"
                                     HorizontalAlignment="HorizontalAlignment.End">
                            @* Outline, not accent. Six identical calls to action rendered in
                               accent made every card shout at the same volume and left the page
                               with no primary action at all; Fluent 2 asks for one primary per
                               view and the outline appearance for repeated minor ones. *@
                            <FluentButton Appearance="Appearance.Outline"
                                          IconEnd="@(new Icons.Regular.Size20.ArrowRight())"
                                          OnClick="@(() => OnContinentClick(continent))">
                                Drill Down
                            </FluentButton>
                        </FluentStack>
                    </FluentStack>
                </FluentCard>
            </FluentGridItem>
        }
    </FluentGrid>
}
else if (_root == null)
{
    <FluentProgressRing />
}
else
{
    <FluentGrid Spacing="3" Style="margin-top:16px;">
        <FluentGridItem xs="12" md="7">
            <FluentCard Style="padding:16px; height:75vh; overflow:auto;">
                @* The rows hold a two-line persona, which is taller than a tree item's own
                   fixed row height; app.css lets the row grow to it. *@
                <FluentTreeView Class="org-tree">
                    <OrgTreeNode Node="@_root" SelectedId="@(_selectedNode?.UserId ?? Guid.Empty)"
                                 OnSelect="OnNodeSelected" />
                </FluentTreeView>
            </FluentCard>
        </FluentGridItem>

        <FluentGridItem xs="12" md="5">
            @* Sized by its content, with a ceiling rather than a fixed height: the panel holds a
               persona, four rows and sometimes a button row, and pinning it to the tree's 75vh
               left a card that was three quarters empty. The ceiling keeps it level with the tree
               when somebody's details run long. *@
            <FluentCard Style="padding:16px; max-height:75vh; overflow:auto;">
                @if (_selectedNode is null)
                {
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8"
                                 HorizontalAlignment="HorizontalAlignment.Center">
                        <FluentIcon Value="@(new Icons.Regular.Size24.Person())" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" />
                        <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                            Pick somebody in the tree to see their details.
                        </FluentLabel>
                    </FluentStack>
                }
                else
                {
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                        <FluentPersona Name="@_selectedNode.Name" Initials="@_selectedNode.Initials"
                                       ImageSize="64px" TextPosition="TextPosition.End">
                            @* FluentPersona drops its Name whenever ChildContent is supplied, so the name is
                               rendered here explicitly above the secondary line. *@
                            <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@_selectedNode.Name</FluentLabel>
                            <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                                @_selectedNode.Role
                            </FluentLabel>
                        </FluentPersona>

                        <FluentDivider Role="DividerRole.Presentation" />

                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                            <FluentStack Orientation="Orientation.Horizontal" Width="100%">
                                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Department</FluentLabel>
                                <FluentSpacer />
                                @* Admins belong to no department by design, and the field read as
                                   blank rather than as "none". *@
                                <FluentLabel Typo="Typography.Body">
                                    @(string.IsNullOrWhiteSpace(_selectedNode.Department) ? "—" : _selectedNode.Department)
                                </FluentLabel>
                            </FluentStack>
                            <FluentStack Orientation="Orientation.Horizontal" Width="100%">
                                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Role</FluentLabel>
                                <FluentSpacer />
                                <FluentLabel Typo="Typography.Body">@_selectedNode.Role</FluentLabel>
                            </FluentStack>
                            <FluentStack Orientation="Orientation.Horizontal" Width="100%">
                                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Contract</FluentLabel>
                                <FluentSpacer />
                                <FluentLabel Typo="Typography.Body">@GetContractPeriodText(_selectedNode)</FluentLabel>
                            </FluentStack>
                            <FluentStack Orientation="Orientation.Horizontal" Width="100%">
                                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Contract Status</FluentLabel>
                                <FluentSpacer />
                                @if (_selectedNode.HasContract && _selectedNode.ContractType != null)
                                {
                                    <FluentBadge Appearance="@(_selectedNode.ContractType == ContractType.Determinate
                                                              ? Appearance.Lightweight : Appearance.Accent)">
                                        @GetContractStatusText(_selectedNode)
                                    </FluentBadge>
                                }
                                else
                                {
                                    <FluentLabel Typo="Typography.Body">—</FluentLabel>
                                }
                            </FluentStack>
                        </FluentStack>

                        @if (_isManagerOrHr && _selectedNode.UserId != _currentUserId)
                        {
                            <FluentDivider Role="DividerRole.Presentation" />

                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                                @if (!CanManageRequests(_selectedNode))
                                {
                                    <FluentButton Disabled="true"
                                                  IconStart="@(new Icons.Regular.Size20.LockClosed())"
                                                  Title="Leave requests can only be approved by Line Managers or HR">
                                        Requests locked
                                    </FluentButton>
                                }
                                else
                                {
                                    <FluentButton Appearance="@(_selectedNode.HasPendingRequest ? Appearance.Accent : Appearance.Outline)"
                                                  IconStart="@(new Icons.Regular.Size20.CalendarLtr())"
                                                  Title="@(_selectedNode.HasPendingRequest ? "View pending leave request" : "No pending leave requests")"
                                                  OnClick="@(() => OnViewRequestClicked(_selectedNode))">
                                        @(_selectedNode.HasPendingRequest ? "View Request" : "No Request")
                                    </FluentButton>
                                }

                                @if (!CanManageContract(_selectedNode))
                                {
                                    <FluentButton Disabled="true"
                                                  IconStart="@(new Icons.Regular.Size20.LockClosed())"
                                                  Title="Contract management locked for superiors or unauthorized roles">
                                        Contract locked
                                    </FluentButton>
                                }
                                else
                                {
                                    <FluentButton Appearance="Appearance.Outline"
                                                  IconStart="@(new Icons.Regular.Size20.DocumentText())"
                                                  Title="Manage contract for this employee"
                                                  OnClick="@(() => OnManageContractClicked(_selectedNode))">
                                        Manage Contract
                                    </FluentButton>
                                }
                            </FluentStack>
                        }
                    </FluentStack>
                }
            </FluentCard>
        </FluentGridItem>
    </FluentGrid>
}
</div>

@code {
    private enum HierarchyLevel
    {
        World,
        SiteOrgChart
    }

    private HierarchyLevel _currentLevel = HierarchyLevel.World;

    private class ContinentModel
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string RegionCode { get; set; } = "";
        public string FlagEmoji { get; set; } = "";
        public string LeadRole { get; set; } = "";
        public string LeadName { get; set; } = "";
        public int TotalEmployeesCount { get; set; }
        public int ActiveCountriesCount { get; set; }
        public int ActiveHubsCount { get; set; }
    }

    private List<ContinentModel> _continents = new();

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private OrgChartNode? _root;
    private OrgChartNode? _selectedNode;

    private bool _isManagerOrHr = false;
    private string _userRole = "";
    private string _userDepartment = "";
    private Guid _currentUserId = Guid.Empty;
    private HashSet<Guid> _subordinateIds = new();

    private IEnumerable<OrgChartNode> _searchSelection = [];

    protected override async Task OnInitializedAsync()
    {
        InitializeContinentsData();

        if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, true))
            return;

        var authState = await AuthStateTask!;
        var userIdString = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        _userRole = authState.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
        _userDepartment = authState.User.FindFirst("Department")?.Value ?? "";

        _isManagerOrHr = _userRole == UserRole.LineManager.ToString() ||
                         _userRole == UserRole.Admin.ToString() ||
                         _userDepartment.Equals("HR", StringComparison.OrdinalIgnoreCase);

        if (Guid.TryParse(userIdString, out var userId))
        {
            _currentUserId = userId;
            bool isAdmin = _userRole == UserRole.Admin.ToString();
            _root = await EmployeeCtx.GetCompanyOrgChartAsync(userId, isAdmin);

            if (_root != null)
            {
                _subordinateIds.Clear();
                var selfNode = FindNodeInTree(_root, _currentUserId);
                if (selfNode != null)
                {
                    CollectSubordinateIds(selfNode, _subordinateIds);
                }
            }
        }
    }

    private void InitializeContinentsData()
    {
        _continents = new List<ContinentModel>
        {
            new ContinentModel
            {
                Id = "north-america",
                Name = "North America",
                RegionCode = "Americas (North America)",
                FlagEmoji = "🇺🇸",
                LeadRole = "Regional VP North America",
                LeadName = "Barbara Humpton",
                TotalEmployeesCount = 45000,
                ActiveCountriesCount = 3,
                ActiveHubsCount = 28
            },
            new ContinentModel
            {
                Id = "south-america",
                Name = "South America",
                RegionCode = "Americas (South & Latin America)",
                FlagEmoji = "🇧🇷",
                LeadRole = "Regional VP Latin America",
                LeadName = "Alejandro Preinfalk",
                TotalEmployeesCount = 18500,
                ActiveCountriesCount = 8,
                ActiveHubsCount = 14
            },
            new ContinentModel
            {
                Id = "europe",
                Name = "Europe",
                RegionCode = "Europe & Middle East",
                FlagEmoji = "🇪🇺",
                LeadRole = "Regional VP Europe & Middle East",
                LeadName = "Dr. Martin Weber",
                TotalEmployeesCount = 135000,
                ActiveCountriesCount = 28,
                ActiveHubsCount = 65
            },
            new ContinentModel
            {
                Id = "africa",
                Name = "Africa",
                RegionCode = "Africa",
                FlagEmoji = "🇿🇦",
                LeadRole = "Regional VP Africa",
                LeadName = "Sabine Dall'Omo",
                TotalEmployeesCount = 22000,
                ActiveCountriesCount = 16,
                ActiveHubsCount = 18
            },
            new ContinentModel
            {
                Id = "asia",
                Name = "Asia",
                RegionCode = "Asia Pacific",
                FlagEmoji = "🇸🇬",
                LeadRole = "Regional VP Asia-Pacific",
                LeadName = "Dr. Xiao Zheng",
                TotalEmployeesCount = 82000,
                ActiveCountriesCount = 19,
                ActiveHubsCount = 48
            },
            new ContinentModel
            {
                Id = "oceania",
                Name = "Australia & Oceania",
                RegionCode = "Australia & Oceania",
                FlagEmoji = "🇦🇺",
                LeadRole = "Regional VP Australia & NZ",
                LeadName = "Peter Halliday",
                TotalEmployeesCount = 9200,
                ActiveCountriesCount = 4,
                ActiveHubsCount = 9
            }
        };
    }

    private void SwitchLevel(HierarchyLevel level)
    {
        _currentLevel = level;
        StateHasChanged();
    }

    private void OnContinentClick(ContinentModel continent)
    {
        Toast.ShowInfo($"Selected region: {continent.Name} ({continent.RegionCode}). Opening local organization tree...");
        SwitchLevel(HierarchyLevel.SiteOrgChart);
    }

    private void OnNodeSelected(OrgChartNode node)
    {
        _selectedNode = node.UserId == Guid.Empty ? null : node;
    }

    private Task OnSearchAsync(OptionsSearchEventArgs<OrgChartNode> args)
    {
        var searchable = GetSearchableNodes();

        args.Items = string.IsNullOrWhiteSpace(args.Text)
            ? searchable.Take(8)
            : searchable
                .Where(n => (!string.IsNullOrWhiteSpace(n.Name) && n.Name.Contains(args.Text, StringComparison.OrdinalIgnoreCase)) ||
                            (!string.IsNullOrWhiteSpace(n.Role) && n.Role.Contains(args.Text, StringComparison.OrdinalIgnoreCase)) ||
                            (!string.IsNullOrWhiteSpace(n.Department) && n.Department.Contains(args.Text, StringComparison.OrdinalIgnoreCase)))
                .Take(10);

        return Task.CompletedTask;
    }

    private void OnSearchNodeSelected(IEnumerable<OrgChartNode> selection)
    {
        _searchSelection = selection;

        var node = selection.FirstOrDefault();
        if (node is null)
            return;

        if (_currentLevel != HierarchyLevel.SiteOrgChart)
            SwitchLevel(HierarchyLevel.SiteOrgChart);

        FocusOnNode(node.UserId);
    }

    private void FocusOnSelf()
    {
        if (_currentLevel != HierarchyLevel.SiteOrgChart)
            SwitchLevel(HierarchyLevel.SiteOrgChart);

        FocusOnNode(_currentUserId);
    }

    // Expanding the path opens the way to the node; the tree card is 75vh with its own scrollbar,
    // so the row still has to be brought into view or "Focus Me" lands on somebody selected far
    // below the fold and looks like it did nothing.
    private void FocusOnNode(Guid targetUserId)
    {
        if (_root == null) return;

        bool found = ExpandPathToNode(_root, targetUserId);
        if (!found && targetUserId != _root.UserId)
        {
            Toast.ShowInfo("Employee is not within your accessible team structure.");
            return;
        }

        _selectedNode = FindNodeInTree(_root, targetUserId);
        StateHasChanged();

        _ = SyncTreeHighlightAsync(targetUserId);
    }

    // Moving the highlight and scrolling the row into view both live in wwwroot/js/orgchart.js:
    // as a named function it is syntax-checked where it is written, can be stepped through, and
    // survives a Content-Security-Policy without 'unsafe-eval' — none of which is true of a
    // routine assembled from a dozen concatenated C# string fragments.
    private async Task SyncTreeHighlightAsync(Guid targetUserId)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("companyOrgChart.focusNode", targetUserId.ToString("D"));
        }
        catch
        {
            // Cosmetic only — the panel is already right.
        }
    }

    private bool ExpandPathToNode(OrgChartNode current, Guid targetUserId)
    {
        if (current.UserId == targetUserId) return true;

        foreach (var child in current.Subordinates)
        {
            if (ExpandPathToNode(child, targetUserId))
            {
                current.IsExpanded = true;
                return true;
            }
        }

        return false;
    }

    private OrgChartNode? FindNodeInTree(OrgChartNode current, Guid targetId)
    {
        if (current.UserId == targetId) return current;
        foreach (var child in current.Subordinates)
        {
            var found = FindNodeInTree(child, targetId);
            if (found != null) return found;
        }
        return null;
    }

    private void CollectSubordinateIds(OrgChartNode node, HashSet<Guid> result)
    {
        foreach (var child in node.Subordinates)
        {
            result.Add(child.UserId);
            CollectSubordinateIds(child, result);
        }
    }

    private bool CanManageRequests(OrgChartNode node)
    {
        if (node == null || node.UserId == Guid.Empty || node.UserId == _currentUserId) return false;
        if (_userRole == UserRole.Admin.ToString()) return false;
        if (_userRole == UserRole.LineManager.ToString()) return _subordinateIds.Contains(node.UserId);
        if (_userDepartment.Equals("HR", StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    // HR is deliberately absent. The button this gates has two destinations — /admin/users for
    // Admins and /manager/team for a Line Manager's own reports — and no third one, because no
    // page in the app lets HR edit a contract. Offering it to HR sent them to /admin/users,
    // which is Admin-only and bounces straight to the dashboard: a button that could only ever
    // fail. Its sibling, CanManageRequests, has an HR branch because /hr/dashboard exists.
    private bool CanManageContract(OrgChartNode node)
    {
        if (node == null || node.UserId == Guid.Empty || node.UserId == _currentUserId) return false;
        if (_userRole == UserRole.Admin.ToString()) return true;
        if (_userRole == UserRole.LineManager.ToString()) return _subordinateIds.Contains(node.UserId);
        return false;
    }

    private void OnViewRequestClicked(OrgChartNode node)
    {
        if (!node.HasPendingRequest)
        {
            Toast.ShowInfo($"No pending requests for {node.Name}.");
            return;
        }

        if (_userRole == UserRole.LineManager.ToString())
        {
            Nav.NavigateTo($"/manager/team?search={Uri.EscapeDataString(node.Name)}");
        }
        else if (_userDepartment.Equals("HR", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo($"/hr/dashboard?search={Uri.EscapeDataString(node.Name)}");
        }
        else
        {
            Nav.NavigateTo($"/admin/users?search={Uri.EscapeDataString(node.Name)}");
        }
    }

    private void OnManageContractClicked(OrgChartNode node)
    {
        if (_userRole == UserRole.LineManager.ToString())
        {
            Nav.NavigateTo($"/manager/team?search={Uri.EscapeDataString(node.Name)}");
        }
        else
        {
            Nav.NavigateTo($"/admin/users?search={Uri.EscapeDataString(node.Name)}");
        }
    }

    private static string GetContractPeriodText(OrgChartNode node)
    {
        if (!node.HasContract || !node.ContractStartDate.HasValue) return "—";
        var start = node.ContractStartDate.Value.ToString("dd.MM.yyyy");
        if (node.ContractEndDate.HasValue) return $"{start} - {node.ContractEndDate.Value:dd.MM.yyyy}";
        return $"{start} - Indefinite";
    }

    private static string GetContractStatusText(OrgChartNode node)
    {
        if (!node.HasContract || node.ContractType == null) return "—";
        return node.ContractType == ContractType.Determinate ? "Determinate" : "Indeterminate";
    }

    private List<OrgChartNode> GetSearchableNodes()
    {
        var list = new List<OrgChartNode>();
        if (_root == null) return list;

        bool isAdmin = _userRole == UserRole.Admin.ToString();
        bool isManager = _userRole == UserRole.LineManager.ToString();

        if (isAdmin)
        {
            CollectAllNodes(_root, list);
        }
        else if (isManager)
        {
            var selfNode = FindNodeInTree(_root, _currentUserId);
            if (selfNode != null)
            {
                CollectAllNodes(selfNode, list);
            }
        }
        else
        {
            var selfNode = FindNodeInTree(_root, _currentUserId);
            if (selfNode != null)
            {
                list.Add(selfNode);
            }
        }

        return list.Where(n => !string.IsNullOrWhiteSpace(n.Name) && n.Name != "Company HQ").ToList();
    }

    private void CollectAllNodes(OrgChartNode node, List<OrgChartNode> list)
    {
        list.Add(node);
        foreach (var child in node.Subordinates)
        {
            CollectAllNodes(child, list);
        }
    }
}
