    private void SwitchLevel(HierarchyLevel level)
    {
        _currentLevel = level;
        StateHasChanged();
    }

    private void OpenOrgChartForHub(RomaniaHubModel? hub)
    {
        if (_activeRomaniaCounty != null)
        {
            _selectedCityFilter = _activeRomaniaCounty.CountySeat;
            
            if (hub != null)
            {
                // Simple mapping from hub names to DB site names, or fallback to hub.Name
                if (hub.IsHQ || hub.Name.Contains("HQ"))
                    _selectedSiteFilter = "Siemens HQ";
                else if (hub.Name.Contains("Digital Industry") || hub.Name.Contains("Industry Software"))
                    _selectedSiteFilter = "Siemens Digital Industry Software";
                else if (hub.Name.Contains("R&D Advanta") || (hub.Name.Contains("R&D") && _selectedCityFilter == "Brașov"))
                    _selectedSiteFilter = "Siemens R&D"; 
                else if (hub.Name.Contains("Advanta"))
                    _selectedSiteFilter = "Siemens Advanta";
                else if (hub.Name.Contains("R&D") || hub.Name.Contains("Energy") || hub.Name.Contains("Grid"))
                    _selectedSiteFilter = "Siemens R&D"; // Fallback mapping based on existing DB sites
                else
                    _selectedSiteFilter = "Toate"; // If we can't reliably map the specific hub to a DB Site
            }
            else
            {
                _selectedSiteFilter = "Toate";
            }
            
            // Ensure the city actually exists in our filter list to avoid empty UI states
            if (!_cities.Contains(_selectedCityFilter))
                _selectedCityFilter = "Toate";
                
            ApplyFilters();
        }

        SwitchLevel(HierarchyLevel.SiteOrgChart);
    }

