    private async Task OpenOrgChartForHub(RomaniaHubModel? hub)
    {
        if (_activeRomaniaCounty != null)
        {
            _selectedCityFilter = _activeRomaniaCounty.CountySeat;
            
            // Ensure the city actually exists in our filter list to avoid empty UI states
            if (!_cities.Contains(_selectedCityFilter))
                _selectedCityFilter = "Toate";
                
            if (hub != null)
            {
                string? siteFilter = null;
                if (hub.Name.Contains("Digital Industry Software")) siteFilter = "Siemens Digital Industry Software";
                else if (hub.Name.Contains("R&D")) siteFilter = "Siemens R&D";
                else if (hub.Name.Contains("Advanta")) siteFilter = "Siemens Advanta";
                else if (hub.Name.Contains("HQ")) siteFilter = "Siemens HQ";
                
                if (siteFilter != null && _sites.Contains(siteFilter))
                    _selectedSiteFilter = siteFilter;
                else
                    _selectedSiteFilter = "Toate";
            }
            else
            {
                _selectedSiteFilter = "Toate";
            }
                
            await OnFilterChangedAsync();
        }

        SwitchLevel(HierarchyLevel.CompanyOrgChart);
    }

