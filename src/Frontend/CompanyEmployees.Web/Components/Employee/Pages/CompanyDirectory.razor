@page "/employee/org-chart"
@layout CompanyEmployees.Web.Components.Layout.EmployeeLayout
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Application
@using CompanyEmployees.Domain.Enums
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@using CompanyEmployees.Web.Models
@using CompanyEmployees.Web.Services
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Nav
@inject IToastService Toast
@inject IJSRuntime JSRuntime
@inject ILogger<CompanyDirectory> Logger
@implements IDisposable

<PageTitle>Organization Chart · Global Directory</PageTitle>

<div class="page-shell">
<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true"
             VerticalAlignment="VerticalAlignment.Center" Width="100%">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8"
                     VerticalAlignment="VerticalAlignment.Center">
            <FluentLabel Typo="Typography.PaneHeader" Weight="FontWeight.Bold">Global Organization Chart</FluentLabel>
            @* A caption for the title, not something to press — so it stops wearing the colour
               that means "press me". *@
            <FluentBadge Appearance="Appearance.Neutral">
                @(_currentLevel == HierarchyLevel.World ? "Level 1: Global Continents" : "Level 5: Site Org Chart")
            </FluentBadge>
        </FluentStack>

        <FluentBreadcrumb>
            @if (_userRole == UserRole.CountryManager.ToString())
            {
                <FluentBreadcrumbItem Href="javascript:void(0)"
                                      @onclick="@(() => SwitchLevel(HierarchyLevel.World))">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Map())" Slot="start" />
                    Romania Map
                </FluentBreadcrumbItem>
            }
            @if (_currentLevel == HierarchyLevel.CompanyOrgChart)
            {
                <FluentBreadcrumbItem>
                    <FluentIcon Value="@(new Icons.Regular.Size16.Building())" Slot="start" />
                    Site Org Chart
                </FluentBreadcrumbItem>
            }
        </FluentBreadcrumb>
    </FluentStack>

    <FluentSpacer />

    @if (_userRole == UserRole.CountryManager.ToString())
    {
        @* A view switcher, not two actions. Accent here meant "this view is selected", which is the
           same paint the app uses for "this is the thing to press" — so the page appeared to have two
           primary buttons that happened to swap. Neutral for the selected side and stealth for the
           other reads as one segmented control and gives the accent back to real actions. *@
        <FluentButton Appearance="@(_currentLevel == HierarchyLevel.World ? Appearance.Neutral : Appearance.Stealth)"
                      IconStart="@(new Icons.Regular.Size20.Map())"
                      OnClick="@(() => SwitchLevel(HierarchyLevel.World))">
            Romania Map
        </FluentButton>
        <FluentButton Appearance="@(_currentLevel == HierarchyLevel.CompanyOrgChart ? Appearance.Neutral : Appearance.Stealth)"
                      IconStart="@(new Icons.Regular.Size20.Organization())"
                      OnClick="@(() => SwitchLevel(HierarchyLevel.CompanyOrgChart))">
            Org Tree
        </FluentButton>
    }

    @* Only where there is a tree to search. The people it searches come from _root, which is
       loaded with the org tree — on the world map that is null, so the box sat there taking
       input and never returning a single result, with nothing to say why. Focus Me below was
       already hidden for the same reason. *@
    @if (_currentLevel == HierarchyLevel.CompanyOrgChart)
    {
    <style>
        /* Force override any cached CSS and hide the extra clear button */
        fluent-autocomplete::part(clear-button),
        fluent-search::part(clear-button),
        fluent-text-field::part(clear-button) {
            display: none !important;
        }
        fluent-autocomplete::part(control)::-webkit-search-cancel-button,
        fluent-autocomplete::part(control)::-webkit-search-decoration,
        fluent-autocomplete::part(control)::-webkit-search-results-button,
        fluent-autocomplete::part(control)::-webkit-search-results-decoration {
            display: none !important;
            -webkit-appearance: none !important;
        }
        .org-path-highlight::part(positioning-region) {
            background-color: rgba(245, 124, 0, 0.15) !important;
            border-radius: 4px !important;
            box-shadow: inset 3px 0 0 0 #F57C00 !important;
            border-left: none !important;
            padding-left: 0 !important;
        }
        .org-search-result::part(positioning-region) {
            background-color: rgba(118, 255, 3, 0.25) !important;
            border-radius: 4px !important;
            box-shadow: inset 3px 0 0 0 #76FF03 !important;
            border-left: none !important;
            padding-left: 0 !important;
        }
        .org-current-user::part(positioning-region) {
            background-color: rgba(255, 193, 7, 0.15) !important;
            border-radius: 4px !important;
            box-shadow: inset 3px 0 0 0 #FFC107 !important;
            border-left: none !important;
            padding-left: 0 !important;
        }
        .org-search-autocomplete,
        .focus-me-btn {
            --accent-fill-rest: #009999 !important;
            --accent-foreground-rest: #009999 !important;
            --accent-foreground-active: #009999 !important;
            --accent-foreground-hover: #009999 !important;
            --accent-fill-active: #009999 !important;
            --accent-fill-hover: #009999 !important;
        }
        .org-search-autocomplete::part(search-icon),
        .org-search-autocomplete svg,
        .focus-me-btn::part(start) svg,
        .focus-me-btn svg {
            fill: #009999 !important;
            color: #009999 !important;
        }
    </style>
    <FluentStack Horizontal="true" Tokens="10" Style="margin-bottom: 20px; align-items: center; flex-wrap: wrap;">
        <FluentSelect TOption="string"
                      Items="@_cities"
                      @bind-SelectedOption="_selectedCityFilter"
                      @bind-SelectedOption:after="OnFilterChangedAsync"
                      OptionText="@(c => c)"
                      OptionValue="@(c => c)"
                      Placeholder="Filtru Oraș"
                      Width="140px" />



        <FluentSelect TOption="string"
                      Items="@_sites"
                      @bind-SelectedOption="_selectedSiteFilter"
                      @bind-SelectedOption:after="OnFilterChangedAsync"
                      OptionText="@(s => s)"
                      OptionValue="@(s => s)"
                      Placeholder="Filtru Sediu"
                      Width="160px" />

        <FluentSelect TOption="string"
                      Items="@_departments"
                      @bind-SelectedOption="_selectedDepartmentFilter"
                      @bind-SelectedOption:after="OnFilterChangedAsync"
                      OptionText="@(d => d)"
                      OptionValue="@(d => d)"
                      Placeholder="Filtru Departament"
                      Width="180px" />
        <FluentAutocomplete Class="org-search-autocomplete"
                            TOption="OrgChartNode"
                            Placeholder="Search people..."
                            autocomplete="off"
                            OnOptionsSearch="OnSearchAsync"
                            OptionText="@(node => node.Name)"
                            OptionValue="@(node => node.UserId.ToString())"
                            MaximumSelectedOptions="1"
                            MaximumOptionsSearch="10"
                            SelectedOptions="@_searchSelection"
                            SelectedOptionsChanged="OnSearchNodeSelected"
                            Width="250px">
            <OptionTemplate Context="node">
                <FluentPersona Name="@node.Name" Initials="@node.Initials" ImageSize="24px"
                               TextPosition="TextPosition.End">
                    <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@node.Name</FluentLabel>
                    <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                        @{
                            var parts = new List<string>();
                            if (!string.IsNullOrWhiteSpace(node.City)) parts.Add(node.City);
                            if (!string.IsNullOrWhiteSpace(node.Site)) parts.Add(node.Site);
                            if (!string.IsNullOrWhiteSpace(node.Department)) parts.Add(node.Department);
                            if (!string.IsNullOrWhiteSpace(node.Role)) parts.Add(node.Role);
                        }
                        @string.Join(" | ", parts)
                    </FluentLabel>
                </FluentPersona>
            </OptionTemplate>
        </FluentAutocomplete>

        <FluentButton Class="focus-me-btn"
                      Appearance="Appearance.Outline"
                      OnClick="FocusOnSelf">
            <FluentIcon Value="@(new Icons.Regular.Size20.Target())" Color="Color.Custom" CustomColor="#009999" Slot="start" />
            Focus Me
        </FluentButton>
    </FluentStack>
    }
</FluentStack>

@if (_currentLevel == HierarchyLevel.World)
{
    @* The hand-drawn vector map was the one thing on this page with no Fluent equivalent;
       the same information is now a card per region, which also makes the counts readable
       without hovering. *@
    <div style="position: relative; width: 100%; height: 650px; background: var(--neutral-layer-2); overflow: hidden; margin-top: 16px; border-radius: 8px;">
        <svg width="100%" height="100%" viewBox="0 0 1000 650" preserveAspectRatio="xMidYMid meet">
            <defs>
                <style>
                    .romania-county-path {
                        fill: var(--neutral-fill-rest);
                        stroke: #009999;
                        stroke-width: 1.4px;
                        stroke-linejoin: round;
                        stroke-linecap: round;
                        transition: fill 0.25s ease, stroke 0.25s ease, stroke-width 0.25s ease, filter 0.25s ease;
                        filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.15));
                        cursor: pointer;
                    }
                    .romania-county-path.has-presence {
                        fill: var(--neutral-fill-secondary-rest);
                        stroke: #009999;
                        stroke-width: 1.8px;
                        filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.25));
                    }
                    .romania-county-group:hover .romania-county-path,
                    .romania-county-path.selected {
                        fill: var(--neutral-fill-stealth-hover);
                        stroke: #009999;
                        stroke-width: 2.5px;
                        filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.4));
                    }

                    /* Siemens Pin styles - Light Mode */
                    .siemens-pin-dot {
                        fill: #009999;
                        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
                    }
                    .siemens-pin-hq {
                        fill: #E68A00;
                        filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.35));
                    }
                    .siemens-hq-pulse-ring {
                        fill: none;
                        stroke: #E68A00;
                        stroke-width: 2px;
                        animation: romaniaPulse 2s cubic-bezier(0.25, 0.8, 0.25, 1) infinite;
                    }
                    .siemens-hub-pulse-ring {
                        fill: none;
                        stroke: #009999;
                        stroke-width: 1.8px;
                        animation: romaniaPulse 2.2s cubic-bezier(0.25, 0.8, 0.25, 1) infinite;
                    }

                    /* City Tag Badges Light */
                    .siemens-city-tag-hq {
                        fill: var(--neutral-layer-1);
                        stroke: #E68A00;
                        stroke-width: 1.5px;
                        filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.15));
                    }
                    .siemens-city-text-hq {
                        font-family: 'Roboto', 'Inter', sans-serif;
                        font-size: 11px;
                        font-weight: 800;
                        fill: #E68A00;
                        letter-spacing: 0.5px;
                    }
                    .siemens-city-tag {
                        fill: var(--neutral-layer-1);
                        stroke: #009999;
                        stroke-width: 1.2px;
                        filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.12));
                    }
                    .siemens-city-text {
                        font-family: 'Roboto', 'Inter', sans-serif;
                        font-size: 10px;
                        font-weight: 700;
                        fill: #009999;
                        letter-spacing: 0.4px;
                    }

                    @@keyframes romaniaPulse {
                        0% { r: 6; opacity: 1; }
                        100% { r: 18; opacity: 0; }
                    }
                </style>

                <pattern id="romaniaCyberGrid" width="40" height="40" patternUnits="userSpaceOnUse">
                    <path d="M 40 0 L 0 0 0 40" fill="none" stroke="var(--neutral-stroke-divider-rest)" stroke-width="1"/>
                </pattern>
            </defs>

            <!-- Grid Background -->
            <rect width="100%" height="100%" fill="url(#romaniaCyberGrid)" />

            <!-- Romanian Counties Group -->
            @foreach (var county in _romaniaCounties)
            {
                bool isSelected = _activeRomaniaCounty?.Id == county.Id;
                <g class="romania-county-group @(isSelected ? "county-active" : "")"
                   @onclick="() => _activeRomaniaCounty = county"
                   cursor="pointer">
                    
                    <path d="@county.SvgPath"
                          class="romania-county-path @(county.HasSiemensPresence ? "has-presence" : "") @(isSelected ? "selected" : "")" />
                </g>
            }

            <!-- Accentuated Siemens Presence Cities -->
            @foreach (var county in _romaniaCounties.Where(c => c.HasSiemensPresence))
            {
                bool isHubSelected = _activeRomaniaCounty?.Id == county.Id;
                string tagText = county.IsHQ ? "⭐ BUCUREȘTI HQ" : county.CountySeat.ToUpper();
                
                string tagTransform = county.CountySeat switch
                {
                    "Brașov" => "translate(10, 8)",
                    "Sibiu" => "translate(-75, -12)",
                    "Craiova" => "translate(10, 8)",
                    "Timișoara" => "translate(10, -12)",
                    "București" => "translate(14, -14)",
                    _ => "translate(10, -12)"
                };

                int badgeWidth = county.IsHQ ? 135 : (county.CountySeat.Length > 8 ? 120 : 90);

                <g class="siemens-hub-pin-group @(isHubSelected ? "selected-hub" : "")"
                   transform="@($"translate({county.CenterX.ToString(System.Globalization.CultureInfo.InvariantCulture)}, {county.CenterY.ToString(System.Globalization.CultureInfo.InvariantCulture)})")"
                   @onclick="() => _activeRomaniaCounty = county"
                   cursor="pointer">
                    @if (county.IsHQ)
                    {
                        <circle r="14" class="siemens-hq-pulse-ring" />
                        <circle r="7" class="siemens-pin-hq" />
                        <circle r="3" fill="#ffffff" />
                        <g transform="@tagTransform">
                            <rect width="@badgeWidth" height="24" rx="12" class="siemens-city-tag-hq" />
                            <text x="12" y="16" class="siemens-city-text-hq">@tagText</text>
                        </g>
                    }
                    else
                    {
                        <circle r="10" class="siemens-hub-pulse-ring" />
                        <circle r="5" class="siemens-pin-dot" />
                        <circle r="2" fill="#ffffff" />
                        <g transform="@tagTransform">
                            <rect width="@badgeWidth" height="20" rx="10" class="siemens-city-tag" />
                            <text x="10" y="14" class="siemens-city-text">@tagText</text>
                        </g>
                    }
                </g>
            }
        </svg>

        @if (_activeRomaniaCounty != null)
        {
            <div style="position: absolute; left: 40px; top: 40px; max-width: 320px; z-index: 10;">
                <FluentCard Style="background: var(--neutral-layer-floating); backdrop-filter: blur(4px); border: 2px solid #009999;">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="padding: 16px;">
                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                            <FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">@_activeRomaniaCounty.Name</FluentLabel>
                            <FluentSpacer />
                            <FluentButton Appearance="Appearance.Stealth" IconStart="@(new Icons.Regular.Size16.Dismiss())" OnClick="@(() => _activeRomaniaCounty = null)" />
                        </FluentStack>
                        
                        @if (_activeRomaniaCounty.HasSiemensPresence)
                        {
                            <FluentDivider />
                            <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">Siemens sites:</FluentLabel>
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="8" Width="100%">
                                @foreach (var hub in _activeRomaniaCounty.Hubs)
                                {
                                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12" Width="100%">
                                        <div style="flex-grow: 1; padding: 12px; border-radius: 4px; border: 1px solid var(--neutral-stroke-rest); background: var(--neutral-fill-stealth-rest);">
                                            <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@hub.Name</FluentLabel>
                                        </div>
                                        <FluentButton Appearance="Appearance.Accent" OnClick="@(() => OpenOrgChartForHub(hub))">Open</FluentButton>
                                    </FluentStack>
                                }
                            </FluentStack>
                            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" Style="margin-top: 16px;">
                                <FluentButton Appearance="Appearance.Outline" OnClick="@(() => OpenOrgChartForHub(null))">Open full chart</FluentButton>
                            </FluentStack>
                        }
                    </FluentStack>
                </FluentCard>
            </div>
        }
    </div>
}
else if (_root == null)
{
    <FluentProgressRing />
}
else
{
    <FluentGrid Spacing="3" Style="margin-top:16px;">
        <FluentGridItem xs="12" md="7">
            <FluentCard Style="padding:16px; height:75vh; overflow:auto;">
                @* The rows hold a two-line persona, which is taller than a tree item's own
                   fixed row height; app.css lets the row grow to it. *@
                <FluentTreeView Class="org-tree">
                    @{
                        var activeRoot = _displayRoot ?? _root;
                    }
                    @if (activeRoot.Role == "Headquarters")
                    {
                        @foreach (var child in activeRoot.Subordinates)
                        {
                            <OrgTreeNode @key="child.UserId" Node="@child" SelectedId="@(_selectedNode?.UserId ?? Guid.Empty)"
                                         CurrentUserId="@_currentUserId" OnSelect="OnNodeSelected" OnExpand="LoadChildrenAsync" RenderToken="@_renderToken" />
                        }
                    }
                    else
                    {
                        <OrgTreeNode @key="activeRoot.UserId" Node="@activeRoot" SelectedId="@(_selectedNode?.UserId ?? Guid.Empty)"
                                     CurrentUserId="@_currentUserId" OnSelect="OnNodeSelected" OnExpand="LoadChildrenAsync" RenderToken="@_renderToken" />
                    }
                </FluentTreeView>
            </FluentCard>
        </FluentGridItem>

        <FluentGridItem xs="12" md="5">
            @* Sized by its content, with a ceiling rather than a fixed height: the panel holds a
               persona, four rows and sometimes a button row, and pinning it to the tree's 75vh
               left a card that was three quarters empty. The ceiling keeps it level with the tree
               when somebody's details run long. *@
            <FluentCard Style="padding:16px; max-height:75vh; overflow:auto;">
                @if (_selectedNode is null)
                {
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8"
                                 HorizontalAlignment="HorizontalAlignment.Center">
                        <FluentIcon Value="@(new Icons.Regular.Size24.Person())" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" />
                        <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                            Pick somebody in the tree to see their details.
                        </FluentLabel>
                    </FluentStack>
                }
                else
                {
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                        <FluentPersona Name="@_selectedNode.Name" Initials="@_selectedNode.Initials"
                                       ImageSize="64px" TextPosition="TextPosition.End">
                            @* FluentPersona drops its Name whenever ChildContent is supplied, so the name is
                               rendered here explicitly above the secondary line. *@
                            <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@_selectedNode.Name</FluentLabel>
                            <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                                @_selectedNode.Role
                            </FluentLabel>
                        </FluentPersona>

                        <FluentDivider Role="DividerRole.Presentation" />

                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
                            <FluentStack Orientation="Orientation.Horizontal" Width="100%">
                                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Department</FluentLabel>
                                <FluentSpacer />
                                @* Admins belong to no department by design, and the field read as
                                   blank rather than as "none". *@
                                <FluentLabel Typo="Typography.Body">
                                    @(string.IsNullOrWhiteSpace(_selectedNode.Department) ? "—" : _selectedNode.Department)
                                </FluentLabel>
                            </FluentStack>
                            <FluentStack Orientation="Orientation.Horizontal" Width="100%">
                                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Role</FluentLabel>
                                <FluentSpacer />
                                <FluentLabel Typo="Typography.Body">@_selectedNode.Role</FluentLabel>
                            </FluentStack>
                            @* The chart spans every country now, so the row's own is worth
                               stating: it is also what decides whether the buttons below appear. *@
                            @if (!string.IsNullOrEmpty(_selectedNode.Region))
                            {
                                <FluentStack Orientation="Orientation.Horizontal" Width="100%">
                                    <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Region</FluentLabel>
                                    <FluentSpacer />
                                    <FluentLabel Typo="Typography.Body">@_selectedNode.Region</FluentLabel>
                                </FluentStack>
                            }
                            @* City/Site are optional — most seed accounts have neither, so the
                               row only appears once there is something to show. Both on one line
                               ("Cluj-Napoca · Siemens Advanta") rather than a row apiece: they
                               are one fact, "where", not two. *@
                            @if (!string.IsNullOrEmpty(_selectedNode.City) || !string.IsNullOrEmpty(_selectedNode.Site))
                            {
                                <FluentStack Orientation="Orientation.Horizontal" Width="100%">
                                    <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Location</FluentLabel>
                                    <FluentSpacer />
                                    <FluentLabel Typo="Typography.Body">
                                        @(string.Join(" · ", new[] { _selectedNode.City, _selectedNode.Site }
                                            .Where(value => !string.IsNullOrEmpty(value))))
                                    </FluentLabel>
                                </FluentStack>
                            }
                            <FluentStack Orientation="Orientation.Horizontal" Width="100%">
                                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Contract</FluentLabel>
                                <FluentSpacer />
                                <FluentLabel Typo="Typography.Body">@GetContractPeriodText(_selectedNode)</FluentLabel>
                            </FluentStack>
                            <FluentStack Orientation="Orientation.Horizontal" Width="100%">
                                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Contract Status</FluentLabel>
                                <FluentSpacer />
                                @if (_selectedNode.HasContract && _selectedNode.ContractType != null)
                                {
                                    <FluentBadge Appearance="@(_selectedNode.ContractType == ContractType.Determinate
                                                              ? Appearance.Lightweight : Appearance.Accent)">
                                        @GetContractStatusText(_selectedNode)
                                    </FluentBadge>
                                }
                                else
                                {
                                    <FluentLabel Typo="Typography.Body">—</FluentLabel>
                                }
                            </FluentStack>
                        </FluentStack>

                        @if (_isManagerOrHr && _selectedNode.UserId != _currentUserId)
                        {
                            <FluentDivider Role="DividerRole.Presentation" />

                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                                @if (!CanManageRequests(_selectedNode))
                                {
                                    <FluentButton Disabled="true"
                                                  IconStart="@(new Icons.Regular.Size20.LockClosed())"
                                                  Title="Leave requests can only be approved by Line Managers or HR">
                                        Requests locked
                                    </FluentButton>
                                }
                                else
                                {
                                    <FluentButton Appearance="@(_selectedNode.HasPendingRequest ? Appearance.Accent : Appearance.Outline)"
                                                  IconStart="@(new Icons.Regular.Size20.CalendarLtr())"
                                                  Title="@(_selectedNode.HasPendingRequest ? "View pending leave request" : "No pending leave requests")"
                                                  OnClick="@(() => OnViewRequestClicked(_selectedNode))">
                                        @(_selectedNode.HasPendingRequest ? "View Request" : "No Request")
                                    </FluentButton>
                                }

                                @if (!CanManageContract(_selectedNode))
                                {
                                    <FluentButton Disabled="true"
                                                  IconStart="@(new Icons.Regular.Size20.LockClosed())"
                                                  Title="Contract management locked for superiors or unauthorized roles">
                                        Contract locked
                                    </FluentButton>
                                }
                                else
                                {
                                    <FluentButton Appearance="Appearance.Outline"
                                                  IconStart="@(new Icons.Regular.Size20.DocumentText())"
                                                  Title="Manage contract for this employee"
                                                  OnClick="@(() => OnManageContractClicked(_selectedNode))">
                                        Manage Contract
                                    </FluentButton>
                                }
                            </FluentStack>
                        }
                    </FluentStack>
                }
            </FluentCard>
        </FluentGridItem>
    </FluentGrid>
}
</div>

@code {
    private enum HierarchyLevel
    {
        World,
        CompanyOrgChart
    }

    private HierarchyLevel _currentLevel = HierarchyLevel.World;

    private class ContinentModel
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string RegionCode { get; set; } = "";
        public string LeadRole { get; set; } = "";
        public string LeadName { get; set; } = "";
        public int TotalEmployeesCount { get; set; }
        public int ActiveCountriesCount { get; set; }
        public int ActiveHubsCount { get; set; }
    }

    private List<ContinentModel> _continents = new();
    private List<RomaniaCountyModel> _romaniaCounties = new();
    private RomaniaCountyModel? _activeRomaniaCounty;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    // Where the global search lands: /employee/org-chart?focus={userId}. The page opens on
    // the world map by default, so arriving with a person named has to switch the level too,
    // or the link appears to do nothing.
    [SupplyParameterFromQuery(Name = "focus")]
    public Guid? Focus { get; set; }

    private OrgChartNode? _root;
    private OrgChartNode? _displayRoot;

    private List<string> _cities = new() { "Toate" };
    private List<string> _sites = new() { "Toate" };
    private List<string> _departments = new() { "Toate" };
    private string _selectedCityFilter = "Toate";
    private string _selectedSiteFilter = "Toate";
    private string _selectedDepartmentFilter = "Toate";

    private void PopulateFilterOptions(OrgChartNode node)
    {
        var allNodes = new List<OrgChartNode>();
        CollectAllNodes(node, allNodes);
        
        _cities = new List<string> { "Toate", "Brașov", "București", "Cluj-Napoca" };
        
        _sites = new List<string> { "Toate", "Siemens Advanta", "Siemens Digital Industry Software", "Siemens HQ", "Siemens R&D" };
        
        _departments = new List<string> { "Toate", "Cloud", "Design", "Engineering", "Executive", "HR", "Industry Software", "Marketing", "Production", "Sales", "Support" };
    }

    private void ApplyFilters()
    {
        if (_root == null)
        {
            _displayRoot = null;
            return;
        }

        bool isCityAll = string.IsNullOrEmpty(_selectedCityFilter) || _selectedCityFilter == "Toate";
        bool isSiteAll = string.IsNullOrEmpty(_selectedSiteFilter) || _selectedSiteFilter == "Toate";
        bool isDeptAll = string.IsNullOrEmpty(_selectedDepartmentFilter) || _selectedDepartmentFilter == "Toate";

        if (isCityAll && isSiteAll && isDeptAll)
        {
            _displayRoot = _root;
            return;
        }

        _displayRoot = CloneAndFilterTree(_root);
    }

    private async Task OnFilterChangedAsync()
    {
        _root = await QueryAsync(employees => employees.GetCompanyOrgChartAsync(_currentUserId, null, _selectedCityFilter, _selectedSiteFilter, _selectedDepartmentFilter));
        ApplyFilters();
    }

    private void UpdateFilters()
    {
        if (_root != null)
        {
            PopulateFilterOptions(_root);
            ApplyFilters();
        }
    }

    private OrgChartNode? CloneAndFilterTree(OrgChartNode node)
    {
        bool matches = true;
        if (!string.IsNullOrEmpty(_selectedCityFilter) && _selectedCityFilter != "Toate" && node.City != _selectedCityFilter) matches = false;
        
        if (!string.IsNullOrEmpty(_selectedSiteFilter) && _selectedSiteFilter != "Toate" && node.Site != _selectedSiteFilter) matches = false;
        
        if (!string.IsNullOrEmpty(_selectedDepartmentFilter) && _selectedDepartmentFilter != "Toate" && node.Department != _selectedDepartmentFilter) matches = false;

        var clonedChildren = new List<OrgChartNode>();
        foreach(var child in node.Subordinates)
        {
            var filteredChild = CloneAndFilterTree(child);
            if (filteredChild != null)
                clonedChildren.Add(filteredChild);
        }

        // If the node is a placeholder (like Department node), we keep it if it has matching children
        bool isDepartmentNode = node.Role == "Department";

        if (matches || clonedChildren.Count > 0 || (isDepartmentNode && clonedChildren.Count > 0))
        {
            // Note: If it's a person and they don't match, but a subordinate does, they are kept
            // to maintain the tree hierarchy.
            return new OrgChartNode
            {
                UserId = node.UserId,
                Name = node.Name,
                Email = node.Email,
                Role = node.Role,
                Department = node.Department,
                City = node.City,
                Site = node.Site,
                
                Initials = node.Initials,
                ManagerId = node.ManagerId,
                Subordinates = clonedChildren,
                IsExpanded = (clonedChildren.Count > 0 && node.Role != "LineManager") || node.IsExpanded,
                HasUnloadedChildren = node.HasUnloadedChildren,
                IsFocusNode = node.IsFocusNode
            };
        }

        return null;
    }
    private OrgChartNode? _selectedNode;

    private bool _isManagerOrHr = false;
    private string _userRole = "";
    private string _userDepartment = "";
    private Guid _currentUserId = Guid.Empty;
    private Guid _currentRegionId = Guid.Empty;
    private HashSet<Guid> _subordinateIds = new();
    private long _renderToken = 0;

    private IEnumerable<OrgChartNode> _searchSelection = [];

    // Which ?focus= the current tree was built for, so the same one is not reloaded on every
    // parameter set, and a different one always is.
    private Guid? _loadedFocus;

    // Set when a focused tree has just been built and its row still needs the JS pass.
    private Guid? _highlightPending;

    // Two separate problems, one helper.
    //
    // The scope: injecting EmployeeContext directly hands this page the *circuit's* DbContext,
    // shared with DbTimeOffService and with whatever the page before it left running. Two
    // overlapping operations on one context is what EF refuses with "a second operation was
    // started on this context instance", and it took the org chart down every time it was
    // reached by a client-side navigation — a full reload worked only because prerender and
    // circuit each get their own scope. NotificationBell and GlobalSearchBox already do this.
    //
    // The lock: the page's own reads can overlap each other too — OnInitializedAsync,
    // OnParametersSetAsync and an expand can all be in flight at once — and a private scope
    // would not save us from that.
    private readonly SemaphoreSlim _dbLock = new(1, 1);

    private async Task<T> QueryAsync<T>(Func<EmployeeContext, Task<T>> query)
    {
        await _dbLock.WaitAsync();
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            return await query(scope.ServiceProvider.GetRequiredService<EmployeeContext>());
        }
        finally
        {
            _dbLock.Release();
        }
    }

    public void Dispose() => _dbLock.Dispose();

    protected override async Task OnInitializedAsync()
    {
        InitializeContinentsData();
        _romaniaCounties = RomaniaMapData.GetCounties();

        if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, true))
            return;

        var authState = await AuthStateTask!;
        var userIdString = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        _userRole = authState.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
        _userDepartment = authState.User.FindFirst("Department")?.Value ?? "";
        Guid.TryParse(authState.User.FindFirst("RegionId")?.Value, out _currentRegionId);

        if (_userRole != UserRole.CountryManager.ToString())
        {
            _currentLevel = HierarchyLevel.CompanyOrgChart;
        }

        _isManagerOrHr = _userRole == UserRole.LineManager.ToString() ||
                         _userRole == UserRole.Admin.ToString() ||
                         _userDepartment.Equals("HR", StringComparison.OrdinalIgnoreCase);

        if (!Guid.TryParse(userIdString, out var userId))
            return;

        _currentUserId = userId;

        // An unhandled exception here tears the circuit down and the user gets the red bar with
        // no idea what happened. These are two whole-company reads; say what went wrong and
        // leave the page standing.
        try
        {
            // Skipped entirely when arriving with ?focus=: OnParametersSetAsync is about to
            // replace this tree with one built around the target, so building the company tree
            // first was a second full-roster read whose result went straight in the bin.
            if (Focus is null)
            {
                _root = await QueryAsync(employees => employees.GetCompanyOrgChartAsync(userId));
                if (_root != null)
                {
                    ExpandPathToNode(_root, userId);
                    _selectedNode = FindNodeInTree(_root, userId);
                    UpdateFilters();
                    if (_selectedNode != null)
                    {
                        _ = SyncTreeHighlightAsync(userId);
                    }
                }
            }

            // From the reporting graph, once, rather than from whichever tree happens to be on
            // screen: the focused view is built around somebody else and usually does not
            // contain the viewer, which used to leave a manager with no buttons on their own
            // reports.
            _subordinateIds = await QueryAsync(employees => employees.GetManagedUserIdsAsync(userId));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load the org chart for {UserId}.", userId);
            Toast.ShowError($"Could not load the organisation chart: {exception.Message}");
        }
    }

    // ?focus= is answered here rather than in OnInitializedAsync: searching for a second person
    // while already on this page reuses the component, so OnInitializedAsync never runs again
    // and the new parameter would be ignored — the tree would keep showing the previous one.
    protected override async Task OnParametersSetAsync()
    {
        if (_currentUserId == Guid.Empty || Focus == _loadedFocus)
            return;

        _loadedFocus = Focus;
        if (Focus is not Guid target)
            return;

        // The ordinary tree opens on *you*, so the person just searched for sits behind some
        // unexpanded branch. Ask for the tree built around them instead.
        //
        // Wrapped for the same reason as OnInitializedAsync: this runs outside any event
        // handler, so an exception escaping it kills the circuit — the page freezes on whatever
        // it had rendered and the user gets the generic red bar with nothing to act on.
        OrgChartNode? focused;
        try
        {
            focused = await QueryAsync(employees =>
                employees.GetCompanyOrgChartAsync(_currentUserId, target));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not focus the org chart on {TargetId}.", target);
            Toast.ShowError($"Could not open that person's org chart: {exception.Message}");

            await EnsureDefaultTreeAsync();
            return;
        }

        if (focused == null)
        {
            // The directory is worldwide, so only a deactivated account or a stale link gets
            // here — not something to apologise for at length.
            Toast.ShowInfo("That employee is no longer in the directory.");
            await EnsureDefaultTreeAsync();
            return;
        }

        _root = focused;
        _currentLevel = HierarchyLevel.CompanyOrgChart;

        UpdateFilters();

        // Selects the row in the tree; the detail panel on the right reads the same field.
        _selectedNode = FindNodeInTree(_root, target);
        _highlightPending = target;
    }

    // OnInitializedAsync skips the company tree when ?focus= is present. If the focused load
    // then fails or finds nobody, the page would be left with no tree at all — this puts the
    // ordinary one back so it degrades to the normal chart instead of an empty card.
    private async Task EnsureDefaultTreeAsync()
    {
        if (_root != null)
            return;

        try
        {
            _root = await QueryAsync(employees => employees.GetCompanyOrgChartAsync(_currentUserId));
            UpdateFilters();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load the org chart for {UserId}.", _currentUserId);
        }
    }

    // The highlight and the scroll are JS, so they cannot run while the component is still
    // building its tree — the rows are not in the DOM yet. Running it after the render that
    // introduced them is what actually marks the row and brings it into view inside the tree's
    // own scrollbar. Not gated on firstRender: a second search lands on a later one.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_highlightPending is not Guid target)
            return;

        _highlightPending = null;
        await SyncTreeHighlightAsync(target);
    }

    private bool IsAdmin => _userRole == UserRole.Admin.ToString();

    // Raised by a tree item the first time it is opened. The chart spans the whole company, so
    // branches are fetched here rather than shipped with the page.
    private async Task LoadChildrenAsync(OrgChartNode node)
    {
        if (node.IsLoading)
            return;

        node.IsLoading = true;
        StateHasChanged();

        try
        {
            var children = await QueryAsync(employees =>
                employees.GetOrgChartChildrenAsync(node.UserId));

            if (_root != null)
            {
                var realNode = FindNodeInTree(_root, node.UserId);
                if (realNode != null)
                {
                    realNode.Subordinates = children;
                    realNode.HasUnloadedChildren = false;
                    realNode.IsExpanded = true;
                }
            }

            node.Subordinates = children;
            node.HasUnloadedChildren = false;
            node.IsExpanded = true;
            
            UpdateFilters();
        }
        catch (Exception)
        {
            // Left set so the next expand retries; the branch simply stays closed for now.
            node.IsExpanded = false;
            Toast.ShowError($"Could not load who reports to {node.Name}.");
        }
        finally
        {
            node.IsLoading = false;
            UpdateFilters();
            StateHasChanged();
        }
    }

    private bool PruneTreeToUserBranch(OrgChartNode current, Guid targetUserId)
    {
        if (current.UserId == targetUserId)
        {
            return true; // Keep this node and all its subordinates
        }

        var childrenToKeep = new List<OrgChartNode>();
        bool foundInSubtree = false;

        foreach (var child in current.Subordinates)
        {
            if (PruneTreeToUserBranch(child, targetUserId))
            {
                childrenToKeep.Add(child);
                foundInSubtree = true;
            }
        }

        if (foundInSubtree)
        {
            current.Subordinates = childrenToKeep;
        }

        return foundInSubtree;
    }

