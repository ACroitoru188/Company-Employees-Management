    private void ZoomIn()
    {
        _scale = Math.Min(_scale * 1.25, 5.0);
    }

    private void ZoomOut()
    {
        _scale = Math.Max(_scale * 0.8, 0.1);
    }

    private void ResetView()
    {
        if (_root != null)
        {
            _scale = 1.0;
            _translateX = 450 - _root.X;
            _translateY = 50;
        }
    }

    private void OnWheel(WheelEventArgs e)
    {
        if (_currentLevel == HierarchyLevel.World || _currentLevel == HierarchyLevel.Continent) return;

        double zoomFactor = e.DeltaY < 0 ? 1.1 : 0.9;
        double newScale = _scale * zoomFactor;
        if (newScale < 0.1) newScale = 0.1;
        if (newScale > 5.0) newScale = 5.0;

        double centerX = 600;
        double centerY = 300;
        double graphX = (centerX - _translateX) / _scale;
        double graphY = (centerY - _translateY) / _scale;

        _translateX = centerX - graphX * newScale;
        _translateY = centerY - graphY * newScale;
        _scale = newScale;
    }

    private void OnMouseDown(MouseEventArgs e)
    {
        if (_currentLevel == HierarchyLevel.World) return;
        _isDragging = true;
        _hasDragged = false;
        _startX = e.ClientX - _translateX;
        _startY = e.ClientY - _translateY;
    }

    private void OnMouseMove(MouseEventArgs e)
    {
        if (_currentLevel == HierarchyLevel.World) return;
        if (_isDragging)
        {
            _hasDragged = true;
            _translateX = e.ClientX - _startX;
            _translateY = e.ClientY - _startY;
        }
    }

    private void OnMouseUp(MouseEventArgs e)
    {
        if (_currentLevel == HierarchyLevel.World) return;
        _isDragging = false;
    }

    private async Task OnSearchNodeSelected(OrgChartNode? node)
    {
        _selectedSearchNode = node;
        if (node == null) return;

        if (_currentLevel != HierarchyLevel.SiteOrgChart)
        {
            SwitchLevel(HierarchyLevel.SiteOrgChart);
            await Task.Delay(100);
        }

        await FocusOnNode(node.UserId);
    }

    private async Task FocusOnSelf()
    {
        if (_currentLevel != HierarchyLevel.SiteOrgChart)
        {
            SwitchLevel(HierarchyLevel.SiteOrgChart);
            await Task.Delay(100);
        }
        await FocusOnNode(_currentUserId);
    }

    private async Task FocusOnNode(Guid targetUserId)
    {
        if (_root == null) return;

        bool found = ExpandPathToNode(_root, targetUserId);
        if (!found && targetUserId != _root.UserId)
        {
            Snackbar.Add("Employee is not within your accessible team structure.", Severity.Info);
            return;
        }

        RecalculateLayout();

        var targetNode = _nodes.FirstOrDefault(n => n.UserId == targetUserId) ?? _root;

        double containerWidth = 1100;
        double containerHeight = 550;

        try
        {
            var bounds = await JSRuntime.InvokeAsync<ElementBounds>("eval", "(() => { const el = document.getElementById('orgContainer'); return el ? { width: el.clientWidth, height: el.clientHeight } : { width: 1100, height: 550 }; })()");
            if (bounds != null && bounds.Width > 0 && bounds.Height > 0)
            {
                containerWidth = bounds.Width;
                containerHeight = bounds.Height;
            }
        }
        catch { }

        _scale = 1.0;
        _translateX = (containerWidth / 2.0) - (targetNode.X * _scale);
        _translateY = (containerHeight / 2.0) - (targetNode.Y * _scale);

        if (targetNode.UserId != _currentUserId && targetNode.UserId != Guid.Empty)
        {
            _hoveredNode = targetNode;
        }
        else
        {
            _hoveredNode = null;
        }

        StateHasChanged();
    }

    private bool ExpandPathToNode(OrgChartNode current, Guid targetUserId)
    {
        if (current.UserId == targetUserId) return true;

        foreach (var child in current.Subordinates)
        {
            if (ExpandPathToNode(child, targetUserId))
            {
                current.IsExpanded = true;
                return true;
            }
        }

        return false;
    }

    private class ElementBounds
    {
        public double Width { get; set; }
        public double Height { get; set; }
    }

    private void FlattenTree(OrgChartNode node)
    {
        _nodes.Add(node);
        if (node.IsExpanded)
        {
            foreach (var child in node.Subordinates)
            {
                _edges.Add((node, child));
                FlattenTree(child);
            }
        }
    }

    private void ToggleNodeExpand(OrgChartNode node)
    {
        node.IsExpanded = !node.IsExpanded;
        RecalculateLayout();
    }

    private void RecalculateLayout()
    {
        if (_root == null) return;
        EmployeeContext.CalculateSubtreeWidths(_root);
        EmployeeContext.CalculateNodeCoordinates(_root, 0, _root.SubtreeWidth / 2.0, 0, 50.0);
        _nodes.Clear();
        _edges.Clear();
        FlattenTree(_root);

        _subordinateIds.Clear();
        var selfNode = FindNodeInTree(_root, _currentUserId);
        if (selfNode != null)
        {
            CollectSubordinateIds(selfNode, _subordinateIds);
        }

        StateHasChanged();
    }

    private OrgChartNode? FindNodeInTree(OrgChartNode current, Guid targetId)
    {
        if (current.UserId == targetId) return current;
        foreach (var child in current.Subordinates)
        {
            var found = FindNodeInTree(child, targetId);
            if (found != null) return found;
        }
        return null;
    }

    private void CollectSubordinateIds(OrgChartNode node, HashSet<Guid> result)
    {
        foreach (var child in node.Subordinates)
        {
            result.Add(child.UserId);
            CollectSubordinateIds(child, result);
        }
    }

    private bool CanManageRequests(OrgChartNode node)
    {
        if (node == null || node.UserId == Guid.Empty || node.UserId == _currentUserId) return false;
        if (_userRole == UserRole.Admin.ToString() || _isManagerOrHr && _userDepartment != "HR" && _userRole != UserRole.LineManager.ToString()) return false;
        if (_userRole == UserRole.LineManager.ToString()) return _subordinateIds.Contains(node.UserId);
        if (_userDepartment.Equals("HR", StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private bool CanManageContract(OrgChartNode node)
    {
        if (node == null || node.UserId == Guid.Empty || node.UserId == _currentUserId) return false;
        if (_userRole == UserRole.Admin.ToString() || (_isManagerOrHr && _userDepartment != "HR" && _userRole != UserRole.LineManager.ToString()) || _userDepartment.Equals("HR", StringComparison.OrdinalIgnoreCase)) return true;
        if (_userRole == UserRole.LineManager.ToString()) return _subordinateIds.Contains(node.UserId);
        return false;
    }

    private void OnNodeMouseEnter(OrgChartNode node)
    {
        if (_isDragging || node.UserId == _currentUserId) return;
        _hoverCts?.Cancel();
        _hoveredNode = node;
    }

    private void OnNodeMouseLeave()
    {
        _hoverCts?.Cancel();
        _hoverCts = new CancellationTokenSource();
        var token = _hoverCts.Token;

        Task.Delay(250, token).ContinueWith(t =>
        {
            if (!t.IsCanceled && !_isMouseOverPanel)
            {
                InvokeAsync(() =>
                {
                    _hoveredNode = null;
                    StateHasChanged();
                });
            }
        });
    }

    private void OnPanelMouseEnter()
    {
        _isMouseOverPanel = true;
        _hoverCts?.Cancel();
    }

    private void OnPanelMouseLeave()
    {
        _isMouseOverPanel = false;
        OnNodeMouseLeave();
    }

