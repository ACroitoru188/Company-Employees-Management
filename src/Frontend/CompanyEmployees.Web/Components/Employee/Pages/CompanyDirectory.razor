@page "/employee/org-chart"
@layout CompanyEmployees.Web.Components.Layout.EmployeeLayout
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Application
@using CompanyEmployees.Domain.Enums
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@using CompanyEmployees.Web.Models
@using CompanyEmployees.Web.Services
@inject EmployeeContext EmployeeCtx
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject ThemeState ThemeState
@implements IDisposable

<PageTitle>Organization Chart · Global Directory</PageTitle>

<div class="d-flex justify-space-between align-center mb-3 flex-wrap gap-2">
    <div>
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.h5" Style="font-weight:700;">Global Organization Chart</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Style="font-weight: 600; font-size: 11px;">
                @(_currentLevel == HierarchyLevel.World ? "Level 1: Global Continents" : "Level 5: Site Org Chart")
            </MudChip>
        </div>
        <MudBreadcrumbs Items="_breadcrumbItems" Class="pa-0 mt-1" Separator=">">
            <ItemTemplate Context="item">
                <MudLink Href="@item.Href" OnClick="@(() => OnBreadcrumbClick(item))" Typo="Typo.caption" Style="cursor: pointer; font-weight: 600; color: var(--mud-palette-primary);">
                    @item.Text
                </MudLink>
            </ItemTemplate>
        </MudBreadcrumbs>
    </div>

    <div class="d-flex align-center gap-3 flex-wrap">
        @* Level Toggle Button Group *@
        <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Medium">
            <MudButton Variant="@(_currentLevel == HierarchyLevel.World ? Variant.Filled : Variant.Outlined)"
                       StartIcon="@Icons.Material.Filled.Public"
                       OnClick="@(() => SwitchLevel(HierarchyLevel.World))"
                       Style="text-transform:none; font-weight:600;">
                Global Map
            </MudButton>
            <MudButton Variant="@(_currentLevel == HierarchyLevel.SiteOrgChart ? Variant.Filled : Variant.Outlined)"
                       StartIcon="@Icons.Material.Filled.AccountTree"
                       OnClick="@(() => SwitchLevel(HierarchyLevel.SiteOrgChart))"
                       Style="text-transform:none; font-weight:600;">
                Org Tree
            </MudButton>
        </MudButtonGroup>

        @* Search People Input *@
        <MudAutocomplete T="OrgChartNode"
                         Value="_selectedSearchNode"
                         ValueChanged="OnSearchNodeSelected"
                         SearchFunc="SearchEmployees"
                         ToStringFunc="@(node => node?.Name ?? "")"
                         Placeholder="Search people..."
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Adornment="Adornment.Start"
                         AdornmentIcon="@Icons.Material.Filled.Search"
                         AdornmentColor="Color.Primary"
                         Clearable="true"
                         Class="search-people-input"
                         Style="min-width: 240px; max-width: 300px;"
                         CoerceValue="true"
                         MaxItems="10">
            <ItemTemplate Context="node">
                <div class="d-flex align-center gap-2 py-1">
                    <MudAvatar Size="Size.Small" Color="Color.Primary" Style="font-size: 11px; font-weight: 700;">
                        @node.Initials
                    </MudAvatar>
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.body2" Style="font-weight: 600; line-height: 1.2;">@node.Name</MudText>
                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary); font-size: 11px;">
                            @node.Role @(!string.IsNullOrEmpty(node.Department) ? $"· {node.Department}" : "")
                        </MudText>
                    </div>
                </div>
            </ItemTemplate>
        </MudAutocomplete>

        @if (_currentLevel == HierarchyLevel.SiteOrgChart)
        {
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.CenterFocusStrong"
                       OnClick="FocusOnSelf"
                       Class="focus-btn"
                       Style="border-radius: 8px; font-weight: 700; text-transform: none; padding: 6px 16px; border-width: 2px; height: 40px; white-space: nowrap;">
                Focus Me
            </MudButton>
        }
    </div>
</div>

<MudCard Elevation="1" Style="height: 75vh; overflow: hidden; position: relative;" class="@($"org-card {(_currentLevel == HierarchyLevel.World ? "world-view" : "")}")">
    <MudCardContent Class="pa-0" Style="height: 100%; width: 100%; position: relative; background-color: var(--mud-palette-background-grey); overflow: hidden;" id="orgContainer"
                    @onwheel="OnWheel" @onmousedown="OnMouseDown" @onmousemove="OnMouseMove" @onmouseup="OnMouseUp" @onmouseleave="OnMouseUp">

        @if (_currentLevel == HierarchyLevel.World)
        {
            @* ========================================== *@
            @* LEVEL 1: INTERACTIVE VECTOR WORLD MAP      *@
            @* ========================================== *@
            <svg width="100%" height="100%" viewBox="0 0 1200 650" preserveAspectRatio="xMidYMid slice" class="@($"world-map-svg {(ThemeState.IsDarkMode ? "dark-map" : "light-map")}")">
                <defs>
                    <style>
                        .world-map-svg.dark-map {
                            background: radial-gradient(circle at 50% 50%, #151d2a 0%, #0d121c 100%);
                        }
                        .world-map-svg.light-map {
                            background: radial-gradient(circle at 50% 50%, #f0f7fa 0%, #d8e8f0 100%);
                        }

                        /* Continents Dark Mode */
                        .dark-map .world-continent-path {
                            fill: rgba(0, 163, 180, 0.12);
                            stroke: #00E5FF;
                            stroke-width: 1.6px;
                            stroke-linejoin: round;
                            stroke-linecap: round;
                            transition: fill 0.25s ease, stroke 0.25s ease, stroke-width 0.25s ease;
                            filter: drop-shadow(0 0 3px rgba(0, 229, 255, 0.3));
                        }
                        .dark-map .continent-group:hover .world-continent-path,
                        .dark-map .world-continent-path.hovered {
                            fill: rgba(0, 229, 255, 0.28);
                            stroke: #00FFF0;
                            stroke-width: 2.5px;
                            filter: drop-shadow(0 0 10px rgba(0, 229, 255, 0.7));
                            cursor: pointer;
                        }

                        /* Continents Light Mode */
                        .light-map .world-continent-path {
                            fill: #ffffff;
                            stroke: #008899;
                            stroke-width: 1.6px;
                            stroke-linejoin: round;
                            stroke-linecap: round;
                            transition: fill 0.25s ease, stroke 0.25s ease, stroke-width 0.25s ease;
                            filter: drop-shadow(0 2px 5px rgba(0, 70, 90, 0.18));
                        }
                        .light-map .continent-group:hover .world-continent-path,
                        .light-map .world-continent-path.hovered {
                            fill: #cbeeef;
                            stroke: #005a66;
                            stroke-width: 2.4px;
                            filter: drop-shadow(0 4px 12px rgba(0, 120, 150, 0.35));
                            cursor: pointer;
                        }

                        /* Pins Dark Mode */
                        .dark-map .continent-pin-pulse {
                            fill: none;
                            stroke: #00E5FF;
                            stroke-width: 1.5px;
                            opacity: 0.7;
                            animation: continentPulse 2.5s infinite ease-in-out;
                        }
                        .dark-map .continent-pin-center {
                            fill: #00E5FF;
                            stroke: #ffffff;
                            stroke-width: 2px;
                            filter: drop-shadow(0 0 8px #00E5FF);
                        }
                        .dark-map .continent-group:hover .continent-pin-center {
                            fill: #FFFF00;
                            filter: drop-shadow(0 0 12px #FFFF00);
                        }

                        /* Pins Light Mode */
                        .light-map .continent-pin-pulse {
                            fill: none;
                            stroke: #008899;
                            stroke-width: 1.5px;
                            opacity: 0.7;
                            animation: continentPulse 2.5s infinite ease-in-out;
                        }
                        .light-map .continent-pin-center {
                            fill: #008899;
                            stroke: #ffffff;
                            stroke-width: 2px;
                            filter: drop-shadow(0 2px 6px rgba(0, 136, 153, 0.4));
                        }
                        .light-map .continent-group:hover .continent-pin-center {
                            fill: #d97706;
                            stroke: #ffffff;
                            filter: drop-shadow(0 0 10px rgba(217, 119, 6, 0.6));
                        }

                        @@keyframes continentPulse {
                            0% { r: 6px; opacity: 0.9; stroke-width: 2px; }
                            50% { r: 18px; opacity: 0.15; stroke-width: 1px; }
                            100% { r: 6px; opacity: 0.9; stroke-width: 2px; }
                        }

                        /* Labels Dark Mode */
                        .dark-map .continent-label {
                            font-family: 'Roboto', 'Inter', sans-serif;
                            font-size: 13px;
                            font-weight: 700;
                            fill: #ffffff;
                            letter-spacing: 0.5px;
                            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.9));
                            pointer-events: none;
                            user-select: none;
                        }
                        .dark-map .continent-sublabel {
                            font-family: 'Roboto', 'Inter', sans-serif;
                            font-size: 10px;
                            font-weight: 500;
                            fill: rgba(0, 229, 255, 0.9);
                            letter-spacing: 0.2px;
                            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.9));
                            pointer-events: none;
                            user-select: none;
                        }

                        /* Labels Light Mode */
                        .light-map .continent-label {
                            font-family: 'Roboto', 'Inter', sans-serif;
                            font-size: 13px;
                            font-weight: 700;
                            fill: #0f172a;
                            letter-spacing: 0.5px;
                            filter: drop-shadow(0 1px 2px rgba(255,255,255,0.9));
                            pointer-events: none;
                            user-select: none;
                        }
                        .light-map .continent-sublabel {
                            font-family: 'Roboto', 'Inter', sans-serif;
                            font-size: 10px;
                            font-weight: 600;
                            fill: #007788;
                            letter-spacing: 0.2px;
                            filter: drop-shadow(0 1px 2px rgba(255,255,255,0.85));
                            pointer-events: none;
                            user-select: none;
                        }

                        /* Flight Lines */
                        .flight-line {
                            fill: none !important;
                            stroke-dasharray: 4, 6;
                            animation: flightDash 25s linear infinite;
                            pointer-events: none;
                        }
                        .dark-map .flight-line {
                            stroke: rgba(0, 229, 255, 0.35);
                            stroke-width: 1.5px;
                        }
                        .light-map .flight-line {
                            stroke: rgba(0, 136, 153, 0.45);
                            stroke-width: 1.5px;
                        }

                        @@keyframes flightDash {
                            to { stroke-dashoffset: -100; }
                        }

                        /* Munich HQ */
                        .global-hq-halo {
                            fill: none;
                            stroke-width: 2px;
                            animation: hqHalo 2s infinite ease-out;
                        }
                        .dark-map .global-hq-halo { stroke: #FFD700; }
                        .light-map .global-hq-halo { stroke: #d97706; }

                        .dark-map .global-hq-dot {
                            fill: #FFD700;
                            stroke: #ffffff;
                            stroke-width: 1.5px;
                            filter: drop-shadow(0 0 6px #FFD700);
                        }
                        .light-map .global-hq-dot {
                            fill: #d97706;
                            stroke: #ffffff;
                            stroke-width: 1.5px;
                            filter: drop-shadow(0 0 5px rgba(217, 119, 6, 0.5));
                        }

                        .dark-map .global-hq-text {
                            font-family: 'Roboto', 'Inter', sans-serif;
                            font-size: 11px;
                            font-weight: 700;
                            fill: #FFD700;
                            letter-spacing: 0.5px;
                            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.9));
                        }
                        .light-map .global-hq-text {
                            font-family: 'Roboto', 'Inter', sans-serif;
                            font-size: 11px;
                            font-weight: 700;
                            fill: #b45309;
                            letter-spacing: 0.5px;
                            filter: drop-shadow(0 1px 2px rgba(255,255,255,0.9));
                        }

                        @@keyframes hqHalo {
                            0% { r: 5px; opacity: 1; }
                            100% { r: 18px; opacity: 0; }
                        }
                    </style>

                    @* Grid Pattern for Blueprint/Cyber Aesthetics *@
                    <pattern id="worldGrid" width="40" height="40" patternUnits="userSpaceOnUse">
                        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="@(ThemeState.IsDarkMode ? "rgba(255, 255, 255, 0.04)" : "rgba(0, 100, 140, 0.06)")" stroke-width="1" />
                    </pattern>
                    <linearGradient id="continentGlow" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#00E5FF" stop-opacity="0.25" />
                        <stop offset="100%" stop-color="#007791" stop-opacity="0.08" />
                    </linearGradient>
                    <filter id="neonGlow" x="-20%" y="-20%" width="140%" height="140%">
                        <feGaussianBlur stdDeviation="4" result="blur" />
                        <feComposite in="SourceGraphic" in2="blur" operator="over" />
                    </filter>
                </defs>

                @* Background Grid *@
                <rect width="100%" height="100%" fill="url(#worldGrid)" />

                @* Latitude / Longitude Decorative Grid Lines *@
                <g class="world-geo-lines">
                    <line x1="0" y1="325" x2="1200" y2="325" stroke="@(ThemeState.IsDarkMode ? "rgba(0, 229, 255, 0.15)" : "rgba(0, 130, 160, 0.2)")" stroke-dasharray="6,6" stroke-width="1" /> @* Equator *@
                    <line x1="0" y1="180" x2="1200" y2="180" stroke="@(ThemeState.IsDarkMode ? "rgba(255, 255, 255, 0.05)" : "rgba(0, 100, 140, 0.1)")" stroke-dasharray="4,4" stroke-width="1" /> @* Tropic of Cancer *@
                    <line x1="0" y1="470" x2="1200" y2="470" stroke="@(ThemeState.IsDarkMode ? "rgba(255, 255, 255, 0.05)" : "rgba(0, 100, 140, 0.1)")" stroke-dasharray="4,4" stroke-width="1" /> @* Tropic of Capricorn *@
                    <line x1="600" y1="0" x2="600" y2="650" stroke="@(ThemeState.IsDarkMode ? "rgba(0, 229, 255, 0.12)" : "rgba(0, 130, 160, 0.18)")" stroke-dasharray="6,6" stroke-width="1" /> @* Prime Meridian *@
                </g>

                @* World Map Content Layer (Static Crisp Full-View) *@
                <g class="world-map-content-layer">
                    
                    @* Continental Landmasses (High Precision Vector Contours) *@
                    @foreach (var continent in _continents)
                    {
                        bool isHovered = _hoveredContinent?.Id == continent.Id;
                        <g class="continent-group @(isHovered ? "continent-active" : "")"
                           @onmouseenter="() => OnContinentMouseEnter(continent)"
                           @onmouseleave="OnContinentMouseLeave"
                           @onclick="() => OnContinentClick(continent)"
                           cursor="pointer">
                            
                            @* Main Continent SVG Outline with non-scaling-stroke for crisp performance *@
                            <path d="@continent.SvgPath" 
                                  vector-effect="non-scaling-stroke"
                                  class="world-continent-path @(isHovered ? "hovered" : "")" />

                            @* Regional Hub Pin (Pulsing Leader Anchor) *@
                            <g transform="@($"translate({continent.CenterPointX.ToString(System.Globalization.CultureInfo.InvariantCulture)}, {continent.CenterPointY.ToString(System.Globalization.CultureInfo.InvariantCulture)})")">
                                <circle r="16" class="continent-pin-pulse" />
                                <circle r="7" class="continent-pin-center" />
                                @((MarkupString)$"<text x=\"0\" y=\"-14\" class=\"continent-label\" text-anchor=\"middle\">{continent.Name}</text>")
                                @((MarkupString)$"<text x=\"0\" y=\"22\" class=\"continent-sublabel\" text-anchor=\"middle\">{continent.LeadRole}</text>")
                            </g>
                        </g>
                    }

                    @* Global Connections (Curved Inter-Continental HQ Network from Munich HQ) *@
                    <g class="world-flight-lines">
                        @* Siemens Global HQ in Munich, Germany (638.6, 258.0) to Other Continents *@
                        <path d="M 638.6 258.0 Q 440 130 244.5 285.3" fill="none" class="flight-line" vector-effect="non-scaling-stroke" /> @* Munich -> North America *@
                        <path d="M 638.6 258.0 Q 520 370 440.4 440.5" fill="none" class="flight-line" vector-effect="non-scaling-stroke" /> @* Munich -> South America *@
                        <path d="M 638.6 258.0 Q 640 330 672.5 397.9" fill="none" class="flight-line" vector-effect="non-scaling-stroke" /> @* Munich -> Africa *@
                        <path d="M 638.6 258.0 Q 800 200 947.3 297.6" fill="none" class="flight-line" vector-effect="non-scaling-stroke" /> @* Munich -> Asia *@
                        <path d="M 638.6 258.0 Q 850 400 1045.9 467.0" fill="none" class="flight-line" vector-effect="non-scaling-stroke" /> @* Munich -> Oceania *@
                    </g>

                    @* Global Executive Anchor: Siemens Global HQ (Munich, Germany - 638.6, 258.0) *@
                    <g transform="@($"translate({WorldMapData.MunichHQ_X.ToString(System.Globalization.CultureInfo.InvariantCulture)}, {WorldMapData.MunichHQ_Y.ToString(System.Globalization.CultureInfo.InvariantCulture)})")" class="global-hq-group">
                        <circle r="14" class="global-hq-halo" />
                        <circle r="5.5" class="global-hq-dot" />
                        <text x="0" y="-14" class="global-hq-text" text-anchor="middle">👑 Siemens Global HQ (Munich)</text>
                    </g>
                </g>
            </svg>

            @* Floating Continent Executive Inspection Card (Glassmorphism) *@
            @if (_hoveredContinent != null)
            {
                <div class="@($"continent-floating-card animate-fade-in {(ThemeState.IsDarkMode ? "dark-card" : "light-card")}")"
                     style="pointer-events: auto;"
                     @onmouseenter="OnCardMouseEnter"
                     @onmouseleave="OnCardMouseLeave">
                    <div class="card-header-row">
                        <div>
                            <div class="continent-title">@_hoveredContinent.Name</div>
                            <div class="continent-region-code">@_hoveredContinent.RegionCode</div>
                        </div>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Style="font-weight:700;">
                            @_hoveredContinent.ActiveCountriesCount Countries
                        </MudChip>
                    </div>

                    <MudDivider Class="my-2" Style="@(ThemeState.IsDarkMode ? "background-color: rgba(255,255,255,0.1);" : "background-color: rgba(0,0,0,0.08);")" />

                    <div class="card-details-grid">
                        <div class="detail-item">
                            <span class="detail-label">Regional Leader</span>
                            <span class="detail-val highlight">@_hoveredContinent.LeadName</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Title</span>
                            <span class="detail-val">@_hoveredContinent.LeadRole</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Total Workforce</span>
                            <span class="detail-val">@_hoveredContinent.TotalEmployeesCount.ToString("N0") Employees</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Active Hubs</span>
                            <span class="detail-val">@_hoveredContinent.ActiveHubsCount Campus Sites</span>
                        </div>
                    </div>

                    <div class="d-flex justify-space-between align-center mt-3 pt-2" style="@(ThemeState.IsDarkMode ? "border-top: 1px solid rgba(255,255,255,0.08);" : "border-top: 1px solid rgba(0,0,0,0.08);")">
                        <span class="explore-hint">Click continent to explore</span>
                        <MudButton Size="Size.Small" 
                                   Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   OnClick="@(() => OnContinentClick(_hoveredContinent))"
                                   Style="text-transform:none; font-weight:700;">
                            Drill Down
                        </MudButton>
                    </div>
                </div>
            }

            @* Map Quick Continent Selector Toolbar (Single Row, Clean Text) *@
            <div class="@($"map-bottom-bar {(ThemeState.IsDarkMode ? "dark-bar" : "light-bar")}")">
                <div class="continent-button-row">
                    @foreach (var cont in _continents)
                    {
                        bool isSelected = _hoveredContinent?.Id == cont.Id;
                        <MudButton Size="Size.Small"
                                   Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Primary"
                                   OnClick="@(() => SelectAndCenterContinent(cont))"
                                   Class="continent-nav-btn"
                                   Style="@(isSelected ? "font-weight: 700; text-transform: none;" : "font-weight: 600; text-transform: none;")">
                            @cont.Name
                        </MudButton>
                    }
                </div>
            </div>
        }
        else
        {
            @* ========================================== *@
            @* LEVEL 5: TREE ORGANIZATION CHART           *@
            @* ========================================== *@
            @if (_root == null)
            {
                <div class="d-flex justify-center align-center" style="height: 100%;">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else
            {
                <svg width="100%" height="100%">
                    <g transform="@($"translate({_translateX.ToString(System.Globalization.CultureInfo.InvariantCulture)}, {_translateY.ToString(System.Globalization.CultureInfo.InvariantCulture)}) scale({_scale.ToString(System.Globalization.CultureInfo.InvariantCulture)})")">
                        @* Lines Layer (Orthogonal 90-degree connectors) *@
                        @foreach (var edge in _edges)
                        {
                            <path d="@GetOrthogonalPath(edge.Source, edge.Target)" 
                                  class="@(edge.Target.IsFocusNode && edge.Source.IsFocusNode ? "org-line-focus" : "org-line")" />
                        }

                        @* Nodes Layer *@
                        @foreach (var node in _nodes)
                        {
                            bool isSelf = node.UserId == _currentUserId;
                            <g transform="translate(@node.X, @node.Y)">
                                @if (isSelf)
                                {
                                    <circle r="33" class="org-node-self-aura" />
                                }

                                <circle r="25" class="@(isSelf ? "org-node-circle-self" : (node.IsFocusNode ? "org-node-circle-focus" : "org-node-circle"))" 
                                        @onmouseenter="() => OnNodeMouseEnter(node)" 
                                        @onmouseleave="OnNodeMouseLeave"
                                        @onclick="() => OnNodeClick(node)" />
                                @((MarkupString)$"<text x=\"0\" y=\"0\" class=\"{(isSelf ? "org-text-self" : (node.IsFocusNode ? "org-text-focus" : "org-text"))}\" dominant-baseline=\"central\" text-anchor=\"middle\" style=\"pointer-events: none;\">{node.Initials}</text>")

                                @if (node.HasChildren)
                                {
                                    <g class="org-expand-btn" transform="translate(0, 25)"
                                       @onclick="() => ToggleNodeExpand(node)" @onclick:stopPropagation="true">
                                        <circle r="9" class="expand-btn-bg" />
                                        @((MarkupString)$"<text x=\"0\" y=\"0\" class=\"expand-btn-icon\" text-anchor=\"middle\" dominant-baseline=\"central\">{(node.IsExpanded ? "−" : "+")}</text>")
                                    </g>
                                }
                            </g>
                        }

                        @* Hover / Focus Info Panel (Rendered last to ensure top z-order) *@
                        @if (_hoveredNode != null && _hoveredNode.UserId != _currentUserId)
                        {
                            <foreignObject x="@(_hoveredNode.X + 32)" y="@(_hoveredNode.Y - 60)" width="345" height="@(_isManagerOrHr ? "245" : "175")" style="pointer-events: auto;">
                                <div class="org-info-panel"
                                     @onmouseenter="OnPanelMouseEnter"
                                     @onmouseleave="OnPanelMouseLeave">
                                    <div class="org-info-header">
                                        <div class="org-info-details">
                                            <div class="info-row">
                                                <span class="info-label">Name:</span>
                                                <span class="info-value" title="@_hoveredNode.Name">@_hoveredNode.Name</span>
                                            </div>
                                            <div class="info-row">
                                                <span class="info-label">Department:</span>
                                                <span class="info-value" title="@_hoveredNode.Department">@_hoveredNode.Department</span>
                                            </div>
                                            <div class="info-row">
                                                <span class="info-label">Role:</span>
                                                <span class="info-value" title="@_hoveredNode.Role">@_hoveredNode.Role</span>
                                            </div>
                                            <div class="info-row">
                                                <span class="info-label">Contract:</span>
                                                <span class="info-value">@GetContractPeriodText(_hoveredNode)</span>
                                            </div>
                                            <div class="info-row">
                                                <span class="info-label">Contract Status:</span>
                                                <span class="info-value">
                                                    @if (_hoveredNode.HasContract && _hoveredNode.ContractType != null)
                                                    {
                                                        <span class="badge @(_hoveredNode.ContractType == ContractType.Determinate ? "determinate" : "indeterminate")">
                                                            @GetContractStatusText(_hoveredNode)
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span>—</span>
                                                    }
                                                </span>
                                            </div>
                                        </div>
                                        <div class="org-info-avatar-box">
                                            <div class="avatar-frame">
                                                <span class="avatar-initials">@_hoveredNode.Initials</span>
                                            </div>
                                        </div>
                                    </div>

                                    @if (_isManagerOrHr)
                                    {
                                        <div class="org-info-actions">
                                            @if (!CanManageRequests(_hoveredNode))
                                            {
                                                <button class="action-btn btn-locked disabled" disabled title="Leave requests can only be approved by Line Managers or HR">
                                                    🔒
                                                </button>
                                            }
                                            else
                                            {
                                                @if (_hoveredNode.HasPendingRequest)
                                                {
                                                    <button class="action-btn btn-request active" @onclick="@(() => OnViewRequestClicked(_hoveredNode))" title="View pending leave request">
                                                        <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg>
                                                        View Request
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="action-btn btn-request disabled" @onclick="@(() => OnViewRequestClicked(_hoveredNode))" title="No pending leave requests">
                                                        <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z"/></svg>
                                                        No Request
                                                    </button>
                                                }
                                            }

                                            @if (!CanManageContract(_hoveredNode))
                                            {
                                                <button class="action-btn btn-locked disabled" disabled title="Contract management locked for superiors or unauthorized roles">
                                                    🔒
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="action-btn btn-contract" @onclick="@(() => OnManageContractClicked(_hoveredNode))" title="Manage contract for this employee">
                                                    <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>
                                                    Manage Contract
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </foreignObject>
                        }
                    </g>
                </svg>
            }
        }

        @* Viewport Zoom Controls (Floating Bottom-Left, only for Site Org Chart) *@
        @if (_currentLevel == HierarchyLevel.SiteOrgChart)
        {
            <div class="viewport-controls-toolbar">
                <MudPaper Class="d-flex flex-column pa-1 gap-1" Style="background-color: rgba(26, 32, 44, 0.85); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.12); border-radius: 8px;">
