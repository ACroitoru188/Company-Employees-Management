        {
            <div class="viewport-controls-toolbar">
                <MudPaper Class="d-flex flex-column pa-1 gap-1" Style="background-color: rgba(26, 32, 44, 0.85); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.12); border-radius: 8px;">
