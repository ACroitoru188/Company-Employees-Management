    /// <summary>
    /// Lazy Loading / Viewport Culling for SVG elements.
    /// Determines whether a continent is within or intersects the current visible viewBox.
    /// </summary>
    private bool IsContinentVisible(ContinentModel continent)
    {
        // At normal zoom or zoomed-out, render all continents
        if (_mapScale <= 1.05 && Math.Abs(_mapTranslateX) < 100 && Math.Abs(_mapTranslateY) < 100)
            return true;

        // Viewport bounds in SVG map coordinate space
        double margin = 80; // Safety margin for pin labels, halos, and coastlines
        double visibleMinX = (0 - _mapTranslateX) / _mapScale - margin;
        double visibleMaxX = (1200 - _mapTranslateX) / _mapScale + margin;
        double visibleMinY = (0 - _mapTranslateY) / _mapScale - margin;
        double visibleMaxY = (650 - _mapTranslateY) / _mapScale + margin;

        // Bounding box intersection check
        bool overlapsX = continent.MinX <= visibleMaxX && continent.MaxX >= visibleMinX;
        bool overlapsY = continent.MinY <= visibleMaxY && continent.MaxY >= visibleMinY;

        return overlapsX && overlapsY;
    }

    /// <summary>
    /// Viewport check for individual point markers (e.g. Munich HQ).
    /// </summary>
    private bool IsPointVisible(double x, double y, double margin = 40)
    {
        double visibleMinX = (0 - _mapTranslateX) / _mapScale - margin;
        double visibleMaxX = (1200 - _mapTranslateX) / _mapScale + margin;
        double visibleMinY = (0 - _mapTranslateY) / _mapScale - margin;
        double visibleMaxY = (650 - _mapTranslateY) / _mapScale + margin;

        return x >= visibleMinX && x <= visibleMaxX && y >= visibleMinY && y <= visibleMaxY;
    }

    private void UpdateBreadcrumbs()
    {
        _breadcrumbItems = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("🌍 Global World Map", href: "#", disabled: _currentLevel == HierarchyLevel.World)
        };

        if (_currentLevel == HierarchyLevel.Continent)
        {
            _breadcrumbItems.Add(new BreadcrumbItem($"🇪🇺 {(_selectedContinent?.Name ?? "Europe")} (Continent)", href: "#", disabled: true));
        }
        else if (_currentLevel == HierarchyLevel.Country)
        {
            _breadcrumbItems.Add(new BreadcrumbItem($"🇪🇺 {(_selectedContinent?.Name ?? "Europe")}", href: "#", disabled: false));
            _breadcrumbItems.Add(new BreadcrumbItem($"🇷🇴 {(_selectedCountry?.Name ?? "Romania")} (Country)", href: "#", disabled: true));
        }
        else if (_currentLevel == HierarchyLevel.City)
        {
            _breadcrumbItems.Add(new BreadcrumbItem($"🇪🇺 {(_selectedContinent?.Name ?? "Europe")}", href: "#", disabled: false));
            _breadcrumbItems.Add(new BreadcrumbItem($"🇷🇴 {(_selectedCountry?.Name ?? "Romania")}", href: "#", disabled: false));
            _breadcrumbItems.Add(new BreadcrumbItem("🏔️ Brașov Sites (2)", href: "#", disabled: true));
        }
        else if (_currentLevel == HierarchyLevel.SiteOrgChart)
        {
            if (_selectedContinent != null)
            {
                _breadcrumbItems.Add(new BreadcrumbItem($"🇪🇺 {_selectedContinent.Name}", href: "#", disabled: false));
            }
            if (_selectedCountry != null)
            {
                _breadcrumbItems.Add(new BreadcrumbItem($"{_selectedCountry.Flag} {_selectedCountry.Name}", href: "#", disabled: false));
            }
            if (_selectedCounty != null)
            {
                _breadcrumbItems.Add(new BreadcrumbItem($"📍 {_selectedCounty.Name}", href: "#", disabled: false));
            }
            if (_activeBrasovSite != null)
            {
                _breadcrumbItems.Add(new BreadcrumbItem($"⚡ {_activeBrasovSite.ShortName}", href: "#", disabled: false));
            }
            _breadcrumbItems.Add(new BreadcrumbItem("🏢 Site Org Chart", href: "#", disabled: true));
        }
    }

    private void SwitchLevel(HierarchyLevel level)
    {
        _currentLevel = level;
        _activeContinent = null;
        _activeCountry = null;
        _activeRomaniaCounty = null;
        _activeBrasovSite = null;
        UpdateBreadcrumbs();
        StateHasChanged();
    }

    private void OnBreadcrumbClick(BreadcrumbItem item)
    {
        if (item.Text.Contains("World"))
        {
            SwitchLevel(HierarchyLevel.World);
        }
        else if (item.Text.Contains("Europe") || item.Text.Contains("Continent"))
        {
            _selectedContinent = _continents.FirstOrDefault(c => c.Id == "europe");
            SwitchLevel(HierarchyLevel.Continent);
        }
        else if (item.Text.Contains("Romania") || item.Text.Contains("Country"))
        {
            _selectedCountry = _europeCountries.FirstOrDefault(c => c.Id == "rou");
            SwitchLevel(HierarchyLevel.Country);
        }
        else if (item.Text.Contains("Brașov") || item.Text.Contains("Brasov") || item.Text.Contains("Sites"))
        {
            SwitchLevel(HierarchyLevel.City);
        }
        else if (item.Text.Contains("Org Chart"))
        {
            SwitchLevel(HierarchyLevel.SiteOrgChart);
        }
    }

    private void OnContinentClick(ContinentModel continent)
    {
        if (_activeContinent?.Id == continent.Id)
        {
            _activeContinent = null;
        }
        else
        {
            _activeContinent = continent;
        }
        StateHasChanged();
    }

    private void OnContinentDblClick(ContinentModel continent)
