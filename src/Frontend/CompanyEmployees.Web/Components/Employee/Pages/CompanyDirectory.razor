                                            <div class="avatar-frame">
                                                <span class="avatar-initials">@_hoveredNode.Initials</span>
                                            </div>
                                        </div>
                                    </div>

                                    @if (_isManagerOrHr)
                                    {
                                        <div class="org-info-actions">
                                            @if (!CanManageRequests(_hoveredNode))
                                            {
                                                <button class="action-btn btn-locked disabled" disabled title="Leave requests can only be approved by Line Managers or HR">
                                                    🔒
                                                </button>
                                            }
                                            else
                                            {
                                                @if (_hoveredNode.HasPendingRequest)
                                                {
                                                    <button class="action-btn btn-request active" @onclick="@(() => OnViewRequestClicked(_hoveredNode))" title="View pending leave request">
                                                        <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg>
                                                        View Request
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="action-btn btn-request disabled" @onclick="@(() => OnViewRequestClicked(_hoveredNode))" title="No pending leave requests">
                                                        <svg class="btn-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z"/></svg>
                                                        No Request
                                                    </button>
                                                }
                                            }

                                            @if (!CanManageContract(_hoveredNode))
                                            {
                                                <button class="action-btn btn-locked disabled" disabled title="Contract management locked for superiors or unauthorized roles">
                                                    🔒
                                                </button>
                                            }
                                            else
                                            {
