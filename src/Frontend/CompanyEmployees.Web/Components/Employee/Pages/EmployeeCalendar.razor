@page "/employee/calendar"
@layout EmployeeLayout
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Domain.Exceptions
@using CompanyEmployees.Web.Security
@using CompanyEmployees.Web.Services
@inject ITimeOffService TimeOff
@inject AppLocalizer Text
@inject IToastService Toast
@inject NavigationManager Nav
@inject ThemeState ThemeState
@* Admin-only path: submitting leave has to create a stand-in first, which ITimeOffService
   has no business knowing about. Everything else on this page still goes through it. *@
@inject EmployeeContext Employees
@inject ManagerContext Manager
@inject ActingContext Acting
@inject IDialogService DialogService

<PageTitle>@Text["Calendar"] · @Text["Time Off Management"]</PageTitle>

@* Laid out like the Teams calendar: a narrow rail on the left with the month picker and the
   list of calendars — here, the leave types — and the surface itself taking the rest.

   The month grid below is built here rather than with FluentCalendar. FluentCalendar is a date
   picker: it sizes itself as eight fixed square cells, wraps its grid in an unnamed div, and
   owns its own selection model. Every one of those had to be overridden to make it behave as a
   month surface, and the overrides were most of this page's CSS. Seven columns of our own are
   less code and answer to us. The picker stays in the rail, doing the job it was written for. *@
<FluentStack Class="cal-page" Orientation="Orientation.Horizontal" HorizontalGap="0"
             VerticalAlignment="VerticalAlignment.Stretch" Style="height:100%;">

    <FluentStack Class="cal-rail" Orientation="Orientation.Vertical" VerticalGap="20"
                 HorizontalAlignment="HorizontalAlignment.Stretch">

        <FluentCalendar Class="cal-mini" Culture="@CalendarCulture"
                        Value="@_anchor.ToDateTime(TimeOnly.MinValue)" ValueChanged="OnMiniPick"
                        PickerMonth="@VisibleMonth.ToDateTime(TimeOnly.MinValue)"
                        PickerMonthChanged="OnPickerMonthChanged" />

        @* The "My calendars" column of the reference: one row per leave type, each with its
           colour, and the balance where Teams puts the checkbox. Clicking one filters the
           surface and arms the day picking — the same control the chips used to be. *@
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="2"
                     HorizontalAlignment="HorizontalAlignment.Stretch">
            <FluentLabel Typo="Typography.Body" Class="cal-rail-title app-overline"
                         Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                @Text["Leave Type"]
            </FluentLabel>

            @foreach (var balance in _balances)
            {
                var isSelected = _selectedType == balance.Type;
                <FluentButton Appearance="Appearance.Stealth"
                              Class="@(isSelected ? "cal-type is-selected" : "cal-type")"
                              Disabled="@(balance.Remaining <= 0)"
                              OnClick="@(() => SelectType(balance.Type))">
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8"
                                 VerticalAlignment="VerticalAlignment.Center" Width="100%">
                        <FluentStack Class="cal-swatch" HorizontalGap="0"
                                     Style="@($"background:{LeaveTypePalette.Hex(balance.Type, ThemeState.IsDarkMode)};")" />
                        <FluentLabel Typo="Typography.Body" Class="cal-type-name">
                            @Text[balance.Type.ToString()]
                        </FluentLabel>
                        <FluentSpacer />
                        <FluentLabel Typo="Typography.Body" Class="app-caption"
                                     Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                            @balance.Remaining / @balance.DaysTotal
                        </FluentLabel>
                    </FluentStack>
                </FluentButton>
            }
        </FluentStack>
    </FluentStack>

    <FluentStack Class="cal-main" Orientation="Orientation.Vertical" VerticalGap="0"
                 HorizontalAlignment="HorizontalAlignment.Stretch"
                 Style="flex:1 1 auto; min-width:0;">

        @* Teams' order exactly: Today, the two arrows, then the period; the view picker sits on
           the far right as a dropdown rather than a row of tabs. *@
        <FluentStack Class="cal-toolbar" Orientation="Orientation.Horizontal" HorizontalGap="4"
                     VerticalAlignment="VerticalAlignment.Center" Width="100%">
            <FluentButton Appearance="Appearance.Stealth" Class="cal-today" OnClick="GoToday">@Text["Today"]</FluentButton>
            <FluentButton Appearance="Appearance.Stealth" Title="@Text["Previous"]"
                          IconStart="@(new Icons.Regular.Size20.ChevronLeft())"
                          OnClick="@(() => Navigate(-1))" />
            <FluentButton Appearance="Appearance.Stealth" Title="@Text["Next"]"
                          IconStart="@(new Icons.Regular.Size20.ChevronRight())"
                          OnClick="@(() => Navigate(1))" />
            <FluentLabel Typo="Typography.Header" Weight="FontWeight.Bold" Class="cal-period">
                @HeaderLabel
            </FluentLabel>
            <FluentSpacer />
            @* OptionValue stays the enum name so SetView can still parse it; only the label is
               translated. *@
            <FluentSelect TOption="string" Items="@ViewNames" Value="@_view.ToString()"
                          OptionValue="@(name => name)" OptionText="@(name => Text[name])"
                          ValueChanged="SetView" Width="120px" Class="cal-viewpicker" />
        </FluentStack>

        <FluentStack Class="cal-surface" Orientation="Orientation.Vertical" VerticalGap="0"
                     HorizontalAlignment="HorizontalAlignment.Stretch"
                     Style="flex:1 1 auto; min-height:0;">

            @if (_view == CalView.Month)
            {
                <FluentStack Class="cal-grid" Orientation="Orientation.Vertical" VerticalGap="0"
                             HorizontalAlignment="HorizontalAlignment.Stretch"
                             Style="flex:1 1 auto; min-height:0;">

                    <FluentStack Class="cal-row cal-row-head" Orientation="Orientation.Horizontal" HorizontalGap="0"
                                 VerticalAlignment="VerticalAlignment.Stretch">
                        @foreach (var name in WeekdayHeaders)
                        {
                            <FluentStack Class="cal-headcell" Orientation="Orientation.Horizontal" HorizontalGap="0">
                                <FluentLabel Typo="Typography.Body" Color="Color.Custom"
                                             CustomColor="var(--neutral-foreground-hint)">@name</FluentLabel>
                            </FluentStack>
                        }
                    </FluentStack>

                    @foreach (var week in MonthWeeks())
                    {
                        <FluentStack Class="cal-row" Orientation="Orientation.Horizontal" HorizontalGap="0"
                                     VerticalAlignment="VerticalAlignment.Stretch">
                            @foreach (var date in week)
                            {
                                var holiday = _holidays.GetValueOrDefault(date);
                                @* title says why a day cannot be picked; the greying alone
                                   leaves "why not?" unanswered. *@
                                <FluentStack Class="@CellClasses(date)" Orientation="Orientation.Vertical"
                                             VerticalGap="3" HorizontalAlignment="HorizontalAlignment.Stretch"
                                             Style="@SelectionStyle(date)"
                                             Title="@UnavailableDateHint(date)"
                                             @onclick="@(() => OnDayClick(date))">

                                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4"
                                                 VerticalAlignment="VerticalAlignment.Center" Width="100%">
                                        <FluentLabel Typo="Typography.Body"
                                                     Class="@(date == _today ? "cal-daynum is-today" : "cal-daynum")"
                                                     Color="@(holiday is not null ? Color.Error : Color.Neutral)">
                                            @date.Day
                                        </FluentLabel>
                                        <FluentSpacer />
                                        @if (holiday is not null)
                                        {
                                            <FluentLabel Typo="Typography.Body" Class="cal-holiday"
                                                         Color="Color.Error" Title="@holiday.Name">
                                                @holiday.Name
                                            </FluentLabel>
                                        }
                                    </FluentStack>

                                    @if (_teamByDay.TryGetValue(date, out var absences))
                                    {
                                        var visible = absences.Where(a => PassesFilter(a.Type)).ToList();
                                        @foreach (var absence in visible.Take(VisibleEntriesPerDay))
                                        {
                                            @* An entry as Teams draws one: a pale wash of its
                                               colour, the full-strength colour as a bar down the
                                               leading edge, ordinary dark text. *@
                                            <FluentStack Class="cal-entry" Orientation="Orientation.Horizontal"
                                                         HorizontalGap="0" Style="@EntryTint(absence.Type)"
                                                         Title="@($"{absence.MemberName} · {Text[absence.Type.ToString()]}")">
                                                <FluentLabel Typo="Typography.Body" Class="cal-entry-text">
                                                    @absence.MemberName
                                                </FluentLabel>
                                            </FluentStack>
                                        }

                                        @if (visible.Count > VisibleEntriesPerDay)
                                        {
                                            @* Hover, not click: this sits inside the day, and a
                                               click here would also land on the day and move the
                                               selection. *@
                                            var moreId = $"more-{date:yyyyMMdd}";
                                            <FluentLabel Id="@moreId" Typo="Typography.Body" Class="cal-more app-caption"
                                                         Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                                                @Text.Format("{0} more", visible.Count - VisibleEntriesPerDay)
                                            </FluentLabel>
                                            <FluentTooltip Anchor="@moreId" Position="TooltipPosition.Bottom">
                                                @foreach (var absence in visible.Skip(VisibleEntriesPerDay))
                                                {
                                                    <FluentLabel Typo="Typography.Body">
                                                        @absence.MemberName · @LeaveTypePalette.Label(absence.Type)
                                                    </FluentLabel>
                                                }
                                            </FluentTooltip>
                                        }
                                    }
                                </FluentStack>
                            }
                        </FluentStack>
                    }
                </FluentStack>
            }
            else if (_view == CalView.Week)
            {
                @* The same surface as the month, seven columns wide: one sheet divided by
                   hairlines, not seven cards floating apart. *@
                <FluentStack Class="cal-grid" Orientation="Orientation.Vertical" VerticalGap="0"
                             HorizontalAlignment="HorizontalAlignment.Stretch"
                             Style="flex:1 1 auto; min-height:0;">

                    <FluentStack Class="cal-row cal-row-head" Orientation="Orientation.Horizontal" HorizontalGap="0"
                                 VerticalAlignment="VerticalAlignment.Stretch">
                        @for (var i = 0; i < 7; i++)
                        {
                            var day = WeekStart.AddDays(i);
                            <FluentStack Class="cal-headcell" Orientation="Orientation.Horizontal"
                                         HorizontalGap="6" VerticalAlignment="VerticalAlignment.Center">
                                <FluentLabel Typo="Typography.Body" Color="Color.Custom"
                                             CustomColor="var(--neutral-foreground-hint)">
                                    @day.ToString("ddd", CalendarCulture)
                                </FluentLabel>
                                <FluentLabel Typo="Typography.Body"
                                             Class="@(day == _today ? "cal-daynum is-today" : "cal-daynum")">
                                    @day.Day
                                </FluentLabel>
                            </FluentStack>
                        }
                    </FluentStack>

                    <FluentStack Class="cal-row cal-row-week" Orientation="Orientation.Horizontal" HorizontalGap="0"
                                 VerticalAlignment="VerticalAlignment.Stretch">
                        @for (var i = 0; i < 7; i++)
                        {
                            var day = WeekStart.AddDays(i);
                            var holiday = _holidays.GetValueOrDefault(day);
                            <FluentStack Class="@CellClasses(day)" Orientation="Orientation.Vertical"
                                         VerticalGap="4" HorizontalAlignment="HorizontalAlignment.Stretch"
                                         Style="@SelectionStyle(day)"
                                         Title="@UnavailableDateHint(day)"
                                         @onclick="@(() => OnDayClick(day))">
                                @if (holiday is not null)
                                {
                                    <FluentLabel Typo="Typography.Body" Class="cal-holiday-block"
                                                 Color="Color.Error" Title="@holiday.Name">
                                        @holiday.Name
                                    </FluentLabel>
                                }

                                @foreach (var item in FilteredRanges.Where(r => r.StartDate <= day && r.EndDate >= day))
                                {
                                    <FluentStack Class="cal-entry cal-entry-block" Orientation="Orientation.Vertical"
                                                 VerticalGap="0" Style="@EntryTint(item.Type)"
                                                 Title="@($"{item.MemberName} · {Text[item.Type.ToString()]}")">
                                        <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold" Class="cal-entry-wrap">
                                            @item.MemberName
                                        </FluentLabel>
                                        <FluentLabel Typo="Typography.Body" Class="cal-entry-wrap app-caption"
                                                     Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                                            @LeaveTypePalette.Label(item.Type)
                                        </FluentLabel>
                                    </FluentStack>
                                }
                            </FluentStack>
                        }
                    </FluentStack>
                </FluentStack>
            }
            else if (_view == CalView.Grid)
            {
                var daysInMonth = DateTime.DaysInMonth(VisibleMonth.Year, VisibleMonth.Month);
                var rows = GridRows();

                @if (rows.Count == 0)
                {
                    <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                        @Text["No approved team leave this month."]
                    </FluentLabel>
                }
                else
                {
                    @* One column per day of the month: a timeline, drawn by the grid. *@
                    <FluentDataGrid Items="@rows.AsQueryable()" TGridItem="GridRow" ShowHover="true"
                                    GridTemplateColumns="@($"210px 92px repeat({daysInMonth}, minmax(0, 1fr))")">
                        <TemplateColumn Title="@Text["Employee"].ToUpper(CultureInfo.CurrentCulture)">
                            <FluentPersona Name="@context.Name" Initials="@context.Initials"
                                           ImageSize="28px" TextPosition="TextPosition.End">
                                @* FluentPersona drops its Name whenever ChildContent is supplied, so the name is
                                   rendered here explicitly above the secondary line. *@
                                <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@context.Name</FluentLabel>
                                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                                    @context.Department@(context.Team is null ? "" : $" · {context.Team}")
                                </FluentLabel>
                            </FluentPersona>
                        </TemplateColumn>

                        <TemplateColumn Title="@Text["Type"].ToUpper(CultureInfo.CurrentCulture)">
                            <FluentBadge Fill="highlight"
                                         BackgroundColor="@LeaveTypePalette.Hex(context.Type, ThemeState.IsDarkMode)"
                                         Color="white">
                                @Text[context.Type.ToString()]
                            </FluentBadge>
                        </TemplateColumn>

                        @* MinWidth="0px": a column defaults to a 100px floor, set inline on the cell.
                           With 31 day columns sharing the width their tracks are about 25px, so every
                           cell overflowed its own track and the page scrolled sideways. *@
                        @for (var d = 1; d <= daysInMonth; d++)
                        {
                            var date = new DateOnly(VisibleMonth.Year, VisibleMonth.Month, d);
                            <TemplateColumn Title="@d.ToString(CultureInfo.InvariantCulture)"
                                            Class="leave-day" MinWidth="0px" Align="Align.Center">
                                @{
                                    var segment = context.Items.FirstOrDefault(r => r.StartDate <= date && r.EndDate >= date);
                                }
                                @if (segment is not null)
                                {
                                    @* One bar per day filling its cell edge to edge, so consecutive days
                                       meet and read as a single period; only the two ends are rounded. *@
                                    var edges = (segment.StartDate == date ? " is-start" : string.Empty)
                                              + (segment.EndDate == date ? " is-end" : string.Empty);
                                    var period = $"{segment.StartDate.ToString("MMM d", CultureInfo.CurrentCulture)} – {segment.EndDate.ToString("MMM d", CultureInfo.CurrentCulture)}";

                                    <FluentStack Class="@($"leave-bar{edges}")"
                                                 VerticalAlignment="VerticalAlignment.Center" HorizontalGap="0"
                                                 Style="@($"background:{LeaveTypePalette.Hex(segment.Type, ThemeState.IsDarkMode)};")"
                                                 Title="@($"{Text[segment.Type.ToString()]} · {period}")">
                                        @* Named once, on the day the range opens, and running along the bar
                                           from there — a cell is ~25px wide, so a label repeated per day
                                           would show nothing. max-width is the range's own span in cells,
                                           which is what stops one period's label from running across the
                                           next one; the dates are on the bar's tooltip. *@
                                        @if (segment.StartDate == date || d == 1)
                                        {
                                            var span = Math.Min(segment.EndDate.DayNumber, MonthEnd.DayNumber)
                                                       - date.DayNumber + 1;
                                            <FluentLabel Class="leave-bar-label" Typo="Typography.Body"
                                                         Style="@($"max-width:{span * 100}%;")"
                                                         Color="Color.Custom" CustomColor="#FFFFFF">
                                                @Text[segment.Type.ToString()]
                                            </FluentLabel>
                                        }
                                    </FluentStack>
                                }
                            </TemplateColumn>
                        }
                    </FluentDataGrid>
                }
            }
            else
            {
                var listRows = FilteredRanges.OrderBy(r => r.StartDate).ToList();

                @if (listRows.Count == 0)
                {
                    <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                        @Text["No approved team leave this month."]
                    </FluentLabel>
                }
                else
                {
                    <FluentDataGrid Items="@listRows.AsQueryable()" TGridItem="TeamTimeOff" ShowHover="true">
                        <TemplateColumn Title="@Text["Employee"].ToUpper(CultureInfo.CurrentCulture)">
                            <FluentPersona Name="@context.MemberName" Initials="@context.Initials"
                                           ImageSize="28px" TextPosition="TextPosition.End" />
                        </TemplateColumn>
                        <PropertyColumn Title="@Text["Department"].ToUpper(CultureInfo.CurrentCulture)" Property="@(r => r.Department)" Sortable="true" />
                        <TemplateColumn Title="@Text["Team"].ToUpper(CultureInfo.CurrentCulture)">@(context.Team ?? "—")</TemplateColumn>
                        <TemplateColumn Title="@Text["Leave Type"].ToUpper(CultureInfo.CurrentCulture)">
                            <FluentBadge Fill="highlight"
                                         BackgroundColor="@LeaveTypePalette.Hex(context.Type, ThemeState.IsDarkMode)"
                                         Color="white">
                                @LeaveTypePalette.Label(context.Type).Split(' ')[0]
                            </FluentBadge>
                        </TemplateColumn>
                        <TemplateColumn Title="@Text["Period"].ToUpper(CultureInfo.CurrentCulture)">
                            @context.StartDate.ToString("MMM d", CultureInfo.CurrentCulture) –
                            @context.EndDate.ToString("MMM d", CultureInfo.CurrentCulture)
                        </TemplateColumn>
                        <TemplateColumn Title="@Text["Days heading"].ToUpper(CultureInfo.CurrentCulture)">
                            @WorkingDays(context.StartDate, context.EndDate)
                        </TemplateColumn>
                    </FluentDataGrid>
                }
            }
        </FluentStack>

        @if (ShowSubmitBar && _range is { } range && _selectedType is { } type)
        {
            @* Last row of the surface rather than pinned to the viewport: fixed, it covered the
               final week of the month and needed a 120px margin to clear it, which put the page
               back to scrolling. *@
            <FluentStack Class="cal-submit" Orientation="Orientation.Horizontal" HorizontalGap="16"
                         Wrap="true" VerticalAlignment="VerticalAlignment.Center" Width="100%">
                <FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">
                    @Text[type.ToString()] ·
                    @range.Start.ToString("MMM d", CultureInfo.CurrentCulture) –
                    @range.End.ToString("MMM d", CultureInfo.CurrentCulture)
                    (@RangeDays(range) @Text[RangeDays(range) == 1 ? "day" : "days"])
                </FluentLabel>
                <FluentTextField @bind-Value="_reason" Label="@Text["Reason (optional)"]" Style="min-width:220px;" />
                <FluentSpacer />
                <FluentButton Appearance="Appearance.Stealth" OnClick="CancelSelection">@Text["Cancel selection"]</FluentButton>
                <FluentButton Appearance="Appearance.Accent" OnClick="Submit">@Text["Submit request"]</FluentButton>
            </FluentStack>
        }
    </FluentStack>
</FluentStack>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private enum CalView { Month, Week, Grid, List }

    // Entries drawn in a day cell before the rest collapse into "N more".
    private const int VisibleEntriesPerDay = 3;

    private static readonly string[] ViewNames = Enum.GetNames<CalView>();

    // The grid always starts on Monday whatever the language does, so the day names are read
    // off the current culture in that fixed order rather than from its own FirstDayOfWeek.
    // Not static: the culture is per request, and a static field would freeze whichever
    // language happened to load the page first.
    private static CultureInfo CalendarCulture => CultureInfo.CurrentCulture;

    private static string[] WeekdayHeaders =>
        Enumerable.Range(0, 7)
            .Select(i => CalendarCulture.DateTimeFormat.AbbreviatedDayNames[((int)DayOfWeek.Monday + i) % 7])
            .ToArray();

    private IReadOnlyList<LeaveBalance> _balances = [];
    private Dictionary<DateOnly, List<TeamAbsence>> _teamByDay = [];
    private IReadOnlyList<TeamTimeOff> _ranges = [];
    private Dictionary<DateOnly, RegionalHoliday> _holidays = [];

    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private CalView _view = CalView.Month;

    // Cursor date: Month/Grid/List show its month, Week shows its Mon–Sun week.
    private DateOnly _anchor;
    private DateOnly VisibleMonth => new(_anchor.Year, _anchor.Month, 1);
    private DateOnly WeekStart => _anchor.AddDays(-(((int)_anchor.DayOfWeek + 6) % 7));

    private LeaveType? _selectedType;
    private DateOnly? _anchorDay;
    private (DateOnly Start, DateOnly End)? _range;
    private string? _reason;

    private bool ShowSubmitBar => _range is not null && _selectedType is not null;

    protected override async Task OnInitializedAsync()
    {
        if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
            return;

        _balances = await TimeOff.GetMyBalancesAsync();
        _anchor = _today;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_view == CalView.Month)
        {
            _teamByDay = (await TimeOff.GetTeamScheduleForMonthAsync(VisibleMonth))
                .GroupBy(a => a.Date)
                .ToDictionary(g => g.Key, g => g.ToList());

            // The grid draws six weeks around the month, so holidays are loaded for the same
            // span rather than for the month alone.
            await LoadHolidaysAsync(MonthGridStart, MonthGridStart.AddDays(41));
        }
        else
        {
            var (from, to) = _view == CalView.Week
                ? (WeekStart, WeekStart.AddDays(6))
                : (VisibleMonth, VisibleMonth.AddMonths(1).AddDays(-1));
            _ranges = await TimeOff.GetTeamTimeOffForRangeAsync(from, to);
            await LoadHolidaysAsync(from, to);
        }
    }

    private async Task LoadHolidaysAsync(DateOnly from, DateOnly to)
    {
        var holidays = new List<RegionalHoliday>();
        for (var year = from.Year; year <= to.Year; year++)
            holidays.AddRange(await TimeOff.GetRegionalHolidaysAsync(year));

        _holidays = holidays
            .GroupBy(holiday => holiday.Date)
            .ToDictionary(group => group.Key, group => group.First());
    }

    // The Monday on or before the 1st: the grid always shows six whole weeks, so a month can
    // open with days of the previous one and close with days of the next.
    private DateOnly MonthGridStart =>
        VisibleMonth.AddDays(-(((int)VisibleMonth.DayOfWeek + 6) % 7));

    private DateOnly MonthEnd => VisibleMonth.AddMonths(1).AddDays(-1);

    private IEnumerable<DateOnly[]> MonthWeeks()
    {
        for (var week = 0; week < 6; week++)
            yield return Enumerable.Range(0, 7)
                .Select(day => MonthGridStart.AddDays(week * 7 + day))
                .ToArray();
    }

    // Everything a day cell can be, as classes; the range's own colour arrives separately as an
    // inline style, because it depends on the leave type being booked.
    private string CellClasses(DateOnly day)
    {
        var classes = "cal-cell";

        if (_view == CalView.Month && day.Month != VisibleMonth.Month)
            classes += " is-outside";
        if (IsWeekend(day))
            classes += " is-weekend";
        if (day == _today)
            classes += " is-today";
        if (IsSelected(day))
            classes += " is-selected";
        if (CanSelectDay(day))
            classes += " is-selectable";

        return classes;
    }

    private async Task Navigate(int delta)
    {
        _anchor = _view == CalView.Week
            ? _anchor.AddDays(7 * delta)
            : VisibleMonth.AddMonths(delta);
        await LoadAsync();
    }

    // The rail's picker moves the surface, which is the only thing it is there for.
    private async Task OnMiniPick(DateTime? picked)
    {
        if (picked is not { } value)
            return;

        _anchor = DateOnly.FromDateTime(value);
        await LoadAsync();
    }

    // Fired by the rail picker's own arrows; without this they move its month but leave the
    // surface on the old one.
    private async Task OnPickerMonthChanged(DateTime month)
    {
        if (month.Year == _anchor.Year && month.Month == _anchor.Month)
            return;

        _anchor = new DateOnly(month.Year, month.Month, 1);
        await LoadAsync();
    }

    private async Task GoToday()
    {
        _anchor = _today;
        await LoadAsync();
    }

    private async Task SetView(string? name)
    {
        if (!Enum.TryParse<CalView>(name, out var view) || _view == view)
            return;

        _view = view;
        await LoadAsync();
    }

    private string HeaderLabel => _view == CalView.Week
        ? WeekLabel()
        : VisibleMonth.ToString("MMMM yyyy", CultureInfo.CurrentCulture);

    private string WeekLabel()
    {
        var start = WeekStart;
        var end = start.AddDays(6);
        var inv = CultureInfo.CurrentCulture;
        if (start.Year != end.Year)
            return $"{start.ToString("MMM d, yyyy", inv)} – {end.ToString("MMM d, yyyy", inv)}";
        if (start.Month != end.Month)
            return $"{start.ToString("MMM d", inv)} – {end.ToString("MMM d", inv)}, {end.Year}";
        return $"{start.ToString("MMM d", inv)} – {end.Day}, {end.Year}";
    }

    // The selected type doubles as a content filter; no selection shows everything.
    private bool PassesFilter(LeaveType type) => _selectedType is null || _selectedType == type;

    private IEnumerable<TeamTimeOff> FilteredRanges => _ranges.Where(r => PassesFilter(r.Type));

    private record GridRow(string Name, string Initials, string Department, string? Team, LeaveType Type, List<TeamTimeOff> Items);

    private List<GridRow> GridRows() =>
        FilteredRanges
            .GroupBy(r => r.MemberName)
            .Select(g =>
            {
                var first = g.OrderBy(r => r.StartDate).First();
                return new GridRow(g.Key, first.Initials, first.Department, first.Team, first.Type, g.ToList());
            })
            .OrderBy(r => r.Name)
            .ToList();

    private static bool IsWeekend(DateOnly day) =>
        day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;

    private int WorkingDays(DateOnly start, DateOnly end)
    {
        var count = 0;
        for (var day = start; day <= end; day = day.AddDays(1))
            if (!IsWeekend(day) && !IsHoliday(day))
                count++;
        return count;
    }

    private void SelectType(LeaveType type)
    {
        if (_selectedType == type)
        {
            _selectedType = null;
            CancelSelection();
        }
        else
        {
            _selectedType = type;
        }
    }

    private bool IsSelected(DateOnly day) =>
        _range is { } r && day >= r.Start && day <= r.End;

    private bool IsRangeEndpoint(DateOnly day) =>
        _range is { } r && (day == r.Start || day == r.End);

    // The range is tinted with the leave type being booked rather than the app accent, so the
    // surface answers "what am I booking" as well as "when".
    private string SelectionStyle(DateOnly day)
    {
        if (!IsSelected(day) || _selectedType is not { } type)
            return "";

        var color = LeaveTypePalette.Hex(type, ThemeState.IsDarkMode);
        return IsRangeEndpoint(day)
            ? $"background:{color}1F; box-shadow: inset 0 0 0 2px {color};"
            : $"background:{color}14;";
    }

    // A calendar entry, coloured the way Teams colours one: the leave type washed over the
    // background at low opacity, the full-strength colour as a bar down the leading edge. The
    // hex suffix is the alpha channel — "24" is about 14%.
    private string EntryTint(LeaveType type)
    {
        var hex = LeaveTypePalette.Hex(type, ThemeState.IsDarkMode);
        return $"background:{hex}24; border-inline-start:3px solid {hex};";
    }

    private string? UnavailableDateHint(DateOnly day)
    {
        if (_selectedType is null)
            return Text["Select a leave type first."];
        if (day < _today)
            return Text["Past dates cannot be selected."];
        if (_holidays.TryGetValue(day, out var holiday))
            return Text.Format("{0} is a public holiday.", holiday.Name);
        if (IsWeekend(day))
            return Text["Weekends are already non-working days."];
        return null;
    }

    private bool CanSelectDay(DateOnly day) =>
        _selectedType is not null && day >= _today && !IsWeekend(day) && !IsHoliday(day);

    private bool IsHoliday(DateOnly day) => _holidays.ContainsKey(day);

    // Click the first day, then the last; clicking inside the range clears it.
    private void OnDayClick(DateOnly day)
    {
        if (!CanSelectDay(day))
            return;

        if (IsSelected(day))
        {
            _range = null;
            _anchorDay = null;
            return;
        }

        if (_anchorDay is not { } anchor || _range is { } existing && existing.Start != existing.End)
        {
            _anchorDay = day;
            _range = (day, day);
            return;
        }

        _range = day < anchor ? (day, anchor) : (anchor, day);
    }

    private void CancelSelection()
    {
        _range = null;
        _anchorDay = null;
        _reason = null;
    }

    private Task Submit() => SubmitAsync(offerDelegation: true);

    // offerDelegation is false on the retry: the dialog's dates are editable, so a period
    // that misses the leave leaves the rule unsatisfied. Prompting again would loop and
    // create a live delegation on every pass.
    private async Task SubmitAsync(bool offerDelegation)
    {
        if (_range is not { } range || _selectedType is not { } type)
            return;

        try
        {
            await TimeOff.SubmitRequestAsync(type, range.Start, range.End, _reason);
            Toast.ShowSuccess(Text["Time off request submitted"]);
            CancelSelection();
            _selectedType = null;
            await LoadAsync();
        }
        catch (DelegationRequiredException ex)
        {
            // The rule lives in EmployeeContext; this only offers the way out of it. If the
            // delegation gets created the submit is retried, so the two land together.
            if (offerDelegation && await OfferDelegationAsync(range))
                await SubmitAsync(offerDelegation: false);
            else if (!offerDelegation)
                Toast.ShowError($"{ex.Message} The delegation you created does not cover these dates.");
        }
        catch (Exception ex)
        {
            // Business validations (overlap, balance, past dates) surface here.
            Toast.ShowError(ex.Message);
        }
    }

    // Returns true when a delegation was created and the request is worth retrying.
    private async Task<bool> OfferDelegationAsync((DateOnly Start, DateOnly End) range)
    {
        var acting = await Acting.GetAsync();
        if (acting is null)
            return false;

        // Lent authority cannot be lent onward — the same rule CreateDelegationAsync
        // enforces, said before the dialog rather than after it.
        if (acting.IsImpersonating)
        {
            Toast.ShowError("Only the owner of this account can choose who covers for them.");
            return false;
        }

        var me = acting.EffectiveUserId;
        var candidates = (await Employees.GetUsersInMyRegionAsync(me))
            .Where(user => user.Id != me)
            .ToList();

        if (candidates.Count == 0)
        {
            Toast.ShowError("There is nobody in your region who could take over.");
            return false;
        }

        var content = new CreateDelegationDialog.Model
        {
            AvailableUsers = candidates,
            StartDate = range.Start.ToDateTime(TimeOnly.MinValue),
            EndDate = range.End.ToDateTime(TimeOnly.MinValue),
            Intro = "Your leave is approved automatically, so somebody has to cover your "
                  + "responsibilities while you are away. The dates match your request — "
                  + "shorten them if the handover is shorter."
        };

        var parameters = new DialogParameters
        {
            Title = "Who takes over while you are away?",
            PrimaryAction = "Delegate",
            SecondaryAction = "Cancel",
            Width = "520px",
            ValidateDialogAsync = () => Task.FromResult(content.Validate())
        };

        var dialog = await DialogService.ShowDialogAsync<CreateDelegationDialog, CreateDelegationDialog.Model>(
            content, parameters);

        var dialogResult = await dialog.Result;
        if (dialogResult.Cancelled || !content.IsValid)
            return false;

        var result = content.ToResult();

        try
        {
            await Manager.CreateDelegationAsync(
                me, result.DelegateId, result.StartDate, result.EndDate, result.Reason);
            return true;
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
            return false;
        }
    }

    private int RangeDays((DateOnly Start, DateOnly End) range) =>
        WorkingDays(range.Start, range.End);
}
