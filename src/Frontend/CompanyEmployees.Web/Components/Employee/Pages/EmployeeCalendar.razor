@page "/employee/calendar"
@layout EmployeeLayout
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@using CompanyEmployees.Web.Services
@inject ITimeOffService TimeOff
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject ThemeState ThemeState

<PageTitle>Calendar · Time Off Management</PageTitle>

<div class="@(ShowSubmitBar ? "cal-page-with-footer" : "")">

<LeaveBalanceSummary UserName="@_userName" Balances="@_balances" />

<div class="d-flex align-center flex-wrap gap-2 mt-6 mb-2">
    @foreach (var balance in _balances)
    {
        var isSelected = _selectedType == balance.Type;
        <MudChip T="LeaveType" Value="@balance.Type"
                 Disabled="@(balance.Remaining <= 0)"
                 Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                 Style="@TypeChipStyle(balance.Type, isSelected)"
                 OnClick="@(() => SelectType(balance.Type))">
            @LeaveTypePalette.Label(balance.Type)
        </MudChip>
    }
</div>

@if (_selectedType is null)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
        Select a leave type to filter the calendar and submit a request.
    </MudAlert>
}

<div class="cal-card">
    <div class="cal-head">
        <div class="cal-head-left">
            <button class="cal-nav" @onclick="() => Navigate(-1)" aria-label="Previous">‹</button>
            <span class="cal-label">@HeaderLabel</span>
            <button class="cal-nav" @onclick="() => Navigate(1)" aria-label="Next">›</button>
            <button class="cal-today" @onclick="GoToday">TODAY</button>
        </div>
        <div class="cal-seg" role="tablist">
            @foreach (var view in Enum.GetValues<CalView>())
            {
                var v = view;
                <button class="cal-seg-btn @(_view == v ? "active" : "")" @onclick="() => SetView(v)">@v</button>
            }
        </div>
    </div>

    @if (_view == CalView.Month)
    {
        <div class="cal-body">
            <div class="cal-grid cal-header">
                @foreach (var name in new[] { "MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN" })
                {
                    <div class="cal-dow">@name</div>
                }
            </div>

            <div class="cal-grid">
                @foreach (var day in _days)
                {
                    var inMonth = day.Month == VisibleMonth.Month;
                    var isPast = day < _today;
                    var selected = IsSelected(day);
                    var isEndpoint = IsRangeEndpoint(day);
                    var canSelect = CanSelectDay(day);
                    <div class="cal-cell @(inMonth ? "" : "cal-other") @(IsWeekend(day) ? "cal-weekend" : "") @(isPast ? "cal-past" : "") @(selected ? "cal-selected" : "") @(isEndpoint ? "cal-range-endpoint" : "") @(canSelect ? "cal-selectable" : "cal-disabled") @(day == _today ? "cal-today-cell" : "")"
                         style="@SelectionStyle(day)"
                         data-date="@day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                         aria-disabled="@(!canSelect)"
                         title="@UnavailableDateHint(day)"
                         @onclick="DayClickCallback(day)">
                        <span class="cal-daynum">@day.Day</span>
                        @if (_teamByDay.TryGetValue(day, out var absences))
                        {
                            var visible = absences.Where(a => PassesFilter(a.Type)).ToList();
                            @foreach (var absence in visible.Take(3))
                            {
                                <MudTooltip Text="@($"{absence.MemberName} · {LeaveTypePalette.Label(absence.Type)}")">
                                    <span class="cal-chip" style="background:@LeaveTypePalette.Hex(absence.Type);">
                                        @ShortName(absence.MemberName)
                                    </span>
                                </MudTooltip>
                            }
                            @if (visible.Count > 3)
                            {
                                <span class="cal-more">+@(visible.Count - 3) more</span>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    }
    else if (_view == CalView.Week)
    {
        <div class="wv">
            @for (var i = 0; i < 7; i++)
            {
                var day = WeekStart.AddDays(i);
                var isToday = day == _today;
                var isPast = day < _today;
                var isWeekend = IsWeekend(day);
                var selected = IsSelected(day);
                var isEndpoint = IsRangeEndpoint(day);
                var canSelect = CanSelectDay(day);
                <div class="wv-col">
                    <div class="wv-head @(isPast ? "wv-head-past" : "") @(isWeekend ? "wv-head-weekend" : "")">
                        <span class="wv-dow">@(day.ToString("ddd", CultureInfo.InvariantCulture).ToUpperInvariant())</span>
                        <span class="wv-num @(isToday ? "wv-num-today" : "")">@day.Day</span>
                    </div>
                    <div class="wv-cell @(isToday ? "wv-cell-today" : "") @(isWeekend ? "wv-cell-weekend" : "") @(isPast ? "wv-cell-past" : "") @(selected ? "wv-cell-selected" : "") @(isEndpoint ? "wv-range-endpoint" : "") @(canSelect ? "wv-cell-selectable" : "wv-cell-disabled")"
                         style="@SelectionStyle(day)"
                         data-date="@day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                         aria-disabled="@(!canSelect)"
                         title="@UnavailableDateHint(day)"
                         @onclick="DayClickCallback(day)">
                        @foreach (var item in FilteredRanges.Where(r => r.StartDate <= day && r.EndDate >= day))
                        {
                            <div class="wv-card" style="background:@LeaveTypePalette.Hex(item.Type);">
                                <div class="wv-name">@item.MemberName</div>
                                <div class="wv-sub">@LeaveTypePalette.Label(item.Type) · @item.Department</div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (_view == CalView.Grid)
    {
        var daysInMonth = DateTime.DaysInMonth(VisibleMonth.Year, VisibleMonth.Month);
        var rows = GridRows();
        <div class="gv" style="grid-template-columns:210px 92px repeat(@daysInMonth, minmax(0, 1fr));">
            <div class="gv-hcell gv-fixed">EMPLOYEE</div>
            <div class="gv-hcell gv-fixed gv-sep">TYPE</div>
            @for (var d = 1; d <= daysInMonth; d++)
            {
                var date = new DateOnly(VisibleMonth.Year, VisibleMonth.Month, d);
                var selected = IsSelected(date);
                var isEndpoint = IsRangeEndpoint(date);
                <div class="gv-hday @(IsWeekend(date) ? "gv-hwend gv-hdisabled" : "") @(date == _today ? "gv-htoday" : "") @(selected ? "gv-range-selected" : "") @(isEndpoint ? "gv-range-endpoint" : "")"
                     style="@SelectionStyle(date)"
                     aria-disabled="@(!CanSelectDay(date))"
                     title="@UnavailableDateHint(date)"
                     @onclick="() => OnDayClick(date)">
                    <span class="gv-hdow">@(date.ToString("ddd", CultureInfo.InvariantCulture)[..2].ToUpperInvariant())</span>
                    <span class="gv-hnum">@d</span>
                </div>
            }
            @foreach (var row in rows)
            {
                <div class="gv-cell gv-emp">
                    <span class="gv-avatar" style="background:@AvatarColor(row.Name);">@row.Initials</span>
                    <span class="gv-emp-text">
                        <span class="gv-emp-name">@row.Name</span>
                        <span class="gv-emp-sub">@row.Department@(row.Team is null ? "" : $" · {row.Team}")</span>
                    </span>
                </div>
                <div class="gv-cell gv-sep gv-type">
                    <span class="gv-pill" style="color:@LeaveTypePalette.Hex(row.Type, ThemeState.IsDarkMode); background:@(LeaveTypePalette.Hex(row.Type, ThemeState.IsDarkMode) + "1F");">
                        @(LeaveTypePalette.Label(row.Type).Split(' ')[0])
                    </span>
                </div>
                @for (var d = 1; d <= daysInMonth; d++)
                {
                    var date = new DateOnly(VisibleMonth.Year, VisibleMonth.Month, d);
                    var seg = row.Items.FirstOrDefault(r => r.StartDate <= date && r.EndDate >= date);
                    <div class="gv-cell gv-day @(IsWeekend(date) ? "gv-wend" : "") @(date == _today ? "gv-today" : "")">
                        @if (seg is not null)
                        {
                            <div class="gv-bar @(date == seg.StartDate ? "gv-bar-s" : "") @(date == seg.EndDate ? "gv-bar-e" : "")"
                                 style="background:@LeaveTypePalette.Hex(seg.Type);"></div>
                        }
                    </div>
                }
            }
        </div>
        @if (rows.Count == 0)
        {
            <div class="cal-empty">No approved team leave this month.</div>
        }
        <div class="gv-legend">
            @foreach (var leaveType in Enum.GetValues<LeaveType>())
            {
                <span class="gv-legend-item">
                    <span class="gv-swatch" style="background:@LeaveTypePalette.Hex(leaveType);"></span>@(LeaveTypePalette.Label(leaveType).Split(' ')[0])
                </span>
            }
            <span class="gv-legend-item"><span class="gv-square gv-square-wend"></span>Weekend</span>
            <span class="gv-legend-item"><span class="gv-square gv-square-today"></span>Today</span>
        </div>
    }
    else
    {
        var rows = FilteredRanges.OrderBy(r => r.StartDate).ToList();
        <div class="lv">
            <div class="lv-hcell">EMPLOYEE</div>
            <div class="lv-hcell">DEPARTMENT</div>
            <div class="lv-hcell">TEAM</div>
            <div class="lv-hcell">LEAVE TYPE</div>
            <div class="lv-hcell">PERIOD</div>
            <div class="lv-hcell">DAYS</div>
            @foreach (var item in rows)
            {
                <div class="lv-cell lv-emp">
                    <span class="gv-avatar" style="background:@AvatarColor(item.MemberName);">@item.Initials</span>
                    <span class="lv-name">@item.MemberName</span>
                </div>
                <div class="lv-cell">@item.Department</div>
                <div class="lv-cell">@(item.Team ?? "—")</div>
                <div class="lv-cell">
                    <span class="gv-pill" style="color:@LeaveTypePalette.Hex(item.Type, ThemeState.IsDarkMode); background:@(LeaveTypePalette.Hex(item.Type, ThemeState.IsDarkMode) + "1F");">
                        @(LeaveTypePalette.Label(item.Type).Split(' ')[0])
                    </span>
                </div>
                <div class="lv-cell">
                    @item.StartDate.ToString("MMM d", CultureInfo.InvariantCulture) –
                    @item.EndDate.ToString("MMM d", CultureInfo.InvariantCulture)
                </div>
                <div class="lv-cell">@WorkingDays(item.StartDate, item.EndDate)</div>
            }
        </div>
        @if (rows.Count == 0)
        {
            <div class="cal-empty">No approved team leave this month.</div>
        }
    }
</div>

@* The submit bar must stay nested inside this wrapping div (not a sibling after it):
   its ::deep CSS rule compiles to "[scope] .cal-submitbar", which only matches
   descendants of a scoped element — position:fixed still pins it to the viewport
   regardless of DOM nesting, so this doesn't change where it renders. *@
@if (ShowSubmitBar && _range is { } range && _selectedType is { } type)
{
    <MudPaper Elevation="4" Class="pa-4 d-flex align-center flex-wrap gap-4 cal-submitbar">
        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">
            @LeaveTypePalette.Label(type) ·
            @range.Start.ToString("MMM d", CultureInfo.InvariantCulture) –
            @range.End.ToString("MMM d", CultureInfo.InvariantCulture)
            (@RangeDays(range) @(RangeDays(range) == 1 ? "day" : "days"))
        </MudText>
        <MudTextField @bind-Value="_reason" Label="Reason (optional)" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Class="flex-grow-1" Style="min-width:220px;" />
        <MudButton Variant="Variant.Text" OnClick="CancelSelection">Cancel selection</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Submit request</MudButton>
    </MudPaper>
}

</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private enum CalView { Month, Week, Grid, List }

    private static readonly string[] AvatarPalette =
    [
        "#1e88e5", "#8e24aa", "#fb8c00", "#43a047", "#e53935",
        "#00897b", "#5e35b1", "#f4511e", "#3949ab", "#00acc1"
    ];

    private IReadOnlyList<LeaveBalance> _balances = [];
    private Dictionary<DateOnly, List<TeamAbsence>> _teamByDay = [];
    private List<DateOnly> _days = [];
    private IReadOnlyList<TeamTimeOff> _ranges = [];

    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private CalView _view = CalView.Month;

    // Cursor date: Month/Grid/List show its month, Week shows its Mon–Sun week.
    private DateOnly _anchor;
    private DateOnly VisibleMonth => new(_anchor.Year, _anchor.Month, 1);
    private DateOnly WeekStart => _anchor.AddDays(-(((int)_anchor.DayOfWeek + 6) % 7));

    private LeaveType? _selectedType;
    private DateOnly? _anchorDay;
    private (DateOnly Start, DateOnly End)? _range;
    private string? _reason;

    private bool ShowSubmitBar => _range is not null && _selectedType is not null;

    private string _userName = "";

    protected override async Task OnInitializedAsync()
    {
        if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
            return;

        _userName = (await TimeOff.GetCurrentUserAsync()).Name;
        _balances = await TimeOff.GetMyBalancesAsync();
        _anchor = _today;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_view == CalView.Month)
        {
            _teamByDay = (await TimeOff.GetTeamScheduleForMonthAsync(VisibleMonth))
                .GroupBy(a => a.Date)
                .ToDictionary(g => g.Key, g => g.ToList());

            var gridStart = VisibleMonth.AddDays(-(((int)VisibleMonth.DayOfWeek + 6) % 7));
            _days = Enumerable.Range(0, 42).Select(gridStart.AddDays).ToList();
        }
        else
        {
            var (from, to) = _view == CalView.Week
                ? (WeekStart, WeekStart.AddDays(6))
                : (VisibleMonth, VisibleMonth.AddMonths(1).AddDays(-1));
            _ranges = await TimeOff.GetTeamTimeOffForRangeAsync(from, to);
        }
    }

    private async Task Navigate(int delta)
    {
        _anchor = _view == CalView.Week
            ? _anchor.AddDays(7 * delta)
            : VisibleMonth.AddMonths(delta);
        await LoadAsync();
    }

    private async Task GoToday()
    {
        _anchor = _today;
        await LoadAsync();
    }

    private async Task SetView(CalView view)
    {
        if (_view == view)
            return;
        _view = view;
        await LoadAsync();
    }

    private string HeaderLabel => _view == CalView.Week
        ? WeekLabel()
        : VisibleMonth.ToString("MMMM yyyy", CultureInfo.InvariantCulture);

    private string WeekLabel()
    {
        var start = WeekStart;
        var end = start.AddDays(6);
        var inv = CultureInfo.InvariantCulture;
        if (start.Year != end.Year)
            return $"{start.ToString("MMM d, yyyy", inv)} – {end.ToString("MMM d, yyyy", inv)}";
        if (start.Month != end.Month)
            return $"{start.ToString("MMM d", inv)} – {end.ToString("MMM d", inv)}, {end.Year}";
        return $"{start.ToString("MMM d", inv)} – {end.Day}, {end.Year}";
    }

    // The selected type chip doubles as a content filter; no selection shows everything.
    private bool PassesFilter(LeaveType type) => _selectedType is null || _selectedType == type;

    private IEnumerable<TeamTimeOff> FilteredRanges => _ranges.Where(r => PassesFilter(r.Type));

    private record GridRow(string Name, string Initials, string Department, string? Team, LeaveType Type, List<TeamTimeOff> Items);

    private List<GridRow> GridRows() =>
        FilteredRanges
            .GroupBy(r => r.MemberName)
            .Select(g =>
            {
                var first = g.OrderBy(r => r.StartDate).First();
                return new GridRow(g.Key, first.Initials, first.Department, first.Team, first.Type, g.ToList());
            })
            .OrderBy(r => r.Name)
            .ToList();

    private static bool IsWeekend(DateOnly day) =>
        day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;

    private static int WorkingDays(DateOnly start, DateOnly end)
    {
        var count = 0;
        for (var day = start; day <= end; day = day.AddDays(1))
            if (!IsWeekend(day))
                count++;
        return count;
    }

    private static string AvatarColor(string name)
    {
        var hash = 0;
        foreach (var ch in name)
            hash = (hash * 31 + ch) & 0x7fffffff;
        return AvatarPalette[hash % AvatarPalette.Length];
    }

    private void SelectType(LeaveType type)
    {
        if (_selectedType == type)
        {
            _selectedType = null;
            CancelSelection();
        }
        else
        {
            _selectedType = type;
        }
    }

    private bool IsSelected(DateOnly day) =>
        _range is { } r && day >= r.Start && day <= r.End;

    private bool IsRangeEndpoint(DateOnly day) =>
        _range is { } r && (day == r.Start || day == r.End);

    private string SelectionStyle(DateOnly day)
    {
        if (!IsSelected(day) || _selectedType is not { } type)
            return "";

        var color = LeaveTypePalette.Hex(type, ThemeState.IsDarkMode);
        return IsRangeEndpoint(day)
            ? $"background:{color}; color:#fff; border-color:{color};"
            : $"background:{LeaveTypePalette.HighlightHex(type, ThemeState.IsDarkMode)}; border-color:{color}66;";
    }

    private bool CanSelectDay(DateOnly day) =>
        _selectedType is not null && day >= _today && !IsWeekend(day);

    private EventCallback<MouseEventArgs> DayClickCallback(DateOnly day) =>
        CanSelectDay(day)
            ? EventCallback.Factory.Create<MouseEventArgs>(this, () => OnDayClick(day))
            : default;

    private string? UnavailableDateHint(DateOnly day)
    {
        if (day < _today)
            return "Past dates cannot be selected.";
        if (IsWeekend(day))
            return "Weekends are already non-working days.";
        return _selectedType is null ? "Select a leave type first." : null;
    }

    private void OnDayClick(DateOnly day)
    {
        if (!CanSelectDay(day))
            return;

        if (IsSelected(day))
        {
            _range = null;
            _anchorDay = null;
            return;
        }

        if (_anchorDay is not { } anchor || _range is { } existing && existing.Start != existing.End)
        {
            _anchorDay = day;
            _range = (day, day);
            return;
        }

        _range = day < anchor ? (day, anchor) : (anchor, day);
    }

    private void CancelSelection()
    {
        _range = null;
        _anchorDay = null;
        _reason = null;
    }

    private async Task Submit()
    {
        if (_range is not { } range || _selectedType is not { } type)
            return;

        try
        {
            await TimeOff.SubmitRequestAsync(type, range.Start, range.End, _reason);
            Snackbar.Add("Time off request submitted", Severity.Success);
            CancelSelection();
            _selectedType = null;
        }
        catch (Exception ex)
        {
            // Business validations (overlap, balance, past dates) surface here.
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static int RangeDays((DateOnly Start, DateOnly End) range) =>
        WorkingDays(range.Start, range.End);

    private string TypeChipStyle(LeaveType type, bool isSelected)
    {
        var hex = LeaveTypePalette.Hex(type);
        return isSelected
            ? $"background:{hex}; color:white;"
            : $"color:{hex}; border-color:{hex};";
    }

    private static string ShortName(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 1 ? $"{parts[0]} {parts[^1][0]}." : fullName;
    }
}
