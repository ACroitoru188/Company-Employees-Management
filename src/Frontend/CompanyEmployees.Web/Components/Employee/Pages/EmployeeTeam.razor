@page "/employee/team"
@layout EmployeeLayout
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@inject ITimeOffService TimeOff
@inject NavigationManager Nav

<PageTitle>Team · Time Off Management</PageTitle>

<FluentLabel Typo="Typography.PaneHeader" Weight="FontWeight.Bold">My Team</FluentLabel>
<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" MarginBlock="4px 16px">
    Your manager and the colleagues who share them, with their time off.
</FluentLabel>

<FluentCard>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
        @if (_team.Count == 0)
        {
            <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                You are not part of a team yet.
            </FluentLabel>
        }
        else
        {
            @foreach (var member in _team)
            {
                <FluentDivider Role="DividerRole.Presentation" />
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12"
                             VerticalAlignment="VerticalAlignment.Center" Width="100%">
                    <FluentPersona Name="@member.Name" Initials="@member.Initials"
                                   ImageSize="36px" TextPosition="TextPosition.End">
                        @* FluentPersona drops its Name whenever ChildContent is supplied, so the name is
                           rendered here explicitly above the secondary line. *@
                        <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@member.Name</FluentLabel>
                        <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-caption">@member.RoleLabel</FluentLabel>
                    </FluentPersona>

                    @if (member.IsManager)
                    {
                        @* FluentBadge only accepts Accent, Lightweight or Neutral — anything
                           else throws out of OnParametersSet and takes the circuit with it. *@
                        <FluentBadge Appearance="Appearance.Lightweight">Manager</FluentBadge>
                    }

                    <FluentSpacer />

                    @if (member.Type is { } type && member.Start is { } start && member.End is { } end)
                    {
                        @* Per-category colour, which Fluent's single-accent palette has no slot for. *@
                        <FluentBadge Fill="highlight"
                                     BackgroundColor="@LeaveTypePalette.Hex(type)"
                                     Color="white">
                            @LeaveTypePalette.Label(type)
                        </FluentBadge>

                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0"
                                     HorizontalAlignment="HorizontalAlignment.End" Width="160px">
                            <FluentLabel Typo="Typography.Body">
                                @start.ToString("MMM d", CultureInfo.InvariantCulture) –
                                @end.ToString("MMM d", CultureInfo.InvariantCulture)
                            </FluentLabel>
                            <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-caption">
                                @(start <= _today ? "On leave now" : "Upcoming leave")
                            </FluentLabel>
                        </FluentStack>
                    }
                    else
                    {
                        <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Available</FluentLabel>
                    }
                </FluentStack>
            }
        }
    </FluentStack>
</FluentCard>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private IReadOnlyList<TeamRosterEntry> _team = [];
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
            return;

        _team = await TimeOff.GetTeamRosterAsync();
    }
}
