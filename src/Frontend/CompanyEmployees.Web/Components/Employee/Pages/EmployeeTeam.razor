@page "/employee/team"
@layout EmployeeLayout
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@using CompanyEmployees.Web.Services
@inject ITimeOffService TimeOff
@inject AppLocalizer Text
@inject IDialogService DialogService
@inject ChatPanelState ChatPanel
@inject NavigationManager Nav

<PageTitle>@Text["Team"] · @Text["Time Off Management"]</PageTitle>

<FluentLabel Typo="Typography.PaneHeader" Weight="FontWeight.Bold">@Text["My Team"]</FluentLabel>
<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" MarginBlock="4px 16px">
    @Text["Your manager and the colleagues who share them, with their time off."]
</FluentLabel>

<FluentCard>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
        @if (_team.Count == 0)
        {
            <EmptyState Icon="@(new Icons.Regular.Size24.People())"
                        Title="@Text["You are not part of a team yet."]"
                        Boxed="false" />
        }
        else
        {
            @foreach (var member in _team)
            {
                <FluentDivider Role="DividerRole.Presentation" />
                <div class="team-row @(member.UserId == Guid.Empty ? "" : "team-row-clickable")"
                     @onclick="@(() => OpenMemberAsync(member))">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12"
                             VerticalAlignment="VerticalAlignment.Center" Width="100%">
                    <FluentPersona Name="@member.Name" Initials="@member.Initials"
                                   ImageSize="36px" TextPosition="TextPosition.End">
                        @* FluentPersona drops its Name whenever ChildContent is supplied, so the name is
                           rendered here explicitly above the secondary line. *@
                        <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@member.Name</FluentLabel>
                        <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-caption">@LocalizedRoleLabel(member.RoleLabel)</FluentLabel>
                    </FluentPersona>

                    @if (member.IsManager)
                    {
                        @* FluentBadge only accepts Accent, Lightweight or Neutral — anything
                           else throws out of OnParametersSet and takes the circuit with it. *@
                        <FluentBadge Appearance="Appearance.Lightweight">@Text["Manager"]</FluentBadge>
                    }

                    <FluentSpacer />

                    @if (member.Type is { } type && member.Start is { } start && member.End is { } end)
                    {
                        @* Per-category colour, which Fluent's single-accent palette has no slot for. *@
                        <FluentBadge Fill="highlight"
                                     BackgroundColor="@LeaveTypePalette.Hex(type)"
                                     Color="white">
                            @Text[type.ToString()]
                        </FluentBadge>

                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0"
                                     HorizontalAlignment="HorizontalAlignment.End" Width="160px">
                            <FluentLabel Typo="Typography.Body">
                                @start.ToString("MMM d", CultureInfo.CurrentCulture) –
                                @end.ToString("MMM d", CultureInfo.CurrentCulture)
                            </FluentLabel>
                            <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-caption">
                                @(start <= _today ? Text["On leave now"] : Text["Upcoming leave"])
                            </FluentLabel>
                        </FluentStack>
                    }
                    else
                    {
                        <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">@Text["Available"]</FluentLabel>
                    }
                </FluentStack>
                </div>
            }
        }
    </FluentStack>
</FluentCard>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private IReadOnlyList<TeamRosterEntry> _team = [];
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
            return;

        _team = await TimeOff.GetTeamRosterAsync();
    }

    private async Task OpenMemberAsync(TeamRosterEntry member)
    {
        // Guid.Empty is the in-memory mock, which has no user ids: nothing to open.
        if (member.UserId == Guid.Empty)
            return;

        var content = new TeamMemberDialog.Model
        {
            Member = member,
            RoleLabel = LocalizedRoleLabel(member.RoleLabel)
        };

        var dialog = await DialogService.ShowDialogAsync<TeamMemberDialog, TeamMemberDialog.Model>(
            content, new DialogParameters
            {
                Title = member.Name,
                PrimaryAction = Text["Send message"],
                SecondaryAction = Text["Close"],
                Width = "420px"
            });

        var result = await dialog.Result;
        if (!result.Cancelled)
            // Opens the floating panel rather than navigating: chat is not a page any more,
            // so sending a message should not take you off the one you are on.
            await ChatPanel.OpenAsync(member.UserId);
    }

    // The label arrives already composed as "Role · Department" from DbTimeOffService. Only the
    // role half has a translation; the department is a name the administrator typed.
    // "Employee" needs its own key because it also names the Employee column elsewhere.
    private string LocalizedRoleLabel(string label)
    {
        var parts = label.Split(" · ", 2, StringSplitOptions.None);
        var roleKey = parts[0] == "Employee" ? "Employee role" : parts[0];
        return parts.Length == 1 ? Text[roleKey] : $"{Text[roleKey]} · {parts[1]}";
    }
}
