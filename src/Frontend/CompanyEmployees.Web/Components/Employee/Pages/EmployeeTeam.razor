@page "/employee/team"
@layout EmployeeLayout
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@inject ITimeOffService TimeOff
@inject NavigationManager Nav
@inject AppLocalizer Text

<PageTitle>Team · Time Off Management</PageTitle>

<MudText Typo="Typo.h5" Style="font-weight:600;">@Text["My Team"]</MudText>
<MudText Typo="Typo.body2" Class="mb-4" Style="color:var(--mud-palette-text-secondary);">
    @Text["Your manager and the colleagues who share them, with their time off."]
</MudText>

<MudCard Elevation="1">
    <MudCardContent>
        @if (_team.Count == 0)
        {
            <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">
                @Text["You are not part of a team yet."]
            </MudText>
        }
        else
        {
            @foreach (var member in _team)
            {
                <div class="d-flex align-center gap-3 py-3"
                     style="border-bottom:1px solid var(--mud-palette-lines-default);">
                    <MudAvatar Size="Size.Small" Color="Color.Primary">@member.Initials</MudAvatar>
                    <div class="flex-grow-1">
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.body2" Style="font-weight:500;">@member.Name</MudText>
                            @if (member.IsManager)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Color="Color.Primary">@Text["Manager"]</MudChip>
                            }
                        </div>
                        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
                            @LocalizedRoleLabel(member.RoleLabel)
                        </MudText>
                    </div>
                    @if (member.Type is { } type && member.Start is { } start && member.End is { } end)
                    {
                        <MudChip T="string" Size="Size.Small"
                                 Style="@($"background:{LeaveTypePalette.Hex(type)}; color:white;")">
                            @Text[type.ToString()]
                        </MudChip>
                        <div style="text-align:right; min-width:150px;">
                            <MudText Typo="Typo.body2">
                                @start.ToString("d", CultureInfo.CurrentCulture) –
                                @end.ToString("d", CultureInfo.CurrentCulture)
                            </MudText>
                            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
                                @(start <= _today ? Text["On leave now"] : Text["Upcoming leave"])
                            </MudText>
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary); min-width:150px; text-align:right;">
                            @Text["Available"]
                        </MudText>
                    }
                </div>
            }
        }
    </MudCardContent>
</MudCard>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private IReadOnlyList<TeamRosterEntry> _team = [];
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
            return;

        _team = await TimeOff.GetTeamRosterAsync();
    }

    private string LocalizedRoleLabel(string label)
    {
        var parts = label.Split(" · ", 2, StringSplitOptions.None);
        var roleKey = parts[0] == "Employee" ? "Employee role" : parts[0];
        return parts.Length == 1 ? Text[roleKey] : $"{Text[roleKey]} · {parts[1]}";
    }
}
