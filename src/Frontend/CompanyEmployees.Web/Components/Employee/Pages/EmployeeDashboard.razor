@page "/employee/dashboard"
@layout EmployeeLayout
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@using CompanyEmployees.Web.Services
@inject ITimeOffService TimeOff
@inject AppLocalizer Text
@inject NavigationManager Nav

<PageTitle>@Text["Dashboard"] · @Text["Time Off Management"]</PageTitle>

<LeaveBalanceSummary UserName="@_userName" Balances="@_balances">
    <Actions>
        <FluentButton Appearance="Appearance.Accent"
                      IconStart="@(new Icons.Regular.Size20.Add())"
                      OnClick="@(() => Nav.NavigateTo("/employee/calendar"))">
            @Text["Request time off"]
        </FluentButton>
    </Actions>
</LeaveBalanceSummary>

<FluentCard Style="margin-top:24px;">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
        <FluentLabel Typo="Typography.Header" Weight="FontWeight.Bold">@Text["Team time off"]</FluentLabel>

        @if (_teamTimeOff.Count == 0)
        {
            <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                @Text["No upcoming time off in your team."]
            </FluentLabel>
        }
        else
        {
            @foreach (var entry in _teamTimeOff)
            {
                <FluentDivider Role="DividerRole.Presentation" />
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12"
                             VerticalAlignment="VerticalAlignment.Center" Width="100%">
                    <FluentPersona Name="@entry.MemberName" Initials="@entry.Initials"
                                   ImageSize="36px" TextPosition="TextPosition.End">
                        @* FluentPersona drops its Name whenever ChildContent is supplied, so the name is
                           rendered here explicitly above the secondary line. *@
                        <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@entry.MemberName</FluentLabel>
                        <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-caption">@entry.Department</FluentLabel>
                    </FluentPersona>

                    <FluentSpacer />

                    @* Per-category colour, which Fluent's single-accent palette has no slot for. *@
                    <FluentBadge Fill="highlight"
                                 BackgroundColor="@LeaveTypePalette.Hex(entry.Type)"
                                 Color="white">
                        @Text[entry.Type.ToString()]
                    </FluentBadge>

                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0"
                                 HorizontalAlignment="HorizontalAlignment.End" Width="160px">
                        <FluentLabel Typo="Typography.Body">
                            @entry.StartDate.ToString("MMM d", CultureInfo.CurrentCulture) –
                            @entry.EndDate.ToString("MMM d", CultureInfo.CurrentCulture)
                        </FluentLabel>
                        <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-caption">
                            @entry.Days @Text[entry.Days == 1 ? "day" : "days"]@(IsOngoing(entry) ? $" · {Text["away now"]}" : "")
                        </FluentLabel>
                    </FluentStack>
                </FluentStack>
            }
        }
    </FluentStack>
</FluentCard>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private IReadOnlyList<TeamTimeOff> _teamTimeOff = [];
    private IReadOnlyList<LeaveBalance> _balances = [];
    private string _userName = "";

    protected override async Task OnInitializedAsync()
    {
        if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
            return;

        _userName = (await TimeOff.GetCurrentUserAsync()).Name;
        _balances = await TimeOff.GetMyBalancesAsync();
        _teamTimeOff = await TimeOff.GetTeamTimeOffAsync();
    }

    private static bool IsOngoing(TeamTimeOff entry)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        return entry.StartDate <= today && today <= entry.EndDate;
    }
}
