@page "/employee/dashboard"
@layout EmployeeLayout
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@inject ITimeOffService TimeOff
@inject NavigationManager Nav

<PageTitle>Dashboard · Time Off Management</PageTitle>

<LeaveBalanceSummary UserName="@_userName" Balances="@_balances">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Nav.NavigateTo("/employee/calendar"))">
            Request time off
        </MudButton>
    </Actions>
</LeaveBalanceSummary>

<MudCard Elevation="1" Class="mt-6">
    <MudCardContent>
        <MudText Typo="Typo.h6" Class="mb-2" Style="font-weight:600;">Team time off</MudText>
        @if (_teamTimeOff.Count == 0)
        {
            <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">
                No upcoming time off in your team.
            </MudText>
        }
        else
        {
            @foreach (var entry in _teamTimeOff)
            {
                <div class="d-flex align-center gap-3 py-3"
                     style="border-bottom:1px solid var(--mud-palette-lines-default);">
                    <MudAvatar Size="Size.Small"
                               Style="@($"background:{LeaveTypePalette.Hex(entry.Type)}; color:white; font-size:.7rem;")">
                        @entry.Initials
                    </MudAvatar>
                    <div class="flex-grow-1">
                        <MudText Typo="Typo.body2" Style="font-weight:500;">@entry.MemberName</MudText>
                        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
                            @entry.Department
                        </MudText>
                    </div>
                    <MudChip T="string" Size="Size.Small"
                             Style="@($"background:{LeaveTypePalette.Hex(entry.Type)}; color:white;")">
                        @LeaveTypePalette.Label(entry.Type)
                    </MudChip>
                    <div style="text-align:right; min-width:150px;">
                        <MudText Typo="Typo.body2">
                            @entry.StartDate.ToString("MMM d", CultureInfo.InvariantCulture) –
                            @entry.EndDate.ToString("MMM d", CultureInfo.InvariantCulture)
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
                            @entry.Days @(entry.Days == 1 ? "day" : "days")@(IsOngoing(entry) ? " · away now" : "")
                        </MudText>
                    </div>
                </div>
            }
        }
    </MudCardContent>
</MudCard>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private IReadOnlyList<TeamTimeOff> _teamTimeOff = [];
    private IReadOnlyList<LeaveBalance> _balances = [];
    private string _userName = "";

    protected override async Task OnInitializedAsync()
    {
        if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
            return;

        _userName = (await TimeOff.GetCurrentUserAsync()).Name;
        _balances = await TimeOff.GetMyBalancesAsync();
        _teamTimeOff = await TimeOff.GetTeamTimeOffAsync();
    }

    private static bool IsOngoing(TeamTimeOff entry)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        return entry.StartDate <= today && today <= entry.EndDate;
    }
}
