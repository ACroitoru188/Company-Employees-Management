@page "/admin/departments"
@layout EmployeeLayout
@using System.Security.Claims
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Domain.Entities
@using CompanyEmployees.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@inject EmployeeContext Employees
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Departments · Admin</PageTitle>

@if (!_authorized)
{
	<MudProgressCircular Indeterminate="true" />
}
else
{
	<MudText Typo="Typo.h5" Style="font-weight:600;" Class="mb-4">Departments</MudText>

	<MudDataGrid T="Department" Items="@_departments" QuickFilter="@_quickFilter"
				 Filterable="true" SortMode="SortMode.Multiple"
				 FilterMode="DataGridFilterMode.ColumnFilterRow"
				 Hover="true" Dense="true" Elevation="1" Class="mb-6">
		<ToolBarContent>
			<MudTextField @bind-Value="_quickSearch" Placeholder="Search department..."
						  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
						  IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense"
						  Immediate="true" />
			<MudSpacer />
		</ToolBarContent>
		<Columns>
			<TemplateColumn T="Department" Title="Name" Sortable="true"
							SortBy="@(d => d.Name)" Filterable="false">
				<CellTemplate>
					<MudTextField @bind-Value="context.Item.Name" Immediate="false"
								  OnBlur="@(() => SaveDepartmentAsync(context.Item))" />
				</CellTemplate>
			</TemplateColumn>
			<TemplateColumn T="Department" Title="Manager" Sortable="true"
							SortBy="@(d => GetManagerName(d.ManagerId))" Filterable="false">
				<CellTemplate>
					<MudAutocomplete T="Guid?" Value="context.Item.ManagerId"
									 ValueChanged="@(v => OnManagerChangedAsync(context.Item, v))"
									 SearchFunc="@SearchManagers"
									 ToStringFunc="@GetManagerName"
									 ResetValueOnEmptyText="true"
									 CoerceText="true" />
				</CellTemplate>
			</TemplateColumn>
			<PropertyColumn Property="@(d => d.Members.Count)" Title="Members" />
			<TemplateColumn T="Department" Sortable="false" Filterable="false">
				<CellTemplate>
					<MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
								   OnClick="@(() => DeleteDepartmentAsync(context.Item))" />
				</CellTemplate>
			</TemplateColumn>
		</Columns>
		<PagerContent>
			<MudDataGridPager T="Department" />
		</PagerContent>
	</MudDataGrid>

	<MudPaper Class="pa-4 mb-6" Elevation="0" Outlined="true">
		<MudText Typo="Typo.subtitle2" Class="mb-2">New department</MudText>
		<div class="d-flex align-center gap-3">
			<MudTextField T="string" @bind-Value="_newName" Label="Name" />
			<MudAutocomplete T="Guid?" @bind-Value="_newManagerId" Label="Manager" Style="min-width:200px;"
							 SearchFunc="@SearchManagers"
							 ToStringFunc="@GetManagerName"
							 ResetValueOnEmptyText="true"
							 CoerceText="true" />
			<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateDepartmentAsync">
				Add
			</MudButton>
		</div>
	</MudPaper>
}

@code {
	[CascadingParameter]
	private Task<AuthenticationState>? AuthStateTask { get; set; }

	private bool _authorized;
	private List<Department> _departments = [];
	private List<User> _users = [];
	private IEnumerable<User> _lineManagers => _users.Where(u => u.Role == UserRole.LineManager);

	private string _newName = "";
	private Guid? _newManagerId;

	private string _quickSearch = "";

	private Func<Department, bool> _quickFilter => d =>
	{
		if (string.IsNullOrWhiteSpace(_quickSearch)) return true;
		return d.Name.Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
			|| GetManagerName(d.ManagerId).Contains(_quickSearch, StringComparison.OrdinalIgnoreCase);
	};

	// The role comes from the auth cookie's claims (AppClaimsPrincipalFactory),
	// so non-admins are redirected without a database query.
	protected override async Task OnInitializedAsync()
	{
		if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
			return;

		var user = (await AuthStateTask!).User;
		var role = user.FindFirst(ClaimTypes.Role)?.Value;
		if (role != UserRole.Admin.ToString())
		{
			Nav.NavigateTo("/employee/dashboard");
			return;
		}

		_authorized = true;
		await LoadAsync();
	}

	private async Task LoadAsync()
	{
		_departments = await Employees.GetDepartmentsAsync();
		_users = await Employees.GetAllUsersAsync();
	}

	private async Task SaveDepartmentAsync(Department dept)
	{
		await Employees.UpdateDepartmentAsync(dept.Id, dept.Name, dept.ManagerId);
		Snackbar.Add("Department updated.", Severity.Success);
		await LoadAsync();
	}

	private async Task OnManagerChangedAsync(Department dept, Guid? managerId)
	{
		dept.ManagerId = managerId;
		await SaveDepartmentAsync(dept);
	}

	private async Task CreateDepartmentAsync()
	{
		if (string.IsNullOrWhiteSpace(_newName))
		{
			Snackbar.Add("Name is required.", Severity.Warning);
			return;
		}
		await Employees.CreateDepartmentAsync(_newName, _newManagerId);
		Snackbar.Add("Department created.", Severity.Success);
		_newName = "";
		_newManagerId = null;
		await LoadAsync();
	}

	private async Task DeleteDepartmentAsync(Department dept)
	{
		await Employees.DeleteDepartmentAsync(dept.Id);
		Snackbar.Add("Department deleted.", Severity.Success);
		await LoadAsync();
	}

	private string GetManagerName(Guid? id) =>
		id == null ? "None" : _lineManagers.FirstOrDefault(m => m.Id == id)?.Name ?? "";

	private Task<IEnumerable<Guid?>> SearchManagers(string value, CancellationToken token)
	{
		var allIds = _lineManagers.Select(m => (Guid?)m.Id).Prepend(null);
		
		// Daca textul e gol, SAU e "None", SAU textul este fix numele deja selectat, afisam toata lista
		if (string.IsNullOrEmpty(value) || value.Equals("None", StringComparison.InvariantCultureIgnoreCase) || _lineManagers.Any(m => m.Name.Equals(value, StringComparison.InvariantCultureIgnoreCase)))
		{
			return Task.FromResult(allIds);
		}
		
		var matches = _lineManagers
			.Where(m => m.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase))
			.Select(m => (Guid?)m.Id);
		return Task.FromResult(matches);
	}
}
