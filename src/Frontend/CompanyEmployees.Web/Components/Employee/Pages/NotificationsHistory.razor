@page "/employee/notifications"
@layout EmployeeLayout
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Domain.Entities
@using CompanyEmployees.Web.Security
@inject NotificationContext Notifications
@inject NavigationManager Nav
@inject ILogger<NotificationsHistory> Logger

<PageTitle>Notifications · Time Off Management</PageTitle>

<FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
             HorizontalGap="12" Wrap="true" Width="100%">
    <FluentLabel Typo="Typography.PaneHeader" Weight="FontWeight.Bold">Notifications</FluentLabel>
    <FluentSpacer />
    @if (_unreadCount > 0)
    {
        <FluentButton Appearance="Appearance.Lightweight"
                      IconStart="@(new Icons.Regular.Size20.CheckmarkCircle())"
                      OnClick="MarkAllAsReadAsync">Mark all as read</FluentButton>
    }
</FluentStack>

@if (_loading)
{
    <FluentProgressRing />
}
else if (_failed)
{
    <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
        Your notifications could not be loaded. Please refresh the page.
    </FluentMessageBar>
}
else if (_total == 0)
{
    <FluentCard Style="margin-top:16px;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8"
                     HorizontalAlignment="HorizontalAlignment.Center">
            <FluentIcon Value="@(new Icons.Regular.Size24.Alert())" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" />
            <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                You have no notifications yet.
            </FluentLabel>
        </FluentStack>
    </FluentCard>
}
else
{
    <FluentCard Style="margin-top:16px;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
            @foreach (var notification in _notifications)
            {
                <FluentButton Appearance="Appearance.Stealth" Style="width:100%; text-align:left;"
                              OnClick="@(() => OpenAsync(notification))">
                    <NotificationRow Notification="@notification" ShowNavigationHint="true" />
                </FluentButton>
                <FluentDivider Role="DividerRole.Presentation" />
            }
        </FluentStack>
    </FluentCard>

    @if (PageCount > 1)
    {
        <FluentStack Orientation="Orientation.Horizontal"
                     HorizontalAlignment="HorizontalAlignment.Center" Width="100%">
            <FluentPaginator State="@_pagination" />
        </FluentStack>
    }
}

@code {
    private const int PageSize = 15;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid _currentUserId;
    private List<Notification> _notifications = new();
    private int _total;
    private int _unreadCount;
    private int _page = 1;
    private bool _loading = true;
    private bool _failed;

    // FluentPaginator drives itself from this state object and raises the change event when
    // the user moves; the page index it exposes is zero-based.
    private readonly PaginationState _pagination = new() { ItemsPerPage = PageSize };

    private int PageCount => (_total + PageSize - 1) / PageSize;

    protected override async Task OnInitializedAsync()
    {
        if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
            return;

        _pagination.TotalItemCountChanged += (_, _) => StateHasChanged();

        var user = (await AuthStateTask!).User;
        if (!Guid.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _currentUserId))
        {
            _failed = true;
            _loading = false;
            return;
        }

        await LoadCountsAsync();
        await LoadPageAsync();
        _loading = false;
    }

    // Sequential awaits throughout: they share this page's scoped DbContext, and two
    // queries in flight on the same context throw.
    private async Task LoadCountsAsync()
    {
        try
        {
            _total = await Notifications.GetHistoryCountAsync(_currentUserId);
            _unreadCount = await Notifications.GetUnreadCountAsync(_currentUserId);
            await _pagination.SetTotalItemCountAsync(_total);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not count notifications for user {UserId}.", _currentUserId);
            _failed = true;
        }
    }

    private async Task LoadPageAsync()
    {
        try
        {
            _page = _pagination.CurrentPageIndex + 1;
            _notifications = await Notifications.GetHistoryPageAsync(
                _currentUserId, (_page - 1) * PageSize, PageSize);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load notifications for user {UserId}.", _currentUserId);
            _failed = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only the slice is re-read: paging cannot change either count.
        if (!firstRender && _pagination.CurrentPageIndex + 1 != _page)
        {
            await LoadPageAsync();
            StateHasChanged();
        }
    }

    private async Task OpenAsync(Notification notification)
    {
        if (!notification.IsRead)
        {
            try
            {
                await Notifications.MarkAsReadAsync(_currentUserId, notification.Id);

                // Rows come back untracked, so this only updates the screen; the bell's
                // badge refreshes through the dispatcher.
                notification.IsRead = true;
                _unreadCount = Math.Max(0, _unreadCount - 1);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not mark notification {NotificationId} read.", notification.Id);
            }
        }

        if (!string.IsNullOrWhiteSpace(notification.ActionUrl))
            Nav.NavigateTo(notification.ActionUrl);
    }

    private async Task MarkAllAsReadAsync()
    {
        try
        {
            await Notifications.MarkAllAsReadAsync(_currentUserId);

            foreach (var notification in _notifications)
                notification.IsRead = true;

            _unreadCount = 0;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not mark all notifications read for user {UserId}.", _currentUserId);
        }
    }
}
