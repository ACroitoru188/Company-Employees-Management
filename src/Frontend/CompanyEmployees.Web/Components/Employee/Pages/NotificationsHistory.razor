@page "/employee/notifications"
@layout EmployeeLayout
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Domain.Entities
@using CompanyEmployees.Web.Security
@inject NotificationContext Notifications
@inject NavigationManager Nav
@inject ILogger<NotificationsHistory> Logger

<PageTitle>Notifications · Time Off Management</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5" Style="font-weight:600;">Notifications</MudText>
    @if (_unreadCount > 0)
    {
        <MudButton Variant="Variant.Text" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.DoneAll"
                   OnClick="MarkAllAsReadAsync">Mark all as read</MudButton>
    }
</div>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_failed)
{
    <MudAlert Severity="Severity.Error">
        Your notifications could not be loaded. Please refresh the page.
    </MudAlert>
}
else if (_total == 0)
{
    <MudPaper Class="pa-8 d-flex flex-column align-center gap-2" Elevation="0" Outlined="true">
        <MudIcon Icon="@Icons.Material.Outlined.NotificationsNone" Size="Size.Large"
                 Style="color:var(--mud-palette-text-disabled);" />
        <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">
            You have no notifications yet.
        </MudText>
    </MudPaper>
}
else
{
    <MudPaper Elevation="1">
        <MudList T="Notification">
            @foreach (var notification in _notifications)
            {
                <MudListItem T="Notification" OnClick="@(() => OpenAsync(notification))">
                    <NotificationRow Notification="@notification" ShowNavigationHint="true" />
                </MudListItem>
                <MudDivider />
            }
        </MudList>
    </MudPaper>

    @if (PageCount > 1)
    {
        <div class="d-flex justify-center mt-4">
            <MudPagination Count="@PageCount" Selected="@_page"
                           SelectedChanged="OnPageChangedAsync"
                           Color="Color.Primary" ShowFirstButton="true" ShowLastButton="true" />
        </div>
    }
}

@code {
    private const int PageSize = 15;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Guid _currentUserId;
    private List<Notification> _notifications = new();
    private int _total;
    private int _unreadCount;
    private int _page = 1;
    private bool _loading = true;
    private bool _failed;

    private int PageCount => (_total + PageSize - 1) / PageSize;

    protected override async Task OnInitializedAsync()
    {
        if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
            return;

        var user = (await AuthStateTask!).User;
        if (!Guid.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _currentUserId))
        {
            _failed = true;
            _loading = false;
            return;
        }

        await LoadCountsAsync();
        await LoadPageAsync();
        _loading = false;
    }

    // Sequential awaits throughout: they share this page's scoped DbContext, and two
    // queries in flight on the same context throw.
    private async Task LoadCountsAsync()
    {
        try
        {
            _total = await Notifications.GetHistoryCountAsync(_currentUserId);
            _unreadCount = await Notifications.GetUnreadCountAsync(_currentUserId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not count notifications for user {UserId}.", _currentUserId);
            _failed = true;
        }
    }

    private async Task LoadPageAsync()
    {
        try
        {
            _notifications = await Notifications.GetHistoryPageAsync(
                _currentUserId, (_page - 1) * PageSize, PageSize);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load notifications for user {UserId}.", _currentUserId);
            _failed = true;
        }
    }

    // Only the slice is re-read: paging cannot change either count.
    private Task OnPageChangedAsync(int page)
    {
        _page = page;
        return LoadPageAsync();
    }

    private async Task OpenAsync(Notification notification)
    {
        if (!notification.IsRead)
        {
            try
            {
                await Notifications.MarkAsReadAsync(_currentUserId, notification.Id);

                // Rows come back untracked, so this only updates the screen; the bell's
                // badge refreshes through the dispatcher.
                notification.IsRead = true;
                _unreadCount = Math.Max(0, _unreadCount - 1);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not mark notification {NotificationId} read.", notification.Id);
            }
        }

        if (!string.IsNullOrWhiteSpace(notification.ActionUrl))
            Nav.NavigateTo(notification.ActionUrl);
    }

    private async Task MarkAllAsReadAsync()
    {
        try
        {
            await Notifications.MarkAllAsReadAsync(_currentUserId);

            foreach (var notification in _notifications)
                notification.IsRead = true;

            _unreadCount = 0;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not mark all notifications read for user {UserId}.", _currentUserId);
        }
    }
}
