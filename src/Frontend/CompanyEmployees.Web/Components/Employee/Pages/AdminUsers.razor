@page "/admin/users"
@layout EmployeeLayout
@using System.Security.Claims
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Domain.Entities
@using CompanyEmployees.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@using CompanyEmployees.Web.Services
@inject EmployeeContext Employees
@inject EmployeeAccountService Accounts
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Users · Admin</PageTitle>

@if (!_authorized)
{
	<MudProgressCircular Indeterminate="true" />
}
else
{
	<MudText Typo="Typo.h5" Style="font-weight:600;" Class="mb-4">Users</MudText>

	<MudPaper Class="pa-4 mb-6" Elevation="0" Outlined="true">
		<MudText Typo="Typo.subtitle1" Style="font-weight:600;" Class="mb-1">
			Create employee account
		</MudText>
		<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
			Enter the employee's name, real email address, and department. Their Siemens login and employee ID are generated automatically.
		</MudText>

		<div class="d-flex align-end gap-3 flex-wrap">
			<MudTextField T="string" @bind-Value="_newEmployeeName"
						  Label="Full name" Variant="Variant.Outlined"
						  Style="min-width:260px;" Disabled="@_creating" />
			<MudTextField T="string" @bind-Value="_newEmployeeInvitationEmail"
						  Label="Real email address" Variant="Variant.Outlined"
						  InputType="InputType.Email" Style="min-width:300px;"
						  Disabled="@_creating" />
			<MudSelect T="Guid?" @bind-Value="_newEmployeeDepartmentId"
					   Label="Department" Variant="Variant.Outlined"
					   Style="min-width:220px;" Disabled="@_creating">
				@foreach (var department in _departments.OrderBy(d => d.Name))
				{
					<MudSelectItem T="Guid?" Value="@((Guid?)department.Id)">
						@department.Name
					</MudSelectItem>
				}
			</MudSelect>
			<MudButton Variant="Variant.Filled" Color="Color.Primary"
					   StartIcon="@Icons.Material.Filled.PersonAdd"
					   OnClick="CreateEmployeeAsync" Disabled="@_creating">
				@(_creating ? "Creating..." : "Create account")
			</MudButton>
		</div>

		@if (_createdAccount != null)
		{
			<MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-4">
				<MudText Typo="Typo.subtitle2" Style="font-weight:600;">Account created</MudText>
				<MudText Typo="Typo.body2">Name: @_createdAccount.Name</MudText>
				<MudText Typo="Typo.body2">Department: @_createdAccount.Department</MudText>
				<MudText Typo="Typo.body2">Siemens login: @_createdAccount.Email</MudText>
				<MudText Typo="Typo.body2">Invitation email: @_createdAccount.InvitationEmail</MudText>
				<MudText Typo="Typo.body2">Employee ID: @_createdAccount.EmployeeId</MudText>
				@if (_createdAccount.EmailDelivered)
				{
					<MudText Typo="Typo.body2">A password setup email was sent to the employee.</MudText>
				}
				else
				{
					<MudText Typo="Typo.body2">SMTP is not configured. Use this development-only setup link:</MudText>
					<MudLink Href="@_createdAccount.DevelopmentSetupLink">Set password</MudLink>
				}
			</MudAlert>
		}
	</MudPaper>

	<MudDataGrid T="User" Items="@_users" QuickFilter="@_quickFilter"
				 Filterable="true" SortMode="SortMode.Multiple"
				 FilterMode="DataGridFilterMode.ColumnFilterRow"
				 Hover="true" Dense="true" Elevation="1">
		<ToolBarContent>
			<MudTextField @bind-Value="_quickSearch" Placeholder="Search users..."
						  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
						  IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense"
						  Immediate="true" />
			<MudSpacer />
		</ToolBarContent>
		<Columns>
			<PropertyColumn Property="@(u => u.Name)" Title="Name" />
			<PropertyColumn Property="@(u => u.Email)" Title="Email" />
			<PropertyColumn Property="@(u => u.Id)" Title="Employee ID" />
			<PropertyColumn Property="@(u => u.Role)" Title="Role" />
			<PropertyColumn Property="@(u => u.Status)" Title="Status" />
			<TemplateColumn T="User" Title="Department" Sortable="true"
							 SortBy="@(u => GetDepartmentName(u.DepartmentId))" Filterable="false">
				<CellTemplate>
					<MudAutocomplete T="Guid?" Value="context.Item.DepartmentId"
									 ValueChanged="@(v => OnUserDepartmentChangedAsync(context.Item, v))"
									 SearchFunc="@SearchDepartments"
									 ToStringFunc="@GetDepartmentName"
									 ResetValueOnEmptyText="true"
									 CoerceText="true" Dense="true" />
				</CellTemplate>
			</TemplateColumn>
		</Columns>
		<PagerContent>
			<MudDataGridPager T="User" />
		</PagerContent>
	</MudDataGrid>
}

@code {
	[CascadingParameter]
	private Task<AuthenticationState>? AuthStateTask { get; set; }

	private bool _authorized;
	private List<User> _users = [];
	private List<Department> _departments = [];
	private string _quickSearch = "";
	private string _newEmployeeName = "";
	private string _newEmployeeInvitationEmail = "";
	private Guid? _newEmployeeDepartmentId;
	private bool _creating;
	private EmployeeAccountResult? _createdAccount;

	private Func<User, bool> _quickFilter => u =>
	{
		if (string.IsNullOrWhiteSpace(_quickSearch)) return true;
		return u.Name.Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
			|| (u.Email ?? "").Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
			|| u.Role.ToString().Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
			|| GetDepartmentName(u.DepartmentId).Contains(_quickSearch, StringComparison.OrdinalIgnoreCase);
	};

	// The role comes from the auth cookie's claims (AppClaimsPrincipalFactory),
	// so non-admins are redirected without a database query.
	protected override async Task OnInitializedAsync()
	{
		if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
			return;

		var user = (await AuthStateTask!).User;
		var role = user.FindFirst(ClaimTypes.Role)?.Value;
		if (role != UserRole.Admin.ToString())
		{
			Nav.NavigateTo("/employee/dashboard");
			return;
		}

		_authorized = true;
		await LoadAsync();
	}

	private async Task LoadAsync()
	{
		_users = await Employees.GetAllUsersAsync();
		_departments = await Employees.GetDepartmentsAsync();
	}

	private async Task OnUserDepartmentChangedAsync(User user, Guid? departmentId)
	{
		await Employees.AssignUserToDepartmentAsync(user.Id, departmentId);
		Snackbar.Add($"{user.Name} moved.", Severity.Success);
		await LoadAsync();
	}

	private async Task CreateEmployeeAsync()
	{
		if (string.IsNullOrWhiteSpace(_newEmployeeName))
		{
			Snackbar.Add("Employee name is required.", Severity.Warning);
			return;
		}

		if (string.IsNullOrWhiteSpace(_newEmployeeInvitationEmail))
		{
			Snackbar.Add("Employee email is required.", Severity.Warning);
			return;
		}

		if (_newEmployeeDepartmentId == null)
		{
			Snackbar.Add("Select a department.", Severity.Warning);
			return;
		}

		_creating = true;
		_createdAccount = null;

		try
		{
			_createdAccount = await Accounts.CreateAsync(
				_newEmployeeName,
				_newEmployeeInvitationEmail,
				_newEmployeeDepartmentId.Value,
				Nav.BaseUri);

			_newEmployeeName = "";
			_newEmployeeInvitationEmail = "";
			_newEmployeeDepartmentId = null;
			await LoadAsync();
			Snackbar.Add(
				_createdAccount.EmailDelivered
					? "Employee account created and setup email sent."
					: "Employee account created; SMTP is not configured.",
				_createdAccount.EmailDelivered ? Severity.Success : Severity.Warning);
		}
		catch (Exception exception)
		{
			Snackbar.Add(exception.Message, Severity.Error);
		}
		finally
		{
			_creating = false;
		}
	}

	private string GetDepartmentName(Guid? id) =>
		id == null ? "None" : _departments.FirstOrDefault(d => d.Id == id)?.Name ?? "";

	private Task<IEnumerable<Guid?>> SearchDepartments(string value, CancellationToken token)
	{
		var allIds = _departments.Select(d => (Guid?)d.Id).Prepend(null);

		// Daca textul e gol, SAU e "None", SAU textul este fix numele departamentului deja selectat, afisam toata lista
		if (string.IsNullOrEmpty(value) || value.Equals("None", StringComparison.InvariantCultureIgnoreCase) || _departments.Any(d => d.Name.Equals(value, StringComparison.InvariantCultureIgnoreCase)))
		{
			return Task.FromResult(allIds);
		}

		var matches = _departments
			.Where(d => d.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase))
			.Select(d => (Guid?)d.Id);
		return Task.FromResult(matches);
	}
}
