@page "/admin/users"
@layout EmployeeLayout
@using System.Globalization
@using System.Security.Claims
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Domain.Entities
@using CompanyEmployees.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@using CompanyEmployees.Web.Services
@inject EmployeeContext Employees
@inject EmployeeAccountService Accounts
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Users · Admin</PageTitle>

@if (!_authorized)
{
	<MudProgressCircular Indeterminate="true" />
}
else
{
	<div class="d-flex justify-space-between align-center gap-3 flex-wrap mb-4">
		<MudText Typo="Typo.h5" Style="font-weight:600;">Users & Contracts</MudText>
		<MudSelect T="Guid?" Value="_regionFilterId"
				   ValueChanged="OnViewingRegionChanged"
				   Label="Preview region" Variant="Variant.Outlined"
				   Dense="true" Style="min-width:220px;">
			<MudSelectItem T="Guid?" Value="@((Guid?)null)">All regions</MudSelectItem>
			@foreach (var region in _regions.Where(region => region.IsActive).OrderBy(region => region.Name))
			{
				<MudSelectItem T="Guid?" Value="@((Guid?)region.Id)">@region.Name</MudSelectItem>
			}
		</MudSelect>
		<MudButton Href="/api/employees/export.csv"
				   Variant="Variant.Outlined" Color="Color.Primary"
				   StartIcon="@Icons.Material.Filled.Download">
			Download latest CSV
		</MudButton>
	</div>

	<MudPaper Class="pa-4 mb-6" Elevation="0" Outlined="true">
		<MudText Typo="Typo.subtitle1" Style="font-weight:600;" Class="mb-1">
			Create employee account
		</MudText>
		<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
			Create employees in your assigned region. Their Siemens login and employee ID are generated automatically.
		</MudText>
		@if (!CanManageSelectedRegion)
		{
			<MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
				This regional preview is read-only. Return to <strong>@GetRegionName(_adminRegionId)</strong> to create an account.
			</MudAlert>
		}

		<div class="d-flex align-end gap-3 flex-wrap">
			<MudTextField T="string" @bind-Value="_newEmployeeName"
						  Label="Full name" Variant="Variant.Outlined"
						  Style="min-width:260px;" Disabled="@(_creating || !CanManageSelectedRegion)" />
			<MudTextField T="string" @bind-Value="_newEmployeeInvitationEmail"
						  Label="Real email address" Variant="Variant.Outlined"
						  InputType="InputType.Email" Style="min-width:300px;"
						  Disabled="@(_creating || !CanManageSelectedRegion)" />
			<MudSelect T="Guid?" @bind-Value="_newEmployeeDepartmentId"
					   Label="Department" Variant="Variant.Outlined"
					   Style="min-width:220px;" Disabled="@(_creating || !CanManageSelectedRegion)">
				@foreach (var department in _departments.OrderBy(d => d.Name))
				{
					<MudSelectItem T="Guid?" Value="@((Guid?)department.Id)">
						@department.Name
					</MudSelectItem>
				}
			</MudSelect>
			<MudSelect T="Guid?" @bind-Value="_newEmployeeRegionId"
					   Label="Region" Variant="Variant.Outlined"
					   Style="min-width:200px;" Disabled="true">
				@foreach (var region in _regions.Where(region => region.IsActive).OrderBy(region => region.Name))
				{
					<MudSelectItem T="Guid?" Value="@((Guid?)region.Id)">@region.Name</MudSelectItem>
				}
			</MudSelect>
			<MudButton Variant="Variant.Filled" Color="Color.Primary"
					   StartIcon="@Icons.Material.Filled.PersonAdd"
					   Style="height:44px; align-self:center; transform:translateY(2px);"
					   OnClick="CreateEmployeeAsync" Disabled="@(_creating || !CanManageSelectedRegion)">
				@(_creating ? "Creating..." : "Create account")
			</MudButton>
		</div>

		@if (_createdAccount != null)
		{
			<MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-4">
				<MudText Typo="Typo.subtitle2" Style="font-weight:600;">Account created</MudText>
				<MudText Typo="Typo.body2">Name: @_createdAccount.Name</MudText>
				<MudText Typo="Typo.body2">Department: @_createdAccount.Department</MudText>
				<MudText Typo="Typo.body2">Region: @_createdAccount.Region</MudText>
				<MudText Typo="Typo.body2">Siemens login: @_createdAccount.Email</MudText>
				<MudText Typo="Typo.body2">Invitation email: @_createdAccount.InvitationEmail</MudText>
				@if (_createdAccount.EmailDelivered)
				{
					<MudText Typo="Typo.body2">A password setup email was sent to the employee.</MudText>
				}
				else
				{
					<MudText Typo="Typo.body2">SMTP is not configured. Use this development-only setup link:</MudText>
					<MudLink Href="@_createdAccount.DevelopmentSetupLink">Set password</MudLink>
				}
			</MudAlert>
		}
	</MudPaper>

	@if (_regionFilterId.HasValue)
	{
		@if (CanManageSelectedRegion)
		{
			<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
				Managing your assigned region, <strong>@GetRegionName(_adminRegionId)</strong>.
			</MudAlert>
		}
		else
		{
			<MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
				Previewing <strong>@GetRegionName(_regionFilterId.Value)</strong> in read-only mode.
				Only an administrator assigned to that region can make changes.
			</MudAlert>
		}
	}
	else
	{
		<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
			Previewing all regions. Employees outside <strong>@GetRegionName(_adminRegionId)</strong> are read-only.
		</MudAlert>
	}

	<MudDataGrid T="User" Items="@FilteredUsers" QuickFilter="@_quickFilter"
				 Filterable="true" SortMode="SortMode.Multiple"
				 FilterMode="DataGridFilterMode.ColumnFilterRow"
				 Hover="true" Dense="true" Elevation="1">
		<ToolBarContent>
			<MudTextField @bind-Value="_quickSearch" Placeholder="Search users or contracts..."
						  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
						  IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense"
						  Immediate="true" />
			<MudSpacer />
		</ToolBarContent>
		<Columns>
			<PropertyColumn Property="@(u => u.Name)" Title="Name" />
			<PropertyColumn Property="@(u => u.Email)" Title="Email" />
			<PropertyColumn Property="@(u => u.Role)" Title="Role" />
			<TemplateColumn T="User" Title="Contract Type" Sortable="true"
							SortBy="@(u => GetActiveContract(u)?.Type.ToString() ?? "None")" Filterable="false">
				<CellTemplate>
					@{
						var contract = GetActiveContract(context.Item);
					}
					@if (contract == null)
					{
						<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">No Contract</MudChip>
					}
					else if (contract.Type == ContractType.Determinate)
					{
						<MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">Determinate</MudChip>
					}
					else
					{
						<MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">Indeterminate</MudChip>
					}
				</CellTemplate>
			</TemplateColumn>
			<TemplateColumn T="User" Title="Contract Period & Status" Sortable="true"
							SortBy="@(u => GetActiveContract(u)?.Status.ToString() ?? "")" Filterable="false">
				<CellTemplate>
					@{
						var contract = GetActiveContract(context.Item);
					}
					@if (contract != null)
					{
						<div class="d-flex flex-column">
							<div class="d-flex align-center gap-1">
								<MudChip T="string" Size="Size.Small" Color="@GetStatusColor(contract.Status)" Variant="Variant.Text" Class="pa-0 ma-0">
									@contract.Status
								</MudChip>
								<MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
									@contract.StartDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) – @(contract.EndDate?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "Indefinite")
								</MudText>
							</div>
						</div>
					}
					else
					{
						<MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">—</MudText>
					}
				</CellTemplate>
			</TemplateColumn>
			<TemplateColumn T="User" Title="Department" Sortable="true"
							 SortBy="@(u => GetDepartmentName(u.DepartmentId))" Filterable="false">
				<CellTemplate>
					<MudAutocomplete T="Guid?" Value="context.Item.DepartmentId"
									 ValueChanged="@(v => OnUserDepartmentChangedAsync(context.Item, v))"
									 SearchFunc="@SearchDepartments"
									 ToStringFunc="@GetDepartmentName"
									 ResetValueOnEmptyText="true"
									 CoerceText="true" Dense="true" Disabled="@(!CanEditUser(context.Item))" />
				</CellTemplate>
			</TemplateColumn>
			<TemplateColumn T="User" Title="Region" Sortable="true"
							 SortBy="@(u => GetRegionName(u.RegionId))" Filterable="false">
				<CellTemplate>
					<MudSelect T="Guid" Value="context.Item.RegionId"
							   ValueChanged="@(value => OnUserRegionChangedAsync(context.Item, value))"
							   Dense="true" Variant="Variant.Text" Disabled="@(!CanEditUser(context.Item))">
						@foreach (var region in _regions.Where(region => region.IsActive).OrderBy(region => region.Name))
						{
							<MudSelectItem T="Guid" Value="@region.Id">@region.Name</MudSelectItem>
						}
					</MudSelect>
				</CellTemplate>
			</TemplateColumn>
			<TemplateColumn T="User" Title="Actions" Filterable="false" Sortable="false">
				<CellTemplate>
					<MudTooltip Text="Manage Contract">
						<MudIconButton Icon="@Icons.Material.Filled.Assignment" Size="Size.Small" Color="Color.Primary"
									   OnClick="@(() => OpenEditContractDialog(context.Item))"
									   Disabled="@(!CanEditUser(context.Item))" />
					</MudTooltip>
				</CellTemplate>
			</TemplateColumn>
		</Columns>
		<PagerContent>
			<MudDataGridPager T="User" />
		</PagerContent>
	</MudDataGrid>
}

@code {
	[CascadingParameter]
	private Task<AuthenticationState>? AuthStateTask { get; set; }

	[SupplyParameterFromQuery(Name = "search")]
	public string? InitialSearch { get; set; }

	private bool _authorized;
	private List<User> _users = new();
	private List<Department> _departments = new();
	private List<Region> _regions = new();
	private string _quickSearch = "";
	private string _newEmployeeName = "";
	private string _newEmployeeInvitationEmail = "";
	private Guid? _newEmployeeDepartmentId;
	private Guid? _newEmployeeRegionId;
	private Guid? _regionFilterId;
	private Guid _adminId;
	private Guid _adminRegionId;
	private bool _creating;
	private EmployeeAccountResult? _createdAccount;

	private Func<User, bool> _quickFilter => u =>
	{
		if (string.IsNullOrWhiteSpace(_quickSearch)) return true;
		var contract = GetActiveContract(u);
		return u.Name.Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
			|| (u.Email ?? "").Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
			|| u.Role.ToString().Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
			|| GetDepartmentName(u.DepartmentId).Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
			|| GetRegionName(u.RegionId).Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
			|| (contract != null && contract.Type.ToString().Contains(_quickSearch, StringComparison.OrdinalIgnoreCase))
			|| (contract != null && contract.Status.ToString().Contains(_quickSearch, StringComparison.OrdinalIgnoreCase));
	};

	private IEnumerable<User> FilteredUsers => _regionFilterId.HasValue
		? _users.Where(user => user.RegionId == _regionFilterId.Value)
		: _users;

	private bool CanManageSelectedRegion => _regionFilterId == _adminRegionId;
	private bool CanEditUser(User user) => user.RegionId == _adminRegionId;

	protected override async Task OnInitializedAsync()
	{
		if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
			return;

		var user = (await AuthStateTask!).User;
		var role = user.FindFirst(ClaimTypes.Role)?.Value;
		if (role != UserRole.Admin.ToString())
		{
			Nav.NavigateTo("/employee/dashboard");
			return;
		}

		if (!string.IsNullOrWhiteSpace(InitialSearch))
		{
			_quickSearch = InitialSearch;
		}

		_authorized = true;
		await LoadAsync();

		var currentAdmin = await Employees.GetEmployeeByEmailAsync(user.Identity!.Name!);
		_adminId = currentAdmin.Id;
		_adminRegionId = currentAdmin.RegionId;
		_regionFilterId = currentAdmin.RegionId;
		_newEmployeeRegionId = currentAdmin.RegionId;
	}

	private async Task LoadAsync()
	{
		_users = await Employees.GetAllUsersAsync();
		_departments = await Employees.GetDepartmentsAsync();
		_regions = await Employees.GetRegionsAsync();
	}

	private Contract? GetActiveContract(User user)
	{
		return user.Contracts?
			.OrderByDescending(c => c.CreatedAt)
			.FirstOrDefault();
	}

	private Color GetStatusColor(ContractStatus status) => status switch
	{
		ContractStatus.Active => Color.Success,
		ContractStatus.Terminated => Color.Error,
		ContractStatus.Expired => Color.Dark,
		_ => Color.Default
	};

	private async Task OpenEditContractDialog(User user)
	{
		if (!CanEditUser(user))
		{
			Snackbar.Add("Other regions are read-only.", Severity.Warning);
			return;
		}

		var contract = GetActiveContract(user);
		var parameters = new DialogParameters<EditContractDialog>
		{
			{ x => x.UserName, user.Name },
			{ x => x.ExistingContract, contract }
		};

		var dialog = await DialogService.ShowAsync<EditContractDialog>("Manage Contract", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
		var result = await dialog.Result;

		if (result != null && !result.Canceled && result.Data is EditContractDialog.ContractEditResult res)
		{
			await Employees.SaveUserContractAsync(_adminId, user.Id, res.Type, res.Status, res.StartDate, res.EndDate, res.Notes);
			Snackbar.Add($"Contract updated for {user.Name}.", Severity.Success);
			await LoadAsync();
		}
	}

	private async Task OnUserDepartmentChangedAsync(User user, Guid? departmentId)
	{
		if (!CanEditUser(user))
			return;

		await Employees.AssignUserToDepartmentAsync(_adminId, user.Id, departmentId);
		Snackbar.Add($"{user.Name} moved.", Severity.Success);
		await LoadAsync();
	}

	private async Task OnUserRegionChangedAsync(User user, Guid regionId)
	{
		if (!CanEditUser(user))
			return;

		if (user.RegionId == regionId)
			return;

		var sourceRegion = GetRegionName(user.RegionId);
		var destinationRegion = GetRegionName(regionId);
		var confirmed = await DialogService.ShowMessageBoxAsync(
			"Confirm region transfer",
			$"Are you sure you want to move {user.Name} from {sourceRegion} to {destinationRegion}? " +
			"They will no longer appear in the source region's employee lists, and cross-region manager links will be removed.",
			yesText: "Yes, transfer",
			cancelText: "Cancel");

		if (confirmed != true)
		{
			StateHasChanged();
			return;
		}

		try
		{
			await Employees.AssignUserToRegionAsync(_adminId, user.Id, regionId);
			Snackbar.Add($"{user.Name} moved from {sourceRegion} to {destinationRegion}.", Severity.Success);
			await LoadAsync();
		}
		catch (Exception exception)
		{
			Snackbar.Add(exception.Message, Severity.Error);
		}
	}

	private Task OnViewingRegionChanged(Guid? regionId)
	{
		_regionFilterId = regionId;
		return Task.CompletedTask;
	}

	private async Task CreateEmployeeAsync()
	{
		if (string.IsNullOrWhiteSpace(_newEmployeeName))
		{
			Snackbar.Add("Employee name is required.", Severity.Warning);
			return;
		}

		if (string.IsNullOrWhiteSpace(_newEmployeeInvitationEmail))
		{
			Snackbar.Add("Employee email is required.", Severity.Warning);
			return;
		}

		if (_newEmployeeDepartmentId == null)
		{
			Snackbar.Add("Select a department.", Severity.Warning);
			return;
		}

		if (_newEmployeeRegionId == null)
		{
			Snackbar.Add("Select a region.", Severity.Warning);
			return;
		}

		_creating = true;
		_createdAccount = null;

		try
		{
			_createdAccount = await Accounts.CreateAsync(
				_adminId,
				_newEmployeeName,
				_newEmployeeInvitationEmail,
				_newEmployeeDepartmentId.Value,
				_newEmployeeRegionId.Value,
				Nav.BaseUri);

			_newEmployeeName = "";
			_newEmployeeInvitationEmail = "";
			_newEmployeeDepartmentId = null;
			_newEmployeeRegionId = _adminRegionId;
			await LoadAsync();
			Snackbar.Add(
				_createdAccount.EmailDelivered
					? "Employee account created and setup email sent."
					: "Employee account created; SMTP is not configured.",
				_createdAccount.EmailDelivered ? Severity.Success : Severity.Warning);
		}
		catch (Exception exception)
		{
			Snackbar.Add(exception.Message, Severity.Error);
		}
		finally
		{
			_creating = false;
		}
	}

	private string GetDepartmentName(Guid? id) =>
		id == null ? "None" : _departments.FirstOrDefault(d => d.Id == id)?.Name ?? "";

	private string GetRegionName(Guid id) =>
		_regions.FirstOrDefault(region => region.Id == id)?.Name ?? "Unknown";

	private Task<IEnumerable<Guid?>> SearchDepartments(string value, CancellationToken token)
	{
		var allIds = _departments.Select(d => (Guid?)d.Id).Prepend(null);

		if (string.IsNullOrEmpty(value) || value.Equals("None", StringComparison.InvariantCultureIgnoreCase) || _departments.Any(d => d.Name.Equals(value, StringComparison.InvariantCultureIgnoreCase)))
		{
			return Task.FromResult(allIds);
		}

		var matches = _departments
			.Where(d => d.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase))
			.Select(d => (Guid?)d.Id);
		return Task.FromResult(matches);
	}
}
