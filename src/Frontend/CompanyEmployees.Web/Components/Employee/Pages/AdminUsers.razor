@page "/admin/users"
@layout EmployeeLayout
@using System.Globalization
@using System.Security.Claims
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Domain.Entities
@using CompanyEmployees.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@using CompanyEmployees.Web.Services
@inject EmployeeContext Employees
@inject AppLocalizer Text
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject IToastService Toast
@inject IDialogService DialogService

<PageTitle>@Text["Users"] · @Text["Admin"]</PageTitle>

@if (!_authorized)
{
	<FluentProgressRing />
}
else
{
	<div class="page-shell">
	<FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
				 HorizontalGap="12" Wrap="true" Width="100%">
		<FluentLabel Typo="Typography.PaneHeader" Weight="FontWeight.Bold">@Text["Users & Contracts"]</FluentLabel>
		<FluentSpacer />
		<FluentSelect TOption="RegionOption" Label="@Text["Preview region"]"
					  Items="@_regionFilterOptions"
					  OptionValue="@(option => option.Id.ToString())"
					  OptionText="@(option => option.Name)"
					  SelectedOption="@FilterOptionFor(_regionFilterId)"
					  SelectedOptionChanged="OnViewingRegionChanged"
					  Style="min-width:220px;" />
		<FluentAnchor Href="/api/employees/export.csv" Appearance="Appearance.Outline"
					  IconStart="@(new Icons.Regular.Size20.ArrowDownload())">
			@Text["Download latest CSV"]
		</FluentAnchor>
		@* IconStart is slotted content, so it never receives the color FAST computes for the
		   button's own label — --accent-fill-rest and --accent-foreground-rest are the same
		   #0F6CBD in light mode, so the icon was the same blue as the button under it and
		   vanished. --app-icon-on-accent-fill is white there and a no-op on dark, where the
		   icon's default already reads fine against the fill. *@
		<FluentAnchor Href="/admin/users/create" Appearance="Appearance.Accent"
					  IconStart="@(new Icons.Regular.Size20.PersonAdd().WithColor("var(--app-icon-on-accent-fill)"))">
			@Text["Create employee account"]
		</FluentAnchor>
	</FluentStack>

	@if (_regionFilterId.HasValue)
	{
		@if (CanManageSelectedRegion)
		{
			<FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">
				@Text.Format("Managing your assigned region, {0}.", GetRegionName(_adminRegionId))
			</FluentMessageBar>
		}
		else
		{
			<FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
				@Text.Format("Previewing {0} in read-only mode.", GetRegionName(_regionFilterId.Value))
				@Text["Only an administrator assigned to that region can make changes."]
			</FluentMessageBar>
		}
	}
	else
	{
		<FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">
			@Text.Format("Previewing all regions. Employees outside {0} are read-only.", GetRegionName(_adminRegionId))
		</FluentMessageBar>
	}

	@* Immediate with a delay, not the bare default: without it every keystroke round-trips the
	   circuit and re-renders the whole grid below (all 15 rows' comboboxes and selects), which is
	   what read as the table reloading and its columns re-measuring themselves mid-type. Debouncing
	   to one render per pause fixes both — the same pattern GlobalSearchBox already uses. *@
	<FluentSearch @bind-Value="_quickSearch" @bind-Value:after="ResetPageAndRefresh"
				  Immediate="true" ImmediateDelay="300"
				  Placeholder="@Text["Search by name..."]" Style="width:320px; margin:16px 0 8px;" />

	@* Grid and paginator share one surface, the same way /admin/departments frames its table:
	   the two admin pages sit next to each other in the nav and a table floating on the page
	   background beside one in a card reads as an oversight. *@
	<FluentCard Class="grid-card" Style="padding:16px;">
	@* Explicit column widths: the department and region cells hold real editors, and left to
	   auto-sizing they push past their column and overlap the next one.

	   The tracks below are sized from what each column actually has to show, measured rather than
	   guessed: Region needs ~50px of label and holds one word, Email is too long to fit at any
	   width so it stops taking room from its neighbours, and Department needs ~120px for its
	   combobox and its own two-line title. *@
	@* ResizableColumns off: dragging a divider on this grid could shrink a column (the Actions
	   column especially, at 0.6fr the narrowest of all) until its content overlapped or fell off
	   the edge, and there is no reset short of a full reload. The widths below are already sized
	   from what each column has to show — see the comment above — so nothing needs to be
	   user-adjustable. *@
	<FluentDataGrid Items="@FilteredUsers" TGridItem="User" ResizableColumns="false"
					ShowHover="true" Pagination="@_pagination"
					GridTemplateColumns="1.2fr 1.5fr 0.8fr 0.8fr 1.6fr 1.4fr 1fr 0.6fr">
		<EmptyContent>
		    <EmptyState Icon="@(new Icons.Regular.Size24.Search())"
		                Title="@Text["No employee matches this search."]"
		                Boxed="false" />
		</EmptyContent>
	<ChildContent>
		<PropertyColumn Title="@Text["Name"]" Property="@(u => u.Name)" Sortable="true"
						Filtered="@(!string.IsNullOrWhiteSpace(_fName))">
			<ColumnOptions>
				<FluentSearch @bind-Value="_fName" @bind-Value:after="ResetPageAndRefresh"
							  Immediate="true" ImmediateDelay="300"
							  Placeholder="@Text["Filter by name"]" AutoFocus="true" />
			</ColumnOptions>
		</PropertyColumn>

		<PropertyColumn Title="@Text["Email"]" Property="@(u => u.Email)" Sortable="true"
						Filtered="@(!string.IsNullOrWhiteSpace(_fEmail))">
			<ColumnOptions>
				<FluentSearch @bind-Value="_fEmail" @bind-Value:after="ResetPageAndRefresh"
							  Immediate="true" ImmediateDelay="300"
							  Placeholder="@Text["Filter by email"]" AutoFocus="true" />
			</ColumnOptions>
		</PropertyColumn>

		<PropertyColumn Title="@Text["Role"]" Property="@(u => u.Role)" Sortable="true"
						Filtered="@(!string.IsNullOrWhiteSpace(_fRole))">
			<ColumnOptions>
				<FluentSearch @bind-Value="_fRole" @bind-Value:after="ResetPageAndRefresh"
							  Immediate="true" ImmediateDelay="300"
							  Placeholder="@Text["Filter by role"]" AutoFocus="true" />
			</ColumnOptions>
		</PropertyColumn>

		@* "Type" rather than "Contract Type": the column sits directly beside "Contract Period &
		   Status", so the word Contract is already established, and the long version could not fit
		   its track without stealing width from a column that needs it more. *@
		<TemplateColumn Title="@Text["Type"]" Sortable="true" SortBy="@_byContractType"
						Filtered="@(!string.IsNullOrWhiteSpace(_fContract))">
			<ColumnOptions>
				<FluentSearch @bind-Value="_fContract" @bind-Value:after="ResetPageAndRefresh"
							  Immediate="true" ImmediateDelay="300"
							  Placeholder="@Text["Filter by type or status"]" AutoFocus="true" />
			</ColumnOptions>
			<ChildContent>
			@{
				var typeContract = GetActiveContract(context);
			}
			@if (typeContract == null)
			{
				<FluentBadge Appearance="Appearance.Neutral">@Text["No Contract"]</FluentBadge>
			}
			else if (typeContract.Type == ContractType.Determinate)
			{
				<FluentBadge Appearance="Appearance.Lightweight">@Text["Determinate"]</FluentBadge>
			}
			else
			{
				<FluentBadge Appearance="Appearance.Neutral">@Text["Indeterminate"]</FluentBadge>
			}
			</ChildContent>
		</TemplateColumn>

		<TemplateColumn Title="@Text["Contract Period & Status"]" Sortable="true" SortBy="@_byContractStatus">
			@{
				var periodContract = GetActiveContract(context);
			}
			@if (periodContract != null)
			{
				<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6"
							 VerticalAlignment="VerticalAlignment.Center">
					<FluentBadge Fill="highlight" BackgroundColor="@StatusColor(periodContract.Status)" Color="white">
						@Text[periodContract.Status.ToString()]
					</FluentBadge>
					<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-caption">
						@periodContract.StartDate.ToString("MMM d, yyyy", CultureInfo.CurrentCulture) –
						@(periodContract.EndDate?.ToString("MMM d, yyyy", CultureInfo.CurrentCulture) ?? Text["Indefinite"])
					</FluentLabel>
				</FluentStack>
			}
			else
			{
				<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">—</FluentLabel>
			}
		</TemplateColumn>

		<TemplateColumn Title="@Text["Department"]" Sortable="true" SortBy="@_byDepartment"
						Filtered="@(!string.IsNullOrWhiteSpace(_fDepartment))">
			<ColumnOptions>
				<FluentSearch @bind-Value="_fDepartment" @bind-Value:after="ResetPageAndRefresh"
							  Immediate="true" ImmediateDelay="300"
							  Placeholder="@Text["Filter by department"]" AutoFocus="true" />
			</ColumnOptions>
			<ChildContent>
			<FluentCombobox TOption="DepartmentOption"
							Items="@_departmentOptions"
							OptionValue="@(option => option.Id.ToString())"
							OptionText="@(option => option.Name)"
							Autocomplete="ComboboxAutocomplete.Both"
							SelectedOption="@DepartmentOptionFor(context.DepartmentId)"
							SelectedOptionChanged="@(option => OnUserDepartmentChangedAsync(context, option))"
							Disabled="@(!CanEditUser(context))" />
			</ChildContent>
		</TemplateColumn>

		<TemplateColumn Title="@Text["Region"]" Sortable="true" SortBy="@_byRegion"
						Filtered="@(!string.IsNullOrWhiteSpace(_fRegion))">
			<ColumnOptions>
				<FluentSearch @bind-Value="_fRegion" @bind-Value:after="ResetPageAndRefresh"
							  Immediate="true" ImmediateDelay="300"
							  Placeholder="@Text["Filter by region"]" AutoFocus="true" />
			</ColumnOptions>
			<ChildContent>
			<FluentSelect TOption="Region"
						  Items="@ActiveRegions"
						  OptionValue="@(r => r.Id.ToString())"
						  OptionText="@(r => r.Name)"
						  SelectedOption="@_regions.FirstOrDefault(r => r.Id == context.RegionId)"
						  SelectedOptionChanged="@(region => OnUserRegionChangedAsync(context, region))"
						  Disabled="@(!CanEditUser(context))" />
			</ChildContent>
		</TemplateColumn>

		<TemplateColumn Title="@Text["Actions"]" Sortable="false" Align="Align.End">
			<form id="@PreviewFormId(context.Id)" method="post" action="/api/auth/preview/start" style="display:none;">
				<input type="hidden" name="userId" value="@context.Id" />
			</form>
			<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4"
						 VerticalAlignment="VerticalAlignment.Center">
				<FluentButton Appearance="Appearance.Stealth" Title="Preview this account (read-only)"
							  IconStart="@(new Icons.Regular.Size20.Eye())"
							  OnClick="@(() => StartPreviewAsync(context.Id))"
							  Disabled="@(context.Id == _adminId)" />
				<FluentButton Appearance="Appearance.Stealth" Title="@Text["Manage Contract"]"
							  IconStart="@(new Icons.Regular.Size20.ClipboardTextEdit())"
							  OnClick="@(() => OpenEditContractDialog(context))"
							  Disabled="@(!CanEditUser(context))" />
			</FluentStack>
		</TemplateColumn>
		</ChildContent>
	</FluentDataGrid>

	<FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center" Width="100%">
		<FluentPaginator State="@_pagination" />
	</FluentStack>
	</FluentCard>
	</div>
}

@code {
	[CascadingParameter]
	private Task<AuthenticationState>? AuthStateTask { get; set; }

	[SupplyParameterFromQuery(Name = "search")]
	public string? InitialSearch { get; set; }

	private bool _authorized;
	private List<User> _users = new();
	private List<Department> _departments = new();
	private List<Region> _regions = new();
	private string _quickSearch = "";
	private Guid? _regionFilterId;
	private Guid _adminId;
	private Guid _adminRegionId;

	private readonly PaginationState _pagination = new() { ItemsPerPage = 15 };

	// Fluent's pickers select an object out of a list rather than resolving a value through a
	// search callback, so the "no department" / "all regions" entries need a real row of their
	// own; Guid.Empty stands in for null on the way in and out.
	public sealed record DepartmentOption(Guid Id, string Name);
	public sealed record RegionOption(Guid Id, string Name);

	// Built once the localizer is available rather than in a field initializer, which runs
	// before injection; a fresh instance per call would stop the pickers recognising their
	// own selected option.
	private DepartmentOption NoDepartment = new(Guid.Empty, "None");
	private RegionOption AllRegions = new(Guid.Empty, "All regions");

	// LoadAsync seeds these with the placeholder above before its first await; they must never be
	// empty while the pickers are on screen.
	private List<DepartmentOption> _departmentOptions = [];
	private List<RegionOption> _regionFilterOptions = [];

	private IEnumerable<Region> ActiveRegions =>
		_regions.Where(region => region.IsActive).OrderBy(region => region.Name);

	private readonly GridSort<User> _byContractType =
		GridSort<User>.ByAscending(u => u.Contracts!.OrderByDescending(c => c.CreatedAt).First().Type);
	private readonly GridSort<User> _byContractStatus =
		GridSort<User>.ByAscending(u => u.Contracts!.OrderByDescending(c => c.CreatedAt).First().Status);
	private GridSort<User> _byDepartment => GridSort<User>.ByAscending(u => GetDepartmentName(u.DepartmentId));
	private GridSort<User> _byRegion => GridSort<User>.ByAscending(u => GetRegionName(u.RegionId));

	// Per-column filters, opened from each column's options icon. They narrow independently
	// and stack with each other and with the toolbar search.
	private string _fName = "";
	private string _fEmail = "";
	private string _fRole = "";
	private string _fContract = "";
	private string _fDepartment = "";
	private string _fRegion = "";

	private static bool Has(string filter, string? value) =>
		string.IsNullOrWhiteSpace(filter)
		|| (value ?? "").Contains(filter, StringComparison.OrdinalIgnoreCase);

	private IQueryable<User> FilteredUsers =>
		(_regionFilterId.HasValue
			? _users.Where(user => user.RegionId == _regionFilterId.Value)
			: _users)
		.Where(MatchesQuickSearch)
		.Where(MatchesColumnFilters)
		.AsQueryable();

	private bool MatchesColumnFilters(User u)
	{
		var contract = GetActiveContract(u);
		var contractText = contract is null
			? Text["No Contract"]
			: $"{contract.Type} {contract.Status}";

		return Has(_fName, u.Name)
			&& Has(_fEmail, u.Email)
			&& Has(_fRole, u.Role.ToString())
			&& Has(_fContract, contractText)
			&& Has(_fDepartment, GetDepartmentName(u.DepartmentId))
			&& Has(_fRegion, GetRegionName(u.RegionId));
	}

	// Name only, on purpose: matching on email/role/department/region/contract too made this box
	// behave like a second, unpredictable column filter — searching "HR" surfaced every HR
	// department member as well as anyone actually named Hr. The per-column filters below the
	// header already cover those other fields individually.
	private bool MatchesQuickSearch(User u) =>
		string.IsNullOrWhiteSpace(_quickSearch)
		|| u.Name.Contains(_quickSearch, StringComparison.OrdinalIgnoreCase);

	private bool CanManageSelectedRegion => _regionFilterId == _adminRegionId;
	private bool CanEditUser(User user) => user.RegionId == _adminRegionId;

	protected override async Task OnInitializedAsync()
	{
		if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
			return;

		var user = (await AuthStateTask!).User;
		var role = user.FindFirst(ClaimTypes.Role)?.Value;
		if (role != UserRole.Admin.ToString() && role != UserRole.CountryManager.ToString())
		{
			Nav.NavigateTo("/employee/dashboard");
			return;
		}

		if (!string.IsNullOrWhiteSpace(InitialSearch))
		{
			_quickSearch = InitialSearch;
		}

		_authorized = true;
		await LoadAsync();

		var currentAdmin = await Employees.GetEmployeeByEmailAsync(user.Identity!.Name!);
		_adminId = currentAdmin.Id;
		_adminRegionId = currentAdmin.RegionId;
		_regionFilterId = currentAdmin.RegionId;
	}

	private async Task LoadAsync()
	{
		NoDepartment = new DepartmentOption(Guid.Empty, Text["None"]);
		AllRegions = new RegionOption(Guid.Empty, Text["All regions"]);

		// Seeded before the first await, not after: the page renders while these queries are in
		// flight, and a picker whose selected option is missing from its own Items resets itself
		// and raises SelectedOptionChanged — which re-renders this component, which hands it the
		// same missing option again. That is an infinite render loop, not a cosmetic glitch.
		_departmentOptions = [NoDepartment];
		_regionFilterOptions = [AllRegions];

		_users = await Employees.GetAllUsersAsync();
		_departments = await Employees.GetDepartmentsAsync();
		_regions = await Employees.GetRegionsAsync();

		_departmentOptions = _departments
			.OrderBy(department => department.Name)
			.Select(department => new DepartmentOption(department.Id, department.Name))
			.Prepend(NoDepartment)
			.ToList();

		_regionFilterOptions = ActiveRegions
			.Select(region => new RegionOption(region.Id, region.Name))
			.Prepend(AllRegions)
			.ToList();
	}

	private Contract? GetActiveContract(User user)
	{
		return user.Contracts?
			.OrderByDescending(c => c.CreatedAt)
			.FirstOrDefault();
	}

	private static string StatusColor(ContractStatus status) => status switch
	{
		ContractStatus.Active => "var(--success)",
		ContractStatus.Terminated => "var(--error)",
		ContractStatus.Expired => "var(--neutral-foreground-hint)",
		_ => "var(--neutral-foreground-hint)"
	};

	private async Task OpenEditContractDialog(User user)
	{
		if (!CanEditUser(user))
		{
			Toast.ShowWarning(Text["Other regions are read-only."]);
			return;
		}

		var content = new EditContractDialog.Model
		{
			UserName = user.Name,
			ExistingContract = GetActiveContract(user)
		};
		content.Initialise();

		var parameters = new DialogParameters
		{
			Title = Text["Manage Contract"],
			PrimaryAction = Text["Save"],
			SecondaryAction = "Cancel",
			Width = "520px",
			// Keeps the dialog open with its own message when the entry is not usable.
			ValidateDialogAsync = () => Task.FromResult(content.TryBuildResult() is not null)
		};

		var dialog = await DialogService.ShowDialogAsync<EditContractDialog, EditContractDialog.Model>(
			content, parameters);
		var result = await dialog.Result;

		if (!result.Cancelled && content.TryBuildResult() is { } res)
		{
			await Employees.SaveUserContractAsync(_adminId, user.Id, res.Type, res.Status, res.StartDate, res.EndDate, res.Notes);
			Toast.ShowSuccess(Text.Format("Contract updated for {0}.", user.Name));
			await LoadAsync();
		}
	}

	// Guards the database work below. The combobox can deliver several callbacks for one pick and
	// the circuit has a single scoped DbContext; EF Core refuses two operations on one context
	// ("a second operation was started on this context instance"), which used to go uncaught and
	// take the whole circuit down with it.
	private readonly SemaphoreSlim _departmentSaveLock = new(1, 1);

	private async Task OnUserDepartmentChangedAsync(User user, DepartmentOption? option)
	{
		// A single pick raises SelectedOptionChanged more than once (fluentui-blazor#2077): first
		// with a null option, then with the department chosen, and then once more on every render
		// for as long as the combobox's own selection disagrees with the SelectedOption parameter
		// it is handed back. Acting on the null would clear the department for as long as it takes
		// the real value to arrive — and permanently if that save then failed. Clearing on purpose
		// arrives as the "None" entry, a real option carrying Guid.Empty, so a null option only
		// ever means the phantom callback. OnUserRegionChangedAsync guards its region the same way.
		if (option is null)
			return;

		if (!CanEditUser(user))
			return;

		var departmentId = ToDepartmentId(option);

		// Written to the row before the first await, which is what ends the repeats: until the row
		// agrees with the combobox, every render hands the component a SelectedOption that
		// contradicts its own state and it raises the event again, so the save never got to
		// finish. Updating it here also keeps the cell showing the new department across the round
		// trip; LoadAsync replaces the row with the stored truth either way.
		if (user.DepartmentId == departmentId)
			return;

		user.DepartmentId = departmentId;

		await _departmentSaveLock.WaitAsync();
		try
		{
			await Employees.AssignUserToDepartmentAsync(_adminId, user.Id, departmentId);
			Toast.ShowSuccess(Text.Format("{0} moved.", user.Name));
		}
		catch (Exception exception)
		{
			// Left unhandled this reaches the renderer and terminates the circuit, blanking the
			// page instead of reporting the failure.
			Toast.ShowError(exception.Message);
		}
		finally
		{
			// Runs after a failure too, so the optimistic value above cannot outlive a save that
			// did not happen.
			await LoadAsync();
			_departmentSaveLock.Release();
		}
	}

	private async Task OnUserRegionChangedAsync(User user, Region? region)
	{
		if (region is null || !CanEditUser(user))
			return;

		if (user.RegionId == region.Id)
			return;

		var sourceRegion = GetRegionName(user.RegionId);
		var destinationRegion = GetRegionName(region.Id);
		var confirmation = await DialogService.ShowConfirmationAsync(
			Text.Format(
				"Are you sure you want to move {0} from {1} to {2}? They will no longer appear in the source region's employee lists, and cross-region manager links will be removed.",
				user.Name, sourceRegion, destinationRegion),
			Text["Yes, transfer"],
			Text["Cancel"],
			Text["Confirm region transfer"]);

		var confirmed = await confirmation.Result;
		if (confirmed.Cancelled)
		{
			StateHasChanged();
			return;
		}

		try
		{
			await Employees.AssignUserToRegionAsync(_adminId, user.Id, region.Id);
			Toast.ShowSuccess(Text.Format("{0} moved from {1} to {2}.", user.Name, sourceRegion, destinationRegion));
			await LoadAsync();
		}
		catch (Exception exception)
		{
			Toast.ShowError(exception.Message);
		}
	}

	private async Task OnViewingRegionChanged(RegionOption? option)
	{
		_regionFilterId = option is null || option.Id == Guid.Empty ? null : option.Id;
		await ResetPageAndRefresh();
	}

	// Narrowing any filter can leave the grid sitting on a page number that no longer exists in
	// the smaller result set — FluentDataGrid does not notice on its own, so the row area just
	// renders empty past the last real page. Jumping back to page one on every filter change is
	// what made the search box read as broken when it was really the page index going stale.
	private async Task ResetPageAndRefresh()
	{
		await _pagination.SetCurrentPageIndexAsync(0);
		StateHasChanged();
	}

	private string GetDepartmentName(Guid? id) =>
		id == null ? Text["None"] : _departments.FirstOrDefault(d => d.Id == id)?.Name ?? "";

	private string GetRegionName(Guid id) =>
		_regions.FirstOrDefault(region => region.Id == id)?.Name ?? "Unknown";

	private DepartmentOption DepartmentOptionFor(Guid? id) =>
		id is null ? NoDepartment : _departmentOptions.FirstOrDefault(option => option.Id == id) ?? NoDepartment;

	private RegionOption FilterOptionFor(Guid? id) =>
		id is null ? AllRegions : _regionFilterOptions.FirstOrDefault(option => option.Id == id) ?? AllRegions;

	private static Guid? ToDepartmentId(DepartmentOption? option) =>
		option is null || option.Id == Guid.Empty ? null : option.Id;

	private static string PreviewFormId(Guid userId) => $"preview-{userId:D}";

	private Task StartPreviewAsync(Guid userId) =>
		JSRuntime.InvokeVoidAsync("eval",
			$"document.getElementById('{PreviewFormId(userId)}').submit();").AsTask();
}
