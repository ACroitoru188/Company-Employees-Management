@page "/admin/users"
@layout EmployeeLayout
@using System.Globalization
@using System.Security.Claims
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Domain.Entities
@using CompanyEmployees.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@using CompanyEmployees.Web.Services
@inject EmployeeContext Employees
@inject EmployeeAccountService Accounts
@inject NavigationManager Nav
@inject IToastService Toast
@inject IDialogService DialogService

<PageTitle>Users · Admin</PageTitle>

@if (!_authorized)
{
	<FluentProgressRing />
}
else
{
	<FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
				 HorizontalGap="12" Wrap="true" Width="100%">
		<FluentLabel Typo="Typography.PaneHeader" Weight="FontWeight.Bold">Users &amp; Contracts</FluentLabel>
		<FluentSpacer />
		<FluentSelect TOption="RegionOption" Label="Preview region"
					  Items="@_regionFilterOptions"
					  OptionValue="@(option => option.Id.ToString())"
					  OptionText="@(option => option.Name)"
					  SelectedOption="@FilterOptionFor(_regionFilterId)"
					  SelectedOptionChanged="OnViewingRegionChanged"
					  Style="min-width:220px;" />
		<FluentAnchor Href="/api/employees/export.csv" Appearance="Appearance.Outline"
					  IconStart="@(new Icons.Regular.Size20.ArrowDownload())">
			Download latest CSV
		</FluentAnchor>
	</FluentStack>

	<FluentCard Style="margin:16px 0 24px; padding:16px;">
		<FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
			<FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
				<FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">Create employee account</FluentLabel>
				<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
					Create employees in your assigned region. Their Siemens login and employee ID are generated automatically.
				</FluentLabel>
			</FluentStack>

			@if (!CanManageSelectedRegion)
			{
				<FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
					This regional preview is read-only. Return to <strong>@GetRegionName(_adminRegionId)</strong> to create an account.
				</FluentMessageBar>
			}

			<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true"
						 VerticalAlignment="VerticalAlignment.Bottom">
				<FluentTextField @bind-Value="_newEmployeeName" Label="Full name"
								 Style="min-width:260px;" Disabled="@(_creating || !CanManageSelectedRegion)" />
				<FluentTextField @bind-Value="_newEmployeeInvitationEmail" Label="Real email address"
								 TextFieldType="TextFieldType.Email" Style="min-width:300px;"
								 Disabled="@(_creating || !CanManageSelectedRegion)" />
				<FluentSelect TOption="Department" Label="Department"
							  Items="@_departments.OrderBy(d => d.Name)"
							  OptionValue="@(d => d.Id.ToString())"
							  OptionText="@(d => d.Name)"
							  SelectedOption="@_departments.FirstOrDefault(d => d.Id == _newEmployeeDepartmentId)"
							  SelectedOptionChanged="@(d => _newEmployeeDepartmentId = d?.Id)"
							  Style="min-width:220px;" Disabled="@(_creating || !CanManageSelectedRegion)" />
				@* Region is fixed to the administrator's own: creating outside it is refused by the
				   application layer anyway, so the field only reports which one it will be. *@
				<FluentSelect TOption="Region" Label="Region"
							  Items="@ActiveRegions"
							  OptionValue="@(r => r.Id.ToString())"
							  OptionText="@(r => r.Name)"
							  SelectedOption="@_regions.FirstOrDefault(r => r.Id == _newEmployeeRegionId)"
							  Style="min-width:200px;" Disabled="true" />
				<FluentButton Appearance="Appearance.Accent"
							  IconStart="@(new Icons.Regular.Size20.PersonAdd())"
							  OnClick="CreateEmployeeAsync" Disabled="@(_creating || !CanManageSelectedRegion)">
					@(_creating ? "Creating..." : "Create account")
				</FluentButton>
			</FluentStack>

			@if (_createdAccount != null)
			{
				<FluentMessageBar Intent="MessageIntent.Success" AllowDismiss="false">
					<FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
						<FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">Account created</FluentLabel>
						<FluentLabel Typo="Typography.Body">Name: @_createdAccount.Name</FluentLabel>
						<FluentLabel Typo="Typography.Body">Department: @_createdAccount.Department</FluentLabel>
						<FluentLabel Typo="Typography.Body">Region: @_createdAccount.Region</FluentLabel>
						<FluentLabel Typo="Typography.Body">Siemens login: @_createdAccount.Email</FluentLabel>
						<FluentLabel Typo="Typography.Body">Invitation email: @_createdAccount.InvitationEmail</FluentLabel>
						@if (_createdAccount.EmailDelivered)
						{
							<FluentLabel Typo="Typography.Body">A password setup email was sent to the employee.</FluentLabel>
						}
						else
						{
							<FluentLabel Typo="Typography.Body">SMTP is not configured. Use this development-only setup link:</FluentLabel>
							<FluentAnchor Href="@_createdAccount.DevelopmentSetupLink"
										  Appearance="Appearance.Hypertext">Set password</FluentAnchor>
						}
					</FluentStack>
				</FluentMessageBar>
			}
		</FluentStack>
	</FluentCard>

	@if (_regionFilterId.HasValue)
	{
		@if (CanManageSelectedRegion)
		{
			<FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">
				Managing your assigned region, <strong>@GetRegionName(_adminRegionId)</strong>.
			</FluentMessageBar>
		}
		else
		{
			<FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
				Previewing <strong>@GetRegionName(_regionFilterId.Value)</strong> in read-only mode.
				Only an administrator assigned to that region can make changes.
			</FluentMessageBar>
		}
	}
	else
	{
		<FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">
			Previewing all regions. Employees outside <strong>@GetRegionName(_adminRegionId)</strong> are read-only.
		</FluentMessageBar>
	}

	<FluentSearch @bind-Value="_quickSearch" @bind-Value:after="StateHasChanged"
				  Placeholder="Search users or contracts..." Style="width:320px; margin:16px 0 8px;" />

	@* Explicit column widths: the department and region cells hold real editors, and left to
	   auto-sizing they push past their column and overlap the next one. *@
	<FluentDataGrid Items="@FilteredUsers" TGridItem="User" ResizableColumns="true"
					ShowHover="true" Pagination="@_pagination"
					GridTemplateColumns="1.2fr 1.6fr 0.8fr 1fr 1.6fr 1.3fr 1.1fr 0.5fr">
		<PropertyColumn Title="Name" Property="@(u => u.Name)" Sortable="true"
						Filtered="@(!string.IsNullOrWhiteSpace(_fName))">
			<ColumnOptions>
				<FluentSearch @bind-Value="_fName" @bind-Value:after="StateHasChanged"
							  Placeholder="Filter by name" AutoFocus="true" />
			</ColumnOptions>
		</PropertyColumn>

		<PropertyColumn Title="Email" Property="@(u => u.Email)" Sortable="true"
						Filtered="@(!string.IsNullOrWhiteSpace(_fEmail))">
			<ColumnOptions>
				<FluentSearch @bind-Value="_fEmail" @bind-Value:after="StateHasChanged"
							  Placeholder="Filter by email" AutoFocus="true" />
			</ColumnOptions>
		</PropertyColumn>

		<PropertyColumn Title="Role" Property="@(u => u.Role)" Sortable="true"
						Filtered="@(!string.IsNullOrWhiteSpace(_fRole))">
			<ColumnOptions>
				<FluentSearch @bind-Value="_fRole" @bind-Value:after="StateHasChanged"
							  Placeholder="Filter by role" AutoFocus="true" />
			</ColumnOptions>
		</PropertyColumn>

		<TemplateColumn Title="Contract Type" Sortable="true" SortBy="@_byContractType"
						Filtered="@(!string.IsNullOrWhiteSpace(_fContract))">
			<ColumnOptions>
				<FluentSearch @bind-Value="_fContract" @bind-Value:after="StateHasChanged"
							  Placeholder="Filter by type or status" AutoFocus="true" />
			</ColumnOptions>
			<ChildContent>
			@{
				var typeContract = GetActiveContract(context);
			}
			@if (typeContract == null)
			{
				<FluentBadge Appearance="Appearance.Neutral">No Contract</FluentBadge>
			}
			else if (typeContract.Type == ContractType.Determinate)
			{
				<FluentBadge Appearance="Appearance.Lightweight">Determinate</FluentBadge>
			}
			else
			{
				<FluentBadge Appearance="Appearance.Accent">Indeterminate</FluentBadge>
			}
			</ChildContent>
		</TemplateColumn>

		<TemplateColumn Title="Contract Period &amp; Status" Sortable="true" SortBy="@_byContractStatus">
			@{
				var periodContract = GetActiveContract(context);
			}
			@if (periodContract != null)
			{
				<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6"
							 VerticalAlignment="VerticalAlignment.Center">
					<FluentBadge Fill="highlight" BackgroundColor="@StatusColor(periodContract.Status)" Color="white">
						@periodContract.Status
					</FluentBadge>
					<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-caption">
						@periodContract.StartDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) –
						@(periodContract.EndDate?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "Indefinite")
					</FluentLabel>
				</FluentStack>
			}
			else
			{
				<FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">—</FluentLabel>
			}
		</TemplateColumn>

		<TemplateColumn Title="Department" Sortable="true" SortBy="@_byDepartment"
						Filtered="@(!string.IsNullOrWhiteSpace(_fDepartment))">
			<ColumnOptions>
				<FluentSearch @bind-Value="_fDepartment" @bind-Value:after="StateHasChanged"
							  Placeholder="Filter by department" AutoFocus="true" />
			</ColumnOptions>
			<ChildContent>
			<FluentCombobox TOption="DepartmentOption"
							Items="@_departmentOptions"
							OptionValue="@(option => option.Id.ToString())"
							OptionText="@(option => option.Name)"
							Autocomplete="ComboboxAutocomplete.Both"
							SelectedOption="@DepartmentOptionFor(context.DepartmentId)"
							SelectedOptionChanged="@(option => OnUserDepartmentChangedAsync(context, ToDepartmentId(option)))"
							Disabled="@(!CanEditUser(context))" />
			</ChildContent>
		</TemplateColumn>

		<TemplateColumn Title="Region" Sortable="true" SortBy="@_byRegion"
						Filtered="@(!string.IsNullOrWhiteSpace(_fRegion))">
			<ColumnOptions>
				<FluentSearch @bind-Value="_fRegion" @bind-Value:after="StateHasChanged"
							  Placeholder="Filter by region" AutoFocus="true" />
			</ColumnOptions>
			<ChildContent>
			<FluentSelect TOption="Region"
						  Items="@ActiveRegions"
						  OptionValue="@(r => r.Id.ToString())"
						  OptionText="@(r => r.Name)"
						  SelectedOption="@_regions.FirstOrDefault(r => r.Id == context.RegionId)"
						  SelectedOptionChanged="@(region => OnUserRegionChangedAsync(context, region))"
						  Disabled="@(!CanEditUser(context))" />
			</ChildContent>
		</TemplateColumn>

		<TemplateColumn Title="Actions" Sortable="false" Align="Align.End">
			<FluentButton Appearance="Appearance.Stealth" Title="Manage Contract"
						  IconStart="@(new Icons.Regular.Size20.ClipboardTextEdit())"
						  OnClick="@(() => OpenEditContractDialog(context))"
						  Disabled="@(!CanEditUser(context))" />
		</TemplateColumn>
	</FluentDataGrid>

	<FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center" Width="100%">
		<FluentPaginator State="@_pagination" />
	</FluentStack>
}

@code {
	[CascadingParameter]
	private Task<AuthenticationState>? AuthStateTask { get; set; }

	[SupplyParameterFromQuery(Name = "search")]
	public string? InitialSearch { get; set; }

	private bool _authorized;
	private List<User> _users = new();
	private List<Department> _departments = new();
	private List<Region> _regions = new();
	private string _quickSearch = "";
	private string _newEmployeeName = "";
	private string _newEmployeeInvitationEmail = "";
	private Guid? _newEmployeeDepartmentId;
	private Guid? _newEmployeeRegionId;
	private Guid? _regionFilterId;
	private Guid _adminId;
	private Guid _adminRegionId;
	private bool _creating;
	private EmployeeAccountResult? _createdAccount;

	private readonly PaginationState _pagination = new() { ItemsPerPage = 15 };

	// Fluent's pickers select an object out of a list rather than resolving a value through a
	// search callback, so the "no department" / "all regions" entries need a real row of their
	// own; Guid.Empty stands in for null on the way in and out.
	public sealed record DepartmentOption(Guid Id, string Name);
	public sealed record RegionOption(Guid Id, string Name);

	private static readonly DepartmentOption NoDepartment = new(Guid.Empty, "None");
	private static readonly RegionOption AllRegions = new(Guid.Empty, "All regions");

	private List<DepartmentOption> _departmentOptions = [NoDepartment];
	private List<RegionOption> _regionFilterOptions = [AllRegions];

	private IEnumerable<Region> ActiveRegions =>
		_regions.Where(region => region.IsActive).OrderBy(region => region.Name);

	private readonly GridSort<User> _byContractType =
		GridSort<User>.ByAscending(u => u.Contracts!.OrderByDescending(c => c.CreatedAt).First().Type);
	private readonly GridSort<User> _byContractStatus =
		GridSort<User>.ByAscending(u => u.Contracts!.OrderByDescending(c => c.CreatedAt).First().Status);
	private GridSort<User> _byDepartment => GridSort<User>.ByAscending(u => GetDepartmentName(u.DepartmentId));
	private GridSort<User> _byRegion => GridSort<User>.ByAscending(u => GetRegionName(u.RegionId));

	// Per-column filters, opened from each column's options icon. They narrow independently
	// and stack with each other and with the toolbar search.
	private string _fName = "";
	private string _fEmail = "";
	private string _fRole = "";
	private string _fContract = "";
	private string _fDepartment = "";
	private string _fRegion = "";

	private static bool Has(string filter, string? value) =>
		string.IsNullOrWhiteSpace(filter)
		|| (value ?? "").Contains(filter, StringComparison.OrdinalIgnoreCase);

	private IQueryable<User> FilteredUsers =>
		(_regionFilterId.HasValue
			? _users.Where(user => user.RegionId == _regionFilterId.Value)
			: _users)
		.Where(MatchesQuickSearch)
		.Where(MatchesColumnFilters)
		.AsQueryable();

	private bool MatchesColumnFilters(User u)
	{
		var contract = GetActiveContract(u);
		var contractText = contract is null
			? "No Contract"
			: $"{contract.Type} {contract.Status}";

		return Has(_fName, u.Name)
			&& Has(_fEmail, u.Email)
			&& Has(_fRole, u.Role.ToString())
			&& Has(_fContract, contractText)
			&& Has(_fDepartment, GetDepartmentName(u.DepartmentId))
			&& Has(_fRegion, GetRegionName(u.RegionId));
	}

	private bool MatchesQuickSearch(User u)
	{
		if (string.IsNullOrWhiteSpace(_quickSearch)) return true;
		var contract = GetActiveContract(u);
		return u.Name.Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
			|| (u.Email ?? "").Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
			|| u.Role.ToString().Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
			|| GetDepartmentName(u.DepartmentId).Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
			|| GetRegionName(u.RegionId).Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
			|| (contract != null && contract.Type.ToString().Contains(_quickSearch, StringComparison.OrdinalIgnoreCase))
			|| (contract != null && contract.Status.ToString().Contains(_quickSearch, StringComparison.OrdinalIgnoreCase));
	}

	private bool CanManageSelectedRegion => _regionFilterId == _adminRegionId;
	private bool CanEditUser(User user) => user.RegionId == _adminRegionId;

	protected override async Task OnInitializedAsync()
	{
		if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
			return;

		var user = (await AuthStateTask!).User;
		var role = user.FindFirst(ClaimTypes.Role)?.Value;
		if (role != UserRole.Admin.ToString())
		{
			Nav.NavigateTo("/employee/dashboard");
			return;
		}

		if (!string.IsNullOrWhiteSpace(InitialSearch))
		{
			_quickSearch = InitialSearch;
		}

		_authorized = true;
		await LoadAsync();

		var currentAdmin = await Employees.GetEmployeeByEmailAsync(user.Identity!.Name!);
		_adminId = currentAdmin.Id;
		_adminRegionId = currentAdmin.RegionId;
		_regionFilterId = currentAdmin.RegionId;
		_newEmployeeRegionId = currentAdmin.RegionId;
	}

	private async Task LoadAsync()
	{
		_users = await Employees.GetAllUsersAsync();
		_departments = await Employees.GetDepartmentsAsync();
		_regions = await Employees.GetRegionsAsync();

		_departmentOptions = _departments
			.OrderBy(department => department.Name)
			.Select(department => new DepartmentOption(department.Id, department.Name))
			.Prepend(NoDepartment)
			.ToList();

		_regionFilterOptions = ActiveRegions
			.Select(region => new RegionOption(region.Id, region.Name))
			.Prepend(AllRegions)
			.ToList();
	}

	private Contract? GetActiveContract(User user)
	{
		return user.Contracts?
			.OrderByDescending(c => c.CreatedAt)
			.FirstOrDefault();
	}

	private static string StatusColor(ContractStatus status) => status switch
	{
		ContractStatus.Active => "var(--success)",
		ContractStatus.Terminated => "var(--error)",
		ContractStatus.Expired => "var(--neutral-foreground-hint)",
		_ => "var(--neutral-foreground-hint)"
	};

	private async Task OpenEditContractDialog(User user)
	{
		if (!CanEditUser(user))
		{
			Toast.ShowWarning("Other regions are read-only.");
			return;
		}

		var content = new EditContractDialog.Model
		{
			UserName = user.Name,
			ExistingContract = GetActiveContract(user)
		};
		content.Initialise();

		var parameters = new DialogParameters
		{
			Title = "Manage Contract",
			PrimaryAction = "Save",
			SecondaryAction = "Cancel",
			Width = "520px",
			// Keeps the dialog open with its own message when the entry is not usable.
			ValidateDialogAsync = () => Task.FromResult(content.TryBuildResult() is not null)
		};

		var dialog = await DialogService.ShowDialogAsync<EditContractDialog, EditContractDialog.Model>(
			content, parameters);
		var result = await dialog.Result;

		if (!result.Cancelled && content.TryBuildResult() is { } res)
		{
			await Employees.SaveUserContractAsync(_adminId, user.Id, res.Type, res.Status, res.StartDate, res.EndDate, res.Notes);
			Toast.ShowSuccess($"Contract updated for {user.Name}.");
			await LoadAsync();
		}
	}

	private async Task OnUserDepartmentChangedAsync(User user, Guid? departmentId)
	{
		if (!CanEditUser(user))
			return;

		if (user.DepartmentId == departmentId)
			return;

		await Employees.AssignUserToDepartmentAsync(_adminId, user.Id, departmentId);
		Toast.ShowSuccess($"{user.Name} moved.");
		await LoadAsync();
	}

	private async Task OnUserRegionChangedAsync(User user, Region? region)
	{
		if (region is null || !CanEditUser(user))
			return;

		if (user.RegionId == region.Id)
			return;

		var sourceRegion = GetRegionName(user.RegionId);
		var destinationRegion = GetRegionName(region.Id);
		var confirmation = await DialogService.ShowConfirmationAsync(
			$"Are you sure you want to move {user.Name} from {sourceRegion} to {destinationRegion}? " +
			"They will no longer appear in the source region's employee lists, and cross-region manager links will be removed.",
			"Yes, transfer",
			"Cancel",
			"Confirm region transfer");

		var confirmed = await confirmation.Result;
		if (confirmed.Cancelled)
		{
			StateHasChanged();
			return;
		}

		try
		{
			await Employees.AssignUserToRegionAsync(_adminId, user.Id, region.Id);
			Toast.ShowSuccess($"{user.Name} moved from {sourceRegion} to {destinationRegion}.");
			await LoadAsync();
		}
		catch (Exception exception)
		{
			Toast.ShowError(exception.Message);
		}
	}

	private void OnViewingRegionChanged(RegionOption? option)
	{
		_regionFilterId = option is null || option.Id == Guid.Empty ? null : option.Id;
	}

	private async Task CreateEmployeeAsync()
	{
		if (string.IsNullOrWhiteSpace(_newEmployeeName))
		{
			Toast.ShowWarning("Employee name is required.");
			return;
		}

		if (string.IsNullOrWhiteSpace(_newEmployeeInvitationEmail))
		{
			Toast.ShowWarning("Employee email is required.");
			return;
		}

		if (_newEmployeeDepartmentId == null)
		{
			Toast.ShowWarning("Select a department.");
			return;
		}

		if (_newEmployeeRegionId == null)
		{
			Toast.ShowWarning("Select a region.");
			return;
		}

		_creating = true;
		_createdAccount = null;

		try
		{
			_createdAccount = await Accounts.CreateAsync(
				_adminId,
				_newEmployeeName,
				_newEmployeeInvitationEmail,
				_newEmployeeDepartmentId.Value,
				_newEmployeeRegionId.Value,
				Nav.BaseUri);

			_newEmployeeName = "";
			_newEmployeeInvitationEmail = "";
			_newEmployeeDepartmentId = null;
			_newEmployeeRegionId = _adminRegionId;
			await LoadAsync();

			if (_createdAccount.EmailDelivered)
				Toast.ShowSuccess("Employee account created and setup email sent.");
			else
				Toast.ShowWarning("Employee account created; SMTP is not configured.");
		}
		catch (Exception exception)
		{
			Toast.ShowError(exception.Message);
		}
		finally
		{
			_creating = false;
		}
	}

	private string GetDepartmentName(Guid? id) =>
		id == null ? "None" : _departments.FirstOrDefault(d => d.Id == id)?.Name ?? "";

	private string GetRegionName(Guid id) =>
		_regions.FirstOrDefault(region => region.Id == id)?.Name ?? "Unknown";

	private DepartmentOption DepartmentOptionFor(Guid? id) =>
		id is null ? NoDepartment : _departmentOptions.FirstOrDefault(option => option.Id == id) ?? NoDepartment;

	private RegionOption FilterOptionFor(Guid? id) =>
		id is null ? AllRegions : _regionFilterOptions.FirstOrDefault(option => option.Id == id) ?? AllRegions;

	private static Guid? ToDepartmentId(DepartmentOption? option) =>
		option is null || option.Id == Guid.Empty ? null : option.Id;
}
