@page "/employee/my-requests"
@layout EmployeeLayout
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@inject ITimeOffService TimeOff
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject AppLocalizer Text

<PageTitle>@Text["My Requests"] · @Text["Time Off Management"]</PageTitle>

<MudText Typo="Typo.h5" Style="font-weight:600;" Class="mb-4">@Text["My Requests"]</MudText>

<MudTable T="TimeOffRequest" Items="@_requests" Hover="true" Elevation="1"
          OnRowClick="@(args => args.Item is null ? Task.CompletedTask : OpenDetails(args.Item))">
    <HeaderContent>
        <MudTh>@Text["Type"]</MudTh>
        <MudTh>@Text["Dates"]</MudTh>
        <MudTh>@Text["Status"]</MudTh>
        <MudTh>@Text["Submitted"]</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@(Text["Type"])">
            @Text[context.Type.ToString()]
        </MudTd>
        <MudTd DataLabel="@(Text["Dates"])">
            @context.StartDate.ToString("d", CultureInfo.CurrentCulture) –
            @context.EndDate.ToString("d", CultureInfo.CurrentCulture)
            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
                @context.Days @Text[context.Days == 1 ? "day" : "days"]
            </MudText>
        </MudTd>
        <MudTd DataLabel="@(Text["Status"])">
            <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">
                @Text[context.Status.ToString()]
            </MudChip>
        </MudTd>
        <MudTd DataLabel="@(Text["Submitted"])">
            @context.SubmittedAt.ToString("d", CultureInfo.CurrentCulture)
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private IReadOnlyList<TimeOffRequest> _requests = [];

    protected override async Task OnInitializedAsync()
    {
        if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
            return;

        _requests = await TimeOff.GetMyRequestsAsync();
    }

    private static Color StatusColor(RequestStatus status) => status switch
    {
        RequestStatus.Pending => Color.Warning,
        RequestStatus.Approved => Color.Success,
        RequestStatus.Rejected => Color.Error,
        _ => Color.Default
    };

    private Task OpenDetails(TimeOffRequest request)
    {
        var parameters = new DialogParameters<RequestDetailsDialog>
        {
            { d => d.Request, request }
        };
        return DialogService.ShowAsync<RequestDetailsDialog>(Text["Request details"], parameters);
    }
}
