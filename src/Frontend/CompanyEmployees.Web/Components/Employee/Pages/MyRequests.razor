@page "/employee/my-requests"
@layout EmployeeLayout
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@inject ITimeOffService TimeOff
@inject IDialogService DialogService
@inject NavigationManager Nav

<PageTitle>My Requests · Time Off Management</PageTitle>

<FluentLabel Typo="Typography.PaneHeader" Weight="FontWeight.Bold" MarginBlock="0 16px">My Requests</FluentLabel>

<FluentDataGrid Items="@_requests.AsQueryable()" TGridItem="TimeOffRequest"
                ShowHover="true" OnRowClick="@(row => OpenDetailsAsync(row.Item!))">
    <PropertyColumn Title="Type" Property="@(r => LeaveTypePalette.Label(r.Type))" />

    <TemplateColumn Title="Dates">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
            <FluentLabel Typo="Typography.Body">
                @context.StartDate.ToString("MMM d", CultureInfo.InvariantCulture) –
                @context.EndDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
            </FluentLabel>
            <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-caption">
                @context.Days @(context.Days == 1 ? "day" : "days")
            </FluentLabel>
        </FluentStack>
    </TemplateColumn>

    <TemplateColumn Title="Status">
        @* Amber / green / red, as before: FluentBadge's three appearances cannot tell
           approved from rejected, and that is the one distinction this column exists for. *@
        <FluentBadge Fill="highlight" BackgroundColor="@StatusColor(context.Status)" Color="white">
            @context.Status
        </FluentBadge>
    </TemplateColumn>

    <PropertyColumn Title="Submitted"
                    Property="@(r => r.SubmittedAt)"
                    Format="MMM d, yyyy" />
</FluentDataGrid>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private IReadOnlyList<TimeOffRequest> _requests = [];

    protected override async Task OnInitializedAsync()
    {
        if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
            return;

        _requests = await TimeOff.GetMyRequestsAsync();
    }

    private static string StatusColor(RequestStatus status) => status switch
    {
        RequestStatus.Approved => "var(--success)",
        RequestStatus.Rejected => "var(--error)",
        _ => "var(--warning)"
    };

    private Task OpenDetailsAsync(TimeOffRequest request) =>
        DialogService.ShowDialogAsync<RequestDetailsDialog>(request, new DialogParameters
        {
            Title = "Request details",
            PrimaryAction = "Close",
            SecondaryAction = null,
            Width = "480px"
        });
}
