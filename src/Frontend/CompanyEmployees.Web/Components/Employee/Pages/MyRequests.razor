@page "/employee/my-requests"
@layout EmployeeLayout
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@inject ITimeOffService TimeOff
@inject IDialogService DialogService
@inject NavigationManager Nav

<PageTitle>My Requests · Time Off Management</PageTitle>

<MudText Typo="Typo.h5" Style="font-weight:600;" Class="mb-4">My Requests</MudText>

<MudTable T="TimeOffRequest" Items="@_requests" Hover="true" Elevation="1"
          OnRowClick="@(args => OpenDetails(args.Item))">
    <HeaderContent>
        <MudTh>Type</MudTh>
        <MudTh>Dates</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Submitted</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Type">
            @LeaveTypePalette.Label(context.Type)
        </MudTd>
        <MudTd DataLabel="Dates">
            @context.StartDate.ToString("MMM d", CultureInfo.InvariantCulture) –
            @context.EndDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
                @context.Days @(context.Days == 1 ? "day" : "days")
            </MudText>
        </MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">
                @context.Status
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Submitted">
            @context.SubmittedAt.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private IReadOnlyList<TimeOffRequest> _requests = [];

    protected override async Task OnInitializedAsync()
    {
        if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
            return;

        _requests = await TimeOff.GetMyRequestsAsync();
    }

    private static Color StatusColor(RequestStatus status) => status switch
    {
        RequestStatus.Pending => Color.Warning,
        RequestStatus.Approved => Color.Success,
        RequestStatus.Rejected => Color.Error,
        _ => Color.Default
    };

    private Task OpenDetails(TimeOffRequest request)
    {
        var parameters = new DialogParameters<RequestDetailsDialog>
        {
            { d => d.Request, request }
        };
        return DialogService.ShowAsync<RequestDetailsDialog>("Request details", parameters);
    }
}
