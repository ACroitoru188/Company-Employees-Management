@* The manager's own view: everyone reporting to them. Distinct from /employee/team,
   which shows peers — hence the "Department" label in the nav. *@
@page "/manager/team"
@layout EmployeeLayout
@using System.Globalization
@using System.Security.Claims
@using CompanyEmployees.Application
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Domain.Entities
@using CompanyEmployees.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@using CompanyEmployees.Web.Components.Pages
@using DomainInvalidOperationException = CompanyEmployees.Domain.Exceptions.InvalidOperationException
@inject EmployeeContext Employees
@inject ManagerContext Manager
@inject NavigationManager Nav
@inject IToastService Toast
@inject IDialogService DialogService
@inject ActingContext Acting

<PageTitle>Department · Time Off &amp; Contracts</PageTitle>

@if (!_authorized || _data is null)
{
    <FluentProgressRing />
}
else
{
    @if (_data.ActiveDelegationsReceived.Count > 0)
    {
        <FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8"
                         VerticalAlignment="VerticalAlignment.Center" Width="100%">
                <FluentLabel Typo="Typography.Body">
                    <strong>Delegated Manager Notice:</strong> You are currently acting as an active delegate for:
                    @string.Join(", ", _data.ActiveDelegationsReceived.Select(d => $"{d.Manager?.Name ?? "Manager"} (until {d.EndDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)})"))
                </FluentLabel>
                <FluentSpacer />
                <FluentBadge Appearance="Appearance.Neutral">Delegation Active</FluentBadge>
            </FluentStack>
        </FluentMessageBar>
    }

    @* Wrap so the action drops under the title on a narrow window instead of being pushed
       off the right edge — a spacer will happily shove its siblings out of view. *@
    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center"
                 HorizontalGap="12" Wrap="true" Width="100%" Style="margin:16px 0;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
            <FluentLabel Typo="Typography.PaneHeader" Weight="FontWeight.Bold">Department</FluentLabel>
            <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                @_data.TeamSize direct @(_data.TeamSize == 1 ? "report" : "reports")
            </FluentLabel>
        </FluentStack>
        <FluentSpacer />
        @* Delegation History is reached from the drawer nav; repeating it here only crowded
           the header. Delegating is the action that belongs on this page. *@
        @if (_onBehalf is null)
        {
            @* Hidden while borrowing: CreateDelegationAsync refuses it anyway, and
               finding that out after filling the dialog is worse than not offering it. *@
            <FluentButton Appearance="Appearance.Outline"
                          IconStart="@(new Icons.Regular.Size20.ArrowSwap())"
                          OnClick="OpenCreateDelegationDialog">
                Delegate Responsibilities
            </FluentButton>
        }
    </FluentStack>

    <FluentGrid Spacing="3" Style="margin-bottom:24px;">
        <FluentGridItem xs="12" sm="6" md="3">
            <FluentCard Style="padding:16px;">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                    <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-overline">TEAM SIZE</FluentLabel>
                    <FluentLabel Typo="Typography.PageTitle" Weight="FontWeight.Bold">@_data.TeamSize</FluentLabel>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" md="3">
            <FluentCard Style="padding:16px;">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                    <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-overline">PENDING</FluentLabel>
                    <FluentLabel Typo="Typography.PageTitle" Weight="FontWeight.Bold">@_data.PendingRequests</FluentLabel>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" md="3">
            <FluentCard Style="padding:16px;">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                    <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-overline">ON LEAVE TODAY</FluentLabel>
                    <FluentLabel Typo="Typography.PageTitle" Weight="FontWeight.Bold">@_data.OnLeaveToday</FluentLabel>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
        <FluentGridItem xs="12" sm="6" md="3">
            <FluentCard Style="padding:16px;">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                    <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-overline">WAITING &gt; 7 DAYS</FluentLabel>
                    <FluentLabel Typo="Typography.PageTitle" Weight="FontWeight.Bold">@_data.StaleRequests</FluentLabel>
                </FluentStack>
            </FluentCard>
        </FluentGridItem>
    </FluentGrid>

    @if (_data.ActiveDelegationsGiven.Count > 0)
    {
        <FluentCard Style="margin-bottom:24px; padding:16px;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                <FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">Active Outgoing Delegations</FluentLabel>

                @* Equal columns would leave the action stranded in the middle of a 450px
                   track; the last one is sized for the button instead. *@
                <FluentDataGrid Items="@_data.ActiveDelegationsGiven.AsQueryable()" TGridItem="ManagerDelegation"
                                GridTemplateColumns="1fr 1fr 2fr 180px" ShowHover="true">
                    <TemplateColumn Title="Delegate">
                        @(context.Delegate?.Name ?? "Colleague")
                    </TemplateColumn>
                    <TemplateColumn Title="Period">
                        @context.StartDate.ToString("MMM d", CultureInfo.InvariantCulture) –
                        @context.EndDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
                    </TemplateColumn>
                    <TemplateColumn Title="Reason">
                        @(string.IsNullOrWhiteSpace(context.Reason) ? "—" : context.Reason)
                    </TemplateColumn>
                    <TemplateColumn Align="Align.End">
                        <FluentButton Appearance="Appearance.Outline"
                                      OnClick="@(() => CancelDelegationAsync(context.Id))">
                            Cancel Delegation
                        </FluentButton>
                    </TemplateColumn>
                </FluentDataGrid>
            </FluentStack>
        </FluentCard>
    }

    <FluentCard Style="margin-bottom:24px; padding:16px;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8"
                         VerticalAlignment="VerticalAlignment.Center">
                <FluentIcon Value="@(new Icons.Regular.Size20.Clock())" Color="Color.Accent" />
                <FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold">Requests to approve</FluentLabel>
            </FluentStack>

            <FluentSearch @bind-Value="RequestsSearchTerm" @bind-Value:after="StateHasChanged"
                          Placeholder="Search by name..." Style="width:100%;" />

            @if (!FilteredRequests.Any())
            {
                <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                    No requests are waiting for approval.
                </FluentLabel>
            }
            else
            {
                @* The accordion replaces the hand-rolled expand/collapse row; ActiveId keeps the
                   panel opened by a ?search= deep link expanded, as ToggleRequest used to. *@
                <FluentAccordion @bind-ActiveId="_activeRequestId">
                    @foreach (var request in FilteredRequests)
                    {
                        <FluentAccordionItem Id="@request.RequestId.ToString()">
                            <HeadingTemplate>
                                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12"
                                             VerticalAlignment="VerticalAlignment.Center" Width="100%">
                                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="2">
                                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8"
                                                     VerticalAlignment="VerticalAlignment.Center">
                                            <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">
                                                @request.Name
                                            </FluentLabel>
                                            @if (request.IsDelegated)
                                            {
                                                <FluentBadge Appearance="Appearance.Lightweight">
                                                    Delegated from @request.DelegatedFromManagerName
                                                </FluentBadge>
                                            }
                                        </FluentStack>
                                        <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">
                                            @request.Type &middot; @request.Days @(request.Days == 1 ? "day" : "days")
                                            &middot; @request.Department
                                            &middot; @request.StartDate.ToString("MMM d", CultureInfo.InvariantCulture)–@request.EndDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
                                        </FluentLabel>
                                    </FluentStack>
                                    <FluentSpacer />
                                    @* Amber, the colour this app gives a pending decision everywhere
                                       else — accent blue read as "approved". *@
                                    <FluentBadge Fill="highlight" BackgroundColor="var(--warning)" Color="white">pending</FluentBadge>
                                </FluentStack>
                            </HeadingTemplate>

                            <ChildContent>
                                @{
                                    var nameParts = request.Name.Split(' ', 2);
                                    var firstName = nameParts.Length > 0 ? nameParts[0] : "";
                                    var lastName = nameParts.Length > 1 ? nameParts[1] : "";
                                    var role = request.Role == "LineManager" ? "Manager" : request.Role;
                                    var reason = string.IsNullOrWhiteSpace(request.Reason)
                                        || request.Reason.Equals(request.Type, StringComparison.OrdinalIgnoreCase)
                                        || request.Reason.Equals(request.Type + " leave", StringComparison.OrdinalIgnoreCase)
                                            ? "No reason specified"
                                            : request.Reason;
                                }

                                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="24" Width="100%">
                                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                                            <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Name</FluentLabel>
                                            <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@firstName</FluentLabel>
                                        </FluentStack>
                                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                                            <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Surname</FluentLabel>
                                            <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@lastName</FluentLabel>
                                        </FluentStack>
                                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                                            <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Department</FluentLabel>
                                            <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@request.Department</FluentLabel>
                                        </FluentStack>
                                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                                            <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Role</FluentLabel>
                                            <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@role</FluentLabel>
                                        </FluentStack>
                                    </FluentStack>
                                </FluentStack>

                                <FluentDivider Role="DividerRole.Presentation" Style="margin:16px 0;" />

                                <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                                        <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Leave type</FluentLabel>
                                        <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@request.Type</FluentLabel>
                                    </FluentStack>
                                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                                        <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Reason</FluentLabel>
                                        <FluentLabel Typo="Typography.Body">@reason</FluentLabel>
                                    </FluentStack>
                                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                                        <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Period</FluentLabel>
                                        <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">
                                            @request.StartDate.ToString("dd.MM.yyyy") - @request.EndDate.ToString("dd.MM.yyyy")
                                            (@request.Days @(request.Days == 1 ? "day" : "days"))
                                        </FluentLabel>
                                    </FluentStack>
                                    <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-caption">
                                        Submitted @request.SubmittedAt.ToString("dd.MM.yyyy - HH:mm")
                                    </FluentLabel>
                                </FluentStack>

                                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8"
                                             HorizontalAlignment="HorizontalAlignment.End" Width="100%"
                                             Style="margin-top:16px;">
                                    <FluentButton Appearance="Appearance.Neutral"
                                                  OnClick="@(() => EditDates(request))">EDIT DATES</FluentButton>
                                    <FluentButton Appearance="Appearance.Neutral"
                                                  OnClick="@(() => DecideAsync(request.RequestId, false))">REJECT</FluentButton>
                                    <FluentButton Appearance="Appearance.Accent"
                                                  OnClick="@(() => DecideAsync(request.RequestId, true))">APPROVE</FluentButton>
                                </FluentStack>
                            </ChildContent>
                        </FluentAccordionItem>
                    }
                </FluentAccordion>
            }
        </FluentStack>
    </FluentCard>

    <FluentLabel Typo="Typography.Header" Weight="FontWeight.Bold" MarginBlock="0 12px">Members &amp; Contracts</FluentLabel>

    @if (_data.Team.Count == 0)
    {
        <FluentCard Style="padding:16px;">
            <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">Nobody reports to you yet.</FluentLabel>
        </FluentCard>
    }
    else
    {
        <FluentSearch @bind-Value="_quickSearch" @bind-Value:after="StateHasChanged"
                      Placeholder="Search members..." Style="width:320px; margin-bottom:8px;" />

        @* Seven equal columns give the contract period the same room as "Role", and its
           badge-plus-date runs past the cell and is cut mid-date. Weighted instead: the two
           columns that carry a badge and a value get more, the short ones less. *@
        <FluentDataGrid Items="@FilteredTeam" TGridItem="ManagerTeamMember" ResizableColumns="true"
                        GridTemplateColumns="1.2fr 0.8fr 1fr 0.9fr 1.7fr 0.8fr 0.6fr"
                        ShowHover="true" Pagination="@_pagination">
            <PropertyColumn Title="Name" Property="@(m => m.Name)" Sortable="true" />
            <PropertyColumn Title="Role" Property="@(m => m.Role)" Sortable="true" />
            <PropertyColumn Title="Department" Property="@(m => m.Department)" Sortable="true" />

            <TemplateColumn Title="Contract Type" Sortable="true" SortBy="@_byContractType">
                @if (context.ContractType == null)
                {
                    <FluentBadge Appearance="Appearance.Neutral">None</FluentBadge>
                }
                else if (context.ContractType == ContractType.Determinate)
                {
                    <FluentBadge Appearance="Appearance.Lightweight">Determinate</FluentBadge>
                }
                else
                {
                    <FluentBadge Appearance="Appearance.Accent">Indeterminate</FluentBadge>
                }
            </TemplateColumn>

            <TemplateColumn Title="Contract Period &amp; Status" Sortable="true" SortBy="@_byContractStatus">
                @if (context.ContractId.HasValue)
                {
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6"
                                 VerticalAlignment="VerticalAlignment.Center">
                        <FluentBadge Fill="highlight" BackgroundColor="@StatusColor(context.ContractStatus)" Color="white">
                            @context.ContractStatus
                        </FluentBadge>
                        <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)" Class="app-caption">
                            @(context.ContractStartDate?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "—") –
                            @(context.ContractEndDate?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "Indefinite")
                        </FluentLabel>
                    </FluentStack>
                }
                else
                {
                    <FluentLabel Typo="Typography.Body" Color="Color.Custom" CustomColor="var(--neutral-foreground-hint)">—</FluentLabel>
                }
            </TemplateColumn>

            <TemplateColumn Title="Leave Status" Sortable="true" SortBy="@_byLeaveStatus">
                <FluentBadge Appearance="@(context.OnLeaveToday ? Appearance.Accent : Appearance.Neutral)">
                    @(context.OnLeaveToday ? "On leave" : "Available")
                </FluentBadge>
            </TemplateColumn>

            <TemplateColumn Title="Contract Actions" Sortable="false" Align="Align.End">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4"
                             VerticalAlignment="VerticalAlignment.Center">
                    @if (context.ContractId.HasValue && context.ContractType == ContractType.Determinate
                         && context.ContractStatus == ContractStatus.Active)
                    {
                        <FluentButton Appearance="Appearance.Stealth" Title="Extend Fixed-Term Contract"
                                      IconStart="@(new Icons.Regular.Size20.CalendarArrowRight())"
                                      OnClick="@(() => OpenExtendContractDialog(context))" />
                    }
                    @if (context.ContractId.HasValue && context.ContractStatus == ContractStatus.Active)
                    {
                        <FluentButton Appearance="Appearance.Stealth" Title="Terminate Contract"
                                      IconStart="@(new Icons.Regular.Size20.DismissCircle().WithColor("var(--error)"))"
                                      OnClick="@(() => OpenTerminateContractDialog(context))" />
                    }
                </FluentStack>
            </TemplateColumn>
        </FluentDataGrid>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center" Width="100%">
            <FluentPaginator State="@_pagination" />
        </FluentStack>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? InitialSearch { get; set; }

    private bool _authorized;
    private Guid _managerId;
    private ActingUser? _acting;

    // Non-null only while this account is borrowed; every manager action below takes it so
    // the delegation window is re-checked, which the auth cookie alone would outlive.
    private ActingOnBehalf? _onBehalf => _acting is { IsImpersonating: true, DelegationId: not null }
        ? new ActingOnBehalf(_acting.RealUserId, _acting.DelegationId.Value)
        : null;
    private ManagerDashboardResult? _data;
    private string _quickSearch = "";
    private string? _activeRequestId;
    private string RequestsSearchTerm { get; set; } = "";

    private readonly PaginationState _pagination = new() { ItemsPerPage = 15 };

    private readonly GridSort<ManagerTeamMember> _byContractType =
        GridSort<ManagerTeamMember>.ByAscending(m => m.ContractType);
    private readonly GridSort<ManagerTeamMember> _byContractStatus =
        GridSort<ManagerTeamMember>.ByAscending(m => m.ContractStatus);
    private readonly GridSort<ManagerTeamMember> _byLeaveStatus =
        GridSort<ManagerTeamMember>.ByAscending(m => m.OnLeaveToday);

    private IEnumerable<ManagerPendingRequest> FilteredRequests => string.IsNullOrWhiteSpace(RequestsSearchTerm)
        ? (_data?.Pending ?? Enumerable.Empty<ManagerPendingRequest>())
        : (_data?.Pending ?? Enumerable.Empty<ManagerPendingRequest>()).Where(r => r.Name.Contains(RequestsSearchTerm, StringComparison.OrdinalIgnoreCase));

    private IQueryable<ManagerTeamMember> FilteredTeam =>
        (_data?.Team ?? new List<ManagerTeamMember>()).Where(MatchesQuickSearch).AsQueryable();

    private bool MatchesQuickSearch(ManagerTeamMember m)
    {
        if (string.IsNullOrWhiteSpace(_quickSearch)) return true;
        return m.Name.Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
            || m.Role.Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
            || m.Department.Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
            || (m.ContractType != null && m.ContractType.ToString()!.Contains(_quickSearch, StringComparison.OrdinalIgnoreCase))
            || (m.ContractStatus != null && m.ContractStatus.ToString()!.Contains(_quickSearch, StringComparison.OrdinalIgnoreCase));
    }

    private async Task EditDates(ManagerPendingRequest request)
    {
        var hrReq = new HrPendingRequest
        {
            RequestId = request.RequestId,
            Name = request.Name,
            Department = request.Department,
            Type = request.Type,
            StartDate = request.StartDate,
            EndDate = request.EndDate,
            Days = request.Days,
            WaitingDays = request.WaitingDays,
            Role = request.Role,
            Reason = request.Reason,
            SubmittedAt = request.SubmittedAt
        };

        var content = EditLeaveDatesDialog.Model.From(hrReq);

        var parameters = new DialogParameters
        {
            Title = "Edit leave period",
            PrimaryAction = "Save",
            SecondaryAction = "Cancel",
            Width = "420px",
            ValidateDialogAsync = () => SaveDatesAsync(content)
        };

        var dialog = await DialogService.ShowDialogAsync<EditLeaveDatesDialog, EditLeaveDatesDialog.Model>(
            content, parameters);

        var result = await dialog.Result;
        if (!result.Cancelled)
            await LoadAsync();
    }

    // Runs before the dialog is allowed to close; returning false keeps it open with the
    // message written back onto the content the dialog is rendering.
    private async Task<bool> SaveDatesAsync(EditLeaveDatesDialog.Model content)
    {
        content.SetError(null);

        if (content.Start is null || content.End is null)
        {
            content.SetError("Both dates are required.");
            return false;
        }

        try
        {
            await Employees.UpdateRequestDatesAsync(
                content.RequestId,
                DateOnly.FromDateTime(content.Start.Value),
                DateOnly.FromDateTime(content.End.Value));
            return true;
        }
        catch (DomainInvalidOperationException ex)
        {
            content.SetError(ex.Message);
            return false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
            return;

        var user = (await AuthStateTask!).User;
        var role = user.FindFirst(ClaimTypes.Role)?.Value;
        if (role != UserRole.LineManager.ToString())
        {
            Nav.NavigateTo("/employee/dashboard");
            return;
        }

        var me = await Employees.GetEmployeeByEmailAsync(user.Identity!.Name!);
        _managerId = me.Id;

        _acting = await Acting.GetAsync();

        if (!string.IsNullOrWhiteSpace(InitialSearch))
        {
            _quickSearch = InitialSearch;
            RequestsSearchTerm = InitialSearch;
        }

        _authorized = true;
        await LoadAsync();

        if (!string.IsNullOrWhiteSpace(InitialSearch) && _data != null)
        {
            _activeRequestId = _data.Pending
                .FirstOrDefault(p => p.Name.Contains(InitialSearch, StringComparison.OrdinalIgnoreCase))
                ?.RequestId.ToString();
        }
    }

    private async Task LoadAsync()
    {
        _data = await Manager.GetManagerDashboardAsync(_managerId);
    }

    private static string StatusColor(ContractStatus? status) => status switch
    {
        ContractStatus.Active => "var(--success)",
        ContractStatus.Terminated => "var(--error)",
        ContractStatus.Expired => "var(--neutral-foreground-hint)",
        _ => "var(--neutral-foreground-hint)"
    };

    private async Task DecideAsync(Guid requestId, bool approve)
    {
        try
        {
            await Manager.DecideRequestAsync(_managerId, requestId, approve, _onBehalf);
            Toast.ShowSuccess(approve ? "Request approved." : "Request declined.");
            if (_activeRequestId == requestId.ToString())
            {
                _activeRequestId = null;
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }

        await LoadAsync();
    }

    private async Task OpenExtendContractDialog(ManagerTeamMember member)
    {
        if (!member.ContractId.HasValue) return;

        var content = new ExtendContractDialog.Model
        {
            EmployeeName = member.Name,
            CurrentStartDate = member.ContractStartDate ?? DateOnly.FromDateTime(DateTime.Today),
            CurrentEndDate = member.ContractEndDate
        };
        content.Initialise();

        var parameters = new DialogParameters
        {
            Title = "Extend Contract",
            PrimaryAction = "Extend",
            SecondaryAction = "Cancel",
            Width = "480px",
            ValidateDialogAsync = () =>
            {
                content.Validate();
                return Task.FromResult(content.IsValid);
            }
        };

        var dialog = await DialogService.ShowDialogAsync<ExtendContractDialog, ExtendContractDialog.Model>(
            content, parameters);
        var result = await dialog.Result;

        if (!result.Cancelled && content.IsValid)
        {
            var newEndDate = content.SelectedDate;
            try
            {
                await Manager.ExtendContractAsync(_managerId, member.ContractId.Value, newEndDate, _onBehalf);
                Toast.ShowSuccess($"Contract extended for {member.Name} until {newEndDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)}.");
                await LoadAsync();
            }
            catch (Exception ex)
            {
                Toast.ShowError(ex.Message);
            }
        }
    }

    private async Task OpenTerminateContractDialog(ManagerTeamMember member)
    {
        if (!member.ContractId.HasValue) return;

        var content = new TerminateContractDialog.Model { EmployeeName = member.Name };

        var parameters = new DialogParameters
        {
            Title = "Terminate Contract",
            PrimaryAction = "Terminate",
            SecondaryAction = "Cancel",
            Width = "480px"
        };

        var dialog = await DialogService.ShowDialogAsync<TerminateContractDialog, TerminateContractDialog.Model>(
            content, parameters);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            var reason = string.IsNullOrWhiteSpace(content.Reason) ? null : content.Reason;

            // Terminating cannot be undone, and from inside a borrowed account the screen
            // looks exactly like your own — so make the identity impossible to skip past.
            if (_onBehalf is not null && !await ConfirmTerminationAsync(member.Name))
                return;

            try
            {
                await Manager.TerminateContractAsync(_managerId, member.ContractId.Value, reason, _onBehalf);
                Toast.ShowWarning($"Contract terminated for {member.Name}.");
                await LoadAsync();
            }
            catch (Exception ex)
            {
                Toast.ShowError(ex.Message);
            }
        }
    }

    private async Task<bool> ConfirmTerminationAsync(string employeeName)
    {
        var confirmation = await DialogService.ShowConfirmationAsync(
            $"You are {_acting!.RealUserName}, acting as {_acting.EffectiveUserName}. " +
            $"Terminate the contract for {employeeName}? This cannot be undone.",
            "Terminate",
            "Cancel",
            "Terminate contract");

        var result = await confirmation.Result;
        return !result.Cancelled;
    }

    private async Task OpenCreateDelegationDialog()
    {
        var regionUsers = await Employees.GetUsersInMyRegionAsync(_managerId);
        var candidateDelegates = regionUsers
            .Where(u => u.Id != _managerId)
            .ToList();

        var content = new CreateDelegationDialog.Model { AvailableUsers = candidateDelegates };

        var parameters = new DialogParameters
        {
            Title = "Delegate Manager Responsibilities",
            PrimaryAction = "Delegate",
            SecondaryAction = "Cancel",
            Width = "520px",
            ValidateDialogAsync = () => Task.FromResult(content.Validate())
        };

        var dialog = await DialogService.ShowDialogAsync<CreateDelegationDialog, CreateDelegationDialog.Model>(
            content, parameters);
        var result = await dialog.Result;

        if (!result.Cancelled && content.IsValid)
        {
            var res = content.ToResult();
            try
            {
                await Manager.CreateDelegationAsync(_managerId, res.DelegateId, res.StartDate, res.EndDate, res.Reason, _onBehalf);
                Toast.ShowSuccess("Delegation created successfully.");
                await LoadAsync();
            }
            catch (Exception ex)
            {
                Toast.ShowError(ex.Message);
            }
        }
    }

    private async Task CancelDelegationAsync(Guid delegationId)
    {
        try
        {
            await Manager.CancelDelegationAsync(_managerId, delegationId);
            Toast.ShowInfo("Delegation cancelled.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }
}
