@* The manager's own view: everyone reporting to them. Distinct from /employee/team,
   which shows peers — hence the "Department" label in the nav. *@
@page "/manager/team"
@layout EmployeeLayout
@using System.Globalization
@using System.Security.Claims
@using CompanyEmployees.Application
@using CompanyEmployees.Application.Contexts
@using CompanyEmployees.Domain.Entities
@using CompanyEmployees.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using CompanyEmployees.Web.Security
@using CompanyEmployees.Web.Components.Pages
@inject EmployeeContext Employees
@inject ManagerContext Manager
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ActingContext Acting

<PageTitle>Department · Time Off & Contracts</PageTitle>

@if (!_authorized || _data is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @if (_data.ActiveDelegationsReceived.Count > 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Elevation="1" Class="mb-4">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                <div>
                    <strong>Delegated Manager Notice:</strong> You are currently acting as an active delegate for:
                    @string.Join(", ", _data.ActiveDelegationsReceived.Select(d => $"{d.Manager?.Name ?? "Manager"} (until {d.EndDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)})"))
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Surface">Delegation Active</MudChip>
            </div>
        </MudAlert>
    }

    <div class="d-flex align-center justify-space-between flex-wrap gap-3 mb-4">
        <div>
            <MudText Typo="Typo.h5" Style="font-weight:600;">Department</MudText>
            <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">
                @_data.TeamSize direct @(_data.TeamSize == 1 ? "report" : "reports")
            </MudText>
        </div>
        <div class="d-flex gap-2">
            @* The only way into the history page — deliberately not in the drawer nav. *@
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.History"
                       Href="/manager/delegation-history">
                Delegation History
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SwapHoriz"
                       OnClick="OpenCreateDelegationDialog">
                Delegate Responsibilities
            </MudButton>
        </div>
    </div>

    <MudGrid Spacing="3" Class="mb-6">
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Style="color:var(--mud-palette-text-secondary); letter-spacing:.08em;">
                        TEAM SIZE
                    </MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:700;">@_data.TeamSize</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Style="color:var(--mud-palette-text-secondary); letter-spacing:.08em;">
                        PENDING
                    </MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:700;">@_data.PendingRequests</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Style="color:var(--mud-palette-text-secondary); letter-spacing:.08em;">
                        ON LEAVE TODAY
                    </MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:700;">@_data.OnLeaveToday</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.overline" Style="color:var(--mud-palette-text-secondary); letter-spacing:.08em;">
                        WAITING &gt; 7 DAYS
                    </MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:700;">@_data.StaleRequests</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @if (_data.ActiveDelegationsGiven.Count > 0)
    {
        <MudCard Elevation="1" Class="mb-6">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Active Outgoing Delegations</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pt-0">
                <MudTable T="ManagerDelegation" Items="@_data.ActiveDelegationsGiven" Hover="true" Elevation="0" Dense="true">
                    <HeaderContent>
                        <MudTh>Delegate</MudTh>
                        <MudTh>Period</MudTh>
                        <MudTh>Reason</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Delegate">@(context.Delegate?.Name ?? "Colleague")</MudTd>
                        <MudTd DataLabel="Period">
                            @context.StartDate.ToString("MMM d", CultureInfo.InvariantCulture) – @context.EndDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
                        </MudTd>
                        <MudTd DataLabel="Reason">@(string.IsNullOrWhiteSpace(context.Reason) ? "—" : context.Reason)</MudTd>
                        <MudTd Style="text-align:right;">
                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                                       OnClick="@(() => CancelDelegationAsync(context.Id))">
                                Cancel Delegation
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudCardContent>
        </MudCard>
    }

    <!-- Requests awaiting approval -->
    <div class="requests-panel">
        <div class="panel-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            Requests to approve
        </div>
        <div class="px-4 py-2 border-bottom">
            <MudTextField @bind-value="RequestsSearchTerm"
                          PlaceHolder="Search by name..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Small"
                          Margin="Margin.Dense"
                          Variant="Variant.Outlined"
                          Immediate="true"></MudTextField>
        </div>
        <div class="requests-list">
            @if (!FilteredRequests.Any())
            {
                <div class="request-row">
                    <div class="req-info">
                        <div class="req-desc">No requests are waiting for approval.</div>
                    </div>
                </div>
            }
            @{
                var requestList = FilteredRequests.ToList();
            }
            @for (int i = 0; i < requestList.Count; i++)
            {
                var request = requestList[i];
                var isLast = i == requestList.Count - 1;
                <div class="request-item" style="border-bottom: @(isLast ? "none" : "1px solid var(--mud-palette-lines-default)");">
                    <div class="request-row" style="cursor: pointer; border-bottom: none; padding-bottom: @(_selectedRequest == request ? "0.5rem" : "1rem");" @onclick="() => ToggleRequest(request)">
                        <div class="req-info">
                            <div class="req-name d-flex align-center gap-2">
                                <span>@request.Name</span>
                                @if (request.IsDelegated)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                        Delegated from @request.DelegatedFromManagerName
                                    </MudChip>
                                }
                            </div>
                            <div class="req-desc">
                                @request.Type &middot; @request.Days @(request.Days == 1 ? "day" : "days") &middot; @request.Department
                                &middot; @request.StartDate.ToString("MMM d", CultureInfo.InvariantCulture)–@request.EndDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
                            </div>
                        </div>
                        <div class="req-status status-pending">pending</div>
                    </div>
                    
                    @if (_selectedRequest == request)
                    {
                        <div class="request-details-panel mt-2 mb-4 p-4 rounded" style="background-color: var(--mud-palette-background-grey); border: 1px solid var(--mud-palette-lines-default);">
                            @{
                                var nameParts = request.Name.Split(' ', 2);
                                var firstName = nameParts.Length > 0 ? nameParts[0] : "";
                                var lastName = nameParts.Length > 1 ? nameParts[1] : "";
                                var role = request.Role == "LineManager" ? "Manager" : request.Role;
                            }

                            <div class="d-flex justify-space-between mb-4">
                                <div>
                                    <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">Name</MudText>
                                    <MudText Typo="Typo.body1" Style="font-weight:500;" Class="mb-2">@firstName</MudText>
                                    <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">Surname</MudText>
                                    <MudText Typo="Typo.body1" Style="font-weight:500;" Class="mb-2">@lastName</MudText>
                                    <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">Department</MudText>
                                    <MudText Typo="Typo.body1" Style="font-weight:500;" Class="mb-2">@request.Department</MudText>
                                    <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">Role</MudText>
                                    <MudText Typo="Typo.body1" Style="font-weight:500;">@role</MudText>
                                </div>
                                <div class="d-flex align-center justify-center rounded border border-solid border-dark" style="width: 120px; height: 150px; background-color: var(--mud-palette-background-grey); border-width: 2px;">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size: 5rem; color: var(--mud-palette-text-secondary);" />
                                </div>
                            </div>

                            <MudDivider Class="my-4" />

                            <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">Leave type</MudText>
                            <MudText Typo="Typo.body1" Style="font-weight:500;" Class="mb-3">@request.Type</MudText>

                            <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">Reason</MudText>
                            <MudText Typo="Typo.body1" Class="mb-3">@(string.IsNullOrWhiteSpace(request.Reason) || request.Reason.Equals(request.Type, StringComparison.OrdinalIgnoreCase) || request.Reason.Equals(request.Type + " leave", StringComparison.OrdinalIgnoreCase) ? "No reason specified" : request.Reason)</MudText>

                            <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">Period</MudText>
                            <MudText Typo="Typo.body1" Style="font-weight:500;" Class="mb-3">
                                @request.StartDate.ToString("dd.MM.yyyy") - @request.EndDate.ToString("dd.MM.yyyy") (@request.Days @(request.Days == 1 ? "day" : "days"))
                            </MudText>

                            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">Submitted @request.SubmittedAt.ToString("dd.MM.yyyy - HH:mm")</MudText>
                            
                            <div class="d-flex justify-end mt-4">
                                <MudButton Variant="Variant.Filled" OnClick="() => ToggleRequest(request)" Class="mr-2">CLOSE</MudButton>
                                <MudButton Variant="Variant.Filled" OnClick="() => EditDates(request)" Class="mr-2">EDIT DATES</MudButton>
                                <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="() => DecideAsync(request.RequestId, false)" Class="mr-2">REJECT</MudButton>
                                <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="() => DecideAsync(request.RequestId, true)">APPROVE</MudButton>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <MudText Typo="Typo.h6" Style="font-weight:600;" Class="mb-3">Members & Contracts</MudText>

    @if (_data.Team.Count == 0)
    {
        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);">
                Nobody reports to you yet.
            </MudText>
        </MudPaper>
    }
    else
    {
        <MudDataGrid T="ManagerTeamMember" Items="@_data.Team" QuickFilter="@_quickFilter"
                     Filterable="true" SortMode="SortMode.Multiple"
                     FilterMode="DataGridFilterMode.ColumnFilterRow"
                     Hover="true" Dense="true" Elevation="1">
            <ToolBarContent>
                <MudTextField @bind-Value="_quickSearch" Placeholder="Search members..."
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" />
                <MudSpacer />
            </ToolBarContent>
            <Columns>
                <PropertyColumn Property="@(m => m.Name)" Title="Name" />
                <PropertyColumn Property="@(m => m.Role)" Title="Role" />
                <PropertyColumn Property="@(m => m.Department)" Title="Department" />
                <TemplateColumn T="ManagerTeamMember" Title="Contract Type" Sortable="true"
                                SortBy="@(m => m.ContractType?.ToString() ?? "None")" Filterable="false">
                    <CellTemplate>
                        @if (context.Item.ContractType == null)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">None</MudChip>
                        }
                        else if (context.Item.ContractType == ContractType.Determinate)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">Determinate</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">Indeterminate</MudChip>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ManagerTeamMember" Title="Contract Period & Status" Sortable="true"
                                SortBy="@(m => m.ContractStatus?.ToString() ?? "")" Filterable="false">
                    <CellTemplate>
                        @if (context.Item.ContractId.HasValue)
                        {
                            <div class="d-flex flex-column">
                                <div class="d-flex align-center gap-1">
                                    <MudChip T="string" Size="Size.Small" Color="@GetContractStatusColor(context.Item.ContractStatus)" Variant="Variant.Text" Class="pa-0 ma-0">
                                        @context.Item.ContractStatus
                                    </MudChip>
                                    <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
                                        @(context.Item.ContractStartDate?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "—") – 
                                        @(context.Item.ContractEndDate?.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "Indefinite")
                                    </MudText>
                                </div>
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">—</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ManagerTeamMember" Title="Leave Status" Sortable="true"
                                SortBy="@(m => m.OnLeaveToday)" Filterable="false">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.Item.OnLeaveToday ? Color.Warning : Color.Default)">
                            @(context.Item.OnLeaveToday ? "On leave" : "Available")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ManagerTeamMember" Title="Contract Actions" Filterable="false" Sortable="false">
                    <CellTemplate>
                        <div class="d-flex align-center gap-1">
                            @if (context.Item.ContractId.HasValue && context.Item.ContractType == ContractType.Determinate && context.Item.ContractStatus == ContractStatus.Active)
                            {
                                <MudTooltip Text="Extend Fixed-Term Contract">
                                    <MudIconButton Icon="@Icons.Material.Filled.Update" Size="Size.Small" Color="Color.Primary"
                                                   OnClick="@(() => OpenExtendContractDialog(context.Item))" />
                                </MudTooltip>
                            }
                            @if (context.Item.ContractId.HasValue && context.Item.ContractStatus == ContractStatus.Active)
                            {
                                <MudTooltip Text="Terminate Contract">
                                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => OpenTerminateContractDialog(context.Item))" />
                                </MudTooltip>
                            }
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="ManagerTeamMember" />
            </PagerContent>
        </MudDataGrid>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? InitialSearch { get; set; }

    private bool _authorized;
    private Guid _managerId;
    private ActingOnBehalf? _onBehalf;
    private string _realUserName = "";
    private string _actingAsName = "";
    private ManagerDashboardResult? _data;
    private string _quickSearch = "";
    private ManagerPendingRequest? _selectedRequest;
    private string RequestsSearchTerm { get; set; } = "";

    private IEnumerable<ManagerPendingRequest> FilteredRequests => string.IsNullOrWhiteSpace(RequestsSearchTerm)
        ? (_data?.Pending ?? Enumerable.Empty<ManagerPendingRequest>())
        : (_data?.Pending ?? Enumerable.Empty<ManagerPendingRequest>()).Where(r => r.Name.Contains(RequestsSearchTerm, StringComparison.OrdinalIgnoreCase));

    private void ToggleRequest(ManagerPendingRequest request)
    {
        if (_selectedRequest == request)
        {
            _selectedRequest = null;
        }
        else
        {
            _selectedRequest = request;
        }
    }

    private async Task EditDates(ManagerPendingRequest request)
    {
        var hrReq = new HrPendingRequest
        {
            RequestId = request.RequestId,
            Name = request.Name,
            Department = request.Department,
            Type = request.Type,
            StartDate = request.StartDate,
            EndDate = request.EndDate,
            Days = request.Days,
            WaitingDays = request.WaitingDays,
            Role = request.Role,
            Reason = request.Reason,
            SubmittedAt = request.SubmittedAt
        };

        var parameters = new DialogParameters<EditLeaveDatesDialog>
        {
            { d => d.Request, hrReq }
        };
        var dialog = await DialogService.ShowAsync<EditLeaveDatesDialog>("Edit leave period", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadAsync();
    }

    private Func<ManagerTeamMember, bool> _quickFilter => m =>
    {
        if (string.IsNullOrWhiteSpace(_quickSearch)) return true;
        return m.Name.Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
            || m.Role.Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
            || m.Department.Contains(_quickSearch, StringComparison.OrdinalIgnoreCase)
            || (m.ContractType != null && m.ContractType.ToString()!.Contains(_quickSearch, StringComparison.OrdinalIgnoreCase))
            || (m.ContractStatus != null && m.ContractStatus.ToString()!.Contains(_quickSearch, StringComparison.OrdinalIgnoreCase));
    };

    protected override async Task OnInitializedAsync()
    {
        if (!await PageGuard.IsAuthenticatedAsync(AuthStateTask, Nav, RendererInfo.IsInteractive))
            return;

        var user = (await AuthStateTask!).User;
        var role = user.FindFirst(ClaimTypes.Role)?.Value;
        if (role != UserRole.LineManager.ToString())
        {
            Nav.NavigateTo("/employee/dashboard");
            return;
        }

        var me = await Employees.GetEmployeeByEmailAsync(user.Identity!.Name!);
        _managerId = me.Id;

        // Non-null only while this account is borrowed. Passing it makes every action below
        // re-check the delegation window, which the auth cookie alone would outlive.
        var acting = await Acting.GetAsync();
        _onBehalf = acting is { IsImpersonating: true, DelegationId: not null }
            ? new ActingOnBehalf(acting.RealUserId, acting.DelegationId.Value)
            : null;
        _realUserName = acting?.RealUserName ?? "";
        _actingAsName = acting?.EffectiveUserName ?? "";

        if (!string.IsNullOrWhiteSpace(InitialSearch))
        {
            _quickSearch = InitialSearch;
            RequestsSearchTerm = InitialSearch;
        }

        _authorized = true;
        await LoadAsync();

        if (!string.IsNullOrWhiteSpace(InitialSearch) && _data != null)
        {
            _selectedRequest = _data.Pending.FirstOrDefault(p => p.Name.Contains(InitialSearch, StringComparison.OrdinalIgnoreCase));
        }
    }

    private async Task LoadAsync()
    {
        _data = await Manager.GetManagerDashboardAsync(_managerId);
    }

    private Color GetContractStatusColor(ContractStatus? status) => status switch
    {
        ContractStatus.Active => Color.Success,
        ContractStatus.Terminated => Color.Error,
        ContractStatus.Expired => Color.Dark,
        _ => Color.Default
    };

    private async Task DecideAsync(Guid requestId, bool approve)
    {
        try
        {
            await Manager.DecideRequestAsync(_managerId, requestId, approve, _onBehalf);
            Snackbar.Add(approve ? "Request approved." : "Request declined.", Severity.Success);
            if (_selectedRequest?.RequestId == requestId)
            {
                _selectedRequest = null;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        await LoadAsync();
    }

    private async Task OpenExtendContractDialog(ManagerTeamMember member)
    {
        if (!member.ContractId.HasValue) return;

        var parameters = new DialogParameters<ExtendContractDialog>
        {
            { x => x.EmployeeName, member.Name },
            { x => x.CurrentStartDate, member.ContractStartDate ?? DateOnly.FromDateTime(DateTime.Today) },
            { x => x.CurrentEndDate, member.ContractEndDate }
        };

        var dialog = await DialogService.ShowAsync<ExtendContractDialog>("Extend Contract", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is DateOnly newEndDate)
        {
            try
            {
                await Manager.ExtendContractAsync(_managerId, member.ContractId.Value, newEndDate, _onBehalf);
                Snackbar.Add($"Contract extended for {member.Name} until {newEndDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)}.", Severity.Success);
                await LoadAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task OpenTerminateContractDialog(ManagerTeamMember member)
    {
        if (!member.ContractId.HasValue) return;

        var parameters = new DialogParameters<TerminateContractDialog>
        {
            { x => x.EmployeeName, member.Name }
        };

        var dialog = await DialogService.ShowAsync<TerminateContractDialog>("Terminate Contract", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            var reason = result.Data as string;

            // Terminating cannot be undone, and from inside a borrowed account the screen
            // looks exactly like your own — so make the identity impossible to skip past.
            if (_onBehalf is not null && !await ConfirmTerminationAsync(member.Name))
                return;

            try
            {
                await Manager.TerminateContractAsync(_managerId, member.ContractId.Value, reason, _onBehalf);
                Snackbar.Add($"Contract terminated for {member.Name}.", Severity.Warning);
                await LoadAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task<bool> ConfirmTerminationAsync(string employeeName) =>
        await DialogService.ShowMessageBoxAsync(
            "Terminate contract",
            (MarkupString)($"You are <b>{_realUserName}</b>, acting as <b>{_actingAsName}</b>.<br/>" +
                           $"Terminate the contract for <b>{employeeName}</b>? This cannot be undone."),
            yesText: "Terminate", noText: null, cancelText: "Cancel") == true;

    private async Task OpenCreateDelegationDialog()
    {
        var regionUsers = await Employees.GetUsersInMyRegionAsync(_managerId);
        var candidateDelegates = regionUsers
            .Where(u => u.Id != _managerId)
            .ToList();

        var parameters = new DialogParameters<CreateDelegationDialog>
        {
            { x => x.AvailableUsers, candidateDelegates }
        };

        var dialog = await DialogService.ShowAsync<CreateDelegationDialog>("Delegate Manager Responsibilities", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateDelegationDialog.DelegationResult res)
        {
            try
            {
                await Manager.CreateDelegationAsync(_managerId, res.DelegateId, res.StartDate, res.EndDate, res.Reason, _onBehalf);
                Snackbar.Add("Delegation created successfully.", Severity.Success);
                await LoadAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task CancelDelegationAsync(Guid delegationId)
    {
        try
        {
            await Manager.CancelDelegationAsync(_managerId, delegationId);
            Snackbar.Add("Delegation cancelled.", Severity.Info);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
