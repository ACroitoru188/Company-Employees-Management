@* One node of the organization tree. It renders itself for each subordinate, which is how
   the whole hierarchy is drawn without any layout maths of its own — FluentTreeView handles
   indentation and the expand chevrons.

   Selection rides on SelectedChanged, not @onclick: a click event bubbles through every
   ancestor tree item, so the outermost (HQ) would always win and wipe the selection.
   SelectedChanged fires only on the item whose state actually flipped. Expanded is bound
   both ways so search / Focus Me can open the path to a node after first render. *@
@using CompanyEmployees.Application

@* The Id is what lets the page move the highlight itself. The tree item owns its own selection:
   it sets `selected` when clicked, but ignores a later `selected=false` from a re-render, so a
   programmatic jump — Focus Me, or picking somebody from the search — left the previous row
   highlighted while the detail panel showed the new person. CompanyDirectory clears and sets it
   by id when that happens. Keying the item on its selected state was tried first and was worse:
   rebuilding the element on every selection meant no row highlighted at all. *@
<FluentTreeItem Id="@($"orgnode-{Node.UserId:D}")"
                Expanded="@Node.IsExpanded"
                ExpandedChanged="@(expanded => Node.IsExpanded = expanded)"
                Selected="@(Node.UserId == SelectedId && Node.UserId != Guid.Empty)"
                SelectedChanged="@(selected => selected ? OnSelect.InvokeAsync(Node) : Task.CompletedTask)"
                Class="@((Node.IsFocusNode ? "org-path-highlight " : "") + (Node.UserId == CurrentUserId && Node.UserId != Guid.Empty ? "org-current-user" : ""))">
    <FluentPersona Name="@Node.Name" Initials="@Node.Initials" ImageSize="28px"
                   TextPosition="TextPosition.End">
        @* FluentPersona drops its Name whenever ChildContent is supplied, so the name is
           rendered here explicitly above the secondary line. *@
        <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@Node.Name</FluentLabel>
        <FluentLabel Typo="Typography.Body" Color="Color.Custom"
                     CustomColor="var(--neutral-foreground-hint)">
            @Node.Role@(string.IsNullOrEmpty(Node.Department) ? "" : $" · {Node.Department}")
        </FluentLabel>
    </FluentPersona>

    @foreach (var child in Node.Subordinates)
    {
        <OrgTreeNode Node="@child" SelectedId="@SelectedId" CurrentUserId="@CurrentUserId" OnSelect="@OnSelect" />
    }
</FluentTreeItem>

@code {
    [Parameter, EditorRequired]
    public OrgChartNode Node { get; set; } = default!;

    [Parameter]
    public Guid SelectedId { get; set; }

    [Parameter]
    public Guid CurrentUserId { get; set; }

    [Parameter]
    public EventCallback<OrgChartNode> OnSelect { get; set; }
}
