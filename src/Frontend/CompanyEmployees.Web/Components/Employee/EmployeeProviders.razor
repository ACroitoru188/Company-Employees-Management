@* Fluent UI's providers, the counterpart of MudBlazor's. FluentDesignTheme emits the design
   tokens every component reads, so it has to sit above them; the rest are the render hosts
   for dialogs, toasts, tooltips and menus. Include this at the top of every layout. *@
@using CompanyEmployees.Web.Services
@inject ThemeState ThemeState
@implements IDisposable

<FluentDesignTheme Mode="@(ThemeState.IsDarkMode ? DesignThemeModes.Dark : DesignThemeModes.Light)"
                   CustomColor="@AccentColor"
                   StorageName="companyemployees-theme" />
<FluentToastProvider MaxToastCount="5" />
<FluentDialogProvider />
<FluentTooltipProvider />
@* Sectioned on purpose: a provider without one also renders the bell's notification centre. *@
<FluentMessageBarProvider Section="@MessageSections.Page" />
<FluentMenuProvider />

@code {
    // The accent Fluent derives its whole token palette from. It has to be the same value
    // app.css names for the light-DOM elements the runtime never reaches, or the app runs two
    // slightly different blues at once. #1E88E5 was that value until it turned out white text
    // on it is only 3.68:1; #0F6CBD is Fluent's own accent fill and clears the 4.5:1 floor.
    public const string AccentColor = "#0F6CBD";

    protected override void OnInitialized() => ThemeState.OnChange += StateHasChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await ThemeState.InitializeAsync();
    }

    public void Dispose() => ThemeState.OnChange -= StateHasChanged;
}
